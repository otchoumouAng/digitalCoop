<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript" src="~/Scripts/FunctionHelpers.js"></script>
<script type="text/javascript">   
    var GetNbrStoreRows = function (newrow) {
        var nbr = App.grpListeCodeOverview.getRowsValues().length;
        App.LblResumeCoding.setText(nbr + ' Code');
    };

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeCodeOverview.columnManager.getColumns(), App.grpListeCodeOverview.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var SetCriteriaTitle = function (statuts,begin, end) {        
        App.CriteriaPanelDeliveryCode.title = "";
        var texttitle = "";        

        if (begin) texttitle += " Du : " + begin;

        if (end) texttitle += " Au : " + end;

        if (status) texttitle += " | Voir uniquement les livraisons en attente : YES ";
        else texttitle += " | Voir uniquement les livraisons en attente : NO ";

        App.CriteriaPanelDeliveryCode.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    };

    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    };

    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {            

            if (App.rowSelectionCode.hasSelection()) {

                if (App.CdhiddenPermModifier.value == 'true')
                    App.btnModifyCode.enable();                

                var isDisabled = App.rowSelectionCode.selected.items[0].data.Desactive;

                if (isDisabled === true) {
                    App.mnuCancelCode.setText('Activer');
                    App.mnuCancelCode.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    App.mnuCancelCode.setText('Annuler');
                    App.mnuCancelCode.setIconCls('glyphicon glyphicon-remove red');
                }

                if (App.CdhiddenPermDesactiver.value == 'true')
                    App.mnuCancelCode.enable();
            } else {

                App.btnModifyCode.disable();                
                App.mnuCancelCode.disable();
            }
        }
        
    };


</script>


