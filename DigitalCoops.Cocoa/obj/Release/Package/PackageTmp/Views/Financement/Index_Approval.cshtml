<script src="~/Scripts/FunctionHelpers.js"></script>
<script src="~/Scripts/FormatAmount.js"></script>
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeFinancingApproval.columnManager.getColumns(), App.grpListeFinancingApproval.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);
        

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
            else if (value == 3) {
                return 'action_new_03';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return  'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }
        },

        SummaryFAP: function () {
            var nbrOfrows = App.grpListeFinancingApproval.getStore().getCount();
            var totalBalance = parseFloat(App.storeListeFinancingApproval.sum('Solde')) || 0;
            var totalAmount = parseFloat(App.storeListeFinancingApproval.sum('Montant')) || 0;
            /*for (var i = 0; i < nbrOfrows; i++) {
              
                totalAmount += parseFloat(App.grpListeFinancingApproval.getRowsValues()[i].Montant);
                totalBalance += parseFloat(App.grpListeFinancingApproval.getRowsValues()[i].Solde);
                
            }*/
            totalAmount = FormatAmount(totalAmount);
            totalBalance = FormatAmount(totalBalance);
            App.lblSummaryFAP.setText("Montant Total : " + totalAmount + " FCFA");
        },
        resetButtons: function () {
            App.btnApprove.disable();
            App.btnReject.disable();
            App.mnuPrintSupplierFinancStatus.disable();

            if (App.rowSelectionListeFAP.hasSelection()) {

                var isActive = App.rowSelectionListeFAP.selected.items[0].data.IsActive;

                if (isActive === true) {
                    if (App.fihiddenPermApprove.value == 'true')
                        App.btnApprove.enable();

                    if (App.fihiddenPermPrintFinancialStatus.value == 'true')
                        App.mnuPrintSupplierFinancStatus.enable();

                    if (App.fihiddenPermReject.value == 'true')
                        App.btnReject.enable();
                }

                else {
                    App.btnApprove.disable();
                    App.btnReject.disable();
                    App.mnuPrintSupplierFinancStatus.disable();
                }

            }
        }
    }


</script>

