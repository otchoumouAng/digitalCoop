
@model Tms.Classes.Business.Sites.PaiementChequeAgenceViewModel
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 140px !important;
    }

    .x-form-text-default.x-form-textarea {
        line-height: 30px;
        min-height: 75px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>

@(

      X.Window()
            .ID("PaiementChequeAgence_Detail")
            .Width(500)
            .Modal(true)
            .Resizable(false)
            .Height(250)
            .CloseAction(Ext.Net.CloseAction.Destroy)

            .Title("Cash Disbursement")
            .Items
            (

             X.Hidden().ID("baseUrlVal").Value(@BaseUrl),


                X.Panel()
                    .Frame(false)
                    .Border(false)
                    .FrameHeader(false)
                    .ID("pnlFlexEvenPay")
                    .Layout(LayoutType.HBox)
                    .MarginSpec("0 0 5 0")
                    .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                    .Items
                    (
                        X.Hidden()
                                        .ID("hiddenExecMode")
                                        .Value(Model._ExecMode)
                                        ,
                                        X.Hidden()
                                            .ID("hiddenRowversion")
                                            .Value(Model._PaiementChequeAgence.RowVersionKey)
                                            ,

                                        X.Hidden()
                                            .ID("txtPaiementChequeID")
                                            .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PaiementChequeAgence.ID : Guid.Empty)
                                            ,

                                            X.Panel()
                                             .ID("firstColPay")
                                             .Layout(LayoutType.Form)
                                             .Flex(1)
                                             .Items
                                             (
                                                X.FieldContainer().Layout(LayoutType.HBox)
                                                .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch })
                                                .FieldLabel("Disbursement Date")
                                                .LabelAlign(LabelAlign.Right)
                                                .Items(
                                                        X.DateField()
                                                             .ID("txtDate")
                                                             .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PaiementChequeAgence.Date.ToString() : DateTime.Now.ToString()).LabelAlign(LabelAlign.Right)
                                                             .AllowBlank(false)
                                                             .Width(160)
                                                             .MarginSpec("0 10 0 0")
                                                             .IndicatorCls("IndicatorRedStar")
                                                             .IndicatorText("*")
                                                )
                                                ,
                                                X.TextField()
                                                .FieldLabel("Montant (CFA)")
                                                .LabelAlign(LabelAlign.Right)
                                                .HideTrigger(true)
                                                //.MaskRe("[0123456789]")
                                                .ID("txtAmountPayment")
                                                .AllowBlank(false)
                                                 .IndicatorCls("IndicatorRedStar")
                                                 .IndicatorText("*")
                                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PaiementChequeAgence.Montant.ToString("n0") : string.Empty)
                                                //.Width(170)
                                                .Listeners
                                                 (
                                                   ls =>
                                                   {
                                                       ls.Blur.Handler = "if (App.txtAmountPayment.value && !App.txtAmountPayment.readOnly) {#{txtAmountPayment}.setValue(formatNumber(#{txtAmountPayment}.getValue()))}";
                                                       ls.Focus.Handler = "if (App.txtAmountPayment.value && !App.txtAmountPayment.readOnly) { #{txtAmountPayment}.setRawValue(unformatNumber(#{txtAmountPayment}.getValue()));}";

                                                   }

                                                 )
                                                 ,
                                                X.TextArea()
                                        .ID("TxtComment")
                                        .FieldLabel("Commentaire")
                                        .LabelAlign(LabelAlign.Right)
                                        .AllowBlank(false)
                                        .IndicatorCls("IndicatorRedStar")
                                        .IndicatorText("*")
                                        .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PaiementChequeAgence.Commentaire.ToString() : string.Empty)
                                              
                                 //1stCol
                                 )

                              //End first panel
                              )


            //End Windows
            )
            .Buttons
                (
                    X.Button()
                    .Text("OK")
                    .ID("BtnOkAdd")
                    .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? "Validate" : "Ok")
                    .DirectEvents
                    (
                        de =>
                        {
                            de.Click.Url = Url.Action("SubmitOnAdd", "PaiementChequeAgence");
                            de.Click.Before = "return validAdd(App.PaiementChequeAgence_Detail.id); ";

                            de.Click.ExtraParams.Add(new Parameter { Name = "ItemPaiementChequeID", Mode = ParameterMode.Raw, Encode = false, Value = "#{txtPaiementChequeID}.getValue()" });
                            de.Click.ExtraParams.Add(new Parameter { Name = "ItemExecMode", Mode = ParameterMode.Raw, Encode = false, Value = "#{hiddenExecMode}.getValue()" });

                            de.Click.ExtraParams.Add(new Parameter { Name = "ItemDate", Mode = ParameterMode.Raw, Encode = false, Value = "#{txtDate}.getRawValue()" });
                            de.Click.ExtraParams.Add(new Parameter { Name = "ItemMontant", Mode = ParameterMode.Raw, Encode = false, Value = "#{txtAmountPayment}.getRawValue()" });
                            de.Click.ExtraParams.Add(new Parameter { Name = "ItemCommentaire", Mode = ParameterMode.Raw, Encode = false, Value = "#{txtComment}.getValue()" });
                            de.Click.Confirmation.ConfirmRequest = Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? true : false;
                            de.Click.Confirmation.BeforeConfirm = "config.confirmation.title = 'Cash Disbursement : Edit Cash Disbursement'; config.confirmation.message = 'Do you want to edit this item? ';";

                            de.Click.FormID = "#(return this.up('window').down('form');)";
                        }
                    ),

                    X.Button()
                    .TabIndex(13)
                    .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                    .Handler("App.PaiementChequeAgence_Detail.doClose()")
                    .Cls("btncancel")

                //End Button
                )

)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validAdd = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Cash Disbursement : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        

    };


    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

   

</script>