<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    @*<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap-theme.min.css" integrity="sha384-rHyoN1iRsVXV4nD0JutlnGaslCJuC7uwjduW9SVrLvRYooPp2bWYgmgJQIXwl/Sp" crossorigin="anonymous">*@

</head>
<script src="~/Scripts/FunctionHelpers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListe.columnManager.getColumns(), App.grpListe.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var GetNbrStoreRows = function () {
        var nbr = App.grpListe.getRowsValues().length;
        App.LblNbrOfWeighings.setText(nbr + ' Weighings');
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }
    var Overview =
    {
        getBootStrapIcons: function (value)
        {
            if (value === 0)
            {
                return 'glyphicon-remove red'; // Cancelled
            }
            else if (value == 2)
            {
                return  'glyphicon-ok green'; // 2nd Weigh.
            }
            else if (value == 1)
            {
                return 'glyphicon-file blue'; // 1st weigh.
            }
            else if (value == 3)
            {
                return 'glyphicon-hand-right blue'; // Manual
            }
            else if (value == 4)
            {
                return 'glyphicon-ban-circle red'; // Rejected
            }
        },
        resetButtons: function () {

        }
    }


</script>

@model Tms.Classes.Business.PeseeViewModel
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
    string StartDate = DateTime.Now.AddDays(-30).ToShortDateString();
    string EndDate = DateTime.Now.ToShortDateString();
}

@(Html.X().ResourceManager().AjaxTimeout(3600000))

<form id="tms_form">

    @(X.Viewport()
                                    .Layout(LayoutType.Border)
                                    .ID("TmsViewPort")
                                    .Items
                                     (
                                        X.Hidden().ID("BaseUrl").Value(@BaseUrl),

                                        X.Panel()
                                            .ID("pnlNorth")
                                            .Region(Region.North)
                                            .Layout(LayoutType.Border)
                                            .TopBar(new Toolbar()
                                            {
                                                Items =
                                                {
                                                 X.Button()
                                                    .ID("btnFilter")
                                                    .IconCls("action_filter_02")
                                                    .Border(false)
                                                    .Cls("ButtonStyle")
                                                    .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                                                    .Disable(false)
                                                    .DirectEvents
                                                     (
                                                        de =>
                                                        {
                                                            de.Click.Url  = Url.Action("OnFilter");
                                                            de.Click.EventMask.ShowMask = true;
                                                        }
                                                     ),

                                         X.Button()
                                            .ID("btnRefresh")
                                            .IconCls("action_refresh_01")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                                            .Border(false)
                                            .Cls("ButtonStyle")
                                            .Disable(false)
                                            .DirectEvents
                                             (
                                                de =>
                                                {
                                                    de.Click.Url  = Url.Action("OnRefresh");
                                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStartDate", Value= "#{dtfStartDate}.getRawValue()",   Mode=ParameterMode.Raw});
                                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemEndDate", Value= "#{dtfEndDate}.getRawValue()",     Mode=ParameterMode.Raw});
                                                    de.Click.Success = "App.CriteriaPanel.setTitle( 'From  '+ App.dtfStartDate.rawValue  + ' au  '+ App.dtfEndDate.rawValue )";
                                                    de.Click.EventMask.ShowMask = true;
                                                }
                                             ),
                                         X.SplitButton()
                                            .ID("btnPrint")
                                            .IconCls("action_print_02")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                            .Disable(false)
                                            .Cls("ButtonStyle")
                                            .Border(false)
                                            .Menu(
                                            new Menu()
                                            {
                                                Items =
                                                {
                                                    X.MenuItem()
                                                        .ID("mnuPrintHistoryOfWeighing")
                                                        .Text("History Of Weighings")
                                                        .DirectEvents(de =>
                                                                {
                                                                    de.Click.Url = Url.Action("OnDisplayHistoryOfWeighing");
                                                                    de.Click.EventMask.ShowMask = true;
                                                                })
                                                }

                                            })
                                            ,
                                        X.ToolbarFill(),
                                        X.Button()
                                            .ID("btnActions")
                                            .Text("Actions")
                                            .Border(false)
                                            .Cls("ButtonStyle")
                                            .IconCls("menu_04")
                                            .Disable(false)
                                            .Menu(
                                            new Menu()
                                            {                                                
                                                 Items = {
                                                    X.MenuItem()
                                                        .ID("mnuExportHistoryWeighing")
                                                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                                        .Icon(Icon.PageExcel)
                                                        .Handler("SetExcelList();")
                                                    }
                                                })
                                        },

                                    }
                                ),

                                    X.FormPanel()
                                       .ID("CriteriaPanel")
                                       .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = @ViewBag.CriteriaTitle })
                                       .Region(Region.North)
                                       .Floatable(false)
                                       .Border(false)
                                       .Collapsed(true)
                                       .Collapsible(true)
                                       .BodyPadding(5)
                                       .Frame(true)
                                       .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Start })
                                       .Items
                                         (

                                               X.Panel()
                                               .Border(false)
                                               //.Frame(true)
                                               //.Margin(10)
                                               .Width(500)
                                               .Height(40)
                                               .Layout(LayoutType.HBox)
                                               .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Center })
                                               .Items
                                                (
                                                        X.Panel()
                                                        .Border(false)
                                                        .Frame(false)
                                                        .Margin(0)
                                                        .Width(450)
                                                        //.Layout(LayoutType.Form)
                                                        //.BodyPadding(10)
                                                        .Items
                                                        (

                                                                X.FieldContainer()
                                                                .FieldLabel("Debut/Fin").LabelAlign(LabelAlign.Right)
                                                                .LabelWidth(110)
                                                                .Layout(LayoutType.HBox)
                                                                .Items
                                                                (
                                                                    X.DateField()
                                                                    .ID("dtfStartDate")
                                                                    .Width(170)
                                                                    .SelectedDate(DateTime.Now.AddDays(-1))
                                                                    .MarginSpec("5 5 0 0")
                                                                    ,

                                                                    X.DateField()
                                                                    .ID("dtfEndDate")
                                                                    .Width(140)
                                                                    .MarginSpec("5 5 0 5")
                                                                    .SelectedDate(DateTime.Now)
                                                                 )


                                                    )
                                           ),


                                           X.Panel()
                                           .ID("formOverview")
                                           .Width(400)                                           
                                           .Flex(1)                                           
                                           .Height(40)
                                           //.TitleConfig(new PanelTitle { Text = "Summary", Cls = "title_font_color" })
                                           .Border(false)                                           
                                           .Layout(LayoutType.HBox)
                                           .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                                           .Items
                                           (
                                                X.Container()
                                                .ID("")
                                                .Layout(LayoutType.VBox)
                                                .LayoutConfig(new VBoxLayoutConfig { Pack = BoxPack.Center })
                                                .Items(X.Label().ID("LblNbrOfWeighings").Text("").EmptyText(""))
                                           )
                            ),

                            X.GridPanel()
                           .Layout(LayoutType.Fit)
                           .ID("grpListe")
                           .Region(Region.Center)
                           .ForceFit(false)
                           .Flex(1)
                           .AllowDeselect(false)
                           .Store
                           (
                              X.StoreFor<Tms.Classes.Business.PeseeHistory>().ID("storeListe")
                              .AutoLoad(true)
                                      .PageSize(100)
                                      .RemotePaging(false)
                              .SorterFor(Model, m => m._Pesee.DateLivraison, Ext.Net.SortDirection.DESC)
                              .Listeners(ls =>
                              {
                                  ls.Load.Handler = "GetNbrStoreRows(); Ext.net.Mask.hide();";
                                  ls.Add.Handler = "GetNbrStoreRows();";
                                  ls.BeforeLoad.Handler = "Ext.net.Mask.show();";
                              })
                              .Proxy
                              (
                                    Html.X().AjaxProxy()
                                    .Url(Url.Action("Select", "PeseeHistory"))
                                    .Reader(Html.X().JsonReader().RootProperty("data"))
                              )
                              .Parameters
                                (
                                    ps =>
                                    {
                                        ps.Add(new StoreParameter { Name = "ItemStartDate", Value = "App.dtfStartDate.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                        ps.Add(new StoreParameter { Name = "ItemEndDate", Value = " App.dtfEndDate.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    }
                                )
                           )
                           .ColumnModel
                           (
                                Html.X().Column().Text("").DataIndex("mIcon").Width(40).Hideable(false).Filterable(false).Renderer("renderIcon"),
                                Html.X().Column().Text("History Date").DataIndex("DateActionAsString").Width(100).Flex(2),
                                Html.X().Column().Text("User").DataIndex("UserName").Width(100).Flex(1),
                                Html.X().Column().Text("Type De Livraison").DataIndex("DeliveryType").Width(100).Flex(3),
                                Html.X().Column().Text("Livraison N°").DataIndex("DeliveryID").Width(100).Flex(1),
                                Html.X().Column().Text("Weighing ID").DataIndex("Numero").Width(100).Flex(1).Hidden(true),
                                Html.X().Column().Text("Bridge N°").DataIndex("BasculeAsString").Hidden(true).Width(100).Flex(1),
                                Html.X().Column().Text("Fournisseur").DataIndex("DeliverySupplier").Width(100).Flex(3),
                                Html.X().Column().Text("Immatriculation").DataIndex("DeliveryTruckID").Width(100).Flex(1),
                                //Html.X().Column().Text("Sacs Estimés").DataIndex("DeliveryEstimatedBags").Width(100).Flex(1),
                                //Html.X().Column().Text("Tonnage Estimé").DataIndex("DeliveryEstimatedTonnage").Width(100).Flex(1),
                                Html.X().Column().Text("Poids (1)").DataIndex("PoidsP1AsString").Width(100).Flex(1),
                                Html.X().Column().Text("Poids (1) Date").DataIndex("DateP1").Width(100).Flex(1).Renderer("renderDateLong").Hidden(true),
                                Html.X().Column().Text("Sacs dechargés").DataIndex("SacsDecharges").Width(150).Flex(1).Hidden(true),
                                Html.X().Column().Text("Sacs acceptés").DataIndex("SacsAcceptes").Width(90).Flex(1).Hidden(true),

                                Html.X().Column().Text("2nd Weight").DataIndex("PoidsP2AsString").Width(100).Flex(1),
                                Html.X().DateColumn().Text("2nd Weight date").DataIndex("DateP2").Width(100).Flex(1).Renderer("renderDateLong").Hidden(true),
                                Html.X().Column().Text("Poids Brut").DataIndex("PoidsBrutAsString").Width(100).Flex(1),
                                Html.X().Column().Text("Taux").DataIndex("Tare").Width(100).Flex(1),
                                Html.X().Column().Text("Tare Des Sacs").DataIndex("TareEmballages").Width(90).Flex(1).Hidden(true),
                                Html.X().Column().Text("Tare Des Palettes").DataIndex("TarePalettes").Width(90).Flex(1).Hidden(true),
                                Html.X().Column().Text("Net Livré").DataIndex("PoidsNetLivreAsString").Width(100).Flex(1),

                                Html.X().Column().Text("Changing Type Of Weighing Reason").DataIndex("RaisonChangementType").Width(100).Flex(1).Hidden(true),
                                Html.X().Column().Text("Correct Poids (1) Reason").DataIndex("RaisonCorrectionPoidsPremierePesee").Width(100).Hidden(true).Flex(1),
                                Html.X().Column().Text("Correct 2nd Weight Reason").DataIndex("RaisonCorrectionPoidsDeuxiemePesee").Width(100).Flex(1).Hidden(true),

                                Html.X().Column().Text("Utilisateur Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                                Html.X().DateColumn().Text("Date Creation ").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                                Html.X().Column().Text("Utilisateur Modification").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                                Html.X().DateColumn().Text("Date Modification").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")
                         )
                         .BottomBar
                         (
                             Html.X().PagingToolbar()
                            .HideRefresh(true)
                            .Plugins(Html.X().ProgressBarPager())
                         )
                         .Plugins
                         (
                           X.FilterHeader()
                         )
                         .View(
                            Html.X().GridView().LoadingText("Chargement...")
                    )
                        .SelectionModel
                        (
                          X.RowSelectionModel()
                           .ID("rowSelectionListe")
                           .Mode(SelectionMode.Single)
                           .AllowDeselect(false)
                        )
                       .Listeners
                       (
                            l =>
                            {
                                l.Select.Fn = "Overview.resetButtons";
                                l.Deselect.Fn = "Overview.resetButtons";
                            }

                       )
                       .DirectEvents
                       (
                            de =>
                            {
                                de.RowDblClick.Url = Url.Action("OnConsult");
                                de.RowDblClick.CleanRequest = true;
                                de.RowDblClick.Success = "App.frmPesee.setTitle('Pesée : Detail')";
                                de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowSelectionListe}.getSelected().items[0].data" });
                                de.RowDblClick.EventMask.ShowMask = true;
                            }
                       )

        )
    )

</form>


