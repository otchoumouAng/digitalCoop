<script type="text/javascript">
    var SelectNewRecord = function (record) {
        var rec = App.grpListe.store.getById(record[0].data.ID);
        App.grpListe.store.loadPage(App.grpListe.store.findPage(rec), {
            callback: function () {
                App.grpListe.getSelectionModel().select(rec);
            }
        });
    };

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListe.columnManager.getColumns(), App.grpListe.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value)
    {
        if (!Ext.isEmpty(value))
        {
            if (value.AsString)
                return value.AsString;
        }

        return '';
    }

    var renderIcon = function (value)
    {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record)
    {
        metaData.css = Overview.getIcons(value);
    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            App.btnNew.disable();

            App.btnModify.disable();

            App.btnApprove.disable();
            App.btnSupplierDashBoard.disable();
         
            App.mnuPrintHistoryOfPayment.disable();
            /*App.mnuPrintSupplierList.disable();*/
            App.mnuPrintHistoryOfBE.disable();
            App.mnuPrintHistoryOfDeliveries.disable();
            App.mnuPrintPrintEngagementExecution.disable();
            App.mnuPrintHistoryOfEngagement.disable();
            App.mnuPrintSupplierFinancingBalance.disable();
            App.mnuPrintSupplierFinancialStatus.disable();
            
            App.mnuPrintHistoryOfPayment.disable();

            App.mnuCancel.disable();

            if (App.FrshiddenPermCreer.value == 'true')
                App.btnNew.enable();

            if (App.rowSelectionListe.hasSelection())
            {
                var isDisabled = App.rowSelectionListe.selected.items[0].data.Desactive;

                var isApproved = App.rowSelectionListe.selected.items[0].data.IsApproved;

                /*if (!isDisabled && !isApproved) {
                    if (App.FrshiddenPermModifier.value == 'true') {
                        App.btnModify.enable();
                    }
                }*/

                if (!isDisabled) {
                    if (App.FrshiddenPermModifier.value == 'true' ) {
                        App.btnModify.enable();
                    }
                }

                if (isApproved === false) {
                    if (App.FrshiddenPermApprove.value == 'true') {
                        App.btnApprove.enable();
                    }
                }

                /*App.mnuPrintCard.enable();*/
                if (isApproved == true && isDisabled === false)
                {
                    if (App.FrshiddenPermApprove.value == 'false') {
                        App.btnModify.disable();
                    }
                    /*if(App.FrshiddenPermPrintSupplierList.value == 'true')
                    App.mnuPrintSupplierList.enable();*/                    

                    if (App.FrshiddenPermPrintHistoryOfBE.value == 'true')
                        App.mnuPrintHistoryOfBE.enable();

                    if (App.FrshiddenPermPrintHistoryOfPayment.value == 'true')
                        App.mnuPrintHistoryOfPayment.enable();

                    if (App.FrshiddenPermPrintDashBoard.value == 'true')
                        App.btnSupplierDashBoard.enable();         

                    if (App.FrshiddenPermPrintHistoryOfDeliveries.value == 'true')
                        App.mnuPrintHistoryOfDeliveries.enable();

                    if (App.FrshiddenPermPrintEngagementExecution.value == 'true')
                        App.mnuPrintPrintEngagementExecution.enable();

                    if (App.FrshiddenPermPrintHistoryOfEngagement.value == 'true')
                        App.mnuPrintHistoryOfEngagement.enable();

                    if (App.FrshiddenPermPrintFinancialBalance.value == 'true')
                        App.mnuPrintSupplierFinancingBalance.enable();

                    if (App.FrshiddenPermPrintFinancialStatus.value == 'true')
                        App.mnuPrintSupplierFinancialStatus.enable();                   

                    if (App.FrshiddenPermPrintHistoryOfPayment.value == 'true')
                        App.mnuPrintHistoryOfPayment.enable();
                }

                if (isDisabled === true)
                {
                    App.mnuCancel.setIconCls("glyphicon glyphicon-ok green");
                    App.mnuCancel.setText('Activer');
                }

                else
                {
                    App.mnuCancel.setIconCls("glyphicon glyphicon-remove red");
                    App.mnuCancel.setText('Desactiver');
                }

                if (App.FrshiddenPermDesactiver.value == 'true')
                    App.mnuCancel.enable();
            }


        },

        updateSummaryInfo: function()
        {
            var mItemsCount = App.storeListe.totalCount;
            mItemsCount = Ext.util.Format.number(mItemsCount,'0,0');

            var mChaine = Ext.String.format('{0} supplier(s) ', mItemsCount);
            App.lblResume.setText(mChaine);

            /*App.rowSelectionListe.deselectAll(true);*/

            Overview.resetButtons();
        }

    }


    Ext.onReady(function() {


        /*
           *   Ajout de la modification des lignes du griPanel
           OnAfterRecordDeleted="AfterUpdate" OnAfterRecordInserted="AfterUpdate" OnAfterRecordUpdated="AfterUpdate"  */

        App.storeListe.on('add',Overview.updateSummaryInfo );


        /*
        *   Ajout de la modification des lignes du griPanel
        OnAfterRecordDeleted="AfterUpdate" OnAfterRecordInserted="AfterUpdate" OnAfterRecordUpdated="AfterUpdate"  */

               App.storeListe.on('update',Overview.updateSummaryInfo );


        /*
       *   Ajout de la modification des lignes du griPanel
       OnAfterRecordDeleted="AfterUpdate" OnAfterRecordInserted="AfterUpdate" OnAfterRecordUpdated="AfterUpdate"  */

               App.storeListe.on('remove',Overview.updateSummaryInfo );


              App.storeListe.on('load',Overview.updateSummaryInfo );
    });


</script>

