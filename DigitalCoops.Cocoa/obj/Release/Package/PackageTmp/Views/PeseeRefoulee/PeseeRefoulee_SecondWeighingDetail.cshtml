    <script type="text/javascript">

        var setCtrlIsRequired = function (field, value)
        {
            field.allowBlank = !value;

            field.setIndicator("");
            field.setIndicatorCls('');
            field.showIndicator();

            if (value == true)
            {

                field.setIndicator("*");
                field.setIndicatorCls('IndicatorRedStar');
                field.showIndicator();
            }
        };

        var calculerNbrSacsAcceptes = function ()
        {
            if (App.txtUnloadledBags.value != '' && App.txtRejectedBags.value != '')
            {
                var sacsDecharges = parseInt(App.txtUnloadledBags.value, 10)||0;
                var sacsRejetes = parseInt(App.txtRejectedBags.value, 10)||0;

                App.txtAcceptedBags.setValue(sacsDecharges - sacsRejetes);
            }
        };

        var calculerTareSacsAcceptes = function ()
        {
            if (App.txtAcceptedBags.value != '' )
            {
                var sacsAcceptes = parseInt(App.txtAcceptedBags.value, 10) || 0;
                var tareSacsUnitaire = parseInt(App.hiddenTareSacsLivraison.value, 10) || 0;

                App.txtTareOfBags.setValue(sacsAcceptes * tareSacsUnitaire);

                calculerPoidsBrut();
            }
        };

        var calculerPoidsNet = function ()
        {
            if (App.txtDeliveryGrossWeight.value != '' && App.txtTareOfBags.value != '' && App.txtTareOfPallets.value != '')
            {

                var grossWeight = parseInt(App.txtDeliveryGrossWeight.value, 10) || 0;
                var tareBags = parseInt(App.txtTareOfBags.value, 10) || 0;
                var tarePallets = parseInt(App.txtTareOfPallets.value, 10) || 0;
                var netWeight = grossWeight - tareBags - tarePallets;

                console.log(App.txtDeliveryNetWeight.value);

                App.txtDeliveryNetWeight.setValue(netWeight);

            }
        };

        var calculerPoidsBrut = function () {
            if (App.txtFirstGrossWeight.value != '' && App.txtSecondGrossWeight.value != '') {

                var firstWeight = parseInt(App.txtFirstGrossWeight.value, 10) || 0;
                var secondWeight = parseInt(App.txtSecondGrossWeight.value, 10) || 0;

                var poidsBrut = Math.abs(firstWeight - secondWeight);
                /*var tarePalletes = parseInt(App.txtTareOfPallets.value, 10);
                var tareSacs = parseInt(App.txtTareOfBags.value, 10);*/

                App.txtDeliveryGrossWeight.setValue(poidsBrut);


                calculerPoidsNet();
            }
        };

        var verifierNbrSacs = function () {

            var nbrBagsGardes = parseInt(App.txtNbrBagsKept.value, 10) || 0;
            var sacsCharges = parseInt(App.txtLoadedBags.value, 10) || 0;

            if (nbrBagsGardes != sacsCharges) {
                App.txtLoadedBags.setValue('');
                App.txtLoadedBags.focus(true);
                Ext.Msg.show({ title: 'Error : Weighing ', msg: 'Nbr de sacs kept must be equals to Nbr de Sacs loaded.', buttons: Ext.Msg.OK });
            }

        }
    </script>
