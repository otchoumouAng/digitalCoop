        de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowSelectionListePrefinancementAgence}.getSelected().items[0].data" });
        de.RowDblClick.EventMask.ShowMask = true;
    }
        )

    )
