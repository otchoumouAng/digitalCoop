<script type="text/javascript">
    var CallSummary = function () {
        /*var baseurl = App.BaseUrl.value;
        Ext.net.DirectMethod.request({ url: baseurl + "/Livraison/UpdateSummary"});*/
        //var mItemsCount = App.grpListe.getRowsValues().length || 0;
             var mItemsCount = App.grpListe.getStore().totalCount || 0;

             var mTotalEstimatedBags = App.storeTransferList.sum('NombreSacs') || 0;
        var mTotalEstimatedTonnage = App.storeTransferList.sum('PoidsBrut') || 0;

        //mItemsCount = Ext.util.Format.number('0,0', mItemsCount);
        //mTotalEstimatedBags = Ext.util.Format.number('0,0', mTotalEstimatedBags);
        //mTotalEstimatedTonnage = Ext.util.Format.number('0,0', mTotalEstimatedTonnage);


        var mChaine = Ext.String.format('Livraison(s) : {0} <br/> Total Sacs Estimés : {1} <br/> Total Tonnage estimé : {2} (Kg)', formatNumber(mItemsCount), formatNumber(mTotalEstimatedBags), formatNumber(mTotalEstimatedTonnage));
       App.lblResume.setHtml(mChaine);

       /*App.rowSelectionListe.deselectAll(true);*/

       Overview.resetButtons();
    };
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListe.columnManager.getColumns(), App.grpListe.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var Overview =
    {

        resetButtons: function () {

            App.btnModify.disable();
            App.btnApprove.disable();
            App.mnuCancel.disable();            
            App.mnuPrintSheet.disable();
            if (App.rowSelectionListe.hasSelection())
            {
                var isDisabled = App.rowSelectionListe.selected.items[0].data.Desactive;
                var isApproved = App.rowSelectionListe.selected.items[0].data.EstFinalise;

                if (!isDisabled && !isApproved) {
                    if (App.tfhiddenPermModifier.value == 'true')
                        App.btnModify.enable();

                    if (App.tfhiddenPermApprove.value == 'true')
                        App.btnApprove.enable();

                    if (App.tfhiddenPermDesactiver.value == 'true')
                        App.mnuCancel.enable();

                }
                
                if (!isDisabled && isApproved) {
                    if (App.tfhiddenPermModifier.value == 'true') {
                        App.mnuPrintSheet.enable();
                        App.btnApprove.disable();
                        App.btnModify.disable();
                    }
                }

                if ((App.tfhiddenPermDesactiverApresApprouve.value == 'true' && isApproved))
                    App.mnuCancel.enable();



               
            }


        }

         , updateSummaryInfo: function ()
         {
             /*var mItemsCount = App.grpListe.getRowsValues().length || 0;
             var mItemsCount = App.grpListe.getStore().totalCount || 0;
             var total = parseFloat(0);*/

             /*var mTotalEstimatedBags = App.storeTransferList.sum('SacsDeclares') || 0;
             var mTotalEstimatedBags = total;
             var mTotalEstimatedTonnage = App.storeTransferList.sum('PoidsDeclare') || 0;*/

             //mItemsCount = Ext.util.Format.number('0,0', mItemsCount);
             //mTotalEstimatedBags = Ext.util.Format.number('0,0', mTotalEstimatedBags);
             //mTotalEstimatedTonnage = Ext.util.Format.number('0,0', mTotalEstimatedTonnage);


             /*var mChaine = Ext.String.format('Livraison(s) : {0} <br/> Total Sacs Estimés : {1} <br/> Total Tonnage estimé : {2} (Kg)', formatNumber(mItemsCount), formatNumber(mTotalEstimatedBags), formatNumber(mTotalEstimatedTonnage));
            App.lblResume.setHtml(mChaine);

            App.rowSelectionListe.deselectAll(true);

            Overview.resetButtons();*/
        }
    }


</script>

@model Tms.Classes.Business.Sites.TransfertFeves
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}

@(Html.X().ResourceManager().AjaxTimeout(36000000)))

<form id="tms_form">

    @(
                        X.Viewport()
                        .Layout(LayoutType.Border)
                        .ID("TmsViewPort")
                        .Items
                        (
                            X.Hidden().ID("BaseUrl").Value(@BaseUrl),
                            X.Hidden().ID("tfhiddenPermPrintTransferSheet").ReadOnly(true),
                            X.Hidden().ID("tfhiddenPermModifier").ReadOnly(true),
                            X.Hidden().ID("tfhiddenPermDesactiver").ReadOnly(true),
                            X.Hidden().ID("tfhiddenPermApprove").ReadOnly(true),
                            X.Hidden().ID("tfhiddenPermDesactiverApresApprouve").ReadOnly(true),
                                X.Panel()
                                .ID("pnlNorth")
                                .Region(Region.North)
                                .Layout(LayoutType.Border)
                                .TopBar(new Toolbar()
                                {
                                    Items =
                                    {
                                    X.Button()
                                    .ID("btnFilter")
                                    .IconCls("action_filter_02")
                                    .Border(false)
                                    .Cls("ButtonStyle")
                                    .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                                    .Disable(false)
                                    .Listeners
                                    (
                                        li =>
                                        {
                                            li.Click.Fn = "Overview.updateSummaryInfo";
                                        }
                                    )
                                    .DirectEvents
                                    (
                                       de =>
                                       {
                                            de.Click.Url  = Url.Action("OnFilter");
                                            de.Click.EventMask.ShowMask = true;
                                        }
                                    ),

                                    X.Button()
                                    .ID("btnRefresh")
                                    .IconCls("action_refresh_01")
                                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                                    .Border(false)
                                    .Cls("ButtonStyle")
                                    .Disable(false)
                                    .Listeners
                                    (
                                        li =>
                                        {
                                            li.Click.Fn = "Overview.updateSummaryInfo";
                                        }
                                    )
                                    .DirectEvents( de =>{

                                        de.Click.Url  = Url.Action("OnRefresh");

                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemCampagne", Encode=false, Value= "#{cmbCampagne}.getValue()", Mode=ParameterMode.Raw});

                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatus", Value= "#{cmbStatus}.getValue()",     Mode=ParameterMode.Raw});

                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStartDate",         Encode=false, Value= "#{dtfDateDebutLivraison}.rawDateText",     Mode=ParameterMode.Raw});

                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemEndDate",         Encode=false, Value= "#{dtfDateFinLivraison}.rawDateText",     Mode=ParameterMode.Raw});

                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemSite",         Encode=false, Value= "#{cmbSite}.getValue()",     Mode=ParameterMode.Raw});

                                        de.Click.Success = "App.CriteriaPanel.setTitle('Site : ' + App.cmbSite.rawValue + ', Campagne :'+ App.cmbCampagne.rawValue + '; Period = '+ App.dtfDateDebutLivraison.rawDateText+' - '+ App.dtfDateFinLivraison.rawDateText + ' ; Statut : ' + App.cmbStatus.rawValue)";

                                        //de.Click.EventMask.ShowMask = true;
                                        de.Click.Before = "Ext.net.Mask.show('Loading...');";
                                    }
                                ),

                                X.Button()
                                .ID("btnNew")
                                .IconCls("glyphicon glyphicon-file blue")
                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                                .Cls("ButtonStyle")
                                .Border(false)
                                .Disable(false)
                                .DirectEvents( de =>{
                                                        de.Click.Url  = Url.Action("OnCreate");
                                                        de.Click.EventMask.ShowMask = true;
                                                    } ),

                             X.Button()
                            .ID("btnModify")
                            .IconCls("action_modify_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                            .Cls("ButtonStyle")
                            .Border(false)
                           .Listeners(l => l.Render.Fn="Overview.resetButtons")
                            .DirectEvents
                            ( de =>{
                                de.Click.Url  = Url.Action("OnEdit");
                                de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListe}.getSelectionModel().getSelection()[0].data"});
                                de.Click.EventMask.ShowMask = true;

                                   }
                            ),
                        X.Button()
                            .ID("btnApprove")
                            .IconCls("glyphicon glyphicon-ok green")
                            .Text("Finaliser")
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Disabled(true)
                            .DirectEvents( de =>{
                                de.Click.Url  = Url.Action("onApprove");
                                de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true,Value="#{grpListe}.getSelectionModel().getSelection()[0].data"});
                                de.Click.EventMask.ShowMask = true;
                                //de.Click.Confirmation.ConfirmRequest = true;
                                //de.Click.Confirmation.BeforeConfirm = "config.confirmation.title = 'Contrat Periode : Approuver'; config.confirmation.message = 'Do you want to Approve this contract ?';";
                                de.Click.Success = "Overview.resetButtons();";
                            }),


             X.SplitButton()
            .ID("btnPrint")
            .IconCls("action_print_02")
            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
            .Disable(false)
            .Cls("ButtonStyle")
            .Border(false)
            .Menu(new Menu()
            {
                Items =
                        {

                           // ,

                             X.MenuItem()
                             .ID("mnuPrintTransferSummary")
                            .Text("Transfer")
                            .Disable(true)
                            .DirectEvents( de=>
                            {
                                de.Click.Url = Url.Action("OnDisplayTransfertList");
                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStartDate",         Encode=false, Value= "#{dtfDateDebutLivraison}.rawDateText",     Mode=ParameterMode.Raw});
                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemEndDate",         Encode=false, Value= "#{dtfDateFinLivraison}.rawDateText",     Mode=ParameterMode.Raw});
                                de.Click.EventMask.ShowMask = true;
                            }),
                             X.MenuItem()
                                .ID("mnuPrintSheet")
                                .Text("Transfer Sheet")
                                .Disabled(true)
                                .DirectEvents
                                (
                                    de=>
                                    {
                                        de.Click.Url = Url.Action("OnPrintTransfert","TransfertFeves");
                                        de.Click.ExtraParams.Add(new Parameter {  Name = "IdTransfert" , Mode= ParameterMode.Raw, Value = "#{grpListe}.getSelectionModel().getSelection()[0].data.ID" });
                                    }
                                )



                         }
               }),

               X.ToolbarFill(),

                X.Button()
                .ID("btnActions")
                .Text("Actions")
                .Border(false)
                .Cls("ButtonStyle")
                .IconCls("menu_04")
                .Disable(false)
                .Menu(new Menu() {
                                        Height = 120,
                                        Items = {

                                               X.MenuItem()
                                                    .ID("mnuExportDeliveries")
                                                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                                    .Icon(Icon.PageExcel)
                                                    .Handler("SetExcelList();"),
                                                X.MenuItem()
                                                    .ID("mnuCancel")
                                                    .IconCls("glyphicon glyphicon-remove red")
                                                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                                                    .Listeners(l => l.Render.Fn="Overview.resetButtons")
                                                    .DirectEvents
                                                    ( de =>
                                                            {
                                                                de.Click.Url = Url.Action("OnActivateDeactivate");
                                                                de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListe}.getSelectionModel().getSelection()[0].data" });
                                                                de.Click.EventMask.ShowMask = true;
                                                                de.Click.Confirmation.ConfirmRequest = true;
                                                                de.Click.Confirmation.Title = "Beans Transfer";
                                                                de.Click.Confirmation.BeforeConfirm = "var isDesactive = #{grpListe}.getSelectionModel().getSelection()[0].data.Desactive ; if(isDesactive == true) { config.confirmation.title = 'Livraison : Enable'; config.confirmation.message = 'Do you want to enable the selected transfer ? '; } else { config.confirmation.title = 'Beans Transfer : Disable'; config.confirmation.message = 'Voulez-vous annuler cette livraison ? '; }";
                                                                de.Click.Success = "Overview.resetButtons();";
                                                             }
                                                     )

                                                }
                                    })
                                   }
                                })

                                    ,
        X.FormPanel()
            .ID("CriteriaPanel")
            //.Title("On essai d'afficher les criteres ici")
            .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Beans Transfer - Overview" })
            .Region(Region.North)
            .Floatable(false)
            .Border(false)
            .Collapsed(true)
            .Collapsible(true)
            //.CollapsedCls("panelcollapse")
            .BodyPadding(5)
            .Frame(true)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Start })
            .Items(
                        X.Panel()
                            .Border(false)
                            .Flex(2)
                            .Layout(LayoutType.Form)
                            .Items
                            (
                                    X.ComboBox()
                                    .ID("cmbSite")
                                    .FieldLabel("Site")
                                    .DisplayField("Nom")
                                    .ValueField("ID")
                                    .MatchFieldWidth(false)
                                    .ListConfig(new BoundList { MinWidth = 300 })
                                    .LabelAlign(LabelAlign.Right)
                                    .TypeAhead(false)
                                    .QueryMode(DataLoadMode.Local)
                                    .TriggerAction(TriggerAction.All)
                                    .ForceSelection(true)
                                    .ReadOnly(true)
                                    .Value((int)ViewBag.SiteParDefaut)
                                    .Store(
                                                X.Store()
                                                .AutoLoad(true)
                                                .Model(
                                                        Html.X().Model()
                                                        .IDProperty("ID")
                                                        .Fields(
                                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                    new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                                                )
                                                    )
                                                .Proxy(
                                                            Html.X().AjaxProxy()
                                                            .Url(Url.Action("LoadSiteByAccess", "Site"))
                                                .Reader(
                                                            Html.X().JsonReader().RootProperty("data")
                                                            )
                                                )
                                        ),
                                    X.ComboBox()
                                        .ID("cmbCampagne")
                                        .FieldLabel("Campagne")
                                        .LabelWidth(110)
                                        .DisplayField("Designation")
                                        .ValueField("Designation")
                                        .LabelAlign(LabelAlign.Right)
                                        .ListConfig(new BoundList { Width = 600, MinWidth = 500 })
                                        .TypeAhead(true)
                                        .QueryMode(DataLoadMode.Local)
                                        .ForceSelection(true)
                                        .Value(ViewBag.DefaultCampagne)
                                        //.SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "{Tous}" }); })
                                        .Store(X.Store()
                                        .AutoLoad(true)
                                        .Model
                                        (
                                                    Html.X().Model()
                                                .IDProperty("Designation")
                                                .Fields
                                                (
                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                )
                                        )
                                        .Proxy
                                        (
                                            Html.X().AjaxProxy()
                                            .Url(Url.Action("LoadCampagneAll", "Campagne"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )
                                    )
                            ),
                        X.Panel()
                            .Border(false)
                            .Flex(2)
                            .Layout(LayoutType.Form)
                            .Items
                            (
                                   X.DateField()
                                        .ID("dtfDateDebutLivraison")
                                        .FieldLabel("Date Debut")
                                        .Width(150)
                                        .LabelAlign(LabelAlign.Right)
                                        .SelectedDate(DateTime.Now.AddDays(-1))
                                        .MarginSpec("0 5 0 0"),

                                    X.DateField()
                                        .ID("dtfDateFinLivraison")
                                        .Width(145)
                                        .LabelAlign(LabelAlign.Right)
                                        .FieldLabel("Date Fin")
                                        .SelectedDate(DateTime.Now),
                                    X.ComboBox()
                                        .ID("cmbStatus")
                                        .FieldLabel("Statut")
                                        .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "-1" }); })
                                        .DisplayField("Nom")
                                        .ValueField("ID")
                                        .LabelAlign(LabelAlign.Right)
                                        .TypeAhead(true)
                                        .ForceSelection(true)
                                        .Items(
                                                new ListItem("{Tous}", "-1"),
                                                new ListItem("Approuvé", "AP"),
                                                new ListItem("Non Approuvé", "NA"),
                                                new ListItem("Annulé", "CA")
                                        )

                            ),

                                X.Panel()
                                    .ID("OvwResume")
                                    .Flex(3)
                                    //.TitleConfig(new PanelTitle { Text = "Summary", Cls = "title_font_color" })
                                    .Border(false)
                                    //.BodyPadding(6)
                                    .Layout(LayoutType.HBox)
                                    .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                                    .Items(X.Container()
                                        .ID("")
                                        .Layout(LayoutType.VBox)
                                        .LayoutConfig(new VBoxLayoutConfig { Pack = BoxPack.Center })
                                        .Items(X.Label()
                                                    .ID("lblResume")
                                                    .Height(50)
                                                    .StyleSpec("text-align:center;")
                                                    .Text("Resume ici")
                                                    .EmptyText("")
                                                    )
                                        )
                            ),

                            X.GridPanel()
                           .Layout(LayoutType.Fit)
                           .ID("grpListe")
                           .Region(Region.Center)
                           .ForceFit(false)
                           .AllowDeselect(false)
                            .Store
                            (
                                X.StoreFor<Tms.Classes.Business.Sites.TransfertFeves>()
                                .ID("storeTransferList")
                                //.RemoteFilter(true)
                                //.RemoteSort(true)
                                .RemotePaging(false)
                                .AutoLoad(true)
                                .PageSize(100)
                                .SorterFor(Model, m => m.DateTransfert, Ext.Net.SortDirection.DESC)
                                .Proxy
                                (
                                    Html.X().AjaxProxy().Timeout(480000)
                                    .Url(Url.Action("Select"))
                                    .Reader(Html.X().JsonReader().RootProperty("data"))
                                )
                            .Listeners
                            (
                                l =>
                                {
                                    l.Add.Handler = "SelectNewRecordAddedOnGrid(records, #{grpListe}.id); Overview.resetButtons(); CallSummary();";
                                    l.Update.Handler = "Overview.resetButtons(); CallSummary();";
                                    l.Remove.Handler = "Overview.resetButtons(); CallSummary();";
                                    l.Load.Handler = "Ext.net.Mask.hide(); CallSummary();";
                                    l.BeforeLoad.Handler = "Ext.net.Mask.show();";
                                }
                            )
                            .Parameters
                            (
                                ps =>
                                {
                                    ps.Add(new StoreParameter { Name = "ItemCampagne", Value = "App.cmbCampagne.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter { Name = "ItemStatus", Value = "App.cmbStatus.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter { Name = "ItemStartDate", Value = "App.dtfDateDebutLivraison.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter { Name = "ItemEndDate", Value = " App.dtfDateFinLivraison.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter { Name = "ItemSite", Value = " App.cmbSite.getValue()", Encode = false, Mode = ParameterMode.Raw });

                                }
                            )
                    )
                    .ColumnModel
                    (
                        Html.X().Column().Text("").DataIndex("mIcon").Width(40).Renderer("renderIcon").Hideable(false).Filterable(false),
                        //Html.X().Column().Text("Date").DataIndex("DateLivraison").Flex(1).Formatter("date(\"m/d/Y g:i A\")"),
                        Html.X().Column().Text("Date").DataIndex("DateTransfertAsString").Flex(1),
                        Html.X().Column().Text("Site").DataIndex("SiteAsString").Flex(1),
                        Html.X().Column().Text("Destination").DataIndex("DestinationAsString").Flex(2),
                        Html.X().Column().Text("Numero").DataIndex("Numero").Flex(1),
                        Html.X().Column().Text("Nb Of bags").DataIndex("NombreSacs").Flex(1),
                        Html.X().Column().Text("Poids Brut (Kg)").DataIndex("PoidsBrutAsString").Flex(1),
                        Html.X().Column().Text("Utilisateur Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                        Html.X().DateColumn().Text("Date Creation ").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                        Html.X().Column().Text("Utilisateur Modification").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                        Html.X().DateColumn().Text("Date Modification").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")
                    )
                    .BottomBar
                    (
                        Html.X().PagingToolbar()
                        .HideRefresh(true)
                        .Plugins
                        (
                            Html.X().ProgressBarPager())
                        )
                        .Plugins
                        (
                            X.FilterHeader()
                        )
                        .SelectionModel
                        (
                            X.RowSelectionModel()
                            .ID("rowSelectionListe")
                            .Mode(SelectionMode.Single)
                            .AllowDeselect(true)
                        )
                        .Listeners
                        (
                            l =>
                            {
                                l.Select.Fn = "Overview.resetButtons"; l.Deselect.Fn = "Overview.resetButtons";
                            }
                         )
                         .View(
                            Html.X().GridView().LoadingText("Chargement...")
                    )
                        .DirectEvents
                        (
                            de =>
                            {
                                de.RowDblClick.Url = Url.Action("OnConsult");
                                de.RowDblClick.CleanRequest = true;
                                de.RowDblClick.Success = "App.frmLivraison.setTitle('Beans Transfer : Detail')";
                                de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowSelectionListe}.getSelected().items[0].data" });
                                de.RowDblClick.EventMask.ShowMask = true;
                            }
                         )

                    )
    )

</form>
<script type="text/javascript">
    var GenerateTicket = function (id, BaseUrl) {
        Ext.net.DirectMethod.request({ url: BaseUrl + "/TransfertFeves/OnPrintTransfert?IdTransfert=" + id + "&IsCopy=0" });
    };
</script>