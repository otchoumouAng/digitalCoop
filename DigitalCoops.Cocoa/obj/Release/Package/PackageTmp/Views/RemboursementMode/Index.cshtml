<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeRemboursementMode.columnManager.getColumns(), App.grpListeRemboursementMode.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var GetNbrStoreRows = function () {
        var nbr = App.grpListeRemboursementMode.getRowsValues().length;
        App.LblResumeRemboursementMode.setText(nbr + ' Mode(s)');        
    };

    var SetCriteriaTitle = function (status) {

        App.RemboursementModeCriteriaPanel.title = "";
        var texttitle = "";

        if (status) texttitle += "Show only active Mode : YES ";
        else texttitle += "Show only active Mode : NO ";

        App.RemboursementModeCriteriaPanel.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            if (App.rowSelectionRemboursementMode.hasSelection()) {
                if (App.RfmhiddenPermModifier.value == 'true')
                    App.btnModifyRemboursementMode.enable();

                if (App.RfmhiddenPermDesactiver.value == 'true')
                    App.mnuCancelRemboursementMode.enable();

                var isDisabled = App.rowSelectionRemboursementMode.selected.items[0].data.Desactive;

                if (isDisabled === true) {
                    if (App.RfmhiddenPermActiver.value == 'true')
                        App.mnuCancelRemboursementMode.enable();

                    App.mnuCancelRemboursementMode.setText('Activer');
                    App.btnModifyRemboursementMode.disable();
                    App.mnuCancelRemboursementMode.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.RfmhiddenPermModifier.value == 'true')
                        App.btnModifyRemboursementMode.enable();

                    App.mnuCancelRemboursementMode.setText('Annuler');
                    App.mnuCancelRemboursementMode.setIconCls('glyphicon glyphicon-remove red');
                }

            } else {

                App.btnModifyRemboursementMode.disable();                
                App.mnuCancelRemboursementMode.disable();

            }
        }
    }


</script>


@model Tms.Classes.Shared.RemboursementMode
@{
