<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Erreur : Weighing ', msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

    };


    var enterKeyPressHandler = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            var param = App.txtOrdreProduction.value;
            var baseurl = App.baseUrlVal.value;
            Ext.net.DirectMethod.request({ url: baseurl + "/PeseeDiverse/SubmitOrdreProduction?ItemNumero=" + param });
            /*App.BtnSearchDeliveryInfo.fireEvent('click', App.BtnSearchDeliveryInfo);*/
            e.stopEvent();

        }
    };

    var GetNbrOfPallets = function () {
        var nbrOfrows = App.grpListePoidsDivers.getStore().getCount();
        App.txtNombrePalette.setValue(nbrOfrows);

        /* set Fields to ReadOnly*/
        if (nbrOfrows > 0) {
            /*App.txtTarePalettes.setReadOnly(true);            */
            App.bntReadTarePallet.disable();
            App.PanelBtnSave.hide();
        } else {
            /*App.txtTarePalettes.setReadOnly(false);*/            
            App.bntReadTarePallet.enable();
            App.PanelBtnSave.show();
        }
    };
</script>








