<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    @*<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap-theme.min.css" integrity="sha384-rHyoN1iRsVXV4nD0JutlnGaslCJuC7uwjduW9SVrLvRYooPp2bWYgmgJQIXwl/Sp" crossorigin="anonymous">*@

</head>
<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 100px !important;
    }
</style>
<script src="~/Scripts/FunctionHelpers.js"></script>
<script src="~/Scripts/FormatAmount.js"></script>
<script src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeLotType.columnManager.getColumns(), App.grpListeLotType.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {

        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },

        SummaryLT: function () {
            var nbrOfrows = App.grpListeLotType.getStore().getCount();            
            App.lblSummaryLT.setHtml("Nbr Of Type(s) : " + nbrOfrows);
        },

        resetButtons: function () {

            App.btnModify.disable();
            App.btnCancel.disable();

            if (App.rowLotType.hasSelection()) {

                var isDesactive = App.rowLotType.selected.items[0].data.Desactive;

                if (isDesactive === false) {
                    if (App.LthiddenPermModifier.value == 'true')
                        App.btnModify.enable();

                    if (App.LthiddenPermDesactiver.value == 'true')
                        App.btnCancel.enable();
                }
                else {
                    App.btnModify.disable();
                    if (App.LthiddenPermActiver.value == 'true')
                        App.btnCancel.enable();

                    App.btnCancel.setText('Activer');
                    App.btnCancel.setIconCls('glyphicon glyphicon-ok green');
                }                

            }
        }
    }

</script>

@*@model Tms.Classes.Business.BonDeLivraison*@
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);    
}

@(Html.X().ResourceManager().AjaxTimeout(3600000))

<form id="tms_form">
    @(X.Viewport()
    .Layout(LayoutType.Border)
    .ID("TmsViewPort")
    .Items
        (
            X.Hidden().ID("BaseUrl").Value(@BaseUrl),
            X.Hidden().ID("LthiddenPermDesactiver").ReadOnly(true),
            X.Hidden().ID("LthiddenPermModifier").ReadOnly(true),
            X.Hidden().ID("LthiddenPermActiver").ReadOnly(true),
    #region Boutons Action
            X.Panel()
                .ID("pnlNorth")
                .Region(Region.North)
                .Layout(LayoutType.Border)
                .TopBar(new Toolbar()
                {
                    Items =
                        {
                            X.Button()
                                .ID("btnFilter")
                                .IconCls("action_filter_02")
                                .Border(false)
                                .Cls("ButtonStyle")
                                .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                                .Disable(false)
                                .DirectEvents
                                    (
                                    de =>
                                    {
                                        de.Click.Url  = Url.Action("OnFilter");
                                        de.Click.EventMask.ShowMask = true;
                                    }
                                    ),
                            X.Button()
                                .ID("btnRefresh")
                                .IconCls("action_refresh_01")
                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                                .Border(false)
                                .Cls("ButtonStyle")
                                .Disable(false)
                                .DirectEvents
                                    (
                                    de =>
                                    {
                                        de.Click.Url  = Url.Action("OnRefresh");
                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatut", Value= "#{CmbFiltreStatut}.getValue()",     Mode=ParameterMode.Raw});
                                        de.Click.Success = "App.LotTypeCP.setTitle('Statut : ' + App.CmbFiltreStatut.rawValue )";
                                        de.Click.EventMask.ShowMask = true;
                                    }
                                    ),
                            X.Button()
                                .ID("btnNew")
                                .IconCls("action_new_02")
                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                                .Cls("ButtonStyle")
                                .Border(false)
                                .Disabled(false)
                                .DirectEvents
                                (
                                    de =>
                                        {
                                            de.Click.Url  = Url.Action("OnAdd");
                                            de.Click.Success = "App.FormLotType.setTitle('Type Of Lot - Nouveau')";
                                            de.Click.EventMask.ShowMask = true;
                                        }
                                ),
                            X.Button()
                                .ID("btnModify")
                                .IconCls("action_modify_02")
                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                                .Cls("ButtonStyle")
                                .Border(false)
                                .Disabled(true)
                                .DirectEvents
                                    (
                                    de =>
                                        {
                                            de.Click.Url  = Url.Action("OnEdit");
                                            de.Click.Success = "App.FormLotType.setTitle('Type Of Lot - Modifier')";
                                            de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeLotType}.getSelectionModel().getSelection()[0].data"});
                                            de.Click.EventMask.ShowMask = true;
                                        }
                                    ),
                           
                                X.ToolbarFill(),
                            X.Button()
                                .ID("btnActions")
                                .Text("Actions")
                                .Border(false)
                                .Cls("ButtonStyle")
                                .IconCls("menu_04")
                                .Disabled(false)
                                .Menu
                                    (
                                        new Menu()
                                        {
                                            Height = 120,
                                            Items =
                                            {
                                                X.MenuItem()
                                                    .ID("mnuExportLotType")
                                                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                                    .Icon(Icon.PageExcel)
                                                    .Handler("SetExcelList();"),

                                                X.MenuItem()
                                                    .ID("btnCancel")
                                                    .Icon(Icon.Cross)
                                                    .Text("Desactiver")
                                                    .Cls("ButtonStyle")
                                                    .Border(false)
                                                    .Disabled(true)
                                                    .DirectEvents
                                                    (
                                                        de =>
                                                        {
                                                        de.Click.Url = Url.Action("OnActivateDeactivate");
                                                        de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeLotType}.getSelectionModel().getSelection()[0].data" });
                                                        de.Click.EventMask.ShowMask = true;
                                                        de.Click.Confirmation.ConfirmRequest = true;
                                                        de.Click.Confirmation.Title = "Type Of Lot";
                                                        de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListeLotType}.getSelectionModel().getSelection()[0].data.Desactive)";
                                                        de.Click.Success = "Overview.resetButtons();";
                                                        }
                                                    )
                                            }
                                        }
                                    )
                            }
                }
                    ),

    #endregion
    #region Filtres
            X.FormPanel()
                .ID("LotTypeCP")
                .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Type Of Lot - overview" })
                .Region(Region.North)
                .Floatable(false)
                .Border(false)
                .Collapsed(true)
                .Collapsible(true)
                .BodyPadding(5)
                .Frame(true)
                .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Start })
                .Items
                (
    #region Zone A
                    X.Container()
                        .Border(false)
                        .Frame(false)
                        .Flex(1)
                        .Layout(LayoutType.Form)
                        .Items
                        (
                             X.ComboBox()
                                    .ID("CmbFiltreStatut")
                                    .ForceSelection(true)
                                    .FieldLabel("Statut")
                                    .TypeAhead(true)
                                    .ForceSelection(true)
                                    .LabelAlign(LabelAlign.Right)
                                    .Items(
                                            new ListItem("{Tous}", "-1"),
                                            new ListItem("Active", "0"),
                                            new ListItem("Inactive", "1")
                                    )
                                    .SelectedItems(se => { se.Add(new ListItem { Text = "Active", Value = "0" }); })
                         ),

    #endregion
    #region B
                    X.Container()
                        .Flex(4)
                        .Border(false)
                        .Layout(LayoutType.HBox)
                        .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                        .Items
                        (
                            X.Container()
                                .Layout(LayoutType.VBox)
                                        .Flex(1)
                                        .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Center, Pack = BoxPack.Start })
                                .Items(
                                        X.Label().ID("lblSummaryLT").Text("Resume").EmptyText("")
                                )
                        )
    #endregion
                ),
    #endregion
    #region GridPanel
                    X.GridPanel()
                       .Layout(LayoutType.Fit)
                       .ID("grpListeLotType")
                       .Region(Region.Center)
                       .ForceFit(false)
                       .AllowDeselect(false)
                       .Store
                       (
                          X.StoreFor<Tms.Classes.Shared.stock.LotType>()
                           .ID("storeListeLotType")
                           .PageSize(100)
                           .RemotePaging(false)
                           .AutoLoad(true)
                           .Proxy
                            (
                                 Html.X().AjaxProxy().Timeout(480000)
                                .Url(Url.Action("Select"))
                                .Reader(Html.X().JsonReader().RootProperty("data"))
                            )
                            .Parameters
                              (
                                ps =>
                                {
                                    ps.Add(new StoreParameter("ItemStatut", "#{CmbFiltreStatut}.getValue()", ParameterMode.Raw));
                                }
                            )
                            .Listeners
                            (
                             ls =>
                             {
                                 ls.BeforeLoad.Handler = "Ext.net.Mask.show();";
                                 ls.Load.Handler = "Overview.SummaryLT(); Ext.net.Mask.hide();";
                                 ls.Add.Handler = "SelectNewRecordAddedOnGrid(records, #{grpListeLotType}.id); Overview.SummaryLT();";
                             }
                          )
                       )
                       .ColumnModel
                       (
                            Html.X().Column().Text("").DataIndex("mIcon").Width(40).Hideable(false).Renderer("renderIcon"),
                            Html.X().Column().Text("Designation").DataIndex("Designation").Flex(1),
                            Html.X().Column().Text("Nbr de sacs").DataIndex("NombreSacs").Flex(1),
                            Html.X().Column().Text("Nbr Of Pallets").DataIndex("NombrePalette").Flex(1),
                            Html.X().Column().Text("Bags Per Pallets").DataIndex("NombreSacsParPalettes").Flex(1),
                            Html.X().Column().Text("Std. Weight").DataIndex("PoidsStandard").Flex(1),
                            Html.X().Column().Text("Min Weight").DataIndex("PoidsMin").Flex(1),
                            Html.X().Column().Text("Max Weight").DataIndex("PoidsMax").Flex(1),
                            Html.X().Column().Text("Tare Per Bag").DataIndex("TareSacsUnitaire").Flex(1).Hidden(true),
                            Html.X().Column().Text("Prefix").DataIndex("Prefixe").Flex(1),
                            Html.X().Column().Text("Utilisateur Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                            Html.X().DateColumn().Text("Date Creation ").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                            Html.X().Column().Text("Utilisateur Modification").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                            Html.X().DateColumn().Text("Date Modification").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")
                         )
                         .BottomBar
                         (
                             Html.X().PagingToolbar()
                            .HideRefresh(true)
                            .Plugins(Html.X().ProgressBarPager())
                         )
                         .Plugins
                         (
                           X.FilterHeader()
                         )
                        .SelectionModel
                        (
                          X.RowSelectionModel()
                           .ID("rowLotType")
                           .Mode(SelectionMode.Single)
                           .AllowDeselect(false)
                        )
                        .View(
                            Html.X().GridView().LoadingText("Chargement...")
                    )
                       .Listeners(l => { l.Select.Fn = "Overview.resetButtons"; l.Deselect.Fn = "Overview.resetButtons"; })
                       .DirectEvents(de =>
                       {
                           de.RowDblClick.Url = Url.Action("OnConsult");
                           de.RowDblClick.CleanRequest = true;
                           de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowLotType}.getSelected().items[0].data" });
                           de.RowDblClick.EventMask.ShowMask = true;
                           de.RowDblClick.Success = "App.FormLotType.setTitle('Type Of Lot : Detail')";
                       }
                       )
    #endregion
        )
    )

</form>

<script type="text/javascript">

</script>