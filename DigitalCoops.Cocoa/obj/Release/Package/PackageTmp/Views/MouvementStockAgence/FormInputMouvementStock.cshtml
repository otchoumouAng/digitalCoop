<script type="text/javascript">


    var numInput;
    window.onload = function () {
        numInput = document.ge('input.number');
        numInput.onkeypress = numInput.onkeydown = numInput.onblur = numInput.onkeyup = function () {
            numInput.value = numInput.value.replace(/[^0-9]+/, "");
        }
    }
</script>







