<script type="text/javascript">    
    var exportExcel = function () {
        debugger;
        Ext.net.DirectMethod.request({
            url: "/Report/ExportToExcel",
            cleanRequest: true,
            isUpload: true,
            params: {
                data: App.grpListeDailyPrice.getRowsValues()
            }
        });
    };

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeDailyPrice.columnManager.getColumns(), App.grpListeDailyPrice.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderNumber = function (value) {
        if (!Ext.isEmpty(value)) {
            var num = value;            
            var numj = num.replace(/\B(?=(\d{3})+(?!\d))/g, " ");            
            return numj;
        }            
    };

    var GetNbrStoreRows = function () {
        var nbr = App.grpListeDailyPrice.getRowsValues().length;
        App.LblResumeDailyPriceAgence.setText(nbr + ' Prix Journalier(s)');
    };

    var SetCriteriaTitle = function (cropyear, site, begin, end, status) {        
        App.DailyPriceAgenceCriteriaPanel.title = "";
        var texttitle = "";        

        if (site) texttitle += " Site : " + site + " | ";

        if (cropyear) texttitle += "Campagne : " + cropyear + " | ";

        if (begin) texttitle += " Du : " + begin;

        if (end) texttitle += " Au : " + end;

        if (status) texttitle += " | Show only active price : YES ";
        else texttitle += " | Show only active price : NO ";

        App.DailyPriceAgenceCriteriaPanel.setTitle(texttitle);
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }            
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }            
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {                          

           /* if (App.rowSelectionDailyPriceAgence.hasSelection()) {

                /*if (App.DPAhiddenPermModifier.value == 'true')
                    App.btnModifyDailyPriceAgence.enable();
                
                if (App.DPAhiddenPermExporterExcel.value == 'true')
                    App.mnuExportDailyPriceAgence.enable();

                if (App.DPAhiddenPermDesactiver.value == 'true')
                    App.mnuCancelDailyPriceAgence.enable();

                var isDisabled = App.rowSelectionDailyPriceAgence.selected.items[0].data.Desactive;
                

                if (isDisabled === true) {                    
                    App.mnuCancelDailyPriceAgence.setText('Activer');
                    App.btnModifyDailyPriceAgence.disable();
                    App.btnExtendDailyPriceAgence.disable();
                    App.mnuCancelDailyPriceAgence.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    App.mnuCancelDailyPriceAgence.setText('Annuler');

                    if (App.DPAhiddenPermModifier.value == 'true')
                        App.btnModifyDailyPriceAgence.enable();

                    if (App.DPAhiddenPermExtend.value == 'true')
                        App.btnExtendDailyPriceAgence.enable();

                    App.mnuCancelDailyPriceAgence.setIconCls('glyphicon glyphicon-remove red');
                }                
            } else {                
                App.btnModifyDailyPriceAgence.disable();
                App.btnExtendDailyPriceAgence.disable();                 
                App.mnuCancelDailyPriceAgence.disable();
                App.mnuExportDailyPriceAgence.disable();
            }*/
        }
    }


</script>


