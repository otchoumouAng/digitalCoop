<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeStatutStockItem.columnManager.getColumns(), App.grpListeStatutStockItem.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }

    var Overview =
    {
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-file blue';
            }
            else if (value === 1) {
                return 'glyphicon-file blue';
            }
            else if (value == -1) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-file blue';
            }
        },

        SummaryStatutItem: function () {
            var nbrOfrows = App.grpListeStatutStockItem.getStore().getCount();
            var totalNetAccepte = App.storeListeStatutStockItem.sum('PoidsNetAccepte') || 0;
            var totalNetLivre = App.storeListeStatutStockItem.sum('PoidsNetLivre') || 0;
            var totalQuantite = App.storeListeStatutStockItem.sum('Quantite') || 0;
            var totalPoidsBrut = App.storeListeStatutStockItem.sum('PoidsBrut') || 0;
            var totalTarePalette = App.storeListeStatutStockItem.sum('TarePalettes') || 0;
            var totalTareSacs = App.storeListeStatutStockItem.sum('TareSacs') || 0;
            var totalRetention = App.storeListeStatutStockItem.sum('Retention') || 0;

            var mTotalEntree = App.storeListeStatutStockItem.sum('TotalEntree') || 0;
            var mTotalSortie = App.storeListeStatutStockItem.sum('TotalSortie') || 0;
            var stock = mTotalEntree + mTotalSortie;

            totalNetAccepte = FormatAmount(totalNetAccepte);
            totalNetLivre = FormatAmount(totalNetLivre);
            totalQuantite = FormatAmount(totalQuantite);
            totalPoidsBrut = FormatAmount(totalPoidsBrut);
            totalTarePalette = FormatAmount(totalTarePalette);
            totalTareSacs = FormatAmount(totalTareSacs);
            totalRetention = FormatAmount(totalRetention);
            /*App.rsNbrOfMovement.setValue(nbrOfrows);*/
            /*App.rsQuantite.setValue(totalQuantite);
            App.rsGrossWeight.setValue(totalPoidsBrut);
            App.rsDelNetWeight.setValue(totalNetLivre);
            App.rsAccNetWeight.setValue(totalNetAccepte);
            App.rsTarePalette.setValue(totalTarePalette);
            App.rsTareSacs.setValue(totalTareSacs);
            App.rsRefaction.setValue(totalRetention);*/

            var mChaine = Ext.String.format('Entrée(s) : {0} (Kg)<br/> Sortie : {1} (Kg)<br/> Stock : {2} (Kg)', FormatAmount(mTotalEntree), FormatAmount(mTotalSortie), FormatAmount(stock));
            /*App.lblRecap.setHtml(mChaine);*/
            /*var mChaine = Ext.String.format('Item(s) : {0} <br/> Total Quantity : {1} <br/> Total Poids Brut : {2} <br/>Total Livré Poids Net : {3}<br/>Total Accepted Poids Net : {4}', nbrOfrows, totalQuantite, totalPoidsBrut, totalNetLivre, totalNetAccepte);
            App.lblSummaryStatutItem.setHtml(mChaine);*/
            /*App.lblSummaryStatutItem.setValue("Nbr Of Movement : " + nbrOfrows + "<br/>Total Quantity : " + totalQuantite + "<br/>Total Poids Brut : " + totalPoidsBrut + "<br/>Total Livré Poids Net : " + totalNetLivre + "<br/>Total Accepted Poids Net : " + totalNetAccepte);*/
        },

        SetCriteriaText: function () {
            App.StatutStockItemCP.setTitle('Site : ' + App.cmbFiltreSite.rawValue + ', Magasin : ' + App.cmbFiltreMagasin.rawValue + ', Campagne : ' + App.cmbFiltreCampagne.rawValue + ', To ' + App.txtFiltreDateFin.rawValue + ', Location : ' + App.cmbFiltreEmplacement.rawValue);
        }
    }

</script>

