        var mTotalEstimatedBags = App.storeDeliveriesList.sum('SacsDeclares') || 0;
        var mTotalEstimatedTonnage = App.storeDeliveriesList.sum('PoidsDeclare') || 0;

        //mItemsCount = Ext.util.Format.number('0,0', mItemsCount);
        //mTotalEstimatedBags = Ext.util.Format.number('0,0', mTotalEstimatedBags);
        //mTotalEstimatedTonnage = Ext.util.Format.number('0,0', mTotalEstimatedTonnage);


        var mChaine = Ext.String.format('Livraison(s) : {0} <br/> Total Sacs Estimés : {1} <br/> Total Tonnage estimé : {2} (Kg)', formatNumber(mItemsCount), formatNumber(mTotalEstimatedBags), formatNumber(mTotalEstimatedTonnage));
       App.lblResume.setHtml(mChaine);

       /*App.rowSelectionListe.deselectAll(true);*/

       Overview.resetButtons();
    };
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListe.columnManager.getColumns(), App.grpListe.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var Overview =
    {

        resetButtons: function () {

            App.btnModify.disable();

            App.mnuCancel.disable();

            App.mnuChangeSupplier.disable();

            if (App.rowSelectionListe.hasSelection())
            {


                var isDisabled = App.rowSelectionListe.selected.items[0].data.Desactive;

                if (!isDisabled) {
                    if (App.LvhiddenPermModifier.value == 'true')
                        App.btnModify.enable();

                    if (App.LvhiddenPermUpdateSupplier.value == 'true')
                        App.mnuChangeSupplier.enable();

                }



                if (isDisabled === true) {
                    App.mnuCancel.setIconCls("glyphicon glyphicon-ok green");
                    App.mnuCancel.setText('Activer');
                }

                else {
                    App.mnuCancel.setIconCls("glyphicon glyphicon-remove red");
                    App.mnuCancel.setText('Desactiver');
                }

                if (App.LvhiddenPermDesactiver.value == 'true')
                    App.mnuCancel.enable();


            }


        }

         , updateSummaryInfo: function ()
         {
             /*var mItemsCount = App.grpListe.getRowsValues().length || 0;
             var mItemsCount = App.grpListe.getStore().totalCount || 0;
             var total = parseFloat(0);*/

             /*var mTotalEstimatedBags = App.storeDeliveriesList.sum('SacsDeclares') || 0;
             var mTotalEstimatedBags = total;
             var mTotalEstimatedTonnage = App.storeDeliveriesList.sum('PoidsDeclare') || 0;*/

             //mItemsCount = Ext.util.Format.number('0,0', mItemsCount);
             //mTotalEstimatedBags = Ext.util.Format.number('0,0', mTotalEstimatedBags);
             //mTotalEstimatedTonnage = Ext.util.Format.number('0,0', mTotalEstimatedTonnage);


             /*var mChaine = Ext.String.format('Livraison(s) : {0} <br/> Total Sacs Estimés : {1} <br/> Total Tonnage estimé : {2} (Kg)', formatNumber(mItemsCount), formatNumber(mTotalEstimatedBags), formatNumber(mTotalEstimatedTonnage));
            App.lblResume.setHtml(mChaine);

            App.rowSelectionListe.deselectAll(true);

            Overview.resetButtons();*/
        }
    }


</script>

