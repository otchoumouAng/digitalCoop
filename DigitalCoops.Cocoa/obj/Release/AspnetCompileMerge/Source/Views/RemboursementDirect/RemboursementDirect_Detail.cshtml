</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">
    var UpdateAmountFIN = function () {

        App.grpDetailFinancing.store.each(function (records) {                       
            records.set('Montant', records.data.MontantAsString);
        });
        
        var totalAmount = parseFloat(App.storeListFinancing.sum('Montant')) || 0;
        console.log(totalAmount);
        totalAmount = FormatAmount(totalAmount);
        App.txtAmount.setValue(totalAmount);
    };

    var UpdateAmountMEC = function () {
        App.grpDetailMec.store.each(function (records) {
            records.set('Montant', records.data.MontantAsString);
        });
        var totalAmount = parseFloat(App.storeListMec.sum('Montant')) || 0;

        totalAmount = FormatAmount(totalAmount);
        App.txtAmount.setValue(totalAmount);
    };
</script>

