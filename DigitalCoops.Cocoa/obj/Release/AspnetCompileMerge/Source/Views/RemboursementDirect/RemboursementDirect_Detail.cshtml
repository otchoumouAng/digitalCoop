@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var Bank = 1;
    var Cash = 2;
    var Saving_Compensation = 3;
    
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Direct Repayment : Data Validation', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        
        var nbrOfrowsFinancing = App.grpDetailFinancing.getStore().getCount();

        if (nbrOfrowsFinancing < 1) {
            Ext.Msg.show({ title: 'Direct Repayment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'At least one financing must be repaid ! ', buttons: Ext.Msg.OK });
            return false;
        }

        /* Check if financing balance can be covered by amount */
        var Amount = unformatNumber(App.txtAmount.value) || '0';
        var totalFinancingClearance = parseFloat(0);

        for (var i = 0; i < nbrOfrowsFinancing; i++) {
            totalFinancingClearance += parseFloat(App.grpDetailFinancing.getRowsValues()[i].SoldeEnCours);
        }

        if (Ext.isNumeric(Amount) && Ext.isNumeric(totalFinancingClearance) && (Amount > totalFinancingClearance)) {
            Ext.Msg.show({ title: 'Direct Repayment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'The balance of financings can not be covered by amount repaid ! ', buttons: Ext.Msg.OK });
            return false;
        }

        /* Check if mec balance can be covered by amount */
        var nbrOfrowsMec = App.grpDetailMec.getStore().getCount();
        var totalMecClearance = parseFloat(0);

        if (nbrOfrowsMec > 0)
        {
            for (var i = 0; i < nbrOfrowsMec; i++) {
                totalMecClearance += parseFloat(App.grpDetailMec.getRowsValues()[i].SoldeEnCours);
            }

            if (Ext.isNumeric(Amount) && Ext.isNumeric(totalMecClearance) && (Amount > totalMecClearance)) {
                Ext.Msg.show({ title: 'Direct Repayment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'The balance of savings can not be covered by amount repaid ! ', buttons: Ext.Msg.OK });
                return false;
            }
        }

        
    };    


    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

    var TypeIndexChanged = function (item) {
        if (item == 1) {
            App.cmbBanque.setReadOnly(false);
            App.cmbBanque.allowBlank = (false);
            App.cmbBanque.setIndicator("*");

            App.txtReference.setReadOnly(false);
            App.txtReference.allowBlank = (false);
            App.txtReference.setIndicator("*");

        }

        if (item == 2) {
            App.cmbBanque.setReadOnly(true);
            App.cmbBanque.allowBlank = (true);
            App.cmbBanque.validate();
            App.cmbBanque.setIndicator("");
            App.cmbBanque.setValue("");

            App.txtReference.setReadOnly(false);
            App.txtReference.allowBlank = (false);
            App.txtReference.setIndicator("*");

        }

        if (item == 3) {
            App.cmbBanque.setReadOnly(true);
            App.cmbBanque.allowBlank = (true);
            App.cmbBanque.validate();
            App.cmbBanque.setIndicator("");
            App.cmbBanque.setValue("");

            App.txtReference.setReadOnly(true);
            App.txtReference.allowBlank = (true);
            App.txtReference.validate();
            App.txtReference.setIndicator("");
            App.txtReference.setValue("");
        }
    };
    

</script>
