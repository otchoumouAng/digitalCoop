<script type="text/javascript" language="javascript">
    var LoadStore = function () {
        if (App.cmbFournisseur.getStore().isLoaded() == false) {
            App.cmbFournisseur.getStore().load();
        }
    };

    var CalculateSummary = function () {
        var nbrOfrows = App.grpListeEngagement.getRowsValues().length;
        var totalBalance = parseFloat(App.storeListeEngagement.sum('Balance')) || 0;
        var totalTonnage = parseFloat(App.storeListeEngagement.sum('TonnageKgToTone')) || 0;
        var totalTonnagekg = parseFloat(App.storeListeEngagement.sum('Tonnage')) || 0;
        var totalCoverage = parseFloat(App.storeListeEngagement.sum('Coverage')) || 0;

        /*for (var i = 0; i < nbrOfrows; i++) {
            totalBalance += parseFloat(App.grpListeEngagement.getRowsValues()[i].Balance);
            totalTonnage += parseFloat(App.grpListeEngagement.getRowsValues()[i].TonnageKgToTone);
            totalTonnagekg += parseFloat(App.grpListeEngagement.getRowsValues()[i].Tonnage);
            totalCoverage += parseFloat(App.grpListeEngagement.getRowsValues()[i].Coverage);
        }*/
        totalCoverage = RoundInt( 100 - ((totalBalance / totalTonnagekg) * 100)) || 0;
        totalBalance = FormatAmount(totalBalance);
        totalTonnagekg = FormatAmount(totalTonnagekg);

        App.LblForwardContractSummary.setText("Poids Total : " + totalTonnagekg + " (Kg) |  Total Balance : " + totalBalance + " (Kg) | Total Coverage : " + totalCoverage + " %");
    };

    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };
</script>