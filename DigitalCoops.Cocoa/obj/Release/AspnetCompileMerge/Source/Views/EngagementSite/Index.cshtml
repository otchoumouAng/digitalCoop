<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeEngagement.columnManager.getColumns(), App.grpListeEngagement.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var SetCriteriaTitle = function (cropyear, fournisseur, site, begin, end, status, opt) {

        App.CriteriaPanelEngagement.title = "";
        var texttitle = "";
        if (cropyear) texttitle += "Campagne : " + cropyear + " | ";

        if (fournisseur) texttitle += "Fournisseur : " + fournisseur + " | ";

        if (site) texttitle += "Site : " + site + " | ";

        if (begin) texttitle += "Du : " + begin;

        if (end) texttitle += " Au : " + end + " |";

        if (status) texttitle += " Statut : " + status + " | ";

        if (opt) texttitle += "Option : " + opt;

        App.CriteriaPanelEngagement.setTitle(texttitle);
    }

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    };

    var iconRenderer = function (value, metaData, record) {
        metaData.css = Overview.getIcons(value);
    };

    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
            else if (value == 3) {
                return 'glyphicon-folder-close green'; // glyphicon glyphicon-file blue
            }
            else if (value == 5) {
                return 'glyphicon-saved blue'; // glyphicon glyphicon-file blue
            }
            else if (value == 6) {
                return 'glyphicon-saved green'; // glyphicon glyphicon-file blue
            }
            else if (value == 7) {
                return 'glyphicon-file green'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {
            App.btnExtendEngagement.disable();
            App.btnModifyEngagement.disable();
            App.btnApproveEngagement.disable();
            App.mnuCancelEngagement.disable();
            /*App.btnRegenerateContract.disable();*/
            App.mnuPrintDetailExecution.enable();

            if (App.rowSelectionEngagement.hasSelection()) {
                
                if (App.EghiddenPermModifier.value == 'true')
                    App.btnModifyEngagement.enable();

                if (App.EghiddenPermApprove.value == 'true')
                    App.btnApproveEngagement.enable();

                if (App.EghiddenPermDesactiver.value == 'true')
                    App.mnuCancelEngagement.enable();

                var isDisabled = App.rowSelectionEngagement.selected.items[0].data.Desactive;
                var isApprouve = App.rowSelectionEngagement.selected.items[0].data.Statut;

                if (isDisabled === true) {
                    App.mnuCancelEngagement.setText('Activer');
                    App.btnExtendEngagement.disable();
                    App.btnModifyEngagement.disable();
                    App.btnApproveEngagement.disable();
                    App.btnCloseEngagement.disable();
                    /*App.btnRegenerateContract.disable();*/
                    App.mnuCancelEngagement.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    App.mnuCancelEngagement.setText('Annuler');
                    if (App.EghiddenPermModifier.value == 'true')
                        App.btnModifyEngagement.enable();

                    if (App.EghiddenPermExtend.value == 'true')
                        App.btnExtendEngagement.enable();

                    if (App.EghiddenPermApprove.value == 'true')
                        App.btnApproveEngagement.enable();

                    App.mnuCancelEngagement.setIconCls('glyphicon glyphicon-remove red');
                }

                if (isApprouve == "RG" && isDisabled === false) {
                    App.btnExtendEngagement.disable();
                    App.btnModifyEngagement.disable();

                    if (App.EghiddenPermApprove.value == 'true')
                        App.btnApproveEngagement.enable();

                    if (App.EghiddenPermDesactiver.value == 'true')
                        App.mnuCancelEngagement.enable();

                    return;
                }

                if (isApprouve == "AP" && isDisabled === false) {
                    App.btnApproveEngagement.disable();
                    App.btnModifyEngagement.disable();
                    /*App.btnRegenerateContract.disable();*/
                    App.mnuPrintDetailExecution.disable();

                    if (App.EghiddenPermClose.value == 'true')
                        App.btnCloseEngagement.enable();

                    return;
                    /*if (App.EghiddenPermRegenerate.value == 'true')
                        App.btnRegenerateContract.enable();

                    if (App.EghiddenPermPrintDetailExecution.value == 'true')
                        App.mnuPrintDetailExecution.enable();*/
                }

                if (isApprouve == "AP" && isDisabled === true) {
                    App.mnuCancelEngagement.setText('Activer');
                    App.btnModifyEngagement.disable();
                    App.mnuCancelEngagement.setIconCls('glyphicon glyphicon-ok green');
                    App.btnCloseEngagement.disable();
                    /*App.btnRegenerateContract.disable();*/
                    App.mnuPrintDetailExecution.disable();

                    return;
                }

            } else {

                App.btnExtendEngagement.disable();
                App.btnModifyEngagement.disable();
                App.btnApproveEngagement.disable();
                App.mnuCancelEngagement.disable();
                /*App.btnRegenerateContract.disable();*/
                App.mnuPrintDetailExecution.enable();
            }
        }
    }


</script>


