@using Tms.Classes
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Login</title>
    @*<link rel="stylesheet" href="~/Content/bootstrap.min.css" />*@
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
    @*<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap-theme.min.css" integrity="sha384-rHyoN1iRsVXV4nD0JutlnGaslCJuC7uwjduW9SVrLvRYooPp2bWYgmgJQIXwl/Sp" crossorigin="anonymous">*@
    <link rel="stylesheet" href="~/Content/preloader.css" />

    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
      <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
      <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->

    <style type="text/css">
        body{
            font-family: Segoe UI, serif, Garamond;
        }
        #tms_header, #tms_footer {
            /*background-color: #607D8B;*/
            background-color: #2ECC71;
        }



            #tms_footer p {
                color: white;
                font-weight: bold;
                font-family: Segoe UI, serif, Garamond;
                padding-top: 2px;              
                
            }

            #tms_header p {
                color: white;
                font-weight: bold;
                font-family: Segoe UI, serif, Garamond;
                padding-top: 10px;
                padding-bottom:10px;
                
            }


        #tms_settings {
            height: 60px;
        }

        #tms_content {
            width: 350;
            float: none;
            margin: 0 auto;
            position: absolute;
            left: 50%;
            top: 50%;
            -webkit-transform: translate(-50%, -50%);
            transform: translate(-50%, -50%);
            /*height:200px;
            position:absolute;
            left:50%;
            top:50%;
            margin:-100px 0 0 -150px;*/
        }

        #tms_footer {
            position: absolute;
            bottom: 0;
            width: 100%;
        }

        .formcsss {
              position: relative;
              z-index: 1;
              background: #FFFFFF;
              max-width: 360px;
              margin: 0 auto 100px;
              padding: 45px;
              /*text-align: center;*/
              box-shadow: 0 0 20px 0 rgba(0, 0, 0, 0.2), 0 5px 5px 0 rgba(0, 0, 0, 0.24);
        }
        
    </style>
</head>
<body>
    <div id="tms_header" class="container-fluid">
        <p class="text-center">DIGITAL SOURCING</p>
    </div>
    <br>

    <div id="tms_settings" class="container-fluid">
        <div class="row" style="margin-left:0px; margin-right:0px;">
            <div class="col-md-3">
                <img src= @(new Tms.Classes.Shared.Parametres(0).Base_url + "/Images/Logo/plant.png") height="90" width="200">
            </div>
            <div class="col-md-3">

            </div>
                <div class="col-md-3 col-md-offset-6">
                    <!--<div class="dropdown">
                        <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            <span class="glyphicon glyphicon-cog"></span>
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                            <li><a href="#">Database settings</a></li>
                            <li><a href="#">Database settings</a></li>
                        </ul>
                    </div>-->
                </div>
            </div>
    </div>


    <div id="tms_content">                        
        @*@DigitalCoops.Cocoa.Properties.Resources*@
        @if (ViewBag.Mode == Tms.Components.Settings.EnumLoginDefinition.DEFAULT)
        {
            using (Html.BeginForm("CheckUser", "Login", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal formcss", role = "form", onsubmit = "return IsValidUser();" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group">
                    <label for="inputUserName" class="col-xs-12 col-md-6 col-sm-6 control-label">@DigitalCoops.Cocoa.Properties.Resources.lblUserName</label>
                    <div class="col-xs-12 col-md-6 col-sm-6">
                        <input type="text" class="form-control" id="inputUserName" placeholder="Nom Utilisateur" name="username" onchange="HideError();">
                    </div>
                </div>                
                if (TempData["ErrorMsg"] != null)
                {
                    <div id="showerror" class="alert alert-danger" role="alert" style="display:block;">@TempData["ErrorMsg"]</div>
                }
                else
                {
                    <div id="showerror" class="alert alert-danger" role="alert" style="display:none;"></div>
                }

                <div class="form-group">
                    <label for="submitbtn" class="col-xs-12 col-md-6 col-sm-6 control-label"></label>
                    <div class="col-xs-12 col-md-6 col-sm-6">
                        <button type="submit" id="submitbtn" class="btn btn-success btn-sm btn-block" >@DigitalCoops.Cocoa.Properties.Resources.BtnNext</button>
                        @*<input type="submit" id="submitbtn" value="Next" class="btn btn-success btn-sm btn-block"  />*@
                    </div>
                </div>

            }
        }
        else if (ViewBag.Mode == Tms.Components.Settings.EnumLoginDefinition.CONNECT)
        {
            using (Html.BeginForm("Authenticate", "Login", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form", onsubmit = "return IsValidForm();",  }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group">
                    <label for="inputUserName" class="col-xs-12 col-md-6 col-sm-6 control-label">@DigitalCoops.Cocoa.Properties.Resources.lblUserName</label>
                    <div class="col-xs-12 col-md-6 col-sm-6">
                        <input type="text" class="form-control" readonly="readonly" id="inputUserName" placeholder="Nom Utilisateur" name="username" value="@ViewBag.UserName" onchange="HideError();">
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputPassword" class="col-xs-12 col-md-6 col-sm-6 control-label">@DigitalCoops.Cocoa.Properties.Resources.lblPassWord</label>
                    <div class="col-xs-12 col-md-6 col-sm-6">
                        <input type="password" class="form-control" id="inputPassword" placeholder="Mot de Passe" name="password" onchange="HideError();">
                    </div>
                </div>
                if (TempData["ErrorMsg"] != null)
                {
                    <div id="showerror" class="alert alert-danger" role="alert" style="display:block;">@TempData["ErrorMsg"]</div>
                }
                else
                {
                    <div id="showerror" class="alert alert-danger" role="alert" style="display:none;"></div>
                }

                <div class="form-group">
                    <label for="submitbtn" class="col-xs-12 col-md-6 col-sm-6 control-label"></label>
                    <div class="col-xs-12 col-md-6 col-sm-6">
                        <button type="submit" id="submitbtn" class="btn btn-success btn-sm btn-block">@DigitalCoops.Cocoa.Properties.Resources.BtnSignIn</button>
                    </div>
                </div>

            }
        }
        else
        {
            using (Html.BeginForm("SubmitNewCredential", "Utilisateur", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form", onsubmit = "return IsValid();" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <input type="hidden" class="form-control" id="inputUserID" value="@ViewBag.userID" name="userid">
                <div class="form-group">
                    <label for="inputUserName" class="col-xs-12 col-md-6 col-sm-6 control-label">@DigitalCoops.Cocoa.Properties.Resources.lblUserName</label>
                    <div class="col-xs-12 col-md-6 col-sm-6">
                        <input type="text" readonly="readonly" class="form-control" id="inputUserName" placeholder="Nom Utilisateur" name="username" value="@ViewBag.UserName">
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputPassword" class="col-xs-12 col-md-6 col-sm-6 control-label">@DigitalCoops.Cocoa.Properties.Resources.lblPassWord</label>
                    <div class="col-xs-12 col-md-6 col-sm-6">
                        <input type="password" class="form-control" id="inputPassword" placeholder="Mot de Passe" name="password" onchange="HideError();">
                    </div>
                </div>
                <div class="form-group">
                    <label for="inputConfirmPassword" class="col-xs-12 col-md-6 col-sm-6 control-label">@DigitalCoops.Cocoa.Properties.Resources.LblConfirm</label>
                    <div class="col-xs-12 col-md-6 col-sm-6">
                        <input type="password" class="form-control" id="inputConfirmPassword" placeholder="Confirmer Mot de Passe" onchange="HideError();" name="confirmpassword">
                    </div>
                </div>
                if (TempData["ErrorMsg"] != null)
                {
                    <div id="showerror" class="alert alert-danger" role="alert" style="display:block;">@TempData["ErrorMsg"]</div>
                }
                else
                {
                    <div id="showerror" class="alert alert-danger" role="alert" style="display:none;"></div>
                }

                <div class="form-group">
                    <label for="submitbtn" class="col-xs-12 col-md-6 col-sm-6 control-label"></label>
                    <div class="col-xs-12 col-md-6 col-sm-6">
                        <button type="submit" id="submitbtn" class="btn btn-success btn-sm btn-block">@DigitalCoops.Cocoa.Properties.Resources.BtnSignIn</button>
                    </div>
                </div>

            }
        }
        
    </div>
    <div id="loading-wrapper">
        <div id="loading-text">LOADING</div>
        <div id="loading-content"></div>
    </div>
    <div id="tms_footer" class="container-fluid">

        <p class="text-center">Powered by ODM Technology &reg; @DateTime.Now.Year </p>

    </div>




</body>



</html>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script type="text/javascript">
    var IsValid = function () {
        var confirmpwd = document.getElementById("inputConfirmPassword").value;
        var password = document.getElementById("inputPassword").value;        

        if (!confirmpwd && !password) {
            document.getElementById("showerror").style.display = "block";
            document.getElementById("showerror").innerHTML = "Please Fill empty Fields !";
            return false;
        }

        if (confirmpwd != password)
        {
            document.getElementById("showerror").style.display = "block";
            document.getElementById("showerror").innerHTML = "New PassWord and Confirm PassWord are different !";
        /*Ext.Msg.show({ title: 'User : Credential ', icon: Ext.MessageBox.WARNING, msg: 'New PassWord and Confirm PassWird is different', buttons: Ext.Msg.OK });*/
        return false;
        }
        
    };

    var HideError = function () {
        if (document.getElementById("showerror").style.display == "block") {
            document.getElementById("showerror").style.display = "none";
        } 
        
    };

    /*$(document).ready(function () {        
        HideError();
    });*/

    var IsValidForm = function () {        
        document.getElementById("loading-wrapper").style.display = "block";

        var password = document.getElementById("inputPassword").value;
        var user = document.getElementById("inputUserName").value;

        if (!user && !password) {
            document.getElementById("showerror").style.display = "block";
            document.getElementById("showerror").innerHTML = "Please Fill empty Fields !";
            return false;
        }        
    };

    var IsValidUser = function () {        
        var user = document.getElementById("inputUserName").value;

        if (!user) {
            document.getElementById("showerror").style.display = "block";
            document.getElementById("showerror").innerHTML = "Please Enter User Name !";
            return false;
        }
    };

    $('.btn').on('click', function () {
        var $this = $(this);
        $this.button('loading');
        
    });
</script>
<script>
    var stat = document.getElementById("inputPassword");
    (function () {
        if (stat) {
            document.getElementById("inputPassword").focus();
        } else {
            document.getElementById("inputUserName").focus();
        }        
    })();
</script>
