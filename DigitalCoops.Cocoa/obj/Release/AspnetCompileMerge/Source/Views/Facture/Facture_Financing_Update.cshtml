@model Tms.Classes.Business.FinancementViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>

@(
                    //X.FormPanel()
                    //                        .Items(
                    X.Window()
                            .ID("FinancingDeduction_Update")
                            .Width(610)
                            .Resizable(false)
                            .Height(220)
                            .Modal(true)
                            .CloseAction(Ext.Net.CloseAction.Destroy)
                            //.Listeners
                            //(
                            //  l =>
                            //  {
                            //      l.BeforeClose.Handler = "App.TmsViewPort.unmask();";
                            //      l.Close.Handler = "App.TmsViewPort.unmask();";
                            //  }
                            //)
                            .X(400)
                            .Y(20)
                            .Title("Financement : deduction")
                            .Layout(LayoutType.HBox)
                            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                            .Items
                            (

                                    X.Panel()
                                        .Layout(LayoutType.Form)
                                        .Flex(1)
                                        .Items
                                        (
                                            X.Hidden()
                                              .ID("hiddenExecMode")
                                              .Value(Model._ExecMode),
                                            X.Hidden()
                                              .ID("hiddenRowversion")
                                              .Value(Model._Financement.RowVersionKey),
                                            X.Hidden()
                                             .ID("hiddenNumero")
                                             .Value(Model._Financement.Numero),
                                            X.Hidden()
                                             .ID("txtFinancementDeductedID")
                                             .Value(Model._Financement.ID),

                                            X.TextField()
                                             .ID("txtNumber")
                                             .FieldLabel("Financing N°")
                                             .HideTrigger(true)
                                             .LabelAlign(LabelAlign.Right)
                                             .ReadOnly(true)
                                             .Value(Model._Financement.Numero),


                                            X.DateField()
                                             .ID("txtDate")
                                             .FieldLabel("Date")
                                             .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Financement.DateFinancement.ToString() : DateTime.Now.ToString()).LabelAlign(LabelAlign.Right)
                                             .AllowBlank(false)
                                             .ReadOnly(true),

                                            X.ComboBox()
                                             .ID("_cmbType")
                                             .ForceSelection(true)
                                             .ReadOnly(true)
                                             .FieldLabel("Type")
                                             .DisplayField("Designation")
                                             .ValueField("ID")
                                             .LabelAlign(LabelAlign.Right)
                                             .Value(Model._Financement.FinancementType.ID)
                                             .Store
                                             (
                                                 X.Store()
                                                .AutoLoad(true)
                                                .Model
                                                (
                                                    Html.X().Model()
                                                   .IDProperty("ID")
                                                   .Fields
                                                   (
                                                     new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                     new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                   )
                                                )
                                                .Proxy
                                                (
                                                  Html.X().AjaxProxy()
                                                 .Url(Url.Action("Load", "FinancementType"))
                                                 .Reader(Html.X().JsonReader().RootProperty("data"))
                                                )
                                             ),

                                            X.TextField()
                                            .ID("txtAmountDeducted")
                                            .FieldLabel("Montant(CFA)")
                                            .HideTrigger(true)
                                            .LabelAlign(LabelAlign.Right)
                                            .ReadOnly(true)
                                            .Value(Model._Financement.MontantAsString.ToString())
                                        ),

                                X.Panel()
                                         .Layout(LayoutType.Form)
                                         .Flex(1)
                                         .Items
                                         (

                                           X.TextField()
                                            .ID("txtBalance")
                                            .FieldLabel("Solde(CFA)")
                                            .HideTrigger(true)
                                            .LabelAlign(LabelAlign.Right)
                                            .ReadOnly(true)
                                            .Value(Model._Financement.SoldeAsString.ToString()),

                                            X.ComboBox()
                                             .ID("cmbPrelevementType")
                                             .ForceSelection(true)
                                             .FieldLabel("Prelevement")
                                             .DisplayField("Designation")
                                             .ValueField("ID")
                                             .LabelAlign(LabelAlign.Right)
                                             .ReadOnly(true)
                                             .Value(Model._Financement.PrelevementMode.ID)
                                             .Store
                                             (
                                                X.Store()
                                                 .AutoLoad(true)
                                                 .Model
                                                 (
                                                    Html.X().Model()
                                                   .IDProperty("ID")
                                                   .Fields
                                                   (
                                                     new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                     new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                   )
                                                 )
                                                 .Proxy
                                                 (
                                                   Html.X().AjaxProxy()
                                                   .Url(Url.Action("Load", "PrelevementMode"))
                                                   .Reader(Html.X().JsonReader().RootProperty("data"))
                                                 )
                                              ),


                                            X.TextField()
                                             .ID("txtTauxRemboursement")
                                             .HideTrigger(true)
                                             .FieldLabel("Taux")
                                             .AllowBlank(true)
                                             .LabelAlign(LabelAlign.Right)
                                             .ReadOnly(true)
                                             .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Financement.PrelevementTauxAsString : string.Empty),

                                             X.TextField()
                                             .ID("txtDeduction")
                                             .MaskRe("[0123456789]")
                                             .HideTrigger(true)
                                             .FieldLabel("Deduction")
                                             .LabelAlign(LabelAlign.Right)
                                             .Value(Model._Financement.MontantPreleveAsString.ToString())
                                             .AllowBlank(false)
                                             .IndicatorCls("IndicatorRedStar")
                                             .IndicatorText("*")
                                             .Listeners
                                             (
                                               ls =>
                                               {
                                                   ls.Blur.Handler = "if (App.txtDeduction.value && !App.txtDeduction.readOnly) {#{txtDeduction}.setValue(formatNumber(#{txtDeduction}.getValue()));}";
                                                   ls.Focus.Handler = "if (App.txtDeduction.value && !App.txtDeduction.readOnly) { #{txtDeduction}.setRawValue(unformatNumber(#{txtDeduction}.getValue()));}";
                                               }

                                             )
                                          )

                             )
                             .Buttons
                             (
                                X.Button()
                                .Text("OK")
                                .ID("BtnOkFinancingDeduction")
                                .DirectEvents
                                (
                                    de =>
                                    {
                                        de.Click.Url = Url.Action("UpdateFinancingDeducted");
                                        de.Click.Before = "return validNewUpdateFinancing(App.FinancingDeduction_Update.id);";
                                        de.Click.ExtraParams.Add(new Parameter { Name = "FinancementId", Mode = ParameterMode.Raw, Encode = false, Value = "App.txtFinancementDeductedID.value" });
                                        de.Click.ExtraParams.Add(new Parameter { Name = "MntDeduction", Mode = ParameterMode.Raw, Encode = false, Value = "App.txtDeduction.value" });
                                    }
                               ),

                                X.Button()
                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                                .Handler("App.FinancingDeduction_Update.doClose()")
                                .Cls("btncancel")

                             )


)

@Scripts.Render("~/bundles/validation")

<script src="~/Scripts/FormatAmount.js"></script>
<script type="text/javascript">

    var validNewUpdateFinancing = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Financing Update Deduction : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        var Balance = unformatNumber(App.txtBalance.value) || '0';
        var Deduction = unformatNumber(App.txtDeduction.value) || '0';

        if (Ext.isNumeric(Balance) && parseFloat(Deduction) < 0) {
            Ext.Msg.show({ title: 'Financing Update Deduction : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Deduction can not be negative ! ', buttons: Ext.Msg.OK });
            return false;
        }

        if (Ext.isNumeric(Balance) && Ext.isNumeric(Deduction) && parseFloat(Deduction) > parseFloat(Balance)) {
            Ext.Msg.show({ title: 'Financing Update Deduction : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Deduction can not be higher than balance ! ', buttons: Ext.Msg.OK });
            return false;
        }

    };

    var CheckDeduction = function () {

        try
        {
            var Balance = unformatNumber(App.txtBalance.value) || '0';
            var Deduction = unformatNumber(App.txtDeduction.value) || '0';

            if (Ext.isNumeric(Balance) && Ext.isNumeric(Deduction) && Deduction > Balance)
            {
                Ext.Msg.show({ title: 'Financing Update Deduction : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Deduction can not be higher than balance ! ', buttons: Ext.Msg.OK });
                return false;
            }
        }
        catch (err) {
            Ext.Msg.show({ title: 'Financing Update Deduction : Check Deduction ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating amount.', buttons: Ext.Msg.OK });

        }

    };


    var RoundInt = function (v) {
      try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    }

</script>
