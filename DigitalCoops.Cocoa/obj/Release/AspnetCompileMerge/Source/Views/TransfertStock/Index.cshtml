                                        )
                                        .Proxy
                                        (
                                            X.AjaxProxy()
                                            .Url(Url.Action("LoadActiveMagasinAll", "Magasin"))
                                            .Reader(X.JsonReader().RootProperty("data"))
                                        )
                                        ),
                            X.Checkbox()
                                .ID("ChkEntransit")
                                .FieldLabel("En Transit")
                                .LabelAlign(LabelAlign.Right)
                                .Listeners(
                                    ls => ls.Change.Handler = "SetCriteriasRd(); App.storeVenteList.reload();"
                                )
                                
                                .Checked(false)
                                    ),

                                X.Panel()
                                    .ID("OvwResume")
                                    .Flex(3)
                                    //.TitleConfig(new PanelTitle { Text = "Summary", Cls = "title_font_color" })
                                    .Border(false)
                                    //.BodyPadding(6)
                                    .Layout(LayoutType.HBox)
                                    .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                                    .Items(X.Container()
                                        .ID("")
                                        .Layout(LayoutType.VBox)
                                        .LayoutConfig(new VBoxLayoutConfig { Pack = BoxPack.Center })
                                        .Items(X.Label()
                                                    .ID("lblResume")
                                                    .Height(50)
                                                    .StyleSpec("text-align:center;")
                                                    .Text("Resume ici")
                                                    .EmptyText("")
                                                    )
                                        )


                            ),

                            X.GridPanel()
                           .Layout(LayoutType.Fit)
                           .ID("grpListe")
                           .Region(Region.Center)
                           .ForceFit(false)
                           .AllowDeselect(false)
                            .Store
                            (
                                X.StoreFor<Tms.Classes.Business.Sites.VenteLot>()
                                .ID("storeVenteList")
                                //.RemoteFilter(true)
                                //.RemoteSort(true)
                                .RemotePaging(false)
                                .AutoLoad(true)
                                .PageSize(100)
                                .SorterFor(Model, m => m.DateVente, Ext.Net.SortDirection.DESC)
                                .Proxy
                                (
                                    X.AjaxProxy().Timeout(480000)
                                    .Url(Url.Action("Select"))
                                    .Reader(X.JsonReader().RootProperty("data"))
                                )
                            .Listeners
                            (
                                l =>
                                {
                                    l.Add.Handler = "SelectNewRecordAddedOnGrid(records, #{grpListe}.id); Overview.resetButtons(); CallSummary();";
                                    l.Update.Handler = "Overview.resetButtons(); CallSummary();";
                                    l.Remove.Handler = "Overview.resetButtons(); CallSummary();";
                                    l.Load.Handler = "Ext.net.Mask.hide(); CallSummary();";
                                    l.BeforeLoad.Handler = "Ext.net.Mask.show();";
                                }
                            )
                            .Parameters
                            (
                                ps =>
                                {
                                    ps.Add(new StoreParameter { Name = "ItemCampagne", Value = "App.cmbCampagne.getRawValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter { Name = "ItemStatus", Value = "App.cmbStatus.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter { Name = "ItemExportateur", Value = "App.cmbExportateur.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter { Name = "ItemStartDate", Value = "App.dtfDateDebutLivraison.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter { Name = "ItemEndDate", Value = " App.dtfDateFinLivraison.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter { Name = "ItemSite", Value = " App.cmbSite.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter { Name = "ItemMagasinExpedition", Value = " App.cmbMagasinExpedition.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter { Name = "ItemMagasinReception", Value = " App.cmbMagasinReception.getValue()", Encode = false, Mode = ParameterMode.Raw });
                                    ps.Add(new StoreParameter("ItemTransit", "#{ChkEntransit}.getValue()", ParameterMode.Raw));
                                }
                            )
                    )
                    .ColumnModel
                    (
                        X.Column().Text("").DataIndex("mIcon").Width(40).Renderer("renderIcon").Hideable(false).Filterable(false),
                        //X.Column().Text("Date").DataIndex("DateLivraison").Flex(1).Formatter("date(\"m/d/Y g:i A\")"),
                        X.Column().Text("Date Expedition").DataIndex("DateExpedition").Flex(1).Renderer("renderDateLong"),
                        X.Column().Text("Numero Expedition").DataIndex("Numero").Flex(1),
                        X.Column().Text("Numero Lot").DataIndex("NumLot").Flex(1),
                        X.Column().Text("Exportateur").DataIndex("ExportateurAsString").Flex(1),
                        X.Column().Text("Bordereau Expedition").DataIndex("NumeroExpedition").Flex(1),
                        X.Column().Text("Magasin Expedition").DataIndex("MagasinExpeditionAsString").Flex(1),
                        X.Column().Text("Site").DataIndex("SiteAsString").Hidden(true).Flex(1),
                         X.Column().Text("Exp - #Sacs").DataIndex("NombreSacs").Hidden(true).Flex(1),
                         X.Column().Text("Exp - #Palettes").DataIndex("NombrePalette").Hidden(true).Flex(1),
                         X.Column().Text("Exp- P.Brut").DataIndex("PoidsBrut").Flex(1),
                          X.Column().Text("Exp - T.Sac").DataIndex("TareSacs").Hidden(true).Flex(1),
                          X.Column().Text("Exp - T.Palettes").DataIndex("TarePalette").Hidden(true).Flex(1),
                          X.Column().Text("Exp - P.Net").DataIndex("PoidsNet").Flex(1),
                        X.Column().Text("Date Reception").DataIndex("DateReception").Flex(1).Renderer("renderDateLong"),
                        X.Column().Text("Magasin Reception").DataIndex("MagasinReceptionAsString").Flex(1),
                        X.Column().Text("Rec - #Sacs").DataIndex("NombreSacsReception").Hidden(true).Flex(1),
                        X.Column().Text("Rec - #Palettes").DataIndex("NombrePaletteReception").Hidden(true).Flex(1),
                        X.Column().Text("Rec - P.Brut").DataIndex("PoidsBrutReception").Flex(1),
                        X.Column().Text("Rec - T.Sac").DataIndex("TareSacsReception").Hidden(true).Flex(1),
                        X.Column().Text("Rec - T.Palette").DataIndex("TarePaletteArrive").Hidden(true).Flex(1),
                        X.Column().Text("Rec - P.Net").DataIndex("PoidsNetArriveAsString").Flex(1),
                        X.Column().Text("Creation User").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                        X.DateColumn().Text("Creation Date").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                        X.Column().Text("Modification User").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                        X.DateColumn().Text("Modification Date").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")
                    )

                    .BottomBar
                    (
                        X.PagingToolbar()
                        .HideRefresh(true)
                        .Plugins
                        (
                            X.ProgressBarPager())
                        )
                        .Plugins
                        (
                            X.FilterHeader()
                        )
                        .SelectionModel
                        (
                            X.RowSelectionModel()
                            .ID("rowSelectionListe")
                            .Mode(SelectionMode.Single)
                            .AllowDeselect(true)
                        )
                        .Listeners
                        (
                            l =>
                            {
                                l.Select.Fn = "Overview.resetButtons"; l.Deselect.Fn = "Overview.resetButtons";
                            }
                         )
                         .View(
                            X.GridView().LoadingText("Chargement...")
                    )
                        .DirectEvents
                        (
                            de =>
                            {
                                de.RowDblClick.Url = Url.Action("OnConsult");
                                de.RowDblClick.CleanRequest = true;
                                //de.RowDblClick.Success = "App.frmLivraison.setTitle('Vente Lot : Detail')";
                                de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowSelectionListe}.getSelected().items[0].data" });
                                de.RowDblClick.EventMask.ShowMask = true;
                            }
                         )

                    )
    )

</form>
<script type="text/javascript">
    var GenerateTicket = function (id, BaseUrl) {
        Ext.net.DirectMethod.request({ url: BaseUrl + "/TransfertFeves/OnPrintTransfert?IdTransfert=" + id + "&IsCopy=0" });
    };

    var SetCriteriasRd = function () {
        var _val = App.ChkEntransit.value || false;
        if (_val) {
            App.dtfDateDebutLivraison.setReadOnly(true);
            App.dtfDateFinLivraison.setReadOnly(true);
            App.cmbStatus.setReadOnly(true);
            App.cmbMagasinReception.setReadOnly(true);
        } else {
            App.dtfDateDebutLivraison.setReadOnly(false);
            App.dtfDateFinLivraison.setReadOnly(false);
            App.cmbStatus.setReadOnly(false);
            App.cmbMagasinReception.setReadOnly(false);
        }
    };
</script>