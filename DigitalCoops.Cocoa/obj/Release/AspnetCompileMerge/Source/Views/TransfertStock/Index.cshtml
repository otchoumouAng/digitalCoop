        //mTotalEstimatedTonnage = Ext.util.Format.number('0,0', mTotalEstimatedTonnage);


        //var mChaine = Ext.String.format('Transfert(s) : {0} || Total Sacs (Depart) : {1} <br/> Poids Brut (Depart) : {2} (Kg) || Poids Net (Depart) : {3} (Kg) <br/> Poids Brut (Exp) : {4} (Kg) || Poids Net (Exp) : {5} (Kg)', formatNumber(mItemsCount), formatNumber(mTotalEstimatedBags), formatNumber(mTotalEstimatedTonnage), formatNumber(mTotalEstimatedNetTonnage), formatNumber(mBrutExportateur), formatNumber(mNetExportateur));
     var mChaine = Ext.String.format('Transfert(s) : {0} || Total Sacs (Depart) : {1} <br/> Poids Brut (Depart) : {2} (Kg) || Poids Net (Depart) : {3} (Kg)', formatNumber(mItemsCount), formatNumber(mTotalEstimatedBags), formatNumber(mTotalEstimatedTonnage), formatNumber(mTotalEstimatedNetTonnage), formatNumber(mBrutExportateur), formatNumber(mNetExportateur));
       App.lblResume.setHtml(mChaine);

       /*App.rowSelectionListe.deselectAll(true);*/

       Overview.resetButtons();
    };
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListe.columnManager.getColumns(), App.grpListe.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';
        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';
        var icon_url = Overview.getBootStrapIcons(value);
        //console.log(Ext.String.format(tpl, icon_url));
        return Ext.String.format(tpl, icon_url);
    };

    var Overview =
    {
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-saved green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
            else if (value == 3) {
                return 'glyphicon-ok green'; // glyphicon glyphicon-file blue
            }
            else if (value == 4) {
                return 'glyphicon-log-out green'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            App.btnReception.disable();
            App.mnuCancel.disable();
            App.mnuPrintSheet.disable();
            App.btnRecept.disable();

            if (App.rowSelectionListe.hasSelection())
            {
                var isDisabled = App.rowSelectionListe.selected.items[0].data.Desactive;
                var EstReceptionne = App.rowSelectionListe.selected.items[0].data.EstReceptionne;

                if (!isDisabled) {

                    if (App.tfhiddenPermReceptionLot.value == 'true' && (!EstReceptionne))
                        App.btnRecept.enable();                    

                    if (App.tfhiddenPermDesactiver.value == 'true')
                        App.mnuCancel.enable();                    
                }                       
            }
        }
        , updateSummaryInfo: function ()
         {
             /*var mItemsCount = App.grpListe.getRowsValues().length || 0;
             var mItemsCount = App.grpListe.getStore().totalCount || 0;
             var total = parseFloat(0);*/

             /*var mTotalEstimatedBags = App.storeVenteList.sum('SacsDeclares') || 0;
             var mTotalEstimatedBags = total;
             var mTotalEstimatedTonnage = App.storeVenteList.sum('PoidsDeclare') || 0;*/

             //mItemsCount = Ext.util.Format.number('0,0', mItemsCount);
             //mTotalEstimatedBags = Ext.util.Format.number('0,0', mTotalEstimatedBags);
             //mTotalEstimatedTonnage = Ext.util.Format.number('0,0', mTotalEstimatedTonnage);


             /*var mChaine = Ext.String.format('Delivery(ies) : {0} <br/> Total estimated bags : {1} <br/> Total estimated tonnage : {2} (Kg)', formatNumber(mItemsCount), formatNumber(mTotalEstimatedBags), formatNumber(mTotalEstimatedTonnage));
            App.lblResume.setHtml(mChaine);

            App.rowSelectionListe.deselectAll(true);

            Overview.resetButtons();*/
        }
    }


</script>

