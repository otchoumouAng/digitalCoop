<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeOrdreProduction.columnManager.getColumns(), App.grpListeOrdreProduction.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {       
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return  'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-lock green'; // glyphicon glyphicon-file blue
            }            
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }
        },

        SummaryOP: function () {
            var nbrOfrows = App.grpListeOrdreProduction.getStore().getCount();
            /*var totalNet = App.storeListeOrdreProduction.sum('PoidsNetAccepte') || 0;
            var totalNbrOfBags = App.storeListeOrdreProduction.sum('NbreSacs') || 0;
            
            totalNet = FormatAmount(totalNet);
            totalNbrOfBags = FormatAmount(totalNbrOfBags);*/
            App.lblSummaryOP.setHtml("Nbr Of Production Order : " + nbrOfrows);
        },

        resetButtons: function () {

            App.btnModify.disable();
            App.btnCancel.disable();                        
            App.btnClose.disable();
            App.mnuPrintProductionSheet.disable();
            if (App.rowOrdreProduction.hasSelection()) {

                var isDesactive = App.rowOrdreProduction.selected.items[0].data.Desactive;
                var isClosed = App.rowOrdreProduction.selected.items[0].data.IsClosed;                

                if (isDesactive === false) {

                    if (App.OphiddenPermPrintSheet.value == 'true')
                        App.mnuPrintProductionSheet.enable();

                    if (App.OphiddenPermClose.value == 'true' && isClosed === false)
                        App.btnClose.enable();

                    if (App.OphiddenPermModifier.value == 'true' && isClosed === false)
                        App.btnModify.enable();

                    if (App.OphiddenPermDesactiver.value == 'true' && isClosed === false)
                        App.btnCancel.enable();
                }

                else {
                    App.btnModify.disable();                    
                    App.btnCancel.disable();                    
                    App.btnClose.disable();
                }
            }else
                App.mnuPrintProductionSheet.disable();

        }
    }

</script>

