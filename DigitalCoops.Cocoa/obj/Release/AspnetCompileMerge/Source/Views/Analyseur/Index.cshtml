                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                                .Cls("ButtonStyle")
                                .Border(false)
                                .Disable(false)
                                .DirectEvents( de =>{
                de.Click.Url  = Url.Action("OnAdd");
                                    de.Click.Success = "App.FormAnalyseur.setTitle('Quality Agent : Nouveau')";
                de.Click.EventMask.ShowMask = true;
            } ),

                             X.Button()
                            .ID("btnModifyAnalyseur")
                            .IconCls("action_modify_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Disabled(true)
                            .DirectEvents( de =>{
                de.Click.Url  = Url.Action("OnEdit");
                                de.Click.Success = "App.FormAnalyseur.setTitle('Quality Agent : Modifier')";
                de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeAnalyseur}.getSelectionModel().getSelection()[0].data"});
                de.Click.EventMask.ShowMask = true;
            } ),


                                // X.SplitButton()
                                //.ID("btnPrint")
                                //.IconCls("action_print_02")
                                //.Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                //.Disable(false)
                                //.Cls("ButtonStyle")
                                //.Border(false)
                                //.Menu(new Menu()
                                //{
                                //    Items =
                                //    {



                                //    }

                                //})
                                //,

                                X.ToolbarFill(),

                                 X.Button()
                                .ID("btnActions")
                                .Text("Actions")
                                .Border(false)
                                .Cls("ButtonStyle")
                                .IconCls("menu_04")
                                .Disable(false)
                                 .Menu(new Menu()
                                 {
                                     Items = {
                                         X.MenuItem()
                                                .ID("mnuExportAnalyseur")
                                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                                .Icon(Icon.PageExcel)
                                                .Handler("SetExcelList();"),
                                                X.MenuItem()
                                                .ID("mnuCancelAnalyseur")
                                                .IconCls("glyphicon glyphicon-remove red")
                                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                                                .Cls("ButtonStyle")
                                                .Border(false)
                                                .Disabled(true)
                                                .DirectEvents(de =>
                                                {
                                                    de.Click.Url = Url.Action("OnActivateDeactivate");
                                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeAnalyseur}.getSelectionModel().getSelection()[0].data" });
