                                    Items = { X.Button()
                            .ID("btnFilterAnalyseur")
                            .IconCls("action_filter_02")
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                            .Disabled(false)
                            .DirectEvents( de =>{
                                de.Click.Url  = Url.Action("OnFilter");
                                de.Click.EventMask.ShowMask = true;
                                } ),

                            X.Button()
                            .ID("btnRefreshAnalyseur")
                            .IconCls("action_refresh_01")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Disable(false)
                            .DirectEvents( de =>{
                                de.Click.Url  = Url.Action("onRefresh");

                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatus", Encode=true, Value= "#{TxtStatus}.getValue()",     Mode=ParameterMode.Raw});
                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeutApprouver", Encode=true, Value= "#{TxtCanApprove}.getValue()",     Mode=ParameterMode.Raw});
                                de.Click.Success = "SetCriteriaTitle(#{TxtStatus}.value,#{TxtCanApprove}.value);";
                                de.Click.EventMask.ShowMask = true;




            } ),

                                 X.Button()
                                .ID("btnNewAnalyseur")
