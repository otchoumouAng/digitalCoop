
@model Tms.Classes.Security.UtilisateurViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
@(X.FormPanel()
            .Items(
                X.Window()
                .ID("FormUserCredential")
                .Width(400)
                .Resizable(false)
                .Height(200)
                .CloseAction(Ext.Net.CloseAction.Destroy)
                .Listeners(l =>
                {
                    l.Close.Handler = "App.TmsViewPort.unmask();";
                })
                .X(400)
                .Y(20)
                .Title("Authentification")
                .Layout(LayoutType.Form)
                .Items (

                        X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                        X.Hidden().ID("hiddenRowversion").Value(Model._Utilisateur.RowVersionKey),

                        X.Hidden().ID("Txtuserid").Value(Model._Utilisateur.IDUtilisateur),

                        X.TextField().ID("TxtOldpwd").FieldLabel("Ancien Mot de Passe").InputType(Ext.Net.InputType.Password).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                          ,
                        X.TextField().ID("TxtNewpwd").FieldLabel("Nouvea").InputType(Ext.Net.InputType.Password).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                          ,
                        X.TextField().ID("TxtConfirmpwd").FieldLabel("Confirmer").InputType(Ext.Net.InputType.Password).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")

                        )            
            .Buttons(
                X.Button().Text("OK").ID("BtnSubmitPwd")                
                .DirectEvents(de =>
                {
                    de.Click.Url = Url.Action("SubmitCredential");
                    de.Click.Before = "return validNew(App.FormUserCredential.id);";
                })                   
                ,
                X.Button().Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel).Handler("App.FormUserCredential.doClose()").Cls("btncancel")

                )

            )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            console.log('error fileds');
            Ext.Msg.show({ title: 'User : Credential ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;


        }
        var oldvalue = App.TxtNewpwd.value;
        alert(oldvalue);
        var newvalue = App.TxtConfirmpwd.value;
        alert(newvalue);

        if (oldvalue != newvalue) {
            Ext.Msg.show({ title: 'User : Credential ', icon: Ext.MessageBox.WARNING, msg: 'New PassWord and Confirm PassWord is different', buttons: Ext.Msg.OK });
            return false;
        }
        

    };


        /*Ext.onReady(function() {
         #{BtnOk}.on(#{BtnOk}.clickEvent,validNew );
        //})*/
</script>
<script type="text/javascript">

    Ext.form.TextField.override({
        initComponent : function()
        {
            if(this.allowBlank!==undefined && !this.allowBlank)
            {
                if(!this.IndicatorText)
                {
                    this.IndicatorText = "";
                }
                this.IndicatorText += '<span style="color:yellow">*</span>';
            }
            this.callParent(arguments);
        }
    });
</script>




