<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeForwardContract.columnManager.getColumns(), App.grpListeForwardContract.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var SetCriteriaTitle = function (site,cropyear, fournisseur, type, begin, end, status, opt) {
        
        App.CriteriaPanelForwardContract.title = "";
        var texttitle = "";
        if (site) texttitle += "Site : " + site + " | ";

        if (cropyear) texttitle += "Campagne : " + cropyear + " | ";        
        
        if (fournisseur) texttitle += "Fournisseur : " + fournisseur + " | ";        

        if (type) texttitle += "Type De Contrat : " + type + " | ";

        if (begin) texttitle += "Du : " + begin;        

        if (end) texttitle += " Au : " + end + " |";        

        if (status) texttitle += "Statut : " + status + " |";

        if (opt) texttitle += "Option : " + opt;

        App.CriteriaPanelForwardContract.setTitle(texttitle);
    }

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    };


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
            else if (value == 3) {
                return 'glyphicon-folder-close green'; // glyphicon glyphicon-file blue
            }
            else if (value == 5) {
                return 'glyphicon-saved blue'; // glyphicon glyphicon-file blue
            }
            else if (value == 6) {
                return 'glyphicon-saved green'; // glyphicon glyphicon-file blue
            }
            else if (value == 7) {
                return 'glyphicon-file green'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {
            
                App.btnExtendContract.disable();
                App.btnModifyContract.disable();
                App.btnApproveContract.disable();                
                App.mnuCancelContract.disable();
                App.btnRegenerateContract.disable();
                App.mnuPrintDetailExecution.disable();
                App.btnCloseContract.disable();

                if (App.rowSelectionListeForwardContract.hasSelection()) {

                    var isDisabled = App.rowSelectionListeForwardContract.selected.items[0].data.Desactive;
                    var estRelance = App.rowSelectionListeForwardContract.selected.items[0].data.EstRelance;
                    var isApprouve = App.rowSelectionListeForwardContract.selected.items[0].data.Statut;
                    var financingType = App.rowSelectionListeForwardContract.selected.items[0].data.ContratPeriodeType.ID;

                    console.log(isDisabled);
                    console.log(isApprouve);                    

                    if (isDisabled === true) {
                        App.mnuCancelContract.setText('Activer');
                        App.btnExtendContract.disable();
                        App.btnModifyContract.disable();
                        App.btnApproveContract.disable();
                        App.btnCloseContract.disable();
                        App.btnRegenerateContract.disable();
                        App.mnuCancelContract.setIconCls('glyphicon glyphicon-ok green');
                    }
                    else {                        
                        if (isApprouve == "NA") {                            
                            App.mnuCancelContract.setText('Annuler');
                            if (App.CphiddenPermModifier.value == 'true')
                                App.btnModifyContract.enable();

                            if (App.CphiddenPermApprove.value == 'true' && App.defaultFinancingTypeID.value != financingType)
                                App.btnApproveContract.enable();

                            if (App.CphiddenPermDesactiver.value == 'true' && App.defaultFinancingTypeID.value != financingType)
                                App.mnuCancelContract.enable();

                            if (App.CphiddenPermExtend.value == 'true' && App.defaultFinancingTypeID.value != financingType)
                                App.btnExtendContract.enable();

                            if (App.CphiddenPermApprove.value == 'true' && App.defaultFinancingTypeID.value != financingType)
                                App.btnApproveContract.enable();

                            App.mnuCancelContract.setIconCls('glyphicon glyphicon-remove red');

                            return;
                        }

                        if (isApprouve == "RG") {
                            App.btnExtendContract.disable();
                            App.btnModifyContract.disable();
                            App.mnuPrintDetailExecution.disable();

                            if (App.CphiddenPermApprove.value == 'true' && App.defaultFinancingTypeID.value != financingType)
                                App.btnApproveContract.enable();

                            if (App.CphiddenPermDesactiver.value == 'true' && App.defaultFinancingTypeID.value != financingType)
                                App.mnuCancelContract.enable();

                            if (App.CphiddenPermPrintDetailExecution.value == 'true')
                                App.mnuPrintDetailExecution.enable();

                            return;
                        }
                    }                    

                    if ((isApprouve == "AP") && isDisabled === false) {                        
                        App.btnApproveContract.disable();
                        App.btnModifyContract.disable();
                        App.btnRegenerateContract.disable();
                        App.mnuPrintDetailExecution.disable();
                        App.mnuCancelContract.disable();
                        App.btnCloseContract.disable();

                        if (App.CphiddenPermClose.value == 'true')
                            App.btnCloseContract.enable();

                        if (App.CphiddenPermRegenerate.value == 'true')
                            App.btnRegenerateContract.enable();

                        if (App.CphiddenPermPrintDetailExecution.value == 'true')
                            App.mnuPrintDetailExecution.enable();                        

                        if (App.CphiddenPermDesactiver.value == 'true')
                            App.mnuCancelContract.enable();

                        if (App.CphiddenPermExtend.value == 'true' && App.defaultFinancingTypeID.value != financingType)
                            App.btnExtendContract.enable();

                        return;
                    }

                    if ((isApprouve == "AP" || isApprouve == "CL") && isDisabled === true) {
                        App.mnuCancelContract.setText('Activer');
                        App.btnModifyContract.disable();
                        App.mnuCancelContract.setIconCls('glyphicon glyphicon-ok green');
                        App.btnCloseContract.disable();
                        App.btnRegenerateContract.disable();
                        App.mnuPrintDetailExecution.disable();

                        return;
                    }

                    if (isApprouve == "CL") {
                        App.btnCloseContract.disable();                       
                        App.mnuPrintDetailExecution.disable();                                                                       

                        if (App.CphiddenPermPrintDetailExecution.value == 'true')
                            App.mnuPrintDetailExecution.enable();
                        return;
                    }

            } else {

                App.btnExtendContract.disable();
                App.btnModifyContract.disable();
                App.btnApproveContract.disable();                
                App.mnuCancelContract.disable();
                App.btnRegenerateContract.disable();
                App.mnuPrintDetailExecution.disable();
            }
        }
    }


</script>


