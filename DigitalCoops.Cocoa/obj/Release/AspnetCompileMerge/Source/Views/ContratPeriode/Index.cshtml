    /*var LoadStore = function () {
        if (App.cmbFournisseur.getStore().isLoaded() == false) {
            App.cmbFournisseur.getStore().load();
        }
    };*/

    var CalculateSummary = function () {
        var nbrOfrows = App.grpListeForwardContract.getRowsValues().length;
        var totalBalance = parseFloat(App.storeListeForwardContract.sum('Balance')) || 0;
        var totalTonnage = parseFloat(App.storeListeForwardContract.sum('TonnageKgToTone')) || 0;
        var totalTonnagekg = parseFloat(App.storeListeForwardContract.sum('Tonnage')) || 0;
        var totalCoverage = parseFloat(App.storeListeForwardContract.sum('Coverage')) || 0;

        /*for (var i = 0; i < nbrOfrows; i++) {
            totalBalance += parseFloat(App.grpListeForwardContract.getRowsValues()[i].Balance);
            totalTonnage += parseFloat(App.grpListeForwardContract.getRowsValues()[i].TonnageKgToTone);
            totalTonnagekg += parseFloat(App.grpListeForwardContract.getRowsValues()[i].Tonnage);
            totalCoverage += parseFloat(App.grpListeForwardContract.getRowsValues()[i].Coverage);
        }*/
        totalCoverage = RoundInt( 100 - ((totalBalance / totalTonnagekg) * 100)) || 0;       
        totalBalance = FormatAmount(totalBalance);
        totalTonnagekg = FormatAmount(totalTonnagekg);
        
        App.LblForwardContractSummary.setText("Poids Total : " + totalTonnagekg + " (Kg) |  Total solde : " + totalBalance + " (Kg) | Total Couvert : " + totalCoverage + " %");
    };

    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };
</script>