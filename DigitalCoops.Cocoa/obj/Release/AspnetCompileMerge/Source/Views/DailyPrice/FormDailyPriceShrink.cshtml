<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">
        var SetNumberSeparator = function () {
            var number = App.TxtPrice.value;
            number = number.replace(/ /g, '');
            number = number.replace(/\B(?=(\d{3})+(?!\d))/g, " ");
            App.TxtPrice.setValue(number.toString());
        };
        var RemoveNumberSeparator = function () {
            var amount = App.TxtPrice.value;
            amount = amount.replace(/\ /g, '');
            App.TxtPrice.setValue(amount);
        };
</script>
