<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script>
    var secondTick = 0;

            function enableDisableTimer()
            {
                if (App.chkAutomaticRefresh.checked == true)
                    reloadOverviewStoreAtIntervals();
                else
                    ResetTimer();
            }

            function ResetTimer()
            {
                clearTimeout(secondTick);
            }

            function reloadOverviewStoreAtIntervals()
            {
                var interval = 60000;

                var store = App.grpListe.getStore();
                var dateNow= Date.now();

               /* App.lblResume.setText('Last refresh :' + dateNow);*/

                store.reload();               
                secondTick = setTimeout("reloadOverviewStoreAtIntervals()", interval);
            }
            
            //reloadOverviewStoreAtIntervals();

            Ext.onReady(function ()
            {

                if (App.chkAutomaticRefresh.checked == true)
                    reloadOverviewStoreAtIntervals();

            })
</script>

