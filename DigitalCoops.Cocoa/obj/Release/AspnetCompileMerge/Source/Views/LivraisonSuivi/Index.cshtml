        getIcons: function (value) {
            if (value === 0) {
                return Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
            else if (value == 3) {
                return Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
            else if (value == 4) {
                return Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value)
        {
            if (value === 4) {
                return 'glyphicon-remove-circle red'; // rejected
            }
            else if (value == 3) {
                return 'glyphicon-ok green';  // accepted
            }
            else if (value == 2) {
                return 'glyphicon-log-out blue'; // In process
            }            
            else if (value == 1) {
                return 'glyphicon-pause black'; // At gate
            }
        }
