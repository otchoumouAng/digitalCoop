    var CalculateUnfermented = function () {

    };

    var RoundIntToPrecision = function (v) {
        try {
            var partieEntiere = parseInt(v);
            var partieDecimale = parseFloat(v) - parseInt(v);
            partieDecimale = partieDecimale.toFixed(2);

            if (partieDecimale == 0)
                return partieEntiere;
            else if (partieDecimale < 0.34)
                return partieEntiere + 0.33;
            else if (partieDecimale <= 0.67)
                return partieEntiere + 0.66;
            else
                return partieEntiere + 1;

        } catch (err) {
            return 0;
        }
    };

    var numInput;
    window.onload = function () {
        numInput = document.ge('input.number');
        numInput.onkeypress = numInput.onkeydown = numInput.onblur = numInput.onkeyup = function () {
            numInput.value = numInput.value.replace(/[^0-9]+/, "");
        }
    }
</script>








