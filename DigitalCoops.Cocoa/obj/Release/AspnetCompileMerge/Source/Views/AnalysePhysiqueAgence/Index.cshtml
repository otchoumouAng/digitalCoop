<script type="text/javascript">
    var GetNbrStoreRows = function () {
        var nbr = App.grpListeAnalysePhysiqueAgence.getRowsValues().length;        
        App.LblResumeAnalysePhysiqueAgence.setText(nbr + ' Analyses');
    };

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeAnalysePhysiqueAgence.columnManager.getColumns(), App.grpListeAnalysePhysiqueAgence.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var SetCriteriaTitle = function (site, cropyear, livraisontype, fournisseur, begin, end, status) {
        App.AnalysePhysiqueAgenceCriteriaPanel.title = "";
        var texttitle = "";

        if (site) texttitle += " Site : " + site + " | ";

        if (cropyear) texttitle += "Campagne : " + cropyear + " | ";

        if (livraisontype) texttitle += "Type De Livraison : " + livraisontype + " | ";

        if (fournisseur) texttitle += "Fournisseur : " + fournisseur + " | ";

        if (begin) texttitle += " Du : " + begin;

        if (end) texttitle += " Au : " + end;

        if (status) texttitle += " | Statut : " + status;

        App.AnalysePhysiqueAgenceCriteriaPanel.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';
        

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
            else if (value == 3) {
                return 'glyphicon-file red'; // glyphicon glyphicon-file blue
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {            

            if (App.rowSelectionAnalysePhysiqueAgence.hasSelection()) {                

                var isDisabled = App.rowSelectionAnalysePhysiqueAgence.selected.items[0].data.Desactive;
                var isApprouve = App.rowSelectionAnalysePhysiqueAgence.selected.items[0].data.Confirmation;
                var resultat = App.rowSelectionAnalysePhysiqueAgence.selected.items[0].data.Resultat;
                                
                if (isDisabled === true) {
                    App.mnuCancelAnalysePhysiqueAgence.disable();
                    App.btnModifyAnalysePhysiqueAgence.disable();
                    App.mnuCancelAnalysePhysiqueAgence.setText('Activer');                    
                    App.btnApproveAnalysePhysiqueAgence.disable();
                    App.mnuCancelAnalysePhysiqueAgence.setIconCls('glyphicon glyphicon-ok green');                    
                }
                else {
                    if (App.AphiddenPermModifier.value == 'true')
                        App.btnModifyAnalysePhysiqueAgence.enable();

                    if (App.AphiddenPermDesactiver.value == 'true')
                        App.mnuCancelAnalysePhysiqueAgence.enable();

                    if (App.AphiddenPermApprove.value == 'true')
                        App.btnApproveAnalysePhysiqueAgence.enable();

                    App.mnuCancelAnalysePhysiqueAgence.setText('Annuler');
                    App.mnuCancelAnalysePhysiqueAgence.setIconCls('glyphicon glyphicon-remove red');

                    if (isApprouve === true && isDisabled === false) {
                        App.btnApproveAnalysePhysiqueAgence.disable();
                        App.btnModifyAnalysePhysiqueAgence.disable();

                        if (App.AphiddenPermSuperDesactiver.value == 'true')
                            App.mnuCancelAnalysePhysiqueAgence.enable();
                        else
                            App.mnuCancelAnalysePhysiqueAgence.disable();

                        return;
                    } 
                }                
            } else {

                App.btnApproveAnalysePhysiqueAgence.disable();
                App.btnModifyAnalysePhysiqueAgence.disable();                                
                App.mnuCancelAnalysePhysiqueAgence.disable();
            }
        }
    }


</script>


