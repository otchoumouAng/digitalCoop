<script type="text/javascript" language="javascript">
    var LoadAllStoreInCriteriaPanel = function () {
        if (App.FactureTransportTransporteurID.getStore().isLoaded() == false) {
            App.FactureTransportTransporteurID.getStore().load();
        }
        
    };

    var OnSearchFactureTransportByNumber = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            /*Ext.net.DirectMethod.request({ url: "/DeliveryCoding/SelectDeliveryInfo"});*/
            App.BtnSearchFactureTransportByNumber.fireEvent('click', App.BtnSearchFactureTransportByNumber);
            e.stopEvent();
        }
    };

    var ShowNotifaction = function () {
        Ext.Msg.notify("Codification", "Code has been saved !");
    };

    var CalculateTotalAmount = function () {
        var nbrOfrows = App.grpListeFactureTransport.getStore().getCount();
        var totalAmount = parseFloat(App.storeListeFactureTransport.sum('Montant')) || 0;
        var totalTonnage = parseFloat(App.storeListeFactureTransport.sum('Tonnage')) || 0;

        /*var total = 
        for (var i = 0; i < nbrOfrows; i++) {
            totalAmount += parseFloat(App.grpListeFactureTransport.getRowsValues()[i].Montant);
            totalTonnage += parseFloat(App.grpListeFactureTransport.getRowsValues()[i].Tonnage);
        }*/
        totalAmount = FormatAmount(totalAmount);
        totalTonnage = FormatAmount(totalTonnage);
        App.LblFactureTransportTotal.setText("Poids Total : " + totalTonnage + "  |  Montant Total : " + totalAmount);
    };
</script>