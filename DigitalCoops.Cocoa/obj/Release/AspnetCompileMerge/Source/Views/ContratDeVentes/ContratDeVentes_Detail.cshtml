@Scripts.Render("~/bundles/validation")

<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Sales Contract : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }
        
    };
    
    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

    var CalculFob = function () {

        try {
            var FobDiscount = unformatNumberDecimal(App.txtFobDiscount.value.replace(',', '.')) || '';
            
            if (isNumeric(FobDiscount) && FobDiscount >= 0) {

                var Price = unformatNumberDecimal(App.txtPrice.value.replace(',', '.')) || '';
                var conv = App.ValeurConversionEuroFrancs.value || 0;
                console.log("conv" + conv);
                var NewPrice = Price - FobDiscount;
                console.log("NewPrice" + Price + " - Fob" + FobDiscount);
                var NewPriceCfa = (Price - FobDiscount) * conv;
                console.log("NewPriceCfa" + NewPriceCfa);
                var PriceCfa = Price * conv;
                console.log("PriceCfa" + PriceCfa);

                if (isNumeric(NewPrice) && NewPrice > 0)
                {
                    PriceCfa = RoundInt(PriceCfa);
                    NewPriceCfa = RoundInt(NewPriceCfa);
                    App.txtFobPrice.setValue(formatNumberDecimal(NewPrice.toString()));
                    App.txtFobPriceCfa.setValue(formatNumberDecimal(NewPriceCfa.toString()));
                    App.txtPriceCFA.setValue(formatNumberDecimal(PriceCfa.toString()));
                }
                else
                {
                    /*Ext.Msg.show({ title: 'Sales Contract : Fob Calculation ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating.', buttons: Ext.Msg.OK });*/
                    return false;
                }

            }
        }
        catch (err) {
            Ext.Msg.show({ title: 'Sales Contract : Fob Calculation ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating Price.'+ err, buttons: Ext.Msg.OK });

        }

    };

    var CalculFobPrice = function () {

        try {
            var Price = unformatNumberDecimal(App.txtPrice.value.replace(",", ".")) || '';
            
            if (isNumeric(Price) && Price > 0 ) {
                var FobDiscount = unformatNumberDecimal(App.txtFobDiscount.value.replace(",", ".")) || '';
                console.log(FobDiscount);
                if (isNumeric(FobDiscount) && FobDiscount >= 0)
                {
                    var conv = App.ValeurConversionEuroFrancs.value || 0;
                    var NewPrice = Price - FobDiscount;
                    var NewPriceCfa = (Price - FobDiscount) * conv;
                    var PriceCfa = Price * conv;
                    console.log(NewPriceCfa);
                    if (isNumeric(NewPrice) && NewPrice > 0) {
                        App.txtFobPrice.setValue(formatNumberDecimal(NewPrice.toString()));
                        App.txtFobPriceCfa.setValue(formatNumberDecimal(NewPriceCfa.toString()));
                        App.txtPriceCFA.setValue(formatNumberDecimal(PriceCfa.toString()));
                    }
                    else {
                        /*Ext.Msg.show({ title: 'Sales Contract : Fob Calculation ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating.', buttons: Ext.Msg.OK });*/
                        return false;
                    }
                }
                
                

            }
        }
        catch (err) {
            Ext.Msg.show({ title: 'Sales Contract : Fob Calculation ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating Price.' + err, buttons: Ext.Msg.OK });

        }

    };

    var CalculateCertifiedPrice = function () {

        try {
            var Price = unformatNumber(App.txtPrice.value) || 0;
            Price = parseFloat(Price);
            if (isNumeric(Price) && App._cmbCertification.value) {
                /*var Bonus = App.BonusCertification.value || 0;*/
                var Bonus = App.txtRefBonusCertif.value || 0;
                Bonus = parseFloat(Bonus);
                var NewValue = (Price + Bonus);
                console.log('Certif ' +NewValue);
                App.txtPrixCertifie.setValue(formatNumber(NewValue));
            } else
                App.txtPrixCertifie.setValue("");
        }
        catch (err) {
            Ext.Msg.show({ title: 'Sales Contract : Certified Price ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating Price.' + err, buttons: Ext.Msg.OK });

        }
    };

    function formatNumberDecimal(amount) {
        amount = thousands_separators(amount.replace(".", ","));
        formatted = amount.replace(".", ",");

        return formatted;
    };

    function unformatNumberDecimal(amount) {
        formatted = amount.replace(" ", "");

        return formatted;
    };

    function thousands_separators(num) {
        var num_parts = num.toString().split(".");
        num_parts[0] = num_parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, " ");
        return num_parts.join(".");
    };

    var DefinirZonesObligatoires = function () {
        /*Certified Price */
        setCtrlIsRequired(App.txtPrixCertifie, false);
        setCtrlIsRequired(App.txtRefBonusCertif, false);

        if (App._cmbCertification.value) {
            setCtrlIsRequired(App.txtPrixCertifie, true);
            setCtrlIsRequired(App.txtRefBonusCertif, true);
        }

    };

    var setCtrlIsRequired = function (field, value) {
        field.allowBlank = !value;

        field.setIndicator("");
        field.setIndicatorCls('');
        field.showIndicator();

        if (value == true) {
            field.setIndicator("*");
            field.setIndicatorCls('IndicatorRedStar');
            field.showIndicator();
        }
    };

</script>
