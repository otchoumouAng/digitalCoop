<script>
    var SetCriteriaTitle = function (begin, end, campagne) {
        App.VolumeCropYearToDatePanel.title = "";
        var texttitle = "";
        
        if (begin) texttitle += "Volume Du : " + begin;

        if (end) texttitle += " Au : " + end;        
        if (campagne) texttitle += " | Campagne : " + campagne;        

        App.VolumeCropYearToDatePanel.setTitle(texttitle);
    };

    var SetCriteriaTitleFin = function (begin, end, campagne) {
        App.FinancingCropYearToDatePanel.title = "";
        var texttitle = "";
        
        if (begin) texttitle += "Financing | Du : " + begin;

        if (end) texttitle += " Au : " + end;        
        if (campagne) texttitle += " | Campagne : " + campagne;        

        App.FinancingCropYearToDatePanel.setTitle(texttitle);
    };

    
        var tipRenderer = function (toolTip, storeItem, item) {
            var total = 0;
            /*var storeid = storeItem.store.storeId;*/
            App.ChartVolumeToday.getStore().each(function (rec) {
                total += rec.get('Total');
            });

            toolTip.setTitle(storeItem.get('Libelle') + ': ' + Math.round(storeItem.get('Total') / total * 100) + '%');
        };

        var tipRendererCropYearAcRj = function (toolTip, storeItem, item) {
            var total = 0;
            /*total = parseInt(App.storeListeCropYearToDate.getRecordsValues()[2].InProcess) + parseInt(App.storeListeCropYearToDate.getRecordsValues()[2].Accepted) + parseInt(App.storeListeCropYearToDate.getRecordsValues()[2].Rejected);*/
            App.PieVolumeCropYearToDateApRj.getStore().each(function (rec) {
                total += rec.get('Total');
            });

            /*toolTip.setTitle(storeItem.get('Libelle') + ': ' + Math.round(storeItem.get('Total') / total * 100) + '%');*/
            toolTip.setTitle(storeItem.get('Libelle') + ': ' + FormatAmount(storeItem.get('Total')) + ' Kg');
        };

        var tipRendererCropYearCrCv = function (toolTip, storeItem, item) {
            var total = 0;

            App.PieVolumeCropYearToDateCrCv.getStore().each(function (rec) {
                total += rec.get('Total');
            });

            toolTip.setTitle(storeItem.get('Libelle') + ': ' + Math.round(storeItem.get('Total') / total * 100) + '%');
        };

        var tipRendererChartFinancing = function (toolTip, storeItem, item) {
            var total = 0;            
                /*console.log(storeItem);*/
            App.ChartFinancingToday.getStore().each(function (rec) {
                total += rec.get('Total');
            });

            toolTip.setTitle(storeItem.get('Libelle') + ': ' + Math.round(storeItem.get('Total') / total * 100) + '%');
        };

        var saveChart = function (btn) {
            Ext.MessageBox.confirm('Confirm Download', 'Would you like to download the chart as an image?', function (choice) {
                if (choice === 'yes') {
                    btn.up('panel').down('polar').download();
                }
            });
        };

    /*Load Volume Chart*/
        var LoadVolumeChart = function (model, records) {            
            var rec = records[2];
            var json = [{
                    'Libelle': 'Accepted',
                    'Total': rec.get('Accepted')
                }, {
                    'Libelle': 'Rejected',
                    'Total': rec.get('Rejected')
                }];
            App.storeListeDshVolumeTodayChart.loadData(json);
            /*if (records[0]) {
                rec = records[2];
                App.storeListeDshVolumeTodayChart.loadRecord(rec);
            }*/
        }; 

        var LoadFinancingChart = function (model, records) {
            /*console.log(records.length);*/
            if (records.length > 0) {
                var SelectedRows = [];
                var json;
                var rec;

                for (var i = 1; i < records.length; i++) {
                    rec = records[i];
                    json = {
                        'Libelle': rec.get('Designation'),
                        'Total': rec.get('Allocated')
                    };
                    SelectedRows[i - 1] = json;
                }
                App.storeListeFinancingChart.loadData(SelectedRows);
                App.storeFinancingEvolution.reload();
                App.storeFinancingTopBadDebit.reload();
            }
            else
            {
                App.storeListeFinancingChart.removeAll();
                App.storeFinancingEvolution.removeAll();
                App.storeFinancingTopBadDebit.removeAll();
            }            
                    
            
        };

    var LoadVolumeCropYearChart = function (model, records) {

        /*var totalEPoidsBrut = App.storeListeCropYearToDate.sum('TotalEntree') || 0;
        var totalSPoidsBrut = App.storeListeCropYearToDate.sum('TotalSortie') || 0;
        var totalSPalette = App.storeListeCropYearToDate.sum('TotalTarePaletteSortie') || 0;
        var totalSsac = App.storeListeCropYearToDate.sum('TotalTareSacsSortie') || 0;*/
        var totalENetLivre = App.storeListeCropYearToDate.sum('TotalPoidsNetLivreEntree') || 0;
        var totalSNetLivre = App.storeListeCropYearToDate.sum('TotalPoidsNetLivreSortie') || 0;
        /*var stock = mTotalEntree - mTotalSortie;*/
        var stock = totalENetLivre - totalSNetLivre;
        /*var stock = totalEPoidsBrut - (totalSPoidsBrut - totalSsac - totalSPalette);*/

        var rec = records[0].data;
            var json =
            [
                {
                    'Libelle': 'Entrée',
                    'Total': totalENetLivre
                },
                {
                    'Libelle': 'Sortie',
                    'Total': totalSNetLivre
                },
                {
                    'Libelle': 'Stock',
                    'Total': stock
                }
            ];          
                                 
            App.storePieVolumeCropYearToDateApRj.loadData(json);  

            /* Reload All Graph*/
            /*App.storeVolumeCropYearToDateProgressChartline.load();
            App.storeVolumeCropYearToDatePerAgenciesBar.load();
            App.storeVolumeCropYearToDatePerformersBar.load();
            */
        };

    var LoadVolumeCropYearChartExport = function (model, records) {

        var totalENetLivre = App.storeListeCropYearToDateR.sum('TotalPoidsNetLivreEntree') || 0;
        var totalSNetLivre = App.storeListeCropYearToDateR.sum('TotalPoidsNetLivreSortie') || 0;
        /*var stock = mTotalEntree - mTotalSortie;*/
        var stock = totalENetLivre - totalSNetLivre;

        var rec = records[0].data;
        var json =
            [
                {
                    'Libelle': 'Entrée',
                    'Total': totalENetLivre
                },
                {
                    'Libelle': 'Sortie',
                    'Total': totalSNetLivre
                },
                {
                    'Libelle': 'Stock',
                    'Total': stock
                }
            ];        

        App.storePieVolumeCropYearToDateCrCv.loadData(json);

        /* Reload All Graph*/
        /*App.storeVolumeCropYearToDateProgressChartline.load();
        App.storeVolumeCropYearToDatePerAgenciesBar.load();
        App.storeVolumeCropYearToDatePerformersBar.load();
        */
    };

    var doMask = function (item) {
        var panel = Ext.getCmp(item);
        if (!panel.loading)
            panel.loading = true;
        else panel.loading = false;
        panel.setLoading(panel.loading, panel.body);                        
    };

    var SetPieLabelInnerCanevas = function (sprite, record, attributes, index, store) {

        var ind = index.store.findExact('Libelle', sprite); /* the field containing the current label*/
        var val = index.store.getAt(ind).data.Total;
        var storeLength = index.store.data.length;
        var total = 0;
        for (var i = 0; i < storeLength; i++) {
            total += index.store.getAt(i).data.Total;
        }

        var PrCent = FormatAmount(val) + ' Kg';
        /*console.log(index);*/

        return PrCent; /* ToString to show int Value in Canevas */

    };
</script>
