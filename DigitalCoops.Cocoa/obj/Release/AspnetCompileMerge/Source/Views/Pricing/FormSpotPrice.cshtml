                        .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PrixNegocie.ModeApplication.ID : (int?)null)
                                .Store(X.Store()
                                        .AutoLoad(true)
                                        .Model(Html.X().Model()
                                        .IDProperty("ID")
                                                .Fields(
                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                )
                                            )
                                        .Proxy(Html.X().AjaxProxy()
                                            .Url(Url.Action("LoadModeApplication", "PrixNegocieModeApplication"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )
                                        ),
                        X.TextField().ID("TxtDeliveryDate").FieldLabel("Date Livraison").LabelAlign(LabelAlign.Right).ReadOnly(true)
                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PrixNegocie.Prix.ToString() : string.Empty),
                        X.TextField().ID("TxtTruckID").FieldLabel("Immatriculation").LabelAlign(LabelAlign.Right).ReadOnly(true)
                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PrixNegocie.Prix.ToString() : string.Empty),
                        X.TextField().ID("TxtEstimatedTonnage").FieldLabel("Tonnage Estimé").LabelAlign(LabelAlign.Right).ReadOnly(true)
                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PrixNegocie.Prix.ToString() : string.Empty)

                        )

            )

            )
            .Buttons(
                X.Button().Text("OK").ID("BtnOk")
                //.Handler("validNew(App.FormFournisseur.id)")
                .DirectEvents(de =>
                {
                    de.Click.Url = Url.Action("SubmitSpotPriceMethod");
                    de.Click.Before = "return validNew(App.FormSpotPrice.id, App.TxtPrice.value);";
                })

                    //.DirectClickUrl( Url.Action("SubmitFormMethod")).Handler("validNew(App.FormFournisseur.id)")
                    ,
                X.Button().Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel).Handler("App.FormSpotPrice.doClose()")

                )

            )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId, val) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            console.log('error fileds');
            Ext.Msg.show({ title: 'Erreur : Collection ', msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        } else {
            /*alert(val);*/
            if (val >= 10 && val <= 100) {
                Ext.Msg.show({ title: 'Erreur : Collection ', msg: 'Please Check Price.', buttons: Ext.Msg.OK });
                return true;
            } else {
                Ext.Msg.show({ title: 'Erreur : Price ', msg: 'Please Check Price.', buttons: Ext.Msg.OK });
                return false;
            }

        }
    };

    var showdate = function (item) {        
        if (item == "1") {
            App.TxtStartDate.setReadOnly(false);
            App.TxtStartDate.allowBlank = (false);
            App.TxtStartDate.validate();
            App.TxtStartDate.setIndicator("*");
            App.TxtDueDate.setReadOnly(false);
            App.TxtDueDate.allowBlank = (false);
            App.TxtDueDate.validate();
            App.TxtDueDate.setIndicator("*");
        } else {
            App.TxtStartDate.setReadOnly(true);
            App.TxtStartDate.allowBlank = (true);
            App.TxtStartDate.validate();
            App.TxtStartDate.setIndicator("");
            App.TxtDueDate.setReadOnly(true);
            App.TxtDueDate.allowBlank = (true);
            App.TxtDueDate.validate();
            App.TxtDueDate.setIndicator("");
        }
    };
        /*Ext.onReady(function() {
         #{BtnOk}.on(#{BtnOk}.clickEvent,validNew );
        //})*/
</script>
