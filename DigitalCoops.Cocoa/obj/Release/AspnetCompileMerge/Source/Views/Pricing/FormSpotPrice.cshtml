            X.DateField().ID("TxtStartDate").ReadOnly(true).FieldLabel("Date Debut").AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PrixNegocie.DateDebut.ToString() : DateTime.Now.ToString()).LabelAlign(LabelAlign.Right)
                                .MinDate(DateTime.Now)
                        ,
                        X.DateField().ID("TxtDueDate").ReadOnly(true).FieldLabel("Date Fin").AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PrixNegocie.DateEcheance.ToString() : DateTime.Now.ToString()).LabelAlign(LabelAlign.Right)
                            .MinDate(DateTime.Now)

)


