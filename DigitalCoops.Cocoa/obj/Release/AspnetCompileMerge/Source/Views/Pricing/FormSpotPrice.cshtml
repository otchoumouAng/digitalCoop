                            X.Hidden().ID("TxtSpotPriceID").Value(Model._PrixNegocie.ID),
                            //X.ComboBox().ID("LocationID").FieldLabel("Location").DisplayField("Nom").ValueField("ID").LabelWidth(110).LabelAlign(LabelAlign.Right)
                            //    .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PrixJournalier.Site.ID : -1).EmptyValue("")
                            //        .Store(X.Store()
                            //                .AutoLoad(true)
                            //                .Model(Html.X().Model()
                            //                .IDProperty("ID")
                            //                        .Fields(
                            //                            new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                            //                            new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                            //                        )
                            //                    )
                            //                .Proxy(Html.X().AjaxProxy()
                            //                    .Url(Url.Action("LoadSite", "Site"))
                            //                    .Reader(Html.X().JsonReader().RootProperty("data"))
                            //                )
                            //                )
                            //    ,
                            X.ComboBox().ID("FournisseurID").EmptyText("Select Supplier").ForceSelection(true).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*").FieldLabel("Fournisseur").DisplayField("Nom").ValueField("ID").LabelWidth(110).LabelAlign(LabelAlign.Right)

                        .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PrixNegocie.Fournisseur.ID : (int?)null)
                                .Store(X.Store()
