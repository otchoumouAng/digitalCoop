@model Tms.Classes.Shared.stock.AgentProductionViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
@(
X.Window()
    .ID("FormAgentProduction")
    .Width(500)
    .Resizable(false)
    .Height(180)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Listeners(l =>
    {        
        l.Show.Handler = "#{TxtNomAgent}.focus();";
    })
    //.X(400)
    .Y(20)
    .Title("Agent Production : Detail")
    .BodyPadding(6)    
    .Items(
            X.FormPanel()
                .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                .Layout(LayoutType.VBox)
                .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
                .Items(
                            X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                            X.Hidden().ID("hiddenRowversion").Value(Model._AgentProduction.RowVersionKey),
                            X.Hidden().ID("TxtAgentProductionID").Value(Model._AgentProduction.ID),
                            X.TextField().ID("TxtNomAgent").FieldLabel("Nom").TabIndex(1)
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._AgentProduction.Nom : string.Empty)
                                .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*"),
                            X.ComboBox()
                                .ID("cmbTypeAgent")
                                .TabIndex(2)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .FieldLabel("Type")
                                .DisplayField("Designation")
                                .ValueField("ID")                                
                                .LabelAlign(LabelAlign.Right)
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._AgentProduction.AgentProductionType.ID : (int?)null)
                                .Store
                                (
                                                X.Store()
                                                    .AutoLoad(true)
                                                    .Model
                                                    (
                                                        Html.X().Model()
                                                        .IDProperty("ID")
                                                        .Fields
                                                        (
                                                            new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                            new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                        )
                                                    )
                                                    .Proxy
                                                    (
                                                        Html.X().AjaxProxy()
                                                        .Url(Url.Action("LoadActiveAgentProductionType", "AgentProductionType"))
                                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                                    )
                                            ),
                            X.Checkbox().ID("ChkAgentPeutApprouver").FieldLabel("Can Appove")
                                .Checked(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._AgentProduction.PeuxApprouver : false)
                                .LabelAlign(LabelAlign.Right)

                    )
    )
    .Buttons(
                X.Button()
                    .Text("OK").ID("BtnSubmitAgent")
                    .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                    .DirectEvents(de =>
                    {
                        de.Click.Url = Url.Action("SubmitFormMethod");
                        de.Click.Before = "return validNew(App.FormAgentProduction.id);";
                        de.Click.FormID = "#(return this.up('window').down('form');)";
                    }),
                X.Button()
                    .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                    .Handler("App.FormAgentProduction.doClose()").Cls("btncancel")

    )            
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Agent Production : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }


    };


</script>












