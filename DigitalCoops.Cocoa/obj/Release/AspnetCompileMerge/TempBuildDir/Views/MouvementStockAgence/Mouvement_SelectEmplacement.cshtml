            .IndicatorText("*")
            .LabelAlign(LabelAlign.Right)
            .Store
            (
                X.Store()
                    .AutoLoad(true)
                    .Model
                    (
                        X.Model()
                            .IDProperty("ID")
                            .Fields
                            (
                                new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                            )
                    )
                    .Proxy
                    (
                        X.AjaxProxy()
                            .Url(Url.Action("LoadActiveEmplacement", "Emplacement"))
                            .Reader(X.JsonReader().RootProperty("data"))
                    )
                    .Parameters
                    (
                        ps =>
                        {
                            ps.Add(new StoreParameter("ItemMagasin", ViewData["MagasinID"].ToString(), ParameterMode.Value));
                        }
                    )
                    .Listeners
                    (
                            li =>
                            {
                                li.Load.Handler = "var combo = App.cmbMouvementEmplacement; combo.setValue(records.length > 0 ? records[0].data.ID : 0);";
