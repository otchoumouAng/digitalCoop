    .Buttons
    (
        X.Button()
            .Text("OK")
            .ID("BtnOk")
            .DirectEvents
            (
                de =>
                {
                    de.Click.Url = Url.Action("GenerateMouvement", "MouvementStock");
                    de.Click.Before = "return validNew(App.Mouvement_SelectEmplacement.id);";
                    de.Click.FormID = "#(return this.up('window').down('form');)";
                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListPendingMouvement.getRowsValues({selectedOnly : true})" });
                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemMagasin", Encode = false, Mode = ParameterMode.Value, Value = ViewData["MagasinID"].ToString() });
                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemEmplacement", Encode = false, Mode = ParameterMode.Raw, Value = "App.cmbMouvementEmplacement.value" });
                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemEmplacementText", Encode = false, Mode = ParameterMode.Raw, Value = "App.cmbMouvementEmplacement.rawValue" });
                    de.Click.EventMask.ShowMask = true;
                }
            ),
        X.Button()
            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
            .Handler("App.Mouvement_SelectEmplacement.doClose()")
            .Cls("btncancel")
