@model Tms.Classes.Business.stock.FicheLotCertifieViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style type="text/css">
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 100px !important;
    }
</style>
<script type="text/javascript">
    var SampleIconRender = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = OverviewSheet.getIcons(value);

        return Ext.String.format(tpl, icon_url);
    };

    var OverviewSheet =
    {
        SetButtons: function () {

            if (App.rowLivraison.hasSelection()) {
                App.BtnRemoveDelivery.enable();                

            } else {
                App.BtnRemoveDelivery.disable();

            }
        },
        getIcons: function (value) {
            console.log(value);
            if (value === 4) {
                return 'glyphicon-file green';
            }
            else {
                return 'glyphicon-file blue';
            }
        }
    };


</script>
@(
    X.Window()
        .ID("FormFicheLotCertifie")
        .Width(540)
        .Resizable(false)
        .Height(490)
        .Modal(true)
        .CloseAction(Ext.Net.CloseAction.Destroy)
        .Y(20)
        .Title("Fiche de lot Certifié : Nouveau")
        //.Layout(LayoutType.Form)
        .Items(
                X.FormPanel()
                    .FieldDefaults(d => d.ReadOnly = (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult) || (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve) ? true : false)
                    .Layout(LayoutType.VBox)
                    .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch })
                    .Items(
                            X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                            X.Hidden().ID("TxtFicheID").Value(Model._FicheLotCertifie.ID),
                            X.Hidden().ID("hiddenRowversion").Value(Model._FicheLotCertifie.RowVersionKey),
                            X.Panel()
                                .Layout(LayoutType.Form)
                                .MarginSpec("5 20")
                                .Items(
                                            X.TextField()
                                                .ID("txtNumeroEchantillon")
                                                .FieldLabel("Fiche N°")
                                                .LabelAlign(LabelAlign.Right)
                                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FicheLotCertifie.Numero : string.Empty)
                                                .ReadOnly(true),
                                            //.AllowBlank(false)
                                            //.IndicatorIconCls("IndicatorRedStar")
                                            //.IndicatorText("*")
                                            //.Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.Numero.ToString() : string.Empty)

                                            X.ComboBox()
                                                .ID("cmbCampagne")
                                                .FieldLabel("Campagne")
                                                .DisplayField("Designation")
                                                .AllowBlank(false)
                                                .IndicatorCls("IndicatorRedStar")
                                                .IndicatorText("*")
                                                .ValueField("Designation")
                                                .QueryMode(DataLoadMode.Local)
                                                .TriggerAction(TriggerAction.All)
                                                .LabelAlign(LabelAlign.Right)
                                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FicheLotCertifie.Campagne.Designation : Model._DefaultCampagne)
                                                .Store
                                                (
                                                    X.Store()
                                                        .AutoLoad(true)
                                                        .Model
                                                        (
                                                            Html.X().Model()
                                                                .IDProperty("Designation")
                                                                .Fields
                                                                (
                                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" },
                                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                                )
                                                            )
                                                        .Proxy
                                                        (
                                                            X.AjaxProxy().Url(Url.Action("LoadCampagne", "Campagne"))
                                                                .Reader(Html.X().JsonReader().RootProperty("data"))
                                                        )
                                                ),
                                               X.ComboBox()
                                                     .ID("cmbCertification")
                                                     .EmptyText("")
                                                     .TabIndex(3)
                                                     .ForceSelection(true)
                                                     .TypeAhead(true)
                                                     .QueryMode(DataLoadMode.Local)
                                                     .TriggerAction(TriggerAction.All)
                                                     .AllowBlank(false)
                                                     .IndicatorCls("IndicatorRedStar")
                                                     .IndicatorText("*")
                                                     .FieldLabel("Certification")
                                                     .DisplayField("Designation")
                                                     //.MatchFieldWidth(false)
                                                     .ListConfig(new BoundList { MinWidth = 300 })
                                                     .ValueField("ID")
                                                     .LabelAlign(LabelAlign.Right)
                                                     .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FicheLotCertifie.Certification.ID : (int?)null)
                                                     .Store
                                                     (
                                                        X.Store()
                                                        .AutoLoad(true)
                                                        .Model
                                                        (
                                                             Html.X().Model()
                                                            .IDProperty("ID")
                                                            .Fields
                                                            (
                                                              new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                              new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                            )
                                                         )
                                                        .Proxy
                                                        (
                                                           Html.X().AjaxProxy()
                                                           .Url(Url.Action("LoadCertification", "Certification"))
                                                           .Reader(Html.X().JsonReader().RootProperty("data"))
                                                        )
                                                        .Listeners(
                                                            ls => {
                                                                if (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew || Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Update)
                                                                {
                                                                    ls.Load.Handler = "if (App.cmbCertification.value){App.BtnAddDelivery.enable(); } ;";
                                                                }
                                                                
                                                            }
                                                        )
                                                )
                                                .Listeners(ls => {
                                                    ls.Select.Handler = "App.BtnAddDelivery.enable();";
                                                }),
                                            X.DateField()
                                                .ID("txtDateFiche")
                                                .LabelAlign(LabelAlign.Right)
                                                .FieldLabel("Date Fiche")
                                                .AllowBlank(false)
                                                .IndicatorIconCls("IndicatorRedStar")
                                                .IndicatorText("*")
                                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FicheLotCertifie.DateFiche.ToString() : DateTime.Now.ToString())


                                    ),
                                    X.GridPanel()
                                       .Layout(LayoutType.Fit)
                                       .ID("grpListeSelectedLivraisons")
                                       .Region(Region.Center)
                                       .ForceFit(true)
                                       .Margin(5)
                                       .Border(true)
                                       //.Disabled((Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve) || (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult) ? true : false)
                                       .Height(250)
                                       .AllowDeselect(true)
                                       .Store(
                                                X.StoreFor<Tms.Classes.Business.stock.FicheLotCertifieLivraison>()
                                                    .ID("storeListeSelectedLivraisons")
                                                    .AutoLoad(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? true : false)
                                                    .Proxy(
                                                           Html.X().AjaxProxy()
                                                           .Url(Url.Action("GetDeliveries"))
                                                           .Reader(
                                                                    Html.X().JsonReader().RootProperty("data")
                                                                    )
                                                      )
                                                    .Parameters(ps =>
                                                    {
                                                        ps.Add(new StoreParameter("ItemFiche", Model._FicheLotCertifie.ID.ToString(), ParameterMode.Value));
                                                    })
                                        )
                                        .ColumnModel
                                        (
                                            Html.X().Column().Text("").DataIndex("mIcon").Renderer("SampleIconRender").Hideable(false).Width(40).Filterable(false),
                                            Html.X().Column().Text("Date Livraison").DataIndex("DateLivraisonAstring").Flex(1).Hideable(false),
                                            Html.X().Column().Text("Note N°").DataIndex("NoteNumero").Flex(1).Hideable(false),
                                            X.Column().Text("Nbr de sacs").DataIndex("NombreSacsProduction").Flex(1).Hideable(false),
                                            //Html.X().Column().Text("Fournisseur").DataIndex("FournisseurNom").Flex(2).Hideable(false),
                                            Html.X().Column().Text("N° Livraison").DataIndex("LivraisonID").Flex(1).Hideable(false)
                                        )
                                        .DockedItems(
                                            X.Toolbar()
                                                .Dock(Dock.Top)
                                                .Items(
                                                            X.Label().Text("Livraison(s)"),
                                                            X.ToolbarSpacer(15),
                                                            X.Button()
                                                                .ID("BtnAddDelivery")
                                                                .IconCls("action_new_02")
                                                                .Border(false)
                                                                .Cls("ButtonStyle")
                                                                .Text("Ajouter")
                                                                //.Disable(false)
                                                                //.Disabled(true)
                                                                .Disabled((Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve) || (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult) ? true : false)
                                                                .DirectEvents(de =>
                                                                {
                                                                    de.Click.Url = Url.Action("OnSelectDelivery");
                                                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemCertification", Encode = false, Mode = ParameterMode.Raw, Value = "App.cmbCertification.getValue()" });
                                                                    de.Click.EventMask.ShowMask = true;
                                                                }),
                                                            X.Button()
                                                                .ID("BtnRemoveDelivery")
                                                                .Icon(Icon.Delete)
                                                                .Border(false)
                                                                .Cls("ButtonStyle")
                                                                .Text("Retirer")
                                                                .Disabled(true)
                                                                .DirectEvents(de =>
                                                                {
                                                                    de.Click.Url = Url.Action("RemoveDelivery");
                                                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeSelectedLivraisons}.getSelectionModel().getSelection()[0].data" });
                                                                    //de.Click.ExtraParams.Add(new Parameter { Name = "storeListeDelivery", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListeCodeOverview.getRowsValues({selectedOnly : false})" });
                                                                    de.Click.EventMask.ShowMask = true;
                                                                    de.Click.Confirmation.ConfirmRequest = true;
                                                                    de.Click.Confirmation.BeforeConfirm = "config.confirmation.title = 'Fiche de lot Certifié : Retirer'; config.confirmation.message = 'Voulez-vous retirer cette livraison ? ';";
                                                                })
                                                        )
                                        )
                                        .SelectionModel(
                                                        X.RowSelectionModel()
                                                            .ID("rowLivraison")
                                                            .Mode(SelectionMode.Single)
                                                            .AllowDeselect(true)
                                            )
                                        .Listeners(l =>
                                        {
                                            if (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew || Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Update)
                                            {
                                                l.Select.Fn = "OverviewSheet.SetButtons";
                                                l.Deselect.Fn = "OverviewSheet.SetButtons";
                                            }
                                        }
                                    )

                )


            )
            .Buttons(
                        X.Button().Text("OK")
                            .ID("BtnSaveCode")
                            .Hidden((Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve) || (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult) ? true : false)
                            .DirectEvents(de =>
                            {
                                de.Click.Url = Url.Action("SubmitFormMethod");
                                //de.Click.Success = "ShowNotifaction();";
                                de.Click.Before = "return validNew(App.FormFicheLotCertifie.id);";
                                de.Click.FormID = "#(return this.up('window').down('form');)";
                                de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListeSelectedLivraisons.getRowsValues({selectedOnly : false})" });
                            }),
                        X.Button().Text(DigitalCoops.Cocoa.Properties.Resources.BtnApprove)
                            .ID("")
                            .Hidden(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Approve ? true : false)
                            .DirectEvents(de =>
                            {
                                de.Click.Url = Url.Action("ApproveLot");
                                de.Click.Before = "return validNew(App.FormFicheLotCertifie.id);";
                                de.Click.FormID = "#(return this.up('window').down('form');)";
                            }),
                        X.Button()
                            .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                            .Handler("App.FormFicheLotCertifie.doClose()").Cls("btncancel")

                    )


)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
                    /*alert(winId);*/
                    /*var winId = #{FormFournisseur}.id;*/
                    var areAllrequiredFieldsFilled = isFormValid(winId);

                    /*
                   *   Vérification de la saisie des champs obligatoires
                   */
                    if (!areAllrequiredFieldsFilled) {
                        console.log('error fields');
                        Ext.Msg.show({ title: 'Fiche de lot Certifié : Data Validation ', buttons: Ext.Msg.OK });
                        return false;
                    }

                }

        /*Ext.onReady(function() {
         #{BtnOk}.on(#{BtnOk}.clickEvent,validNew );
        //})*/
</script>
<script type="text/javascript" language="javascript">
    var enterKeyPressHandler = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            /*Ext.net.DirectMethod.request({ url: "/DeliveryCoding/SelectDeliveryInfo"});*/
            App.BtnSearchDeliveryInfo.fireEvent('click', App.BtnSearchDeliveryInfo);
            e.stopEvent();
        }
    };
    
</script>


