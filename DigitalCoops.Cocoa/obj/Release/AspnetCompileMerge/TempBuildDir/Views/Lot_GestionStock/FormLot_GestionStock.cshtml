@model Tms.Classes.Business.stock.Lot_GestionStockViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 140px !important;
    }

    .x-form-text-default.x-form-textarea {
        line-height: 17px;
        min-height: 50px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>

@(
X.Window()
    .ID("FormLot_GestionStock")
    .Width(750)
    .Resizable(false)
    .Height(340)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    //.X(400)
    .Y(20)
    .Title("Lot_GestionStock : Detail")
    .Items
    (
        X.FormPanel()
            .Layout(LayoutType.HBox)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
            .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .Items(
    #region zone A
                    X.Container()
                        .Layout(LayoutType.Form)
                        .Flex(1)
                        .Items
                        (
                            X.Hidden().ID("hiddenExecMode").ReadOnly(true).Value(Model._ExecMode),
                            //X.Hidden().ID("hiddenProduit").ReadOnly(true).Value(Model._DefaultProduit),
                            X.Hidden().ID("TxtLot_GestionStockId").ReadOnly(true).Value(Model._Lot_GestionStock.ID),
                            //X.Hidden().ID("txtOrdreProductionID").Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew && Model._Lot_GestionStock.Production != null ? Model._Lot_GestionStock.Production.ID : (Guid?)null),
                            X.ComboBox()
                                .ID("cmbCampagne")
                                .TabIndex(1)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .FieldLabel("Campagne")
                                .DisplayField("Designation")
                                .ValueField("Designation")
                                .QueryMode(DataLoadMode.Local)
                                .TriggerAction(TriggerAction.All)
                                .LabelAlign(LabelAlign.Right)
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.Campagne.Designation : Model._DefaultCampagne)
                                .Store
                                (
                                    X.Store()
                                        .AutoLoad(true)
                                        .Model
                                        (
                                            Html.X().Model()
                                            .IDProperty("Designation")
                                            .Fields
                                            (
                                                new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                            )
                                        )
                                        .Proxy
                                        (
                                            Html.X().AjaxProxy()
                                            .Url(Url.Action("LoadCampagne", "Campagne"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )
                                ),
                            X.ComboBox()
                                .ID("cmbExportateur")
                                .TabIndex(2)
                                .QueryMode(DataLoadMode.Local)
                                .TriggerAction(TriggerAction.All)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .FieldLabel("Exportateur")
                                .DisplayField("Nom")
                                .ValueField("ID")
                                .LabelAlign(LabelAlign.Right)
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.Exportateur.ID : (int?)null)
                                .Store
                                (
                                    X.Store()
                                        .AutoLoad(true)
                                        .Model
                                        (
                                            X.Model()
                                                .IDProperty("ID")
                                                .Fields
                                                (
                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                    new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                                )
                                        )
                                        .Proxy
                                        (
                                            Html.X().AjaxProxy()
                                            .Url(Url.Action("LoadExportateurActive", "Exportateur"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )
                                //.Listeners(
                                //    ls => ls.Load.Handler = "if (App.cmbProduit.value){ DefinirZonesObligatoires(App.cmbProduit.getSelectedRecord().data);};"
                                //)
                                ),
                            X.ComboBox()
                                .ID("cmbProduit")
                                .TabIndex(2)
                                .QueryMode(DataLoadMode.Local)
                                .TriggerAction(TriggerAction.All)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .FieldLabel("Produit")
                                .DisplayField("Designation")
                                .ValueField("ID")
                                .LabelAlign(LabelAlign.Right)
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.Produit.ID : (int?)null)
                                .Store
                                (
                                    X.Store()
                                        .AutoLoad(true)
                                        .Model
                                        (
                                            X.Model()
                                                .IDProperty("ID")
                                                .Fields
                                                (
                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                )
                                        )
                                        .Proxy
                                        (
                                            Html.X().AjaxProxy()
                                            .Url(Url.Action("LoadProduit", "Produit"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )
                                //.Listeners(
                                //    ls => ls.Load.Handler = "if (App.cmbProduit.value){ DefinirZonesObligatoires(App.cmbProduit.getSelectedRecord().data);};"
                                //)
                                ),
                            X.ComboBox()
                                  .ID("cmbMagasin")
                                  .FieldLabel("Magasin")
                                  .DisplayField("Designation")
                                  .ValueField("ID")
                                  .TabIndex(7)
                                  .LabelAlign(LabelAlign.Right)
                                  .Value(Model._Lot_GestionStock.Magasin != null ? (int?)Model._Lot_GestionStock.Magasin.ID : (int?)null)
                                  .Store
                                  (
                                     X.Store()
                                          .AutoLoad(true)
                                          .Model
                                          (
                                            X.Model()
                                                .IDProperty("ID")
                                                .Fields
                                                (
                                                  new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                  new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                )
                                           )
                                          .Proxy
                                           (
                                             Html.X().AjaxProxy()
                                                 .Url(Url.Action("LoadMagasin", "Magasin"))
                                                 .Reader(Html.X().JsonReader().RootProperty("data"))
                                           )
                                    ),
                            X.DateField()
                                .ID("TxtDateLot")
                                .TabIndex(3)
                                .FieldLabel("Date")
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.DateLot.ToShortDateString() : DateTime.Now.ToShortDateString())
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .SubmitFormat("d/m/Y H:i:s")
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*"),
                            X.TextField()
                                .ID("TxtNumero")
                                .FieldLabel("Lot N°")
                                .TabIndex(5)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("")
                                .LabelAlign(LabelAlign.Right)
                                .Text(Model._Lot_GestionStock.NumeroLot),
                             X.ComboBox()
                                .ID("cmbTypeLot")
                                .TabIndex(6)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .FieldLabel("Type de Lot")
                                .DisplayField("Designation")
                                .ValueField("ID")
                                .DirectEvents(de =>
                                   {
                                       de.Select.Url = Url.Action("SelectInfoTypeLot");
                                       de.Select.ExtraParams.Add(new Parameter { Name = "ItemType", Mode = ParameterMode.Raw, Value = "App.cmbTypeLot.value" });

                                   })
                                .LabelAlign(LabelAlign.Right)
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.LotType.ID : (int?)null)
                                .Store
                                (
                                    X.Store()
                                        .AutoLoad(true)
                                        .Model
                                        (
                                            Html.X().Model()
                                            .IDProperty("ID")
                                            .Fields
                                            (
                                                new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                            )
                                        )
                                        .Proxy
                                        (
                                            Html.X().AjaxProxy()
                                            .Url(Url.Action("LoadActiveLotType", "LotType"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )
                                ),
                            X.Checkbox()
                                .ID("ChkEstReusine")
                                .FieldLabel("Re-Usinage")
                                .TabIndex(13)
                                .Hidden(true)
                                .Checked(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.EstReusine : false)
                                .LabelAlign(LabelAlign.Right)
                                .Listeners(
                                    ls =>
                                    {
                                        ls.Change.Fn = "SetNumberLot_GestionStockField";
                                        ls.AfterRender.Fn = "SetNumberLot_GestionStockField";
                                    }
                                ),
                            X.Checkbox()
                                .ID("ChkEstQueue")
                                .FieldLabel("Queue de Lot")
                                .TabIndex(13)
                                .Checked(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.EstQueue : false)
                                .LabelAlign(LabelAlign.Right)
                            ),
    #endregion
                    X.Panel()
                        .Layout(LayoutType.Form)
                        .Flex(1)
                        .Items
                        (
                            X.TextField()
                                .ID("txtNombreSacs")
                                .FieldLabel("Nbr de Sacs")
                                .HideTrigger(true)
                                .TabIndex(8)
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .MaskRe("[0123456789]")
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.NombreSacsAsString : string.Empty)
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtNombreSacs}.setValue(formatNumber(#{txtNombreSacs}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtNombreSacs.value) { #{txtNombreSacs}.setRawValue(unformatNumber(#{txtNombreSacs}.getValue()));}";
                                }),

                            X.TextField()
                                .ID("txtNombrePalette")
                                .FieldLabel("Nbr de Palette")
                                .HideTrigger(true)
                                .TabIndex(8)
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .MaskRe("[0123456789]")
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.NombrePaletteAsString : string.Empty)
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtNombrePalette}.setValue(formatNumber(#{txtNombrePalette}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtNombrePalette.value) { #{txtNombrePalette}.setRawValue(unformatNumber(#{txtNombrePalette}.getValue()));}";
                                }),
                             X.TextField()
                                .ID("txtPoidsBrut")
                                .FieldLabel("Poids Brut")
                                .TabIndex(9)
                                .MaskRe("[0123456789]")
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.PoidsBrutAsString : string.Empty)
                                .Listeners(ls =>
                                {
                                    //ls.Blur.Handler = "#{txtPoidsBrut}.setValue(formatNumber(#{txtPoidsBrut}.getValue()));";
                                    //ls.Focus.Handler = "if (App.txtPoidsBrut.value) { #{txtPoidsBrut}.setRawValue(unformatNumber(#{txtPoidsBrut}.getValue()));}";
                                    ls.Change.Handler = "calculerNetLivre();";
                                }),

                             X.TextField()
                                .ID("txtTareSacs")
                                .TabIndex(10)
                                .MaskRe("[0123456789]")
                                .FieldLabel("Tare des sacs")
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.TareSacsAsString : string.Empty)
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtTareSacs}.setValue(formatNumber(#{txtTareSacs}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtTareSacs.value) { #{txtTareSacs}.setRawValue(unformatNumber(#{txtTareSacs}.getValue()));}";
                                    ls.Change.Handler = "calculerNetLivre();";
                                }),


                            X.TextField()
                                .ID("txtTarePalette")
                                .TabIndex(11)
                                .MaskRe("[0123456789]")
                                .FieldLabel("Tare des palettes")
                                .LabelAlign(LabelAlign.Right)
                                .IndicatorCls("IndicatorRedStar")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.TarePaletteAsString : string.Empty)
                                .IndicatorText("*")
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtTarePalette}.setValue(formatNumber(#{txtTarePalette}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtTarePalette.value) { #{txtTarePalette}.setRawValue(unformatNumber(#{txtTarePalette}.getValue()));}";
                                    ls.Change.Handler = "calculerNetLivre();";
                                }),
                            X.TextField()
                                .ID("txtPoidsNet")
                                .HideTrigger(true)
                                .TabIndex(12)
                                .ReadOnly(true)
                                .MaskRe("[0123456789]")
                                .FieldLabel("Poids Net")
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Lot_GestionStock.PoidsNetAsString.ToString() : string.Empty)
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtPoidsNet}.setValue(formatNumber(#{txtPoidsNet}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtPoidsNet.value) { #{txtPoidsNet}.setRawValue(unformatNumber(#{txtPoidsNet}.getValue()));}";
                                    //ls.Change.Handler = "calculerNetAccepte()";
                                })

                             )
            )
    )
    .Buttons
    (
        X.Button()
            .Text("OK")
            .ID("BtnOk")
            .TabIndex(14)
            .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult || Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve ? true : false)
            .DirectEvents
            (
                de =>
                {
                    de.Click.Url = Url.Action("UpdateFormMethod");
                    de.Click.FormID = "#(return this.up('window').down('form');)";
                    de.Click.Before = "return validNew(App.FormLot_GestionStock.id);";
                }
            ),
        X.Button()
            .TabIndex(15)
            .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
            .Handler("App.FormLot_GestionStock.doClose()")
            .Cls("btncancel")
    )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Production - Lot_GestionStock : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

       /* if (App.cmbTypeLot_GestionStock.value) {
            var AutNombreSacs = App.cmbTypeLot_GestionStock.getSelectedRecord().data.NombreSacs;
            var NombreSacLot_GestionStock = App.txtNombreSacs.value || 0;
            if (NombreSacLot_GestionStock > AutNombreSacs) {
                Ext.Msg.show({ title: 'Production - Lot_GestionStock : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Nbr de sacs added is higher than authorized Nbr de sacs for the Selected Type of Lot_GestionStock !', buttons: Ext.Msg.OK });
                return false;
            }
        }*/


    };


    var calculerNetLivre = function () {
        var tareBags = parseInt(unformatNumber(App.txtTareSacs.value), 10) || 0;
        var tarePallets = parseInt(unformatNumber(App.txtTarePalette.value), 10) || 0;
        var poidsbrut = parseInt(unformatNumber(App.txtPoidsBrut.value), 10) || 0;
        var poidsnet = poidsbrut - tareBags - tarePallets;

        poidsnet = formatNumber(poidsnet);
        App.txtPoidsNet.setValue(poidsnet);

    };

    var setCtrlIsRequired = function (field, value) {
        field.allowBlank = !value;

        field.setIndicator("");
        field.setIndicatorCls('');
        field.showIndicator();

        if (value == true) {

            field.setIndicator("*");
            field.setIndicatorCls('IndicatorRedStar');
            field.showIndicator();
        }
    };

