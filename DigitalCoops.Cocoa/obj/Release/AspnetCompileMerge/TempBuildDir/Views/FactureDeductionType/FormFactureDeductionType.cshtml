
@model Tms.Classes.Shared.FactureDeductionTypeViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
@(X.FormPanel()
        .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
        .Items(
                X.Window()
                .ID("FormFactureDeductionType")
                .Width(500)
                .Resizable(false)
                .Height(200)
                .CloseAction(Ext.Net.CloseAction.Destroy)
                .Listeners(l =>
                {
                    l.Close.Handler = "App.TmsViewPort.unmask();";
                })
                //.X(400)
                .Y(20)
                .Title("Type De Deduction Facture : Detail")
                .Layout(LayoutType.VBox)
                .BodyPadding(6)
                .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
                    .Items(
                            X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                            X.Hidden().ID("hiddenRowversion").Value(Model._FactureDeductionType.RowVersionKey),
                            X.Hidden().ID("TxtFactureDeductionTypeID").Value(Model._FactureDeductionType.ID),
                            X.TextField().ID("TxtDesignationFactureDeductionType").FieldLabel("Designation")
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FactureDeductionType.Designation.ToString() : string.Empty)
                                .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*"),
                            X.Checkbox().ID("ChkIsAutoFactureDeductionType").FieldLabel("Is Auto")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FactureDeductionType.Auto : false)
                                .LabelAlign(LabelAlign.Right),
                            X.NumberField()
                                .ID("TxtTauxDeduction")
                                .FieldLabel("Taux")
                                .AllowDecimals(true)
                                .MinValue(0)
                                .HideTrigger(true)
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FactureDeductionType.Taux: (decimal?)null)
                                .LabelAlign(LabelAlign.Right)                                                          
                    )
            .Buttons(
                X.Button().Text("OK")
                .ID("BtnSubmitFactureDeductionType")
                .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                .DirectEvents(de =>
                {
                    de.Click.Url = Url.Action("SubmitFormMethod");
                    de.Click.Before = "return validNew(App.FormFactureDeductionType.id);";
                })

                    ,
                X.Button()
                .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                .Handler("App.FormFactureDeductionType.doClose()").Cls("btncancel")

                )

            )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Type De Deduction Facture : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }


    };


</script>











