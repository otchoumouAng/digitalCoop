                            .Html(String.Format("<p style='width: 100%;text-align: center;padding-bottom: 10px; padding-top:3px;font-size: 14px;position: absolute;top: 0;font-weight: normal; background-color:#607D8B;color:white;'>Server : {0} | Database: {1} | Version : 1.0.0 | Business Tech &copy; {2} </p>", (new Tms.Components.Data.DataConfig().Server), new Tms.Components.Data.DataConfig().DataBase, DateTime.Now.Year))
