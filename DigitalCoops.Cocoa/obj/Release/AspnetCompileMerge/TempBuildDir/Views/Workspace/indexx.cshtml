                            .Items(i =>
                            {
                                //List<Module> mItems = Module.GetAll();
                                List<Module> mItems = Module.GetItemsForUser(ViewBag.UserID, -1, -1);

                                foreach (var mItem in mItems)
                                {

                                    var e = Html.X().MenuPanel()
                                        .Title(mItem.Title)
                                        .SaveSelection(false);

                                    foreach (var item in mItem.Items)
                                    {
                                        var menuItem = new Ext.Net.MenuItem
                                        {
                                            Text = item.Title,

                                            IconCls = "glyphicon glyphicon-play-circle  #7f7f7f"
                                            //Icon = Icon.ApplicationFormAdd
                                        };

                                        menuItem.Listeners.Click.Handler = string.Format("addTab(window.parent.Ext.getCmp('tabCenter'), '{0}', '{1}', this, '{2}', 'overview');", item.ID.ToString(), item.Url, item.Title);

                                        e.Menu(m =>
                                        {
                                            m.Add(menuItem);
                                            //m.Listeners.Click.Handler = string.Format("addTab(window.parent.Ext.getCmp('tabCenter'), 'id{0}', '{1}', this, '{2}');", item.Title + item.ID.ToString(), item.Url, item.Title);
                                        });
                                    }
                                    i.Add(e);
                                }

