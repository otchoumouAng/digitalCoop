                                l.Add(new MessageBusListener { Name = "Msg.DisplayReport", Fn = "displayReport" });
                            })

                .Items(
                         X.Panel()
                        .ID("tabMenuItems")
                        .Title("Menu")
                        .Closable(false)
                        .Border(false)
                        .BodyStyle("background: #FAFAFA;")
                        .BodyPadding(6)
                        .Loader(
                        X.ComponentLoader()
                        .Url(Url.Action("RenderPartialMenuItems"))
                        .Mode(LoadMode.Frame)
