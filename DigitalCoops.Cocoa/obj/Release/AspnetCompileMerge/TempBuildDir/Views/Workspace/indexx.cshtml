            var displayReport = function () {

                var selectId = data.selectId;
                var rptId = data.reportId;
                addTab(window.parent.Ext.getCmp('tabCenter'), selectId, 'Fournisseur/Index', this, rptId);
            };


            function logOff() {
                var urlR = $('input#base_url_index').val() + '/Workspace/LogOut';
                $.ajax({
                    'url': urlR,
                    'content-type': 'application/html; charset=utf-8',
                    'type': 'GET',
                    'dataType': 'html'
                })
                        .success(function (result) {
                            var urlL = $('input#base_url_index').val() + '/login';
                            parent.window.location = urlL;

                        })
                        .error(function (xhr, status) {

                            console.log(xhr);
                        })
            };
    </script>





