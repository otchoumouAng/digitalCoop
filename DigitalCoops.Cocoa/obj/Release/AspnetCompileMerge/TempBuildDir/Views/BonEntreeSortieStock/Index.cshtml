<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeBordereauxES.columnManager.getColumns(), App.grpListeBordereauxES.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
            else if (value == 3) {
                return 'action_new_03';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 'N') {
                return 'glyphicon-remove red';
            }
            else if (value === 'E') {
                return 'glyphicon-arrow-right green';
            }
            else if (value == 'S') {
                return 'glyphicon-arrow-left green';
            }
            else if (value == '3') {
                return 'glyphicon-ban-circle red';
            }
        },

        SummaryBL: function () {
            var nbrOfrows = App.grpListeBordereauxES.getStore().getCount();
            var totalNetAccepte = App.storeListeBordereauxES.sum('PoidsNetAccepte') || 0;
            var totalNetLivre = App.storeListeBordereauxES.sum('PoidsLivre') || 0;
            var totalQuantite = App.storeListeBordereauxES.sum('Quantite') || 0;
            var totalPoidsBrut = App.storeListeBordereauxES.sum('PoidsBrut') || 0;

            totalNetAccepte = FormatAmount(totalNetAccepte);
            totalNetLivre = FormatAmount(totalNetLivre);
            totalQuantite = FormatAmount(totalQuantite);
            totalPoidsBrut = FormatAmount(totalPoidsBrut);
            App.lblSummaryBL.setHtml("Nbr : " + nbrOfrows + "<br/>Total Quantité : " + totalQuantite + "<br/>Total Poids Brut : " + totalPoidsBrut + "<br/>Total Livré Poids Net : " + totalNetLivre + "<br/>Total Poids Net Accepté : " + totalNetAccepte);            
        },

        resetButtons: function () {

            App.btnModify.disable();
            App.btnCancel.disable();
            App.mnuPrintDeliveryNote.disable();

            if (App.rowBordereauES.hasSelection()) {

                var isActive = App.rowBordereauES.selected.items[0].data.IsActive;

                if (isActive === true) {

                    /*if (App.BlhiddenPermOverview.value == 'true')
                        App.btnModify.enable();*/

                    if (App.BlhiddenPermDesactiver.value == 'true')
                        App.btnCancel.enable();

                    if (App.BlhiddenPermPrintCopyOfDeliveryNote.value == 'true')
                        App.mnuPrintDeliveryNote.enable();
                }

                else {
                    App.btnModify.disable();
                    App.btnCancel.disable();
                }

            }
        }
    }

</script>

