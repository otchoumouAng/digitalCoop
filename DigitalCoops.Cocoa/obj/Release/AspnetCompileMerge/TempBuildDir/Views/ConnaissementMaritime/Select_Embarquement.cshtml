                            .LabelAlign(LabelAlign.Right)
                            //.Width(400)
                            .Value(Model.Designation)
                            .Store
                            (
                                X.Store()
                                    .AutoLoad(true)
                                    .Model
                                    (
                                        X.Model()
                                            .IDProperty("Designation")
                                            .Fields
                                            (
                                                new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                            )
                                    )
                                    .Proxy
                                    (
                                        X.AjaxProxy()
                                            .Url(Url.Action("LoadCampagneAll", "Campagne"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                    )
                            )
                    ),
                X.Panel()
                    .Border(false)                    
                    .Flex(2)
                    .Layout(LayoutType.Form)
                    //.BodyPadding(0)
                    .Items
                    (
                        X.DateField().ID("dtpStartDateFD").FieldLabel("Debut").LabelAlign(LabelAlign.Right).Value(Model.DateDebut),
                        X.DateField().ID("dtpEndDateFD").FieldLabel("Fin").LabelAlign(LabelAlign.Right).Value(Model.DateFin)

                    ),
 X.Panel()
        .ID("forerview")
        .Flex(3)
        .Border(false)
        .Layout(LayoutType.HBox)
        .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
        .Items(
                X.Container()
                    .ID("")
                    .Layout(LayoutType.VBox)
                    //.Flex(2)
                    .LayoutConfig(new VBoxLayoutConfig {Align = VBoxAlign.Center, Pack = BoxPack.Center })
                    .Items(
                            X.Label()
                                .ID("LblResumeAvlbShipments")
                                .Text("")
                                .EmptyText("")
                                )
                    )
                )
             ),

        //X.Hidden()
        // .ID("TxtExecMode")
        // .Value(Model._ExecMode)
        // ,
        X.GridPanel()
            .Layout(LayoutType.Fit)
            .ID("grpListShipment")
            .Height(300)
            //.Border(true)
            .Frame(true)
            .FrameHeader(false)
            .AllowDeselect(true)
            .Store
            (
                X.StoreFor<Tms.Classes.Business.Sales.Embarquement>()
                    .ID("storeListShipment")
                    .AutoLoad(true)
                    .Proxy
                    (
                        X.AjaxProxy()
                            .Url(Url.Action("LoadListOfAvailableShipments"))
                            .Reader(Html.X().JsonReader().RootProperty("data"))
                    )
                    .Listeners(
                        ls => ls.Load.Handler = "SetAvailableShipmentsInfos();"
                        )
                    .Parameters
                    (
                               ps =>
                               {
                                   ps.Add(new StoreParameter("ItemExportateur", "#{cmbExportateurFD}.getValue()", ParameterMode.Raw));
                                   ps.Add(new StoreParameter("ItemCampagne", "#{cmbCropYearFD}.getValue()", ParameterMode.Raw));
                                   ps.Add(new StoreParameter("ItemPeriodStart", "#{dtpStartDateFD}.getRawValue()", ParameterMode.Raw));
                                   ps.Add(new StoreParameter("ItemPeriodEnd", "#{dtpEndDateFD}.getRawValue()", ParameterMode.Raw));
