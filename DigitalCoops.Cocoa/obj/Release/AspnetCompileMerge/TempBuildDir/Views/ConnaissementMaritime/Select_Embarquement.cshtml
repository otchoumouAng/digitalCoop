@*@model Tms.Classes.Business.Sales.EmbarquementViewModel*@
@model Tms.Classes.Shared.Campagne
@{
    Layout = null;
    var X = Html.X();
    //string StartDate = DateTime.Now.AddDays(-30).ToShortDateString();
    //string EndDate = DateTime.Now.ToShortDateString();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style>
    /*.x-btn-default-toolbar-small {
        padding: 2px 7px 2px 7px !important;
    }*/
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script>
    var SetAvailableShipmentsInfos = function () {
        var Qty = App.storeListShipment.sum('Quantite') || 0;

        var mChaine = Ext.String.format('Total Quantity : {0} (T)', formatNumberDecimal(Qty));
        App.LblResumeAvlbShipments.setText(mChaine);

    };
    function formatNumberDecimal(amount) {

        amount = thousands_separators(amount.toString().replace(".", ","));

        formatted = amount.toString().replace(".", ",");

        return formatted;
    };

    function unformatNumberDecimal(amount) {
        formatted = amount.toString().replace(" ", "");

        return formatted;
    };

    function thousands_separators(num) {
        var num_parts = num.toString().split(".");
        num_parts[0] = num_parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, " ");
        return num_parts.join(".");
    };

    var SetBtnOK = function () {
        if (App.rowSelectionListShipment.hasSelection())
            App.BtnSendShipment.enable();
        else
            App.BtnSendShipment.disable();
    };
</script>
@(

X.Window()
    .ID("ListOfShipments")
    .Width(1200)
    .Resizable(false)
    .Height(470)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Y(20)
    .BodyPadding(5)
    .Title("List of Shipments")
    .Layout(LayoutType.Form)
    .Items
    (

        X.FormPanel()
            .ID("CriteriaPanelShi")
            .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "BL - Shipments", Height = 30 })
            .Region(Region.North)
            //.Border(true)
            .Collapsed(false)
            .Collapsible(true)
            .BodyPadding(0)
            .MarginSpec("0 0 5 0")
            .Frame(true)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Start })
            .HeaderConfig(new PanelHeader
            {
                Items = {
                    X.Button()
                        .ID("btnRefreshShipment")
                        .IconCls("action_refresh_01")
                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                        .Border(false)
                        .Disable(false)
                        .DirectEvents
                        (
                            de =>
                            {
                                de.Click.Url  = Url.Action("OnRefreshForAvailableShipments");
                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemExportateur", Encode=true, Value= "#{cmbExportateurFD}.getValue()", Mode=ParameterMode.Raw});
                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemCampagne", Encode=true, Value= "#{cmbCropYearFD}.getValue()", Mode=ParameterMode.Raw});
                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodStart", Value= "#{dtpStartDateFD}.getRawValue()",   Mode=ParameterMode.Raw});
                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodEnd", Value= "#{dtpEndDateFD}.getRawValue()",     Mode=ParameterMode.Raw});
                                //de.Click.Success = "App.CriteriaPanelShi.setTitle('Exportateur = ' + App.cmbExportateurFD.rawValue + ' , du  '+ App.dtpStartDateFD.rawValue  + ' au  '+ App.dtpEndDateFD.rawValue )";
                                de.Click.Success = "App.CriteriaPanelShi.setTitle('Exportateur = ' + App.cmbExportateurFD.rawValue )";
                                de.Click.EventMask.ShowMask = true;
                            }
                        )
                }
            }
    )
    .Height(150)
    .Items
