                    Html.X().Column().Text("N° Contract").DataIndex("ContratAsString").Flex(2).Hideable(false),
                    Html.X().Column().Text("Destination").DataIndex("DestinationExportAsString").Flex(2),
                    Html.X().DateColumn().Text("Periode").DataIndex("PeriodeEmbarquement").Format("m/Y").Flex(1),
                    Html.X().Column().Text("Quantity (T)").DataIndex("QuantiteAsString").Flex(2)
                // Html.X().Column().Text("Statut").DataIndex("StatutAsSTring").Flex(2)
                )
                .SelectionModel(X.RowSelectionModel().ID("rowSelectionListShipment").Mode(SelectionMode.Single)
                .Listeners(l =>
