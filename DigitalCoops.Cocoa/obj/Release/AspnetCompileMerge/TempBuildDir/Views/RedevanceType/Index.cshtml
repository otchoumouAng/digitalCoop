<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript">
    var GetNbrStoreRows = function () {
        var nbr = App.grpListeRedevanceType.getRowsValues().length;
        App.LblResumeRedevanceType.setText(nbr + ' Fee Type(s)');        
    };

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeRedevanceType.columnManager.getColumns(), App.grpListeRedevanceType.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var SetCriteriaTitle = function (status, deduction) {

        App.RedevanceTypeCriteriaPanel.title = "";
        var texttitle = "";

        if (status) texttitle += "Show only active Type : YES ";
        else texttitle += "Show only active Type : NO ";

        if (deduction) texttitle += " | Show only auto deduction : YES ";
        else texttitle += " | Show only auto deduction : NO ";

        App.RedevanceTypeCriteriaPanel.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            if (App.rowSelectionRedevanceType.hasSelection()) {
                if (App.RthiddenPermModifier.value == 'true')
                    App.btnModifyRedevanceType.enable();

                if (App.RthiddenPermDesactiver.value == 'true')
                    App.mnuCancelRedevanceType.enable();

                var isDisabled = App.rowSelectionRedevanceType.selected.items[0].data.Desactive;

                if (isDisabled === true) {
                    if (App.RthiddenPermActiver.value == 'true')
                        App.mnuCancelRedevanceType.enable();

                    App.btnModifyRedevanceType.disable();
                    App.mnuCancelRedevanceType.setText('Activer');
                    App.mnuCancelRedevanceType.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.RthiddenPermModifier.value == 'true')
                        App.btnModifyRedevanceType.enable();

                    App.mnuCancelRedevanceType.setText('Desactiver');
                    App.mnuCancelRedevanceType.setIconCls('glyphicon glyphicon-remove red');
                }

            } else {

                App.btnModifyRedevanceType.disable();                
                App.mnuCancelRedevanceType.disable();

            }
        }
    }


</script>


