@model Tms.Classes.Business.LivraisonViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 140px !important;
    }

    .x-form-text-default.x-form-textarea {
        line-height: 17px;
        min-height: 50px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
@(
X.Window()
    .ID("BonDeLivraison_Origine")
    .Width(400)
    .Resizable(false)
    .Height(320)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Y(20)
    .BodyPadding(5)
    .Title("Bon De Livraison : Reclassification")
    .Items
    (
        X.FormPanel()
            .Layout(LayoutType.VBox)
            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
            .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .Items(
    #region zone A                    
                    X.Hidden().ID("hiddenExecMode").ReadOnly(true).Value(Model._ExecMode),
                    X.Hidden().ID("hiddenLivraisonID").ReadOnly(true).Value(Model._Livraison.ID),
                    X.ComboBox()
                          .ID("OldOrigineID")
                          .FieldLabel("Old Origin")
                          .DisplayField("Nom")
                          .ValueField("ID")
                          .LabelAlign(LabelAlign.Right)
                          .ForceSelection(true)
                          .LabelWidth(150)
                          //.Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.NouvelleProvenance.ID : Model._Livraison.Provenance.ID)
                          .Value(Model._Livraison.NouvelleProvenance.ID)
                          .Store
                          (
                             X.Store()
                              .AutoLoad(true)
                              .Model
                              (
                                Html.X().Model()
                                .IDProperty("ID")
                                .Fields
                                (
                                  new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                  new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                )
                               )
                               .Proxy
                               (
                                 Html.X().AjaxProxy()
                                 .Url(Url.Action("LoadProvenanceByLivraisonType", "Provenance"))
                                 .Reader(Html.X().JsonReader().RootProperty("data"))
                               )
                               .Parameters(p => {
                                   p.Add(new StoreParameter("TypeLivraison", Model._Livraison.LivraisonType.ID.ToString(), ParameterMode.Value));
                                   p.Add(new StoreParameter("siteID", Model._Livraison.Site.ID.ToString(), ParameterMode.Value));
                               })
                          ),
                    X.ComboBox()
                          .ID("NewOrigineID")
                          .FieldLabel("New Origin")
                          .DisplayField("Nom")
                          .ValueField("ID")
                          .LabelAlign(LabelAlign.Right)
                          .ForceSelection(true)
                          .LabelWidth(150)
                          .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.NouvelleProvenance.ID : Model._Livraison.Provenance.ID)
                          .Store
                          (
                             X.Store()
                              .AutoLoad(true)
                              .Model
                              (
                                Html.X().Model()
                                .IDProperty("ID")
                                .Fields
                                (
                                  new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                  new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                )
                               )
                               .Proxy
                               (
                                 Html.X().AjaxProxy()
                                 .Url(Url.Action("LoadProvenanceByLivraisonType", "Provenance"))
                                 .Reader(Html.X().JsonReader().RootProperty("data"))
                               )
                               .Parameters(p => {
                                   p.Add(new StoreParameter("TypeLivraison", Model._Livraison.LivraisonType.ID.ToString(), ParameterMode.Value));
                                   p.Add(new StoreParameter("siteID", Model._Livraison.Site.ID.ToString(), ParameterMode.Value));
                               })
                          ),
                    X.ComboBox()
                          .ID("OldDestinationID")
                          .FieldLabel("Old Destination")
                          .DisplayField("Nom")
                          .ValueField("ID")
                          .LabelAlign(LabelAlign.Right)
                          .ForceSelection(true)
                          .LabelWidth(150)
                          //.Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.NouvelleDestination.ID : Model._Livraison.Destination.ID)
                          .Value(Model._Livraison.NouvelleDestination.ID)
                          .Store
                          (
                             X.Store()
                              .AutoLoad(true)
                              .Model
                              (
                                Html.X().Model()
                                .IDProperty("ID")
                                .Fields
                                (
                                  new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                  new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                )
                               )
                               .Proxy
                               (
                                 Html.X().AjaxProxy()
                                 .Url(Url.Action("LoadDestinationByLivraisonType", "Destination"))
                                 .Reader(Html.X().JsonReader().RootProperty("data"))
                               )
                               .Parameters(p => {
                                   p.Add(new StoreParameter("TypeLivraison", Model._Livraison.LivraisonType.ID.ToString(), ParameterMode.Value));
                                   p.Add(new StoreParameter("siteID", Model._Livraison.Site.ID.ToString(), ParameterMode.Value));
                               })
                          ),
                    X.ComboBox()
                          .ID("NewDestinationID")
                          .FieldLabel("New Destination")
                          .DisplayField("Nom")
                          .ValueField("ID")
                          .LabelAlign(LabelAlign.Right)
                          .ForceSelection(true)
                          .LabelWidth(150)
                          .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.NouvelleDestination.ID : Model._Livraison.Destination.ID)
                          .Store
                          (
                             X.Store()
                              .AutoLoad(true)
                              .Model
                              (
                                Html.X().Model()
                                .IDProperty("ID")
                                .Fields
                                (
                                  new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                  new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                )
                               )
                               .Proxy
                               (
                                 Html.X().AjaxProxy()
                                 .Url(Url.Action("LoadDestinationByLivraisonType", "Destination"))
                                 .Reader(Html.X().JsonReader().RootProperty("data"))
                               )
                               .Parameters(p => {
                                   p.Add(new StoreParameter("TypeLivraison", Model._Livraison.LivraisonType.ID.ToString(), ParameterMode.Value));
                                   p.Add(new StoreParameter("siteID", Model._Livraison.Site.ID.ToString(), ParameterMode.Value));
                               })
                          ),
                    X.TextArea()
                        .ID("txtRaison")
                        .FieldLabel("Commentaire")
                        .TabIndex(5)
                        .LabelWidth(150)
                        .AllowBlank(true)
                        .IndicatorCls("IndicatorRedStar")
                        .IndicatorText("")
                        .LabelAlign(LabelAlign.Right)
                        .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.RaisonReclassement : string.Empty)

    #endregion                    
            )
    )
    .Buttons
    (
        X.Button()
            .Text("OK")
            .ID("BtnOk")
            .TabIndex(14)
            .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .DirectEvents
            (
                de =>
                {
                    de.Click.Url = Url.Action("UpdateValues");
                    de.Click.FormID = "#(return this.up('window').down('form');)";
                    de.Click.Before = "return validNew(App.BonDeLivraison_Origine.id);";
                }
            ),
        X.Button()
            .TabIndex(15)
            .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
            .Handler("App.BonDeLivraison_Origine.doClose()")
            .Cls("btncancel")
    )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Bon De Livraison - Lot : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }        


    };   
      

</script>


