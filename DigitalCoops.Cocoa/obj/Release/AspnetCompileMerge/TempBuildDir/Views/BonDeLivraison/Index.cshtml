    var GenerateBLReport = function (record, baseurl) {        
        var id = record[0].data.ID;
        var AfficheResultatAnalyse = record[0].data.Livraison.LivraisonType.AfficheResultatAnalyse;        
        Ext.net.DirectMethod.request({ url: baseurl+"/BonDeLivraison/OnPrintDeliveryNote?IdBon="+ id +"&IsCopy=0&AfficheResultatAnalyse=" + AfficheResultatAnalyse});
    };
</script>