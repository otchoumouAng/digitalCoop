<script type="text/javascript">

    var StockSummaryInfo = function () {        
        var mTotalEntree = App.storeListeStatutStockQuantite.sum('TotalEntree') || 0;
        var mTotalSortie = App.storeListeStatutStockQuantite.sum('TotalSortie') || 0;
        var totalENetLivre = App.storeListeStatutStockQuantite.sum('TotalPoidsNetLivreEntree') || 0;
        var totalSNetLivre = App.storeListeStatutStockQuantite.sum('TotalPoidsNetLivreSortie') || 0;
        /*var stock = mTotalEntree - mTotalSortie;*/
        var stock = totalENetLivre - totalSNetLivre;
        var mChaine = Ext.String.format('Entrée(s) : {0} (Kg)<br/> Sortie : {1} (Kg)<br/> Stock : {2} (Kg)', FormatAmount(totalENetLivre), FormatAmount(totalSNetLivre), FormatAmount(stock));
        App.lblRecap.setHtml(mChaine);

        /*App.rowSelectionListe.deselectAll(true);*/

        //Overview.resetButtons();
    };

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeStatutStockQuantite.columnManager.getColumns(), App.grpListeStatutStockQuantite.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }

    var Overview =
    {
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value === 1) {
                return 'glyphicon-arrow-right blue';
            }
            else if (value == -1) {
                return 'glyphicon-arrow-left green';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
        },

        SummaryStatutStock: function () {
            var nbrOfrows = App.grpListeStatutStockQuantite.getStore().getCount();
            
            /*var totalNetAccepte = App.storeListeStatutStockQuantite.sum('PoidsNetAccepte') || 0;
            var totalNetLivre = App.storeListeStatutStockQuantite.sum('PoidsNetLivre') || 0;
            var totalQuantite = App.storeListeStatutStockQuantite.sum('Quantite') || 0;
            var totalPoidsBrut = App.storeListeStatutStockQuantite.sum('PoidsBrut') || 0;

            var totalTarePalette = App.storeListeStatutStockQuantite.sum('TarePalettes') || 0;
            var totalTareSacs = App.storeListeStatutStockQuantite.sum('TareSacs') || 0;
            var totalRetention = App.storeListeStatutStockQuantite.sum('Retention') || 0;
            ....*/

            var totalENetAccepte = App.storeListeStatutStockQuantite.sum('TotalPoidsNetAccepteEntree') || 0;
            var totalSNetAccepte = App.storeListeStatutStockQuantite.sum('TotalPoidsNetAccepteSortie') || 0;
            var totalENetLivre = App.storeListeStatutStockQuantite.sum('TotalPoidsNetLivreEntree') || 0;
            var totalSNetLivre = App.storeListeStatutStockQuantite.sum('TotalPoidsNetLivreSortie') || 0;
            var totalEQuantite = App.storeListeStatutStockQuantite.sum('TotalSacsEntree') || 0;
            var totalSQuantite = App.storeListeStatutStockQuantite.sum('TotalSacsSortie') || 0;
            var totalEPoidsBrut = App.storeListeStatutStockQuantite.sum('TotalEntree') || 0;
            var totalSPoidsBrut = App.storeListeStatutStockQuantite.sum('TotalSortie') || 0;

            var totalETarePalette = App.storeListeStatutStockQuantite.sum('TotalTarePaletteEntree') || 0;
            var totalSTarePalette = App.storeListeStatutStockQuantite.sum('TotalTarePaletteSortie') || 0;
            var totalETareSacs = App.storeListeStatutStockQuantite.sum('TotalTareSacsEntree') || 0;
            var totalSTareSacs = App.storeListeStatutStockQuantite.sum('TotalTareSacsSortie') || 0;

            var totalERetention = App.storeListeStatutStockQuantite.sum('TotalRetentionEntree') || 0;
            var totalSRetention = App.storeListeStatutStockQuantite.sum('TotalRetentionSortie') || 0;            
            
            totalNetAccepte = FormatAmount(totalENetAccepte - totalSNetAccepte);
            totalNetLivre = FormatAmount(totalENetLivre - totalSNetLivre);
            totalQuantite = FormatAmount(totalEQuantite - totalSQuantite);
            totalPoidsBrut = FormatAmount(totalEPoidsBrut - (totalSPoidsBrut - totalSTareSacs - totalSTarePalette));
            totalTarePalette = FormatAmount(totalETarePalette - totalSTarePalette);
            totalTareSacs = FormatAmount(totalETareSacs - totalSTareSacs);
            totalRetention = FormatAmount(totalERetention - totalSRetention);

            /*App.rsNbrOfMovement.setValue(nbrOfrows);*/
            App.rsQuantite.setValue(totalQuantite);
            App.rsGrossWeight.setValue(totalPoidsBrut);
            App.rsDelNetWeiight.setValue(totalNetLivre);
            App.rsAccNetWeight.setValue(totalPoidsBrut);
            App.rsTarePalette.setValue(totalTarePalette);
            App.rsTareSacs.setValue(totalTareSacs);
            App.rsRefaction.setValue(totalRetention);            
            /*var mChaine = Ext.String.format('Nbr Of Movement : {0} <br/> Total Quantity : {1} <br/> Total Poids Brut : {2} <br/>Total Livré Poids Net : {3}<br/>Total Accepted Poids Net : {4}', nbrOfrows, totalQuantite, totalPoidsBrut, totalNetLivre, totalNetAccepte);
            App.lblSummaryStatutStock.setHtml(mChaine);*/
            /*App.lblSummaryStatutStock.setValue("Nbr Of Movement : " + nbrOfrows + "<br/>Total Quantity : " + totalQuantite + "<br/>Total Poids Brut : " + totalPoidsBrut + "<br/>Total Livré Poids Net : " + totalNetLivre + "<br/>Total Accepted Poids Net : " + totalNetAccepte);*/
        },
    }

</script>

