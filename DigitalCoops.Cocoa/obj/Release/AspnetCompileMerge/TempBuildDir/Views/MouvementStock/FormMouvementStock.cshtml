                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._MouvementStock.TareSacsAsString : string.Empty)
                                .Listeners(ls =>
