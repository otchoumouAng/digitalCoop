                            .Layout(LayoutType.HBox)
                            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Start })
                            .Items(
    #region Zone Gauche
                    X.Panel()
                                        .Layout(LayoutType.Form)
                                        .Flex(3)
                                        .Items
                                        (
                                            X.Hidden().ID("txtMouvementID").ReadOnly(true).Value(Model._MouvementStock.ID),
                                            X.Hidden().ID("hiddenExecMode").ReadOnly(true).Value(Model._ExecMode),
                                            X.ComboBox()
                                                .ID("cmbMagasin")
                                                .EmptyText("")
                                                .TabIndex(1)
                                                .ValueField("ID")
                                                .DisplayField("Designation")
                                                .ForceSelection(true)
                                                .QueryMode(DataLoadMode.Local)
                                                .TriggerAction(TriggerAction.All)
                                                .AllowBlank(false)
                                                .IndicatorCls("IndicatorRedStar")
                                                .IndicatorText("*")
                                                .FieldLabel("Magasin")
