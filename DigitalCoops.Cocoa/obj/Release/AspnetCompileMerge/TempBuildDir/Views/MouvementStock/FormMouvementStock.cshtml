                                                .LabelAlign(LabelAlign.Right)
                                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._MouvementStock.Magasin.ID : (int?)null)
                                                .Store
