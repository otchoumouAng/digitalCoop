                                    ls.Blur.Handler = "#{txtPoidsNetLivre}.setValue(formatNumber(#{txtPoidsNetLivre}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtPoidsNetLivre.value) { #{txtPoidsNetLivre}.setRawValue(unformatNumber(#{txtPoidsNetLivre}.getValue()));}";
                                }),
                            X.TextField()
                                .ID("txtRetention")
                                .TabIndex(12)
                                .MaskRe("[0123456789]")
                                .FieldLabel("Retention")
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._MouvementStock.Retention.ToString() : string.Empty)
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtRetention}.setValue(formatNumber(#{txtRetention}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtRetention.value) { #{txtRetention}.setRawValue(unformatNumber(#{txtRetention}.getValue()));}";
                                }),
                            X.TextField()
                                .ID("txtPoidsNetAccepte")
                                .MaskRe("[0123456789]")
                                .TabIndex(12)
                                .FieldLabel("Acc Poids Net")
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._MouvementStock.PoidsNetAccepteAsString : string.Empty)
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtPoidsNetAccepte}.setValue(formatNumber(#{txtPoidsNetAccepte}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtPoidsNetAccepte.value) { #{txtPoidsNetAccepte}.setRawValue(unformatNumber(#{txtPoidsNetAccepte}.getValue()));}";
                                }),
                            X.TextArea()
                                .ID("txtComment")
                                .FieldLabel("Commentaire")
                                .TabIndex(13)
                                .LabelAlign(LabelAlign.Right)
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._MouvementStock.Commentaire : string.Empty)
                        )
    #endregion

                    )
    )
    .Buttons
    (
        X.Button()
            .Text("OK")
            .ID("BtnOk")
            .TabIndex(12)
            .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .DirectEvents
            (
                de =>
                {
                    de.Click.Url = Url.Action("UpdateFormMethod");
                    de.Click.Before = "return validNew(App.FormMouvementStock.id);";
                    de.Click.FormID = "#(return this.up('window').down('form');)";
                }
            ),
        X.Button()
            .TabIndex(13)
            .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
            .Handler("App.FormMouvementStock.doClose()")
            .Cls("btncancel")
    )

)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Stock Movement : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }
        
    };







    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };


</script>
