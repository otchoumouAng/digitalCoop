                                                             .AllowBlank(false)
                                                             .Width(140)
                                                             .IndicatorCls("IndicatorRedStar")
                                                             .IndicatorText("*"),
                                                         X.TextField().FieldStyle("background-color:#F5F5F5 !important;").Width(200).ReadOnly(true)
                                                ),

                                            X.ComboBox()
                                                 .ID("cmbSens")
                                                 .EmptyText("")
                                                 .TabIndex(5)
                                                 .ForceSelection(true)
                                                 .AllowBlank(false)
                                                 .IndicatorCls("IndicatorRedStar")
                                                 .IndicatorText("*")                                                 
                                                 .FieldLabel("Direction")
                                                 .LabelAlign(LabelAlign.Right)
                                                 .DisplayField("Designation")
                                                 .ValueField("ID")
                                                 .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._MouvementStock.Sens : string.Empty)
                                                 .Items
