                                .TabIndex(8)
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._MouvementStock.PoidsBrutAsString : string.Empty)
