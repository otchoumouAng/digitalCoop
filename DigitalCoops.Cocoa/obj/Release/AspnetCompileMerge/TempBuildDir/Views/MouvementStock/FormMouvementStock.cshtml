                                                       .IDProperty("ID")
                                                       .Fields
                                                       (
                                                         new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                         new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                       )
                                                    )
                                                    .Proxy
                                                    (
                                                      Html.X().AjaxProxy()
                                                     .Url(Url.Action("LoadActiveMouvementStockTypeAll", "MouvementStockType"))
                                                     .Reader(Html.X().JsonReader().RootProperty("data"))
                                                    )
                                                    .Parameters
                                                    (
                                                        ps => { ps.Add(new StoreParameter("SensMouvement", "App.cmbSens.getValue()", ParameterMode.Raw)); }
                                                    )
                                                 )
                                                 ,
                                                X.TextField()
                                                    .ID("txtNumeroBordereau")
                                                    .FieldLabel("Note N°")
                                                    .TabIndex(6)
                                                    .LabelAlign(LabelAlign.Right)
                                                    .AllowBlank(false)
                                                    .IndicatorCls("IndicatorRedStar")
                                                    .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._MouvementStock.Reference1 : string.Empty)
                                                    .IndicatorText("*"),
                                                 X.TextField()
                                                    .ID("txtReferenceMouvement")
                                                    .FieldLabel("Reference")
                                                    .TabIndex(6)
                                                    .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._MouvementStock.Reference2 : string.Empty)
                                                    .LabelAlign(LabelAlign.Right),
                                                X.ComboBox()
                                                     .ID("cmbSacType")
                                                     .TabIndex(5)
                                                     .ForceSelection(true)
                                                     .AllowBlank(false)
                                                     .IndicatorCls("IndicatorRedStar")
                                                     .IndicatorText("*")
                                                     .FieldLabel("Type de Sacs")
                                                     .DisplayField("Designation")
                                                     .ValueField("ID")
                                                     .LabelAlign(LabelAlign.Right)
                                                     .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._MouvementStock.SacType.ID : (int?)null)
                                                     .Store
                                                     (
                                                         X.Store()
                                                        .AutoLoad(true)
                                                        .Model
                                                        (
                                                            Html.X().Model()
                                                           .IDProperty("ID")
                                                           .Fields
                                                           (
                                                             new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                             new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                           )
                                                        )
                                                    .Proxy
                                                    (
                                                        Html.X().AjaxProxy()
                                                        .Url(Url.Action("LoadSacTypeActive", "SacType"))
                                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                                    )
                                                 )



                                            ),
    #endregion
    #region Zone Droite
                    X.Panel()
                        .Layout(LayoutType.Form)
                        //.Height(350)
                        .Flex(2)
                        .Items
                        (
                            X.TextField()
                                .ID("txtQuantite")
                                .FieldLabel("Quantity")
                                .MaskRe("[0123456789]")                                                                                              
                                .TabIndex(7)
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._MouvementStock.QuantiteAsString : string.Empty)
                                .IndicatorText("*")
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtQuantite}.setValue(formatNumber(#{txtQuantite}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtQuantite.value) { #{txtQuantite}.setRawValue(unformatNumber(#{txtQuantite}.getValue()));}";
                                }),

                            X.TextField()
                                .ID("txtPoidsBrut")
                                .MaskRe("[0123456789]")
                                .FieldLabel("Poids Brut")
