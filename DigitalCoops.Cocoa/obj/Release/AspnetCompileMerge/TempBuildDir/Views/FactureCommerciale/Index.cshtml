@Scripts.Render("~/bundles/CommonScripts")
<script type="text/javascript">

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeCommercialInvoice.columnManager.getColumns(), App.grpListeCommercialInvoice.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };


    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
            else if (value == 3) {
                return 'action_new_03';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }

            else if (value == 5) {
                return 'glyphicon-saved green';
            }
        },
        SummaryFI: function () {
            var nbrOfrows = App.grpListeCommercialInvoice.getStore().getCount();
            var totalTonnage = parseFloat(App.storeListeCommercialInvoice.sum('PoidsNetTheorique')) || 0;
            var totalAmount = parseFloat(App.storeListeCommercialInvoice.sum('MontantNet')) || 0;
            
            totalAmount = FormatAmount(totalAmount);
            totalTonnage = FormatAmount(totalTonnage);
            App.lblSummarySFI.setText("Poids Total : " + totalTonnage  + " (Kg),  :Montant Total " + totalAmount + " Euro");
        },
        resetButtons: function () {

          /** Permission control**/
            App.btnModify.disable();
            App.btnApprove.disable();
            App.mnuCancel.disable();
            App.mnuPrintInvoice.disable();


            if (App.rowSelectionCommercialInvoice.hasSelection()) {

                var isActive = App.rowSelectionCommercialInvoice.selected.items[0].data.IsActive;
                var isApproved = App.rowSelectionCommercialInvoice.selected.items[0].data.IsApproved;

                if (isActive === true) {

                    if (App.fchiddenPermModifier.value == 'true')
                        App.btnModify.enable();

                    if (App.fchiddenPermCancel.value == 'true')
                        App.mnuCancel.enable();

                    if (App.fchiddenPermApprove.value == 'true')
                        App.btnApprove.enable();

                    if (App.fchiddenPermPrintInvoice.value == 'true')
                        App.mnuPrintInvoice.disable();
                }
                else if (isApproved === true) {

                    if (App.fchiddenPermModifier.value == 'true')
                        App.btnModify.disable();

                    if (App.fchiddenPermPrintInvoice.value == 'true')
                        App.mnuPrintInvoice.enable();

                    if (App.fchiddenPermCancel.value == 'true')
                        App.mnuCancel.enable();

                    if (App.fchiddenPermApprove.value == 'true')
                        App.btnApprove.disable();
                }

                else {
                    App.btnModify.disable();
                    App.btnApprove.disable();
                    App.mnuCancel.disable();
                    App.mnuPrintInvoice.disable();
                }



            }


        }
    }


</script>


