<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListePeriode.columnManager.getColumns(), App.grpListePeriode.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };


    var GetNbrStoreRows = function () {
        var nbr = App.grpListePeriode.getRowsValues().length;
        App.LblResumePeriode.setText(nbr + ' Period(s)');
    };

    var SetCriteriaTitle = function (status) {

        App.PeriodeCP.title = "";
        var texttitle = "";

        if (status) texttitle += "Show only active Period(s) : YES ";
        else texttitle += "Show only active Period(s) : NO ";

        App.PeriodeCP.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    };



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    };


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            if (App.rowPeriode.hasSelection()) {
                if (App.PerhiddenPermModifier.value == 'true')
                    App.btnModifyPeriode.enable();

                if (App.PerhiddenPermDesactiver.value == 'true')
                    App.mnuCancelPeriode.enable();

                var isDisabled = App.rowPeriode.selected.items[0].data.Desactive;

                if (isDisabled === true) {
                    App.mnuCancelPeriode.setText('Activer');
                    App.btnModifyPeriode.disable();

                    if (App.PerhiddenPermActiver.value == 'true')
                        App.mnuCancelPeriode.enable();

                    App.mnuCancelPeriode.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.PerhiddenPermModifier.value == 'true')
                        App.btnModifyPeriode.enable();

                    App.mnuCancelPeriode.setText('Annuler');
                    App.mnuCancelPeriode.setIconCls('glyphicon glyphicon-remove red');
                }

            } else {

                App.btnModifyPeriode.disable();
                App.mnuCancelPeriode.disable();

            }
        }
    }


</script>
@model Tms.Classes.Shared.stock.Periode
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}

@(Html.X().ResourceManager())

<form id="tms_form">

    @(X.Viewport()
                        .Layout(LayoutType.Border)
                        .ID("TmsViewPort")
                        .Items(
                            X.Hidden().ID("BaseUrl").Value(@BaseUrl),
                            X.Hidden().ID("PerhiddenPermModifier").ReadOnly(true),
                            X.Hidden().ID("PerhiddenPermDesactiver").ReadOnly(true),
                            X.Hidden().ID("PerhiddenPermActiver").ReadOnly(true),
                            X.Panel()
                                .ID("pnlNorth")
                                .Region(Region.North)
                                .Layout(LayoutType.Border)
                                .TopBar(new Toolbar()
                                {
                                    Items = { X.Button()
                            .ID("btnFilterPeriode")
                            .IconCls("action_filter_02")
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                            .Disabled(false)
                            .DirectEvents( de =>{
                                de.Click.Url  = Url.Action("OnFilter");
                                de.Click.EventMask.ShowMask = true;
                                } ),

                        X.Button()
                            .ID("btnRefreshPeriode")
                            .IconCls("action_refresh_01")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Disable(false)
                            .DirectEvents( de =>{
                                de.Click.Url  = Url.Action("onRefresh");

                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatus", Encode=false, Value= "#{TxtStatus}.getValue()",     Mode=ParameterMode.Raw});
                                de.Click.Success = "SetCriteriaTitle(#{TxtStatus}.value);";
                                de.Click.EventMask.ShowMask = true;
                            } ),

                        X.Button()
                                .ID("btnNewPeriode")
                                .IconCls("action_new_02")
                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                                .Cls("ButtonStyle")
                                .Border(false)
                                .Disable(false)
                                .DirectEvents( de =>{
                de.Click.Url  = Url.Action("OnAdd");
                                    de.Click.Success = "App.FormPeriode.setTitle('Period : Nouveau')";
                de.Click.EventMask.ShowMask = true;
            } ),

                             X.Button()
                            .ID("btnModifyPeriode")
                            .IconCls("action_modify_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Disabled(true)
                            .DirectEvents( de =>{
                de.Click.Url  = Url.Action("OnEdit");
                                de.Click.Success = "App.FormPeriode.setTitle('Period : Modifier')";
                de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListePeriode}.getSelectionModel().getSelection()[0].data"});
                de.Click.EventMask.ShowMask = true;
            } ),


                                // X.SplitButton()
                                //.ID("btnPrint")
                                //.IconCls("action_print_02")
                                //.Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                //.Disable(false)
                                //.Cls("ButtonStyle")
                                //.Border(false)
                                //.Menu(new Menu()
                                //{
                                //    Items =
                                //    {



                                //    }

                                //})
                                //,

                                X.ToolbarFill(),

                                 X.Button()
                                .ID("btnActions")
                                .Text("Actions")
                                .Border(false)
                                .Cls("ButtonStyle")
                                .IconCls("menu_04")
                                .Disable(false)
                                 .Menu(new Menu()
                                 {
                                     Items = {
                                         X.MenuItem()
                                                .ID("mnuExportPeriode")
                                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                                .Icon(Icon.PageExcel)
                                                .Handler("SetExcelList();"),
                                                X.MenuItem()
                                                .ID("mnuCancelPeriode")
                                                .IconCls("glyphicon glyphicon-remove red")
                                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                                                .Cls("ButtonStyle")
                                                .Border(false)
                                                .Disabled(true)
                                                .DirectEvents(de =>
                                                {
                                                    de.Click.Url = Url.Action("OnActivateDeactivate");
                                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListePeriode}.getSelectionModel().getSelection()[0].data" });
                                                    de.Click.EventMask.ShowMask = true;
                                                    de.Click.Confirmation.ConfirmRequest = true;
                                                    de.Click.Confirmation.Title = "Period";
                                                    de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListePeriode}.getSelectionModel().getSelection()[0].data.Desactive)";
                                                    de.Click.Success = "Overview.resetButtons();";
                                                })

                                                }
                                        })
                                        }
                                })

                                    ,
                        X.FormPanel()
                            .ID("PeriodeCP")
                            .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Period - overview" })
                            .Region(Region.North)
                            .Floatable(false)
                            .Border(false)
                            .Collapsed(true)
                            .Collapsible(true)
                            //.CollapsedCls("panelcollapse")
                            .BodyPadding(5)
                            .Frame(true)
                            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Start })
                            .Items(

                                        X.Panel()
                                            .Border(false)
                                            .Flex(1)
                                            .Layout(LayoutType.Form)
                                            .Items(
                                                      X.Checkbox().ID("TxtStatus").FieldLabel("Show only active Period(s)").LabelAlign(LabelAlign.Right)
                                            ),

                                        X.Container()
                                .Flex(4)
                                .Border(false)
                                .Layout(LayoutType.HBox)
                                .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                                .Items
                                 (
                                     X.Container()
                                        .Layout(LayoutType.VBox)
                                        .Flex(1)
                                        .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Center, Pack = BoxPack.Start })
                                         .Items(
                                                X.Label().ID("LblResumePeriode").Text("Resume ici").EmptyText("")
                                             )
                                 )

                            ),


                            X.GridPanel()
                           .Layout(LayoutType.Fit)
                           .ID("grpListePeriode")
                           .Region(Region.Center)
                           .ForceFit(false)
                           .AllowDeselect(false)
                            .Store(
                                X.StoreFor<Tms.Classes.Shared.stock.Periode>()
                                    .ID("storeListePeriode")
                                    .PageSize(50)
                                    .RemotePaging(false)
                                .Proxy(Html.X().AjaxProxy()
                                            .Url(Url.Action("Select"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )
                                        .Listeners(ls =>
                                        {
                                            ls.Load.Handler = "GetNbrStoreRows();";
                                            ls.Add.Handler = "GetNbrStoreRows();";
                                        })
                                )
                        .ColumnModel
                        (
                            Html.X().Column().Text("").DataIndex("mIcon").Hideable(false).Renderer("renderIcon").Width(40).Filterable(false),
                            Html.X().Column().Text("Designation").DataIndex("Designation").Flex(1),
                            X.Column().Text("Utilisation Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                        X.DateColumn().Text("Date Creation").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                        X.Column().Text("Utilisation Modification").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                        X.DateColumn().Text("Date Modification").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")

                    ).BottomBar(
                        Html.X().PagingToolbar()
                        .HideRefresh(true)
                .Plugins(Html.X().ProgressBarPager())
                )
                .Plugins(
                    X.FilterHeader()
                )
                .SelectionModel(
                    X.RowSelectionModel()
                        .ID("rowPeriode")
                        .Mode(SelectionMode.Single)
                        .AllowDeselect(false)
                ).Listeners(l =>
                {
                    l.Select.Fn = "Overview.resetButtons";
                    l.Deselect.Fn = "Overview.resetButtons";

                }
                )
                .DirectEvents(de =>
                {
                    de.RowDblClick.Url = Url.Action("OnConsult");
                    de.RowDblClick.CleanRequest = true;
                    de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowPeriode}.getSelected().items[0].data" });
                    de.RowDblClick.EventMask.ShowMask = true;
                }
                )

    )
    )

</form>