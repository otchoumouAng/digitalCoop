@Scripts.Render("~/bundles/CommonScripts")
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeContratDeVentes.columnManager.getColumns(), App.grpListeContratDeVentes.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };
    var GetNbrStoreRows = function () {
        var nbr = App.grpListeContratDeVentes.getRowsValues().length;
        App.LblResumeArticle.setText(nbr + 'Sales Contracts');
    };


    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
            else if (value == 3) {
                return 'action_new_03';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }

            else if (value == 5) {
                return 'glyphicon-saved green';
            }
        },
        SummarySC: function () {
            var nbrOfrows = App.grpListeContratDeVentes.getStore().getCount();
            var totalWeight = parseFloat(App.storeListeContratDeVentes.sum('Quantite')) || 0;
            var totalBalance = parseFloat(App.storeListeContratDeVentes.sum('Solde')) || 0; 
            var valeurContrat = parseFloat(App.storeListeContratDeVentes.sum('ValeurContrat')) || 0;
            var TotalPrix = parseFloat(App.storeListeContratDeVentes.sum('Prix')) || 0;
            var PrixMoyen = valeurContrat / totalWeight;
            var mChaine = Ext.String.format('Poids Total (T): {0} <br/> Cumul Solde (T) : {1} <br/> Average Price (Euro/T) : {2}', formatNumber(totalWeight), formatNumber(totalBalance), formatNumber(PrixMoyen));
            App.lblSummarySC.setHtml(mChaine);
        },
        resetButtons: function () {

            /** Permission control**/

            App.btnModify.disable();
            App.btnApprove.disable();
            App.mnuCancel.disable();
            App.mnuClose.disable();
            App.mnuPrintAgreement.disable();
            App.mnuChangeCertif.disable();

            if (App.rowSelectionListeContratDeVentes.hasSelection()) {

                var isActive = App.rowSelectionListeContratDeVentes.selected.items[0].data.IsActive;
                var isApproved = App.rowSelectionListeContratDeVentes.selected.items[0].data.IsApproved;
                var isClosed = App.rowSelectionListeContratDeVentes.selected.items[0].data.IsClose;

                if (isActive === true) {

                    if (App.cvhiddenPermModifier.value == 'true')
                        App.btnModify.enable();

                    if (App.cvhiddenPermCancel.value == 'true')
                        App.mnuCancel.enable();

                    if (App.cvhiddenPermClose.value == 'true')
                        App.mnuClose.disable();

                    if (App.cvhiddenPermApprove.value == 'true')
                        App.btnApprove.enable();

                    if (App.cvhiddenPermPrintAgreement.value == 'true')
                        App.mnuPrintAgreement.disable();
                }
                else if (isApproved === true) {

                    App.btnModify.disable();

                    if (App.cvhiddenHighPermModifier.value == 'true' && isClosed === false)
                        App.btnModify.enable();
                    else
                        App.btnModify.disable();

                    if (App.cvhiddenPermPrintAgreement.value == 'true')
                        App.mnuPrintAgreement.enable();

                    if (App.cvhiddenPermCancel.value == 'true')
                        App.mnuCancel.enable();

                    if (App.cvhiddenPermClose.value == 'true')
                        App.mnuClose.disable();

                    if (App.cvhiddenPermApprove.value == 'true')
                        App.btnApprove.disable();

                    if (App.cvhiddenPermModifierCertif.value == 'true')
                        App.mnuChangeCertif.enable();
                }
               
                else {
                    App.btnModify.disable();
                    App.btnApprove.disable();
                    App.mnuCancel.disable();
                    App.mnuClose.disable();
                    App.mnuPrintAgreement.disable();
                    App.mnuChangeCertif.disable();
                }



            }

        }
    }


</script>


