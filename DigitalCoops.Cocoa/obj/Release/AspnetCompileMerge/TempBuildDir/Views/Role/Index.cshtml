<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript"> 
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeRole.columnManager.getColumns(), App.grpListeRole.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };
      
    var GetNbrStoreRows = function () {
        var nbr = App.grpListeRole.getRowsValues().length;
        App.LblResumeRole.setText(nbr + ' Role(s)');        
    };

    var SetCriteriaTitle = function (status) {

        App.RoleCriteriaPanel.title = "";
        var texttitle = "";

        if (status) texttitle += "Voir uniquement les roles actifs : YES ";
        else texttitle += "Voir uniquement les roles actifs : NO ";

        App.RoleCriteriaPanel.setTitle(texttitle);
    };


    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';       

        var icon_url = Overview.getBootStrapIcons(value);        

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-briefcase red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-briefcase green';
            }
            else if (value == 2) {
                return 'glyphicon-briefcase blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {            

            if (App.rowSelectionRole.hasSelection()) {

                if (App.RohiddenPermModifier.value == 'true')
                    App.btnModifyRole.enable();

                if (App.RohiddenPermDesactiver.value == 'true')
                    App.mnuCancelRole.enable();

                var isDisabled = App.rowSelectionRole.selected.items[0].data.IsDisable;

                if (isDisabled === true) {
                    App.btnModifyRole.disable();

                    App.mnuCancelRole.setText('Activer');
                    if (App.RohiddenPermActiver.value == 'true')
                        App.mnuCancelRole.enable();
                    else
                        App.mnuCancelRole.disable();

                    App.mnuCancelRole.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.RohiddenPermDesactiver.value == 'true')
                        App.mnuCancelRole.enable();
                    else
                        App.mnuCancelRole.disable();
                    
                    if (App.RohiddenPermModifier.value == 'true')
                        App.btnModifyRole.enable();

                    App.mnuCancelRole.setText('Desactiver');                    
                    App.mnuCancelRole.setIconCls('glyphicon glyphicon-remove red');
                }

            } else {

                App.btnModifyRole.disable();                                
                App.mnuCancelRole.disable();
            }
        }
    }


</script>


@model Tms.Classes.Security.Role
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}

@(Html.X().ResourceManager())

<form id="tms_form">

    @(X.Viewport()
        .Layout(LayoutType.Border)
        .ID("TmsViewPort")
        .Items(
                X.Hidden().ID("BaseUrl").Value(@BaseUrl),
                X.Hidden().ID("RohiddenPermCreer").ReadOnly(true),
                X.Hidden().ID("RohiddenPermModifier").ReadOnly(true),
                X.Hidden().ID("RohiddenPermActiver").ReadOnly(true),
                X.Hidden().ID("RohiddenPermDesactiver").ReadOnly(true),
                X.Hidden().ID("RohiddenPermPrintRoleList").ReadOnly(true),
                X.Hidden().ID("RohiddenPermExporterExcel").ReadOnly(true),
                X.Hidden().ID("RohiddenPermOverview").ReadOnly(true),
            X.Panel()
                .ID("pnlNorth")
                .Region(Region.North)
                .Layout(LayoutType.Border)
                .TopBar(new Toolbar()
                {
                    Items = {
                        X.Button()
                        .ID("btnFilterRole")
                        .IconCls("action_filter_02")
                        .Border(false)
                        .Cls("ButtonStyle")
                        .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                        .Disabled(false)
                        .DirectEvents( de =>{
                            de.Click.Url  = Url.Action("OnFilter");
                            de.Click.EventMask.ShowMask = true;
                            } ),
                        X.Button()
                        .ID("btnRefreshRole")
                        .IconCls("action_refresh_01")
                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                        .Border(false)
                        .Cls("ButtonStyle")
                        .Disable(false)
                        .DirectEvents( de =>{
                            de.Click.Url  = Url.Action("onRefresh");

                            de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatus", Value= "#{TxtStatus}.getValue()", Mode=ParameterMode.Raw});
                            de.Click.Success = "SetCriteriaTitle(App.TxtStatus.value);";
                            de.Click.EventMask.ShowMask = true;
                        } ),

                        X.Button()
                        .ID("btnNewRole")
                        .IconCls("action_new_02")
                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                        .Cls("ButtonStyle")
                        .Border(false)
                        .Disable(false)
                        .DirectEvents( de =>{
                            de.Click.Url  = Url.Action("OnAdd");
                            de.Click.Success = "App.FormRole.setTitle('Role : Nouveau');";
                            de.Click.EventMask.ShowMask = true;
                        } ),

                        X.Button()
                        .ID("btnModifyRole")
                        .IconCls("action_modify_02")
                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                        .Cls("ButtonStyle")
                        .Border(false)
                        .Disabled(true)
                        .DirectEvents( de =>{
                            de.Click.Url  = Url.Action("OnEdit");
                            de.Click.Success = "App.FormRole.setTitle('Role : Modifier');";
                            de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeRole}.getSelectionModel().getSelection()[0].data"});
                            de.Click.EventMask.ShowMask = true;
                        } ),

                        //X.SplitButton()
                        //.ID("btnPrintRole")
                        //.IconCls("action_print_02")
                        //.Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                        //.Disable(false)
                        //.Cls("ButtonStyle")
                        //.Border(false)
                        //.Menu(new Menu()
                        //{
                        //    Items =
                        //    {
                                
                        //    }

                        //}),

                        X.ToolbarFill(),

                        X.Button()
                        .ID("btnActions")
                        .Text("Actions")
                        .Border(false)
                        .Cls("ButtonStyle")
                        .IconCls("menu_04")
                        .Disable(false)
                        .Menu(new Menu()
                        {
                            Items = {
                                X.MenuItem()
                                        .ID("mnuExportListRole")
                                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                        .Icon(Icon.PageExcel)
                                        .Handler("SetExcelList();"),
                                X.MenuItem()
                                .ID("mnuCancelRole")
                                .IconCls("glyphicon glyphicon-remove red")
                                .Text("Desactiver")
                                .Cls("ButtonStyle")
                                .Border(false)
                                .Disabled(true)
                                .DirectEvents(de =>
                                {
                                    de.Click.Url = Url.Action("OnActivateDeactivate");
                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeRole}.getSelectionModel().getSelection()[0].data" });
                                    de.Click.EventMask.ShowMask = true;
                                    de.Click.Confirmation.ConfirmRequest = true;
                                    de.Click.Confirmation.Title = "Role";
                                    de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListeRole}.getSelectionModel().getSelection()[0].data.IsDisable)";
                                    de.Click.Success = "Overview.resetButtons();";
                                })

                                }
                        })
                    }
                })
                ,
                X.FormPanel()
                .ID("RoleCriteriaPanel")
                .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Role - overview" })
                .Region(Region.North)
                .Floatable(false)
                .Border(false)
                .Collapsed(true)
                .Collapsible(true)
                //.CollapsedCls("panelcollapse")
                .BodyPadding(5)
                .Frame(true)
                .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Start })
                .Items(
                        X.Panel()
                        .Border(false)
                        //.Frame(true)
                        //.Margin(10)
                        .Width(400)
                        .Height(40)
                        //.Title("Criteria")
                        .Layout(LayoutType.Form)
                        //.BodyPadding(6)
                        .Items(
                                X.Checkbox().ID("TxtStatus").FieldLabel("Show only active Role").LabelAlign(LabelAlign.Right)
                            ),

                        X.Panel()
                        .ID("formOverviewRole")
                        .Width(400)
                        //.Margin(10)
                        .Flex(1)
                        //.Frame(true)
                        .Height(40)
                        //.TitleConfig(new PanelTitle { Text = "Summary", Cls = "title_font_color" })
                        .Border(false)
                        //.BodyPadding(6)
                        .Layout(LayoutType.HBox)
                        .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                        .Items(X.Container()
                                .ID("")
                                .Layout(LayoutType.VBox)
                                .LayoutConfig(new VBoxLayoutConfig { Pack = BoxPack.Center })
                                .Items(X.Label().ID("LblResumeRole").Text("Resume ici").EmptyText(""))
                            )
                        ),
                        X.GridPanel()
                        .Layout(LayoutType.Fit)
                        .ID("grpListeRole")
                        .Region(Region.Center)
                        .ForceFit(false)
                        .AllowDeselect(false)
                        .Store(
                            X.StoreFor<Tms.Classes.Security.Role>()
                            .ID("storeListeRole")
                            .PageSize(50)
                            .RemotePaging(false)
                            .Proxy(Html.X().AjaxProxy()
                                        .Url(Url.Action("Select"))
                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                    ).Listeners(ls =>
                                    {
                                        ls.Load.Handler = "GetNbrStoreRows(); Ext.net.Mask.hide();";
                                        ls.Add.Handler = "SelectNewRecordAddedOnGrid(records, #{grpListeRole}.id); GetNbrStoreRows();";
                                        ls.BeforeLoad.Handler = "Ext.net.Mask.show();";
                                    })

                            )
                        .ColumnModel
                        (
                            Html.X().Column().Text("").DataIndex("mIcon").Renderer("renderIcon").Hideable(false).Width(40).Filterable(false),
                            Html.X().Column().Text("Nom").DataIndex("Nom").Flex(1),
                            Html.X().Column().Text("Description").DataIndex("Description").Flex(1),
                            X.Column().Text("Utilisation Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                                X.DateColumn().Text("Date Creation").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                                X.Column().Text("Utilisation Modification").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                                X.DateColumn().Text("Date Modification").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")
                        )
                        .BottomBar(
                            Html.X().PagingToolbar()
                            .HideRefresh(true)
                        .Plugins(Html.X().ProgressBarPager())
                            )
                        .Plugins(
                            X.FilterHeader()
                        )
                        .View(
                                Html.X().GridView().LoadingText("Chargement...")
                        )
                        .SelectionModel(
                            X.RowSelectionModel()
                                .ID("rowSelectionRole")
                                .Mode(SelectionMode.Single)
                                .AllowDeselect(false)
                        )
                        .Listeners(l =>
                        {
                            l.Select.Fn = "Overview.resetButtons";
                            l.Deselect.Fn = "Overview.resetButtons";

                        }
                        )
                        .DirectEvents(de =>
                        {
                            de.RowDblClick.Url = Url.Action("OnConsult");
                            de.RowDblClick.CleanRequest = true;
                            de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowSelectionRole}.getSelected().items[0].data" });
                            de.RowDblClick.EventMask.ShowMask = true;
                        }
                            )

    )
    )

</form>