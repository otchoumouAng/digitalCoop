@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Error : Weighing ', msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

    };

    var validTare = function () {
        if (App.txtTarePalettes.value) {
            return true;
        }
        else
        {
            Ext.Msg.show({ title: 'Error : Weighing ', msg: 'Capture Tare Of Pallet Before', buttons: Ext.Msg.OK });
            return false;
        }

    };

    var enterKeyPressHandler = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            var param = App.txtDeliveryID.value;
            var baseurl = App.baseUrlVal.value;
            Ext.net.DirectMethod.request({ url: baseurl + "/PeseeProduction/SubmitDeliveryNumber?ItemDeliveryNumber=" + param });
            /*App.BtnSearchDeliveryInfo.fireEvent('click', App.BtnSearchDeliveryInfo);*/
            e.stopEvent();
        }
    };

    var CalculateValues = function () {
        var totalNbrSacs = App.storeListeWeightPU.sum('NombreSacs') || 0;
        var totalPoidsBrut = App.storeListeWeightPU.sum('PoidsBrut') || 0;
        var TareUnitaire = parseFloat(App.cmbTypeLot.getSelectedRecord().data.TareSacsUnitaire) || 0;
        App.txtNombreSacs.setValue(totalNbrSacs);
        App.txtPoidsBrut.setValue(formatNumber(totalPoidsBrut));
        App.txtTareSacs.setValue(totalNbrSacs * TareUnitaire);
    };

    var CalculateNetWeight = function () {
        var totalNbrSacs = App.storeListeWeightPU.sum('NombreSacs') || 0;
        var totalPoidsBrut = App.storeListeWeightPU.sum('PoidsBrut') || 0;
        var TareUnitaire = parseFloat(App.cmbTypeLot.getSelectedRecord().data.TareSacsUnitaire) || 0;        
        var tareSacs = parseFloat(totalNbrSacs * TareUnitaire) || 0;

        var tarePalettes = App.txtTarePalettes.value;
        if (App.txtTarePalettes.value != "0")
            tarePalettes = parseFloat(unformatNumber(App.txtTarePalettes.value)) || 0;
        var netWeight = parseFloat(totalPoidsBrut) - tareSacs - tarePalettes;
        App.txtTarePalettesLabel.setValue(formatNumber(tarePalettes));
        App.txtNetWeight.setValue(formatNumber(netWeight));
    };

    var GetNbrOfPallets = function () {
        var nbrOfrows = App.grpListeWeightPU.getStore().getCount();
        App.txtNombrePalette.setValue(nbrOfrows);

        /* set Fields to ReadOnly*/
        if (nbrOfrows > 0) {
            App.txtLot.setReadOnly(true);
            App.btnSelectLot.disable();
            App.cmbTypeLot.setReadOnly(true);
            App.PanelBtnSave.hide();
            /*App.btnSelectDelivery.disable();*/
        } else {
            App.txtLot.setReadOnly(false);
            App.cmbTypeLot.setReadOnly(false);
            App.btnSelectLot.enable();
            App.PanelBtnSave.show();
            /*App.btnSelectDelivery.enable();*/
        }
    };
</script>








