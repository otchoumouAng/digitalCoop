@model Tms.Classes.Business.stock.InventaireViewModel
@{
    Layout = null;
    var X = Html.X();
    string DefaultCampagne = new Tms.Classes.Shared.Parametres(0).Campagne;
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style type="text/css">
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 300px !important;
    }

    .new-row .x-grid-cell, .new-row .x-grid-rowwrap-div {
            background: #c8ffc8 !important;
    }
</style>
<script src="~/Scripts/FormatAmount.js"></script>
<script type="text/javascript">
    var OverviewCode =
    {
        SetButtons: function () {

            if (App.rowItem.hasSelection()) {
                /*if (App.CdhiddenPermRemove.value == 'true')*/
                App.BtnSaveInventaire.enable();
            } else {
                App.BtnSaveInventaire.disable();
            }
        }
    };


    var OnChnageValueField = function () {
        if (App.grpListeItemInStock.getStore().isLoaded() == true) {
        App.txtPoidsNetAccepte.setValue('');
        App.txtPoidsNetLivre.setValue('');
        App.txtQuantite.setValue('');
        App.txtPoidsBrut.setValue('');
        App.txtTareSacs.setValue('');
        App.txtTarePalettes.setValue('');
        App.txtRetention.setValue('');

        App.grpListeItemInStock.getStore().removeAll();
        }
    };

    var getRowClass = function (record) {
        console.log(record.data.GenereMouvement);
        if (record.data.GenereMouvement) {
            return "new-row";
        }        
    };

</script>
@(
    X.Window()
        .ID("FormAjustementStock")
        .Width(870)
        .Resizable(false)
        .Height(550)
        .CloseAction(Ext.Net.CloseAction.Destroy)
        .Modal(true)
        //.X(400)
        .Y(20).Title("Inventaire de Stock : Ajustement")
        .Layout(LayoutType.VBox)
        .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Start })
        .Items(
                    X.FormPanel()
                        .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                        .Items(
                                    X.Panel()
                                        .Layout(LayoutType.HBox)
                                        .Padding(5)
                                        .Frame(true)
                                        .PaddingSpec("0 100")
                                        .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                                        .Items(
                                                X.Hidden().ID("hiddenExecMode").Value(Tms.Components.Settings.EnumsDefinition.CONSULT),
                                                X.Hidden().ID("hiddenRowversion").Value(Model._Inventaire.RowVersionKey),
                                                X.Hidden().ID("TxtinventaireID").Value(Model._Inventaire.ID),
                                                X.Container()
                                                    .Layout(LayoutType.Form)
                                                    .Flex(1)
                                                    .Items(
                                                                X.TextField().ID("").FieldLabel("Site ").LabelAlign(LabelAlign.Right).Text(Model._Inventaire.Sites.Nom).ReadOnly(true),
                                                                X.TextField().ID("").FieldLabel("Inventaire N°").LabelAlign(LabelAlign.Right).Text(Model._Inventaire.Numero).ReadOnly(true),
                                                                X.TextField().ID("").FieldLabel("Magasin").LabelAlign(LabelAlign.Right).Text(Model._Inventaire.Magasin.Designation).ReadOnly(true)
                                                            ),
                                                X.Container()
                                                    .Layout(LayoutType.Form)
                                                    .Flex(1)
                                                    .Items(
                                                                X.DateField().ID("").FieldLabel("Date Inventaire").LabelAlign(LabelAlign.Right).Text(Model._Inventaire.DateInventaire.ToShortDateString()).ReadOnly(true),
                                                                X.TextField().ID("").FieldLabel("Periode").LabelAlign(LabelAlign.Right).Text(Model._Inventaire.Periode.Designation).ReadOnly(true)
                                                            )
                                        ),
                                    X.Label()
                                        .Text("Elements en stock")
                                        .MarginSpec("0 0 0 5"),

    X.Panel()
        .Layout(LayoutType.Fit)
        .Padding(5)
        .Items(
                X.GridPanel()
                   .Layout(LayoutType.Fit)
                   .ID("grpListeItemInStock")
                   .Region(Region.Center)
                   .ForceFit(true)
                   .Border(true)
                   .Height(340)
                   .AllowDeselect(true)
                   .Store(
                            X.StoreFor<Tms.Classes.Business.stock.InventaireElementStock>()
                                .ID("storeListeItemInStock")
                                .AutoLoad(true)
                                .Proxy(
                                       Html.X().AjaxProxy()
                                       .Url(Url.Action("SelectItemsInventaire"))
                                       .Reader(
                                                Html.X().JsonReader().RootProperty("data")
                                                )
                                  )
                                .Listeners
                                (
                                     ls =>
                                     {
                                         ls.BeforeLoad.Handler = "Ext.net.Mask.show();";
                                         ls.Load.Handler = "Ext.net.Mask.hide();";
                                     }
                                )
                                .Parameters
                                (
                                ps =>
                                {
                                    ps.Add(new StoreParameter("inventaireID", Model._Inventaire.ID.ToString(), ParameterMode.Value));
                                }
                            )
                    )
                    .ColumnModel
                    (
                        Html.X().Column().Text("Item Type").Flex(1).DataIndex("ObjetEnStock").Hideable(false),
                        Html.X().Column().Text("Item N°").Flex(1).DataIndex("Reference").Hideable(false),
                        Html.X().Column().Text("Nbr de sacs").Flex(1).DataIndex("QuantiteAsString").EmptyCellText("0").Hideable(false),
                        Html.X().Column().Text("Poids Brut").Flex(1).DataIndex("PoidsBrutAsString").EmptyCellText("0").Hideable(false),
                        Html.X().Column().Text("Tare Sacs").Flex(1).DataIndex("TareSacsAsString").EmptyCellText("0").Hideable(false),
                        Html.X().Column().Text("Tare Palettes").Flex(1).DataIndex("TarePalettesAsString").EmptyCellText("0").Hideable(false),
                        Html.X().Column().Text("Net Livré").Flex(1).DataIndex("PoidsNetLivreAsString").EmptyCellText("0").Hideable(false),
                        Html.X().Column().Text("Sacs Physique").Flex(1).DataIndex("QuantitePhysiqueAsString").EmptyCellText("0").Hideable(false),
                        Html.X().Column().Text("Poids Physique").Flex(1).DataIndex("PoidsBrutPhysiqueAsString").EmptyCellText("0").Hideable(false)
                    )
                    .DockedItems(
                                    X.Toolbar()
                                        .Dock(Dock.Top)
                                        .Items(
                                                X.Button()
                                                    .ID("BtnEditWeight")
                                                    .IconCls("action_modify_02")
                                                    .Border(false)
                                                    .Cls("ButtonStyle")
                                                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                                                    .Disabled(true)
                                                    .DirectEvents
                                                    (
                                                        de =>
                                                        {
                                                            de.Click.Url = Url.Action("onUpdateStock");
                                                            de.Click.ExtraParams.Add(new Parameter { Name = "storerow", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListeItemInStock.getSelectionModel().getSelection()[0].data" });
                                                            de.Click.EventMask.ShowMask = true;
                                                        }
                                                    )
                                                )
                    )
                    .SelectionModel(
                                    X.RowSelectionModel()
                                        .ID("rowItem")
                                        .Mode(SelectionMode.Single)
                                        .AllowDeselect(true)
                                        .Listeners(
                                            ls => {
                                                if (Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Approve)
                                                {
                                                    ls.Select.Handler = "App.BtnEditWeight.enable();";
                                                    ls.Deselect.Handler = "App.BtnEditWeight.disable();";
                                                }

                                            }
                                        )
                        )
                    .View(
                            X.GridView()
                                .StripeRows(false)
                                .GetRowClass(grc => grc.Fn = "getRowClass")
                    )
                    .Listeners(l =>
                    {
                        if (Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Consult)
                        {
                            l.Select.Fn = "OverviewCode.SetButtons";
                            l.Deselect.Fn = "OverviewCode.SetButtons";
                        }
                    }
                )
)

    )
    )
    .Buttons(
                X.Button()
                    .Text("Fermer")
                    .ID("BtnSaveInventaire")
                    .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve ? true : false)
                    .Handler("App.FormAjustementStock.doClose()").Cls("btncancel"),
                X.Button()
                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnApprove)
                    .ID("BtnApproveInventaire")
                    .Hidden(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Approve ? true : false)
                    .DirectEvents(de =>
                    {
                        de.Click.Url = Url.Action("OnConfirmStock");
                        de.Click.Before = "return validNew(App.FormAjustementStock.id);";
                        de.Click.FormID = "#(return this.up('window').down('form');)";
                        de.Click.ExtraParams.Add(new Parameter { Name = "storerows", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListeItemInStock.getRowsValues({selectedOnly : false})" });
                    }),
                X.Button()
                    .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                    .Handler("App.FormAjustementStock.doClose()").Cls("btncancel")
                    )


)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
        *   Vérification de la saisie des champs obligatoires
        */
        if (!areAllrequiredFieldsFilled) {
            console.log('error fileds');
            Ext.Msg.show({ title: 'Codification : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Please enter the delivery ID', buttons: Ext.Msg.OK });
            return false;
        }

    }

</script>



