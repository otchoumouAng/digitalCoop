                                            X.Panel()
                                            .Border(false)
                                            .Frame(false)
                                            .MarginSpec("0 0 0 0")
                                            .Width(450)
                                            .Layout(LayoutType.Form)
                                            .Margin(0)
                                            .BodyPadding(0)
                                            .Items
