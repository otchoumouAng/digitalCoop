                          Html.X().Column().Text("Fournisseur").DataIndex("FournisseurNameAndCode").Flex(2),
                          Html.X().Column().Text("Type").DataIndex("LibelleMiseEnCompteType").Flex(1),
                          Html.X().DateColumn().Text("Date Fin").DataIndex("DateEcheance").Flex(1),
