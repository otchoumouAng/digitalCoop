                            X.Hidden().ID("MphiddenPermPrintSavingList").ReadOnly(true),
                            X.Hidden().ID("MphiddenPermExporterExcel").ReadOnly(true),
                            X.Hidden().ID("MphiddenPermOverview").ReadOnly(true),

                            X.Panel()
                                .ID("pnlNorth")
                                .Region(Region.North)
                                .Layout(LayoutType.Border)
                                .TopBar(new Toolbar()
                                {
                                    Items =
                                    {
                                         X.Button()
                                            .ID("btnFilter")
                                            .IconCls("action_filter_02")
                                            .Border(false)
                                            .Cls("ButtonStyle")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                                            .Disabled(false)
                                            .DirectEvents
                                             (
                                                de =>
                                                {
                                                    de.Click.Url  = Url.Action("OnFilter");
                                                    de.Click.EventMask.ShowMask = true;
                                                }
                                             ),

                                         X.Button()
                                            .ID("btnRefresh")
                                            .IconCls("action_refresh_01")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                                            .Border(false)
                                            .Cls("ButtonStyle")
                                            .Disabled(false)
                                            .DirectEvents
                                             (
                                                de =>
                                                {
                                                    de.Click.Url  = Url.Action("OnRefresh");
                                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemFournisseur", Encode=true, Value= "#{cmbFournisseur}.getValue()", Mode=ParameterMode.Raw});
                                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodStart", Value= "#{dtpStartDate}.getRawValue()",   Mode=ParameterMode.Raw});
                                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodEnd", Value= "#{dtpEndDate}.getRawValue()",     Mode=ParameterMode.Raw});
                                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatus", Encode=false, Value= "#{cmbStatus}.getValue()", Mode=ParameterMode.Raw});
                                                    de.Click.Success = "App.CriteriaPanelMP.setTitle(' Fournisseur : ' + App.cmbFournisseur.rawValue +  ', Statut : '+ App.cmbStatus.rawValue + ' , du  '+ App.dtpStartDate.rawValue  + ' au  '+ App.dtpEndDate.rawValue )";
                                                    de.Click.EventMask.ShowMask = true;
                                                }
                                             ),

                                         X.Button()
                                            .ID("btnNew")
                                            .IconCls("action_new_02")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                                            .Cls("ButtonStyle")
                                            .Border(false)
                                            .Disabled(false)
                                            .DirectEvents
                                             (
                                                de =>
                                                    {
                                                        de.Click.Url  = Url.Action("OnAdd");
                                                        de.Click.Success = "App.MecPlanifiee_Detail.setTitle('Planned saving : Nouveau')";
                                                        de.Click.EventMask.ShowMask = true;
                                                    }
                                             ),

                                         X.Button()
                                            .ID("btnModify")
                                            .IconCls("action_modify_02")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                                            .Cls("ButtonStyle")
                                            .Border(false)
                                            .Disabled(true)
                                            .DirectEvents
                                             (
                                                 de =>
                                                 {
                                                    de.Click.Url  = Url.Action("OnEdit");
                                                    de.Click.Success = "App.MecPlanifiee_Detail.setTitle('Planned saving : Modifier')";
                                                    de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeMecP}.getSelectionModel().getSelection()[0].data"});
                                                    de.Click.EventMask.ShowMask = true;
                                                 }
                                             ),

                                         X.SplitButton()
                                            .ID("btnPrint")
                                            .IconCls("action_print_02")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                            .Cls("ButtonStyle")
                                            .Border(false)
                                            .Menu
                                             (
                                                new Menu()
                                                {
                                                    Items =
                                                    {
                                                        X.MenuItem()
                                                            .ID("mnuPrintProgSavingList")
                                                            .Text("Mise en Compte planifiées")                                                                    
                                                            .DirectEvents
                                                            (
                                                                de=>
                                                                {
                                                                    de.Click.Url = Url.Action("OnDisplayProgSavingList");
                                                                    de.Click.EventMask.ShowMask = true;
                                                                }
                                                            )
                                                    }
                                                }
                                               ),

                                            X.ToolbarFill(),

                                            X.Button()
                                                .ID("btnActions")
                                                .Text("Actions")
                                                .Border(false)
                                                .Cls("ButtonStyle")
                                                .IconCls("menu_04")
                                                .Disabled(false)
                                                .Menu
                                                 (
                                                    new Menu()
                                                    {
                                                        Items =
                                                        {
                                                            X.MenuItem()
                                                            .ID("mnuExportPlanSaving")
                                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                                            .Icon(Icon.PageExcel)
                                                            .Handler("SetExcelList();"),
                                                           X.MenuItem()
                                                            .ID("btnCancel")
                                                            .Icon(Icon.Cross)
                                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                                                            .Cls("ButtonStyle")
                                                            .Border(false)
                                                            .Disabled(true)
                                                            .DirectEvents
                                                            (
                                                              de =>
                                                              {
                                                                de.Click.Url = Url.Action("OnCancel");
                                                                de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeMecP}.getSelectionModel().getSelection()[0].data" });
                                                                de.Click.EventMask.ShowMask = true;
                                                                de.Click.Confirmation.ConfirmRequest = true;
                                                                de.Click.Confirmation.Title = "Mise en Compte planifiée";
                                                                de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListeMecP}.getSelectionModel().getSelection()[0].data.IsActive)";
                                                                de.Click.Success = "Overview.resetButtons();";
                                                              }
                                                            )


                                                        }
                                                    }
                                                )
                                     }
                                }
                           ),


                           X.FormPanel()
                            .ID("CriteriaPanelMP")
                            .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Mise en Compte planifiée - overview" })
                            .Region(Region.North)
                            .Floatable(false)
                            .Border(false)
                            .Collapsed(true)
                            .Collapsible(true)
                            .BodyPadding(5)
                            .Frame(true)
                            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Start })
                            .Items
                             (

                               X.Panel()
                                    .Border(false)
                                    //.Frame(true)
                                    .MarginSpec("0 0 0 0")
                                    .Width(750)
                                    .Height(80)
                                    .Layout(LayoutType.HBox)
                                    .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Center })
                                    //.BodyPadding(0)
                                    .Items
