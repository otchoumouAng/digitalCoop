@model Tms.Classes.Business.stock.RetourEmpotageViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 140px !important;
    }

    .x-form-text-default.x-form-textarea {
        line-height: 17px;
        min-height: 50px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
@(
X.Window()
    .ID("EmpotageConteneur_Ajustement")
    .Width(700)
    .Resizable(false)
    .Height(320)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    //.X(400)
    .Y(20)
    .Title("Stuffing - Adjustment")
    .Items
    (
        X.FormPanel()
            .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .Layout(LayoutType.HBox)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Start })
            .Items(
    #region Zone Gauche
                    X.Panel()
                        .Layout(LayoutType.Form)
                        .Flex(1)
                        .Items
                        (
                            X.Hidden().ID("txtRetourEmpotageID").ReadOnly(true).Value(Model._RetourEmpotage.ID),
                            X.Hidden().ID("hiddenExecMode").ReadOnly(true).Value(Model._ExecMode),
                            X.ComboBox()
                                .ID("cmbCampagne")
                                .TabIndex(1)
                                .ForceSelection(true)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .FieldLabel("Campagne")
                                .DisplayField("Designation")
                                .ValueField("Designation")
                                .LabelAlign(LabelAlign.Right)
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.Campagne.Designation : Model._DefaultCampagne)
                                .Store
                                (
                                    X.Store()
                                        .AutoLoad(false)
                                        .Model
                                        (
                                            Html.X().Model()
                                            .IDProperty("Designation")
                                            .Fields
                                            (
                                            new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                            )
                                        )
                                        .Proxy
                                        (
                                            Html.X().AjaxProxy()
                                            .Url(Url.Action("LoadCampagne", "Campagne"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )
                                ),
                            X.TextField()                                
                                .LabelAlign(LabelAlign.Right)                                
                                .ReadOnly(true)                                
                                .FieldLabel("Stuffing N°")
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")                                
                                .ID("TxtNumeroShipment")
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.Empotage.EmbarquementAsString : Model._RetourEmpotage.Empotage.Embarquement.Numero)
                                ,
                            X.Hidden().ID("TxtEmpotageID")
                                .Listeners(ls => ls.Change.Handler = "if (App.TxtEmpotageID.value) { App.cmbLot.getStore().load();};")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.Empotage.ID : Model._RetourEmpotage.Empotage.ID),

                            X.ComboBox()
                                .ID("cmbLot")
                                .EmptyText("")
                                .TabIndex(3)
                                .ForceSelection(true)
                                .TypeAhead(true)
                                .QueryMode(DataLoadMode.Remote)
                                .TriggerAction(TriggerAction.All)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .FieldLabel("Lot")
                                .HideTrigger(true)
                                .DisplayField("NumeroLot")
                                //.MatchFieldWidth(false)
                                .ListConfig(new BoundList { MinWidth = 300 })
                                .ValueField("ID")
                                .MinChars(6)
                                .LabelAlign(LabelAlign.Right)
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.Lot.ID : (Guid?)null)
                                .Store
                                (
                                    X.Store()
                                        .AutoLoad(false)
                                        .Model
                                        (
                                            X.Model()
                                                .IDProperty("ID")
                                                .Fields
                                                (
                                                    new ModelField("ID", ModelFieldType.Object) { Mapping = "ID" },
                                                    new ModelField("NumeroLot", ModelFieldType.String) { Mapping = "NumeroLot" }
                                                )
                                        )
                                        .Proxy
                                        (
                                            Html.X().AjaxProxy()
                                            .Url(Url.Action("LoadLotsForAjustement", "LotProduction"))
                                            .ActionMethods(am => am.Read = HttpMethod.POST)
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )
                                        .Parameters(
                                                    ps =>
                                                    {
                                                        ps.Add(new StoreParameter("query", (Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.Lot.NumeroLot : "#{cmbLot}.getRawValue()"), ParameterMode.Raw));
                                                        ps.Add(new StoreParameter("statut", "#{cmbSens}.getValue()", ParameterMode.Raw));
                                                    }
                                        )
                                ),
                            X.ComboBox()
                                .ID("cmbSens")
                                .FieldLabel("Direction")
                                .DisplayField("Designation")
                                .ValueField("ID")
                                .LabelAlign(LabelAlign.Right)
                                .Items
                                (
                                    it =>
                                    {
                                        it.Add(new ListItem { Text = "Input", Value = "1" });
                                        it.Add(new ListItem { Text = "OutPut", Value = "-1" });
                                    }
                                )
                                .SelectedItems
                                (
                                    it =>
                                    {
                                        it.Add(new ListItem { Text = "Input", Value = "1" });
                                    }
                                ),
                            X.DateField()
                                .ID("txtDateRetour")
                                .TabIndex(4)
                                .FieldLabel("Date")
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.DateRetour.ToString() : DateTime.Now.ToString())
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .Width(140)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                    ),
    #endregion
    #region Zone Droite
                    X.Panel()
                        .Layout(LayoutType.Form)
                        //.Height(350)
                        .Flex(1)
                        .Items
                        (
                            X.TextField()
                                .ID("txtQuantite")
                                .FieldLabel("Nbr de sacs")
                                .MaskRe("[0123456789]")
                                .TabIndex(11)
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.QuantiteAsString : string.Empty)
                                .IndicatorText("*")
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtQuantite}.setValue(formatNumber(#{txtQuantite}.getValue())); validEstimatedWeight(); CalculateTareBags();";
                                    ls.Focus.Handler = "if (App.txtQuantite.value) { #{txtQuantite}.setRawValue(unformatNumber(#{txtQuantite}.getValue()));}";
                                }),

                            X.TextField()
                                .ID("txtPoidsBrut")
                                .MaskRe("[0123456789]")
                                .FieldLabel("Poids Brut (Kg)")
                                .HideTrigger(true)
                                .TabIndex(12)
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.PoidsBrutAsString : string.Empty)
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtPoidsBrut}.setValue(formatNumber(#{txtPoidsBrut}.getValue())); validEstimatedWeight();";
                                    ls.Focus.Handler = "if (App.txtPoidsBrut.value) { #{txtPoidsBrut}.setRawValue(unformatNumber(#{txtPoidsBrut}.getValue()));}";
                                    ls.Change.Handler = "calculerNetLivre()";
                                }),
                            X.TextField()
                                .ID("txtTareSacs")
                                .MaskRe("[0123456789]")
                                .TabIndex(13)
                                .FieldLabel("Tare Des Sacs")
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.TareSacsAsString : string.Empty)
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtTareSacs}.setValue(formatNumber(#{txtTareSacs}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtTareSacs.value) { #{txtTareSacs}.setRawValue(unformatNumber(#{txtTareSacs}.getValue()));}";
                                    ls.Change.Handler = "calculerNetLivre()";
                                }),
                            X.TextField()
                                .ID("txtTarePalette")
                                .TabIndex(14)
                                .MaskRe("[0123456789]")
                                .FieldLabel("Tare Des Palettes")
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.TarePaletteAsString : string.Empty)
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtTarePalette}.setValue(formatNumber(#{txtTarePalette}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtTarePalette.value) { #{txtTarePalette}.setRawValue(unformatNumber(#{txtTarePalette}.getValue()));}";
                                    ls.Change.Handler = "calculerNetLivre()";
                                }),
                            X.TextField()
                                .ID("txtNetWeight")
                                .MaskRe("[0123456789]")
                                .TabIndex(17)
                                .ReadOnly(true)
                                .FieldLabel("Poids Net (Kg)")
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.PoidsNetAsString : string.Empty)
                                .Listeners(ls =>
                                {
                                    ls.Blur.Handler = "#{txtNetWeight}.setValue(formatNumber(#{txtNetWeight}.getValue()));";
                                    ls.Focus.Handler = "if (App.txtNetWeight.value) { #{txtNetWeight}.setRawValue(unformatNumber(#{txtNetWeight}.getValue()));}";
                                }),
                            X.TextArea()
                                .ID("txtComment")
                                .FieldLabel("Commentaire")
                                .TabIndex(18)
                                .LabelAlign(LabelAlign.Right)
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RetourEmpotage.Commentaire : string.Empty)
                        )
    #endregion

                    )
    )
    .Buttons
    (
        X.Button()
            .Text("OK")
            .ID("BtnOk")
            .TabIndex(20)
            .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .DirectEvents
            (
                de =>
                {
                    de.Click.Url = Url.Action("AjustFormMethod");
                    de.Click.Before = "return validNew(App.EmpotageConteneur_Ajustement.id);";
                    de.Click.FormID = "#(return this.up('window').down('form');)";
                }
            ),
        X.Button()
            .TabIndex(21)
            .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
            .Handler("App.EmpotageConteneur_Ajustement.doClose()")
            .Cls("btncancel")
    )

)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Movement Sheet : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

    };

    var calculerNetLivre = function () {
        var tareBags = parseInt(unformatNumber(App.txtTareSacs.value), 10) || 0;
        var tarePallets = parseInt(unformatNumber(App.txtTarePalette.value), 10) || 0;
        var poidsbrut = parseInt(unformatNumber(App.txtPoidsBrut.value), 10) || 0;
        var poidsnet = poidsbrut - tareBags - tarePallets;

        poidsnet = formatNumber(poidsnet);
        App.txtNetWeight.setValue(poidsnet);

    };

    var calculerNetAccepte = function () {
        var poidsnetlivre = parseInt(unformatNumber(App.txtNetWeight.value), 10) || 0;
        var retentionPoids = parseInt(unformatNumber(App.txtRetention.value), 10) || 0;

        var poidsnetaccepte = poidsnetlivre - retentionPoids;

        poidsnetaccepte = formatNumber(poidsnetaccepte);
        App.txtNetWeight.setValue(poidsnetaccepte);

    };

    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

    var validEstimatedWeight = function () {
        var combo = App.cmbSacType;
        var record = App.cmbSacType.getSelectedRecord().data;
        if (!record)
            return;
        else
            CheckGrossWeight(record);

    };

    var CheckGrossWeight = function (record) {

        if (!record)
            return;

        if (App.txtQuantite.value != null && App.txtPoidsBrut.value != null) {

            var mNbSacsDeclares = parseInt(unformatNumber(App.txtQuantite.value), 10) || 0;

            var mPoidsDeclare = parseInt(unformatNumber(App.txtPoidsBrut.value), 10) || 0;

            if (record.PoidsMax > 0 && unformatNumber(App.txtPoidsBrut.value) > 0) {
                if ((mPoidsDeclare > record.PoidsMax * mNbSacsDeclares) || (mPoidsDeclare < record.PoidsMin * mNbSacsDeclares)) {
                    /*App.txtPoidsBrut.setValue('');
                    App.txtPoidsBrut.focus(true);*/
                    Ext.Msg.show({ title: 'Erreur : Delivery ', msg: 'The estimated weight is out of the range of theoritical weight. Min= ' + record.PoidsMin * mNbSacsDeclares + ' ,Max= ' + record.PoidsMax * mNbSacsDeclares, buttons: Ext.Msg.OK });
                }
            }

        }
    };


    var CalculateTareBags = function () {
        var tareunitaire = parseFloat(App.cmbSacType.getSelectedRecord().data.Tare) || 1;
        var NombreSacs = parseFloat(App.txtQuantite.value) || 0;

        App.txtTareSacs.setValue(formatNumber(NombreSacs * tareunitaire));
    };
</script>



