<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Movement Sheet : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

    };

    var calculerNetLivre = function () {        
        var tareBags = parseInt(unformatNumber(App.txtTareSacs.value), 10) || 0;
        var tarePallets = parseInt(unformatNumber(App.txtTarePalette.value), 10) || 0;
        var poidsbrut = parseInt(unformatNumber(App.txtPoidsBrut.value), 10) || 0;
        var poidsnet = poidsbrut - tareBags - tarePallets;
        
        poidsnet = formatNumber(poidsnet);
        App.txtPoidsNetLivre.setValue(poidsnet);
       
    };

    var calculerNetAccepte = function () {
        var poidsnetlivre = parseInt(unformatNumber(App.txtPoidsNetLivre.value), 10) || 0;
        var retentionPoids = parseInt(unformatNumber(App.txtRetention.value), 10) || 0;
        
        var poidsnetaccepte = poidsnetlivre - retentionPoids;
        
        poidsnetaccepte = formatNumber(poidsnetaccepte);
        App.txtPoidsNetAccepte.setValue(poidsnetaccepte);

    };

    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

    var validEstimatedWeight = function () {
        var combo = App.cmbSacType;
        var record = App.cmbSacType.getSelectedRecord().data;        
        if (!record)
            return;
        else
            CheckGrossWeight(record);
        
    };

    var CheckGrossWeight = function (record) {        

        if (!record)
            return;

        if (App.txtQuantite.value != null && App.txtPoidsBrut.value != null) {

            var mNbSacsDeclares = parseInt(unformatNumber(App.txtQuantite.value), 10) || 0;

            var mPoidsDeclare = parseInt(unformatNumber(App.txtPoidsBrut.value), 10) || 0;
            
            if (record.PoidsMax > 0 && unformatNumber(App.txtPoidsBrut.value) > 0) {
                if ((mPoidsDeclare > record.PoidsMax * mNbSacsDeclares) || (mPoidsDeclare < record.PoidsMin * mNbSacsDeclares)) {
                    /*App.txtPoidsBrut.setValue('');
                    App.txtPoidsBrut.focus(true);*/
                    Ext.Msg.show({ title: 'Erreur : Delivery ', msg: 'The estimated weight is out of the range of theoritical weight. Min= ' + record.PoidsMin * mNbSacsDeclares + ' ,Max= ' + record.PoidsMax * mNbSacsDeclares, buttons: Ext.Msg.OK });
                }
            }

        }
    };
    
    var CalculateMontant = function () {
        var prix = parseInt(unformatNumber(App.txtPrix.value), 10) || 0;
        var weight = parseInt(unformatNumber(App.txtPoidsNetAccepte.value), 10) || 0;
        var result = prix * weight;
        App.txtMontant.setValue(formatNumber(result));

    };

    var CalculateTareBags = function () {        
        var tareunitaire = parseFloat(App.cmbSacType.getSelectedRecord().data.Tare) || 1;
        var NombreSacs = parseFloat(App.txtQuantite.value) || 0;

        App.txtTareSacs.setValue(formatNumber(NombreSacs * tareunitaire));
    };
</script>

