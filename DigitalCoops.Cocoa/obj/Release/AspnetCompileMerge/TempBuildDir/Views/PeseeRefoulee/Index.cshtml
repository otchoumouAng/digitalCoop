<script type="text/javascript">
    var RejWeighingSummaryInfo = function () {
        var mItemsCount = App.grpListe.getRowsValues().length || 0;
        var mTotalEstimatedBags = App.storeListe.sum('DeliveryEstimatedBags') || 0;
        var mTotalEstimatedTonnage = App.storeListe.sum('DeliveryEstimatedTonnage') || 0;
        var mTotalUnloadedBags = App.storeListe.sum('SacsDecharges') || 0;
        var mTotalRejGrossWeight = App.storeListe.sum('PoidsBrut') || 0;
        var mTotalPrevGrossWeight = App.storeListe.sum('PreviousGrossWeight') || 0;

        var mChaine = Ext.String.format('Pesée(s) : {0} <br/> Total Sacs Estimé : {1} <br/> Poids Total Estimé : {2} (Kg) <br/> Sacs dechargés : {3} <br/>Prev. Poids Brut : {4} (Kg) <br/>Rej. Poids Brut : {5} (Kg)', formatNumber(mItemsCount), formatNumber(mTotalEstimatedBags), formatNumber(mTotalEstimatedTonnage), formatNumber(mTotalUnloadedBags), formatNumber(mTotalPrevGrossWeight), formatNumber(mTotalRejGrossWeight));
        App.LblRejWeighingSummary.setHtml(mChaine);

        App.rowSelectionListe.deselectAll(true);

        //Overview.resetButtons();
    };
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListe.columnManager.getColumns(), App.grpListe.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }
    var Overview =
    {
        getBootStrapIcons: function (value)
        {
            if (value === 0)
            {
                return 'glyphicon-remove red'; // Cancelled
            }
            else if (value == 2)
            {
                return  'glyphicon-ok green'; // 2nd Weigh.
            }
            else if (value == 1)
            {
                return 'glyphicon-file blue'; // 1st weigh.
            }
            else if (value == 3)
            {
                return 'glyphicon-hand-right blue'; // Manual
            }
            else if (value == 4)
            {
                return 'glyphicon-ban-circle red'; // Rejected
            }
        },
        resetButtons: function () {            

            App.btnSecondWeight.disable();
            App.btnCancel.disable();
            App.btnFirstWeight.disable();
            App.mnuPrintTicket.disable();
            //App.mnuChangeDeliveryType.disable();
            //App.mnuCorrectWeightManually.disable();

            var canFirstWeighing = true;
            var canManualWeighing = true;
            var canChangeDeliveryType = false;
            var canCorrectWeightManually = false;


            if (canFirstWeighing === true)   App.btnFirstWeight.enable();

            if (canManualWeighing === true) App.mnuManualWeighing.enable();


            if (App.rowSelectionListe.hasSelection())
            {
                var isFirstWeighing = App.rowSelectionListe.selected.items[0].data.DateP2 == null;

                var isCancelled = App.rowSelectionListe.selected.items[0].data.Cancelled == true;

                var canCancel = true;

                if (isFirstWeighing === true && App.RehiddenPermSecondWeight.value == 'true')
                    App.btnSecondWeight.enable();
                else {
                    if (App.RehiddenPermFirstWeight.value == 'true')
                        App.btnFirstWeight.enable();

                }


                if (isCancelled === true) {
                    App.btnCancel.setIconCls("glyphicon glyphicon-ok green");
                    App.btnCancel.setText('Activer');
                }

                else {
                    App.btnCancel.setIconCls("glyphicon glyphicon-remove red");
                    App.btnCancel.setText('Desactiver');
                }

                if (canCancel === true && !isCancelled && App.RehiddenPermDesactiver.value == 'true') App.btnCancel.enable();


                if (!isFirstWeighing === true && App.RehiddenPermPrintWeighingTicket.value == 'true') {
                    App.mnuPrintTicket.enable();
                }
                else {
                    App.mnuPrintTicket.disable();
                }

                //if (canChangeDeliveryType === true) App.mnuChangeDeliveryType.enable();

                //if (canCorrectWeightManually === true) App.mnuCorrectWeightManually.enable();
            }
        }
    }


</script>
