@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Facture : Data Validation', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }
    };

    var enterKeyPressHandler = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            var param = App.txtDeliveryID.value;
            var baseurl = App.baseUrlVal.value;
            Ext.net.DirectMethod.request({ url: baseurl + "/Facture/SubmitDeliveryNumber?ItemDeliveryNumber=" + param });
            /*App.BtnSearchDeliveryInfo.fireEvent('click', App.BtnSearchDeliveryInfo);*/
            e.stopEvent();

        }
    };



    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

    var FormatNetWeight = function () {
        try
        {
            var mNetWeight = parseFloat(App.txtNetWeight.value.toString().replace(' ', ''));
            var NetWeightFormat = FormatAmount(mNetWeight);
            App.txtNetWeight.setValue(NetWeightFormat);
        }
        catch (err)
        {
            return 0;
        }
    };

    var UpdateTotalDeductions = function () {
        try
        {
            var mTotalDeduction = 0;
            App.txtTotalDeduction.setValue(mTotalDeduction);
            
            if (App.grpDetailDeduction.getRowsValues().length >= 1)
            {
                for (i = 0; i < App.grpDetailDeduction.getRowsValues().length; i++)
                {
                    mTotalDeduction += App.grpDetailDeduction.getRowsValues()[i].Montant;
                }               

                App.txtTotalDeduction.setValue(FormatAmount(mTotalDeduction));
            } else 
                App.txtTotalDeduction.setValue(0);
            
            var mTotalValorisation = App.hiddenTotalValorisation.value;
            var Amount = 0;            
            if (Ext.isNumeric(mTotalValorisation) && Ext.isNumeric(mTotalDeduction)) {
                Amount = mTotalValorisation - mTotalDeduction;
                App.txtAmount.setValue(FormatAmount(Amount));
            }

        }
        catch (err)
        {
            return err;
        }
    };

    var UpdateTotalValorisations = function () {
        try {
            var mTotalValorisation = 0;

            if (App.grpDetailValorisation.getRowsValues().length >= 1) {
                for (i = 0; i < App.grpDetailValorisation.getRowsValues().length; i++) {
                    mTotalValorisation += App.grpDetailValorisation.getRowsValues()[i].Montant;
                }

                App.hiddenTotalValorisation.setValue(mTotalValorisation);

                mTotalValorisation = FormatAmount(mTotalValorisation);

                App.txtTotalValorization.setValue(mTotalValorisation);

                var ded = App.txtTotalDeduction.value || 0;
                if (ded == 0)
                {                    
                    App.txtAmount.setValue(FormatAmount(mTotalValorisation));
                }
            }
        }
        catch (err) {
            return 0;
        }
    };



</script>




