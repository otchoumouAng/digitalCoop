                            Html.X().Column().Text("Poids Net").DataIndex("PoidsNetAccepteAsString").EmptyCellText("0").Flex(1),
                            Html.X().Column().Text("Valorisation").DataIndex("MontantValorisationAsString").Flex(1).Hidden(true).EmptyCellText("0"),
                            Html.X().Column().Text("Deduction").DataIndex("MontantDeductionAsString").Flex(1).Hidden(true).EmptyCellText("0"),
                            Html.X().Column().Text("Montant").DataIndex("MontantAsString").Flex(1).EmptyCellText("0"),
                            Html.X().Column().Text("Utilisateur Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                            Html.X().DateColumn().Text("Date Creation ").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                            Html.X().Column().Text("Utilisateur Modification").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                            Html.X().DateColumn().Text("Date Modification").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")
                         //Html.X().Column().Text("Sticker Nr").DataIndex("NumeroSticker").Width(90)

                         )
                         .BottomBar
                         (
                             Html.X().PagingToolbar()
                            .HideRefresh(false)
                            .Plugins(Html.X().ProgressBarPager())
                         )
                         .Plugins
                         (
                           X.FilterHeader()
                         )
                        .SelectionModel
                        (
                          X.RowSelectionModel()
                           .ID("rowSelectionListeFacture")
                           .Mode(SelectionMode.Single)
                           .AllowDeselect(false)
                        )
                        .View(
                            Html.X().GridView().LoadingText("Chargement...")
                       )
                       .Listeners(l => { l.Select.Fn = "Overview.resetButtons"; l.Deselect.Fn = "Overview.resetButtons"; })
                       .DirectEvents(de =>
                       {
                           de.RowDblClick.Url = Url.Action("OnConsult");
                           de.RowDblClick.CleanRequest = true;
                           de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowSelectionListeFacture}.getSelected().items[0].data" });
                           de.RowDblClick.EventMask.ShowMask = true;
                           de.RowDblClick.Success = "App.Facture_Detail.setTitle('Facture : Detail')";
                       }
                       )
        )
    )

</form>

<script type="text/javascript">
    var GenerateReport = function (record) {
        var BaseUrl = App.BaseUrl.value;
        var id = record[0].data.ID;
        console.log(id);
        Ext.net.DirectMethod.request({ url: BaseUrl + "/Facture/OnPrintInvoice?IdFacture=" + id + "&IsCopy=0" });
    };
</script>