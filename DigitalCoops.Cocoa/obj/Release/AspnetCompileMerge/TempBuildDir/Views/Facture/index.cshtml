@Scripts.Render("~/bundles/CommonScripts")
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeFacture.columnManager.getColumns(), App.grpListeFacture.getRowsValues({ visibleOnly: true }));
        /*var mHeaders = getColsForExcel(App.grpListeFacture.columnManager.getColumns());*/
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';        

        var icon_url = Overview.getBootStrapIcons(value);        

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
            else if (value == 3) {
                return 'action_new_03';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return  'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-plus green';
            }
            else if (value == 3) {
                return 'glyphicon-minus red';
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }
        },

        SummaryFA: function () {
            var nbrOfrows = App.grpListeFacture.getStore().getCount();
            var totalNet = parseFloat(App.storeListeFacture.sum('PoidsNetAccepte')) || 0;
            var totalAmount = parseFloat(App.storeListeFacture.sum('Montant')) || 0;
                        
            /*for (var i = 0; i < nbrOfrows; i++) {
                if (App.grpListeFacture.getRowsValues()[i].IsActive) {
                    totalNet += parseFloat(App.grpListeFacture.getRowsValues()[i].PoidsNetAccepte);
                    totalAmount += parseFloat(App.grpListeFacture.getRowsValues()[i].Montant);
                }
            }*/
            totalNet = FormatAmount(totalNet);
            totalAmount = FormatAmount(totalAmount);
            App.lblSummaryFA.setText("Poids Total : " + totalNet + " Kg, Montant Total : " + totalAmount + " FCFA");
        },

        resetButtons: function () {
            
            App.btnCancel.disable();
            App.mnuPrintInvoice.disable();

            if (App.rowSelectionListeFacture.hasSelection())
            {

                var isActive = App.rowSelectionListeFacture.selected.items[0].data.IsActive;

                if (isActive === true)
                {
                    if (App.FahiddenPermDesactiver.value == 'true')
                        App.btnCancel.enable();

                    if (App.FahiddenPermPrintCopyOfInvoices.value == 'true')
                        App.mnuPrintInvoice.enable();

                }

                else
                {
                    App.btnCancel.disable();
                    App.mnuPrintInvoice.disable();
                }

            }

            else {
                App.btnCancel.disable();
            }
        }
    }

</script>

