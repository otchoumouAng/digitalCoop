                                .Listeners
                                (
                                ls =>
                                {
                                    ls.Blur.Handler = "if (App.TxtCapitalFournisseur.value && !App.TxtCapitalFournisseur.readOnly) {#{TxtCapitalFournisseur}.setValue(formatNumber(#{TxtCapitalFournisseur}.getValue()));}";
                                    ls.Focus.Handler = "if (App.TxtCapitalFournisseur.value && !App.TxtCapitalFournisseur.readOnly) { #{TxtCapitalFournisseur}.setRawValue(unformatNumber(#{TxtCapitalFournisseur}.getValue()));}";
                                }

