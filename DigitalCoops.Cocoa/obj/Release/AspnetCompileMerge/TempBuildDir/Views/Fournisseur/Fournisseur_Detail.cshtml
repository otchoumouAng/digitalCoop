            .Buttons
            (
                X.Button()
                .Text("OK")
                .ID("BtnOk")
                .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult)
                .DirectEvents(de =>
                {
                    de.Click.Url = Url.Action("SubmitFormMethod");
                    de.Click.Before = "return validNew(App.FormFournisseur.id);";
                    de.Click.FormID = "#(return this.up('window').down('form');)";
                    de.Click.EventMask.ShowMask = true;
                }),
                X.Button().Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel).Handler("App.FormFournisseur.doClose()").Cls("btncancel")

                )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
       
            var areAllrequiredFieldsFilled = isFormValid(winId);

            /*
           *   Vérification de la saisie des champs obligatoires
           */
            if (!areAllrequiredFieldsFilled) {
              
                Ext.Msg.show({ title: 'Erreur : Fournisseur ', msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
                return false;
            }

        }


</script>

