@model Tms.Classes.Business.FournisseurViewModel
@{
    Layout = null;
    var X = Html.X();
    var wzFieldPattern = @"^[1-9]\d{2}\.\d{3}\.\d{4}";
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style type="text/css">
    .x-form-layout-auto-label > * > .x-form-item-label 
    {
        width: 70px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script>
    var TypeFournisseurChanged = function (item) {
        var Fournisseur_Type = App.hiddenTypeFournisseur.value;
        
        if (App.hiddenExecMode.value.toString() != "Consult") {

            /*var agence = App.cmbAgenceFrs.value || '';
            if (agence) {
                App.cmbAgenceFrs.setValue(agence);
            }*/

            if (item == Fournisseur_Type) {                
                App.cmbAgenceFrs.setReadOnly(false);
                App.cmbAgenceFrs.allowBlank = false;
                App.cmbAgenceFrs.validate();
                /*App.cmbAgenceFrs.setIndicator("*");
                App.cmbAgenceFrs.setIndicatorCls('IndicatorRedStar');
                App.cmbAgenceFrs.showIndicator();   */                                            
            }
            else if (Ext.isNumeric(item)) {
                App.cmbAgenceFrs.setReadOnly(true);
                App.cmbAgenceFrs.validate();
                /*App.cmbAgenceFrs.allowBlank = true;                
                App.cmbAgenceFrs.setIndicator("");
                App.cmbAgenceFrs.setValue(-1);*/
            }
        }
        else {
            App.cmbAgenceFrs.setReadOnly(true);       
        }

    };

</script>
@(         
