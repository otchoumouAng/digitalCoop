
@model Tms.Classes.Shared.Sales.CompagnieMaritimeViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
@(
    X.Window()
            .ID("FormCompagnieMaritime")
            .Width(500)
            .Resizable(false)
            .Height(180)
            .Modal(true)
            .CloseAction(Ext.Net.CloseAction.Destroy)
            //.X(400)
            .Y(20)
            .Title("Ship Line : Detail")
            .Layout(LayoutType.Form)
            .Items(
                    X.FormPanel()
                    .Layout(LayoutType.Form)
                .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                .Items(
                            X.Hidden().ID("hiddenExecModeCM").Value(Model._ExecMode),
                            X.Hidden().ID("hiddenRowversionCM").Value(Model._CompagnieMaritime.RowVersionKey),
                            X.Hidden().ID("TxtCompagnieMaritimeID").Value(Model._CompagnieMaritime.ID),
                            X.Hidden().ID("hiddenStatutForm").Value(ViewData["StatutForm"]),
                            X.TextField().ID("TxtDesignationCompagnieMaritime").FieldLabel("Nom")
                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._CompagnieMaritime.Nom.ToString() : string.Empty)
                            .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                           )
            )
            .Buttons(
                X.Button()
                .Text("OK")
                .ID("BtnSubmitCompagnieMaritime")
                .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                .DirectEvents(de =>
                {
                    de.Click.Url = Url.Action("SubmitFormMethod", "CompagnieMaritime");
                    de.Click.Before = "return validNewCP(App.FormCompagnieMaritime.id);";
                    de.Click.FormID = "#(return this.up('window').down('form');)";
                }),
                X.Button()
                .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                .Handler("App.FormCompagnieMaritime.doClose()").Cls("btncancel")

                )

            )

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNewCP = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            
            Ext.Msg.show({ title: 'Ship Line : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }


    };


</script>











