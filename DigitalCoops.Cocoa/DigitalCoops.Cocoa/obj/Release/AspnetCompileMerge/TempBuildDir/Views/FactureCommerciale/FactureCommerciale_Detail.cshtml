@model Tms.Classes.Business.Sales.FactureCommercialeViewModel


@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />

</head>
<style>
    .x-table-form-item {
        margin-bottom: 5px;
    }

    #txtAmount-labelTextEl, #txtTotalValorization-labelTextEl, #txtTotalDeduction-labelTextEl {
        font-weight: bold;
    }
     #labelAmount-labelTextEl{
        font-weight: bold;
    }

    #txtAmount-inputEl, #txtTotalValorization-inputEl, #txtTotalDeduction-inputEl {
        text-align: right !important;
        font-weight: bold !important;
    }

    #txtGrossAmount-inputEl,#txtAmountAT-inputEl {
        text-align: left !important;
        font-weight: bold !important;
    }
    #btnSelectShipment-inputEl {
        text-align: center !important;
    }
</style>
<script src="~/Scripts/FormatAmount.js"></script>
<script type="text/javascript">


    var Detail =
    {
        resetButtons: function () {

            App.btnEditPrefinancing.disable();
            App.btnRemovePrefinancing.disable();
            App.btnEditOtherDeduction.disable();
            App.btnRemoveOtherDeduction.disable();
            
            if (App.rowSelectionValorisation.hasSelection()) {

                if (App.rowSelectionValorisation.lastSelected.data.Desactive == false)
                    App.btnEditPrefinancing.enable();
                else
                    App.btnEditPrefinancing.disable();

                if (App.rowSelectionValorisation.lastSelected.data.Desactive == false)
                    App.btnRemovePrefinancing.enable();
                else
                    App.btnRemovePrefinancing.disable();
            }
           


            if (App.rowSelectionDeduction.hasSelection()) {
                if (App.rowSelectionDeduction.lastSelected.data.IsAuto == false && App.rowSelectionDeduction.lastSelected.data.Desactive == false)
                    App.btnEditOtherDeduction.enable();
                else
                    App.btnEditOtherDeduction.disable();

                if (App.rowSelectionDeduction.lastSelected.data.Desactive == false && App.rowSelectionDeduction.lastSelected.data.IsAuto == false) 
                    App.btnRemoveOtherDeduction.enable();
                else 
                    App.btnRemoveOtherDeduction.disable();
                    
                

            }
            






        }

    }

</script>
