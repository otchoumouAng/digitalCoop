@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Facture Commerciale : Data Validation', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        var Amount = unformatNumber(App.txtAmount.value.replace(",","."));
        if ((Ext.isNumeric(Amount) && Amount < 0) || (!Ext.isNumeric(Amount))) {
            Ext.Msg.show({ title: 'Facture Commerciale : Data Validation', icon: Ext.MessageBox.WARNING, msg: 'Amount invalid.', buttons: Ext.Msg.OK });
            return false;
        }
    };

   



    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

    var FormatNetWeight = function () {
        try
        {
            var mNetWeight = parseFloat(App.txtNetWeight.value.toString().replace(' ', ''));
            var NetWeightFormat = FormatAmount(mNetWeight);
            App.txtNetWeight.setValue(NetWeightFormat);
        }
        catch (err)
        {
            return 0;
        }
    };

    var UpdateTotalDeductions = function () {
        try
        {
            var mTotalDeduction = 0;

            if (App.grpDetailDeduction.getRowsValues().length >= 1)
            {
                for (i = 0; i < App.grpDetailDeduction.getRowsValues().length; i++)
                {
                    mTotalDeduction += App.grpDetailDeduction.getRowsValues()[i].Montant;
                }
                mTotalDeduction = mTotalDeduction.toFixed(3);
                App.hiddenTotalDeduction.setValue(mTotalDeduction);
                App.txtTotalDeduction.setValue(formatNumberDecimal(mTotalDeduction));
            } else {

                App.hiddenTotalDeduction.setValue(mTotalDeduction);
                App.txtTotalDeduction.setValue(formatNumberDecimal(mTotalDeduction));
            }

            var mTotalValorisation = App.hiddenTotalValorisation.value || 0;
            var MontantAT = unformatNumber(App.txtAmountAT.value.replace(",", ".")) || 0;
            var Amount = 0;


            if (Ext.isNumeric(MontantAT) && Ext.isNumeric(mTotalValorisation) && Ext.isNumeric(mTotalDeduction)) {
                Amount = MontantAT - mTotalValorisation - mTotalDeduction;
                App.txtAmount.setValue(formatAmountDecimal(Amount));
            }
            else {
                App.txtAmount.setValue(formatAmountDecimal(MontantAT));
            }
        }
        catch (err)
        {
            return 0;
        }
    };

    var UpdateTotalValorisations = function () {
        try {
            var mTotalValorisation = 0;
            var mTotalAPC = 0;
            var mTotalBlank = 0;

            if (App.grpDetailValorisation.getRowsValues().length >= 1) {
                for (i = 0; i < App.grpDetailValorisation.getRowsValues().length; i++) {
                    if (App.grpDetailValorisation.getRowsValues()[i].Desactive == false)
                    {
                        mTotalValorisation += App.grpDetailValorisation.getRowsValues()[i].Montant;

                        if (App.grpDetailValorisation.getRowsValues()[i].Prefinancement.LibellePrefinancementType == "Blank")
                            mTotalBlank += App.grpDetailValorisation.getRowsValues()[i].Montant;
                        else
                            mTotalAPC += App.grpDetailValorisation.getRowsValues()[i].Montant;
                    }
                  
                }
                mTotalValorisation = mTotalValorisation.toFixed(3);
                mTotalBlank = mTotalBlank.toFixed(3);
                mTotalAPC = mTotalAPC.toFixed(3);
                App.hiddenTotalValorisation.setValue(mTotalValorisation);
                App.hiddenMontantPrefinancmentBlank.setValue(formatNumberDecimal(mTotalBlank));
                App.hiddenMontantPrefinancmentAPC.setValue(formatNumberDecimal(mTotalAPC));

                mTotalVal = formatNumberDecimal(mTotalValorisation);

                App.txtTotalValorization.setValue(mTotalVal);
            }else
            {
                
                App.hiddenTotalValorisation.setValue(mTotalValorisation);

                mTotalVal = formatNumberDecimal(mTotalValorisation);

                App.txtTotalValorization.setValue(mTotalVal);
            }

            var mTotalDeduction = App.hiddenTotalDeduction.value || 0 ;
            var MontantAT = unformatNumber(App.txtAmountAT.value.replace(",", ".")) || 0;
            Amount = 0;

            if (Ext.isNumeric(MontantAT) && Ext.isNumeric(mTotalValorisation) && Ext.isNumeric(mTotalDeduction)) {
                Amount = MontantAT - mTotalValorisation - mTotalDeduction;
                App.txtAmount.setValue(formatAmountDecimal(Amount));
            }else
            {
                App.txtAmount.setValue(formatAmountDecimal(MontantAT));
            }
        }
        catch (err) {
            return 0;
        }
    };

    var UpdateAmountAT = function () {
        try {
           
            var mTotalDeduction = App.hiddenTotalDeduction.value || 0;
            var mTotalValorisation = App.hiddenTotalValorisation.value || 0;
            var MontantAT = unformatNumber(App.txtAmountAT.value.replace(",", ".")) || 0;
            Amount = 0;

            if (Ext.isNumeric(MontantAT) && Ext.isNumeric(mTotalValorisation) && Ext.isNumeric(mTotalDeduction)) {
                Amount = MontantAT - mTotalValorisation - mTotalDeduction;
              
                App.txtAmount.setValue(formatAmountDecimal(Amount));
            } else {
                App.txtAmount.setValue(formatAmountDecimal(MontantAT));
            }
        }
        catch (err) {
            return 0;
        }
    };

    function formatNumberDecimal(amount) {

        amount = thousands_separators(amount.toString().replace(".", ","));

        formatted = amount.toString().replace(".", ",");

        return formatted;
    };

    function formatAmountDecimal(amount) {
        amount = FormatAmount(amount);
        formatted = amount.replace(".", ",");

        return formatted;
    };

    function unformatNumberDecimal(amount) {
        formatted = amount.replace(" ", "");

        return formatted;
    };

    function thousands_separators(num) {
        var num_parts = num.toString().split(".");
        num_parts[0] = num_parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, " ");
        return num_parts.join(".");
    }

</script>





