    var CalculateTonnage = function () {        
        var nbrOfrows = App.grpListeSpotPrice.getRowsValues().length;
        var total = parseFloat(App.storeListeSpotPrice.sum('Tonnage')) || 0;        
        
        total = FormatAmount(total);
        App.LblTonnage.setText("Poids Total : " + total + " (T)");
    };
