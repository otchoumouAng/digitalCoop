<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeSpotPrice.columnManager.getColumns(), App.grpListeSpotPrice.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var GetNbrStoreRows = function () {        
        var nbr = App.grpListeSpotPrice.getRowsValues().length;
        App.LblTonnage.setText(nbr + ' Prix Negocié(s)');
    };

    var SetCriteriaTitle = function (site, campagne,fournisseur, begin, end, statut) {

        App.CriteriaPanelSpotPrice.title = "";
        var texttitle = "";

        if (site) texttitle += "Site : " + site + " | ";

        if (campagne) texttitle += "Campagne : " + campagne + " | ";

        if (fournisseur) texttitle += "Fournisseur : " + fournisseur + " | ";

        if (statut) texttitle += "Statut : " + statut + " | ";

        if (begin) texttitle += "Du : " + begin;

        if (end) texttitle += " Au : " + end;

        App.CriteriaPanelSpotPrice.setTitle(texttitle);
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    };



    var iconRenderer = function (value, metaData, record) {
        metaData.css = Overview.getIcons(value);
    };


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';
                /*Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');*/
            }
            else if (value == 1) {
                return 'action_approve_02';
                /*// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');*/
            }
            else if (value == 2) {
                return 'action_new_02';
                /*//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New*/
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; /* glyphicon glyphicon-remove red*/
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; /*glyphicon glyphicon-file blue*/
            }
        },

        resetButtons: function () {            

            if (App.rowSelectionListeSpotPrice.hasSelection()) {

                if (App.SphiddenPermDesactiver.value == 'true')
                        App.mnuCancelSpotPrice.enable();                

                var isDisabled = App.rowSelectionListeSpotPrice.selected.items[0].data.PrixNegocie.Desactive;                
                var isApprouve = App.rowSelectionListeSpotPrice.selected.items[0].data.PrixNegocie.Statut;

                if (isDisabled === true) {
                    App.btnApproveSpotPrice.disable();
                    App.btnModifySpotPrice.disable();
                    App.mnuCancelSpotPrice.setText('Activer');
                    App.mnuCancelSpotPrice.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.SphiddenPermApprove.value == 'true')
                        App.btnApproveSpotPrice.enable();

                    if (App.SphiddenPermModifier.value == 'true')
                        App.btnModifySpotPrice.enable();
                   
                    App.mnuCancelSpotPrice.setText('Annuler');
                    App.mnuCancelSpotPrice.setIconCls('glyphicon glyphicon-remove red');
                }

                if (isApprouve == "AP" && (isDisabled === false || isDisabled === true)) {
                    if (App.SphiddenPermApprove.value == 'true')
                        App.btnApproveSpotPrice.disable();

                    if (App.SphiddenPermModifier.value == 'true')
                        App.btnModifySpotPrice.disable();

                }

            } else {
                App.btnModifySpotPrice.disable();
                App.btnApproveSpotPrice.disable();                
                App.mnuCancelSpotPrice.disable();
            }
        }
    };


</script>

