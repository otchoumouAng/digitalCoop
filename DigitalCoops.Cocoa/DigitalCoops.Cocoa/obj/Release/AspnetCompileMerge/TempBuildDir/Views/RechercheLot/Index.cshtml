<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeMouvementStock.columnManager.getColumns(), App.grpListeMouvementStock.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    };


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    };


    var Overview =
    {

        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value === 1) {
                return 'glyphicon-arrow-right blue';
            }
            else if (value == -1) {
                return 'glyphicon-arrow-left green';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
        },
        SummaryPanelMouvement: function () {
            App.MouvementStockCP.setTitle('Site : ' + App.cmbFiltreSite.rawValue + ', Campagne : ' + App.cmbFiltreCampagne.rawValue + ', Magasin : ' + App.cmbFiltreMagasin.rawValue + ', Certification : ' + App.cmbFiltreCertification.rawValue + ', Sens : ' + App.cmbFiltreDirection.rawValue + ', Type : ' + App.cmbFiltreMouvementType.rawValue + ', Emplacement : ' + App.cmbFiltreEmplacement.rawValue + ', Statut : ' + App.CmbFiltreStatut.rawValue);
        },

        SummaryMouvement: function () {
            var nbrOfrows = App.grpListeMouvementStock.getStore().getCount();                        
            /*var totalNetAccepte = App.storeListeMouvementStock.sum('PoidsNetAccepte') || 0;
            var totalNetLivre = App.storeListeMouvementStock.sum('PoidsNetLivre') || 0;
            var totalQuantite = App.storeListeMouvementStock.sum('Quantite') || 0;
            var totalPoidsBrut = App.storeListeMouvementStock.sum('PoidsBrut') || 0;

            totalNetAccepte = FormatAmount(totalNetAccepte);
            totalNetLivre = FormatAmount(totalNetLivre);
            totalQuantite = FormatAmount(totalQuantite);
            totalPoidsBrut = FormatAmount(totalPoidsBrut);*/
            /*App.lblSummaryMouvement.setHtml("Nbr De Mouvement : " + nbrOfrows);*/
        },

        resetButtons: function () {

        }
    };

    var SetStyleRows = function (record) {
        var _mClass = "";
        var nbrOfrows = App.grpListeMouvementStock.getStore().getCount();        
        if (record.data.Font === nbrOfrows) {
            _mClass = " colorC";
            App.lblSummaryMouvement.setHtml("Position Actuelle : " + record.data.Magasin.Designation);
        } else {

        }

        return _mClass;
    };
</script>

@*@model Tms.Classes.Business.BonDeLivraison*@
@{
    Layout = null;
    var X = Html.X();
}

@(Html.X().ResourceManager().AjaxTimeout(3600000))

<form id="tms_form">
    @(
    X.Viewport()
        .Layout(LayoutType.Border)
        .ID("TmsViewPort")
        .Items
            (
    #region Champs Masqués
            X.Hidden().ID("BaseUrl").Value(ViewBag.BaseUrl),
                X.Hidden().ID("mvhiddenPermDesactiver").ReadOnly(true),
                X.Hidden().ID("mvhiddenPermChangePosition").ReadOnly(true),
    #endregion
            X.Panel()
                    .ID("pnlNorth")
                    .Region(Region.North)
                    .Layout(LayoutType.Border)
                    .TopBar(new Toolbar()
                    {
                        #region Toolbar
                        Items =
                        {
                        X.Button()
                            .ID("btnFilter")
                            .IconCls("action_filter_02")
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Text("Filtrer")
                            .Disable(false)
                            .DirectEvents
                            (
                                de =>
                                {
                                    de.Click.Url  = Url.Action("OnFilter");
                                    de.Click.EventMask.ShowMask = true;
                                }
                            ),

                        X.Button()
                            .ID("btnRefresh")
                            .IconCls("action_refresh_01")
                            .Text("Rafraichir")
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Disable(false)
                            .DirectEvents
                                (
                                de =>
                                {
                                    de.Click.Url  = Url.Action("OnRefresh");
                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemLot", Encode=false, Value= "#{txtNumLot}.getRawValue()", Mode=ParameterMode.Raw});
                                    //de.Click.Success = "Overview.SummaryPanelMouvement();";
                                    //de.Click.Success = "App.MouvementStockCP.setTitle('Crop Year : '+ App.cmbFiltreCampagne.rawValue +', Magasin : ' + App.cmbFiltreMagasin.rawValue +', Exporter : '+ App.cmbFiltreExportateur.rawValue + ', Certification : ' + App.cmbFiltreCertification.rawValue +', Dir : '+ App.cmbFiltreDirection.rawValue + ', Type : ' + App.cmbFiltreMouvementType.rawValue + ', Position : ' + App.cmbFiltreEmplacement.rawValue + ', Status : ' + App.CmbFiltreStatut.rawValue )";
                                    de.Click.EventMask.ShowMask = true;
                                }
                                )




                                         }
                        #endregion
                    }
                               ),


                X.FormPanel()
                    .ID("MouvementStockCP")
                    .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Recherche Lot - overview" })
                    .Region(Region.North)
                    .Floatable(false)
                    .Border(false)
                    .Collapsed(false)
                    .Collapsible(true)
                    .BodyPadding(5)
                    .Frame(true)
                    .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Start })
                    .Items
                    (
    #region Critere de Filtre
    #region Zone A
                            X.Container()
                                    .Border(false)
                                    .Frame(false)
                                    .Margin(0)
                                    .Flex(1)
                                    .Layout(LayoutType.Form)
                                    //.BodyPadding(0)
                                    .Items
                                    (

                                        X.TextField()
                                            .ID("txtNumLot")
                                            .FieldLabel("Numéro Lot")
                                            .LabelAlign(LabelAlign.Right)
                                         //.Listeners(
                                         //    ls => ls.en
                                         //)
                                         ),
    #endregion

    #region Zone D

                            X.Container()
                                .Flex(1)
                                .Border(false)
                                .Layout(LayoutType.HBox)
                                .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                                .Items
                                 (
                                     X.Container()
                                        .Layout(LayoutType.VBox)
                                        .Flex(1)
                                        .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Center, Pack = BoxPack.Center })
                                         .Items(
                                                X.Label().ID("lblSummaryMouvement").Text("Resume").EmptyText("")
                                             )
                                 )
    #endregion
    #endregion
                ),
    #region GridPanel
            X.GridPanel()
                .Layout(LayoutType.Fit)
                .ID("grpListeMouvementStock")
                .Region(Region.Center)
                .ForceFit(false)
                .AllowDeselect(false)
                .Store
                (
                    X.StoreFor<Tms.Classes.Business.stock.MouvementStock>()
                        .ID("storeListeMouvementStock")
                        .PageSize(100)
                        .RemotePaging(false)
                        //.SorterFor(Model, m => m.DateLivraison, Ext.Net.SortDirection.DESC)
                        .AutoLoad(false)
                        .Proxy
                        (
                            Html.X().AjaxProxy()
                                //.Timeout(480000)
                                .Url(Url.Action("Select"))
                                .Reader(Html.X().JsonReader().RootProperty("data"))
                            )
                            .Parameters
                            (
                                ps =>
                                {
                                    ps.Add(new StoreParameter("ItemLot", "#{txtNumLot}.getRawValue()", ParameterMode.Raw));
                                }
                            )
                            .Listeners
                            (
                             ls =>
                             {
                                 ls.BeforeLoad.Handler = "Ext.net.Mask.show();";
                                 ls.Load.Handler = "Overview.SummaryMouvement(); Ext.net.Mask.hide();";                                 
                             }
                          )
                       )
                       .ColumnModel
                       (
                            Html.X().Column().Text("").DataIndex("mIcon").Width(40).Hideable(false).Renderer("renderIcon"),                            
                            Html.X().Column().Text("Date/Heure").DataIndex("DateMouvement").Flex(2).Renderer("renderDateLong"),
                            Html.X().Column().Text("Exportateur").DataIndex("ExportateurAsString").Flex(2),
                            //Html.X().Column().Text("Site").DataIndex("SiteAsString").Flex(2),
                            Html.X().Column().Text("Magasin").DataIndex("SiteAsString").Flex(2),
                            Html.X().Column().Text("Type De Mvt").DataIndex("MouvementTypeAsString").Flex(2),
                            Html.X().Column().Text("Ref 1").DataIndex("Reference1").Flex(1),
                            Html.X().Column().Text("# Lot").DataIndex("Reference2").Flex(1),
                            Html.X().Column().Text("Type/Sacs").DataIndex("SacTypeAsString").Flex(2),
                            Html.X().Column().Text("Nbr/Sacs").DataIndex("QuantiteAsString").Flex(1).EmptyCellText("0"),
                            Html.X().Column().Text("P. Brut").DataIndex("PoidsBrutAsString").Flex(1).EmptyCellText("0"),
                            Html.X().Column().Text("Tare/Sacs").DataIndex("TareSacsAsString").Flex(1).EmptyCellText("0"),
                            Html.X().Column().Text("Tare/Palettes").DataIndex("TarePalettesAsString").Flex(1).EmptyCellText("0"),
                            Html.X().Column().Text("P. Net").DataIndex("PoidsNetAccepteAsString").Flex(1).EmptyCellText("0"),
                            Html.X().Column().Text("Commentaire").DataIndex("Commentaire").Flex(1).Hidden(true),
                            Html.X().Column().Text("Creation User").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                            Html.X().DateColumn().Text("Creation Date").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                            Html.X().Column().Text("Modification User").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                            Html.X().DateColumn().Text("Modification Date").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")

                         )
                         .BottomBar
                         (
                             Html.X().PagingToolbar()
                            .HideRefresh(true)
                            .Plugins(Html.X().ProgressBarPager())
                         )
                         .Plugins
                         (
                           X.FilterHeader()
                         )
                        .SelectionModel
                        (
                          X.RowSelectionModel()
                           .ID("rowMouvementStock")
                           .Mode(SelectionMode.Single)
                           .AllowDeselect(false)
                        )
                        .View(
                            Html.X().GridView().LoadingText("Chargement ...")
                                .GetRowClass(g =>
                                    {
                                        g.Fn = "SetStyleRows";
                                    })
                    )
                    .Listeners(l => { l.Select.Fn = "Overview.resetButtons"; l.Deselect.Fn = "Overview.resetButtons"; })
                    .DirectEvents(de =>
                    {
                        de.RowDblClick.Url = Url.Action("OnConsult");
                        de.RowDblClick.CleanRequest = true;
                        de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowMouvementStock}.getSelected().items[0].data" });
                        de.RowDblClick.EventMask.ShowMask = true;
                        de.RowDblClick.Success = "App.FormMouvementStock.setTitle('Mouvement de Stock : Detail')";
                    }
                       )
    #endregion
        )
    )

</form>



<script type="text/javascript">

    var GenerateBLReport = function (record,baseurl) {
        var id = record[0].data.ID;
        Ext.net.DirectMethod.request({ url: baseurl+"/BonDeLivraison/OnPrintDeliveryNote?IdBon="+ id +"&IsCopy=0" });
    };
</script>