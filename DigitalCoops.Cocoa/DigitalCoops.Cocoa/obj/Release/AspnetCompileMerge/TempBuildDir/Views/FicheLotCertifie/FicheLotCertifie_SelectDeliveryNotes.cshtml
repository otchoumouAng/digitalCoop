@{
    Layout = null;
    var X = Html.X();
    string StartDate = DateTime.Now.AddDays(-30).ToShortDateString();
    string EndDate = DateTime.Now.ToShortDateString();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style>
    .x-btn-default-toolbar-small {
        padding: 2px 7px 2px 7px;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script>
    var SetAvailableNotesInfos = function () {
       var PoidsNetAccepte = App.storeListDeliveryNotes.sum('PoidsNetAccepte') || 0;

        var mChaine = Ext.String.format('Total Livré : {0} (Kg)', formatNumber(PoidsNetAccepte));
        App.LblResumeAvlbNotes.setText(mChaine);

    };

    var SetValidBtnOK = function () {
        if (App.RowPendingBLforInvoice.hasSelection())
            App.BtnSendBlDelivery.enable();
        else
            App.BtnSendBlDelivery.disable();
    };
</script>
@(                    
X.Window()
    .ID("FicheLotCertifie_SelectDeliveryNotes")
    .Width(880)
    .Resizable(false)
    .Height(470)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .X(200)
    .Y(20)
    .Title("BE Disponibles")
    .Layout(LayoutType.VBox)
    .BodyPadding(5)
    .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch })
    .Items
    (
        X.FormPanel()
            .ID("CriteriaPanelDeliveryNote")
            .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "BE - Livraisons disponibles", Height = 20 })
            .Region(Region.North)
            .Border(false)
            .Collapsed(false)
            .Collapsible(true)
            .BodyPadding(5)
            .Frame(true)
            .Layout(LayoutType.HBox)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
            .HeaderConfig(new PanelHeader
            {
                Items = {
                            X.Button()
                                .ID("btnRefreshDeliveryNote")
                                .IconCls("action_refresh_01")
                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                                .Border(false)
                                .Cls("ButtonStyle")
                                .Disable(false)
                                .DirectEvents
                                (
                                    de =>
                                    {
                                        de.Click.Url  = Url.Action("OnRefreshForAvailableDeliveryNotes");
                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemFournisseur", Encode=true, Value= "#{cmbFournisseurFD}.getValue()", Mode=ParameterMode.Raw});
                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodStart", Value= "#{dtpStartDateFD}.getRawValue()",   Mode=ParameterMode.Raw});
                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodEnd", Value= "#{dtpEndDateFD}.getRawValue()",     Mode=ParameterMode.Raw});
                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemCertification", Value= "#{cmbFiltreCertificationLiv}.getValue()",     Mode=ParameterMode.Raw});
                                        de.Click.Success = "App.CriteriaPanelDeliveryNote.setTitle('Fournisseur : ' + App.cmbFournisseurFD.rawValue + 'Certification = ' + App.cmbFiltreCertificationLiv.rawValue + ', du  '+ App.dtpStartDateFD.rawValue  + ' au  '+ App.dtpEndDateFD.rawValue )";
                                        de.Click.EventMask.ShowMask = true;
                                    }
                                )
                    }
            }
            )
            .Items
            (
                        X.Panel()
                            .Border(false)
                            .Flex(2)
                            .Layout(LayoutType.Form)
                            .Items
                            (
                                X.ComboBox()
                                    .ID("cmbFournisseurFD")
                                    .FieldLabel("Fournisseur")
                                    .DisplayField("Nom")
                                    .ValueField("ID")
                                    .LabelAlign(LabelAlign.Right)
                                    .TypeAhead(true)
                                    .ForceSelection(true)
                                    .Store
                                    (
                                        X.Store()
                                            .AutoLoad(true)
                                            .Model
                                            (
                                                    X.Model()
                                                    .IDProperty("ID")
                                                    .Fields
                                                    (
                                                        new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                        new ModelField("Nom", ModelFieldType.String) { Mapping = "NameAndCode" }
                                                    )
                                            )
                                            .Proxy
                                            (
                                                X.AjaxProxy()
                                                    .Url(Url.Action("LoadFournisseurAll", "Fournisseur"))
                                                    .Reader(X.JsonReader().RootProperty("data"))
                                            )
                                    )
                                    .SelectedItems
                                    (
                                        it =>
                                        {
                                            it.Add(new ListItem { Text = "{Tous}", Value = "-1" });
                                        }
                                    ),
                                X.ComboBox()
                                    .ID("cmbFiltreCertificationLiv")
                                    .EmptyText("")
                                    .TabIndex(3)
                                    .ForceSelection(true)
                                    .TypeAhead(true)
                                    .QueryMode(DataLoadMode.Local)
                                    .TriggerAction(TriggerAction.All)
                                    .AllowBlank(false)
                                    .IndicatorCls("IndicatorRedStar")
                                    .IndicatorText("*")
                                    .FieldLabel("Certification")
                                    .DisplayField("Designation")
                                    //.MatchFieldWidth(false)
                                    .ListConfig(new BoundList { MinWidth = 300 })
                                    .ValueField("ID")
                                    .ReadOnly(true)
                                    .LabelAlign(LabelAlign.Right)
                                    .Value(int.Parse(ViewData["CertificationID"].ToString()))
                                    .Store
                                    (
                                        X.Store()
                                            .AutoLoad(true)
                                            .Model
                                            (
                                                X.Model()
                                                    .IDProperty("ID")
                                                    .Fields
                                                    (
                                                        new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                        new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                    )
                                            )
                                            .Proxy
                                            (
                                                X.AjaxProxy()
                                                .Url(Url.Action("LoadCertification", "Certification"))
                                                .Reader(X.JsonReader().RootProperty("data"))
                                            )
                                    //.Listeners
                                    //(
                                    //    li => li.Load.Handler = "var combo = App.cmbFiltreCertificationLiv; combo.setValue(records.length > 0 ? records[0].data.ID : 0);"
                                    //)
                                    )
                            ),
                    X.Panel()
                        .ID("")
                        .Flex(2)
                        .Layout(LayoutType.Form)
                        .Items(
                                X.DateField()
                                    .ID("dtpStartDateFD")
                                    .FieldLabel("Du")
                                    .LabelAlign(LabelAlign.Right)
                                    .Text(@StartDate),
                                X.DateField()
                                    .ID("dtpEndDateFD")
                                    .LabelAlign(LabelAlign.Right)
                                    .FieldLabel("Au")
                                    .Text(@EndDate)
                                ),
                    X.Container()
                        .ID("")
                        .Layout(LayoutType.VBox)
                        .Flex(1)
                        .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
                        .Items(
                                    X.Label()
                                        .ID("LblResumeAvlbNotes")
                                        .Text("")
                                        .EmptyText("")
                                )
                    ),

            //X.Hidden()
            // .ID("TxtExecMode").Value(Model._ExecMode),
            X.GridPanel()
                .Layout(LayoutType.Fit)
                .ID("grpListDeliveryNotes")
                .MarginSpec("5 0 0 0")
                //.MinHeight(130)
                .Frame(true)
                .Height(220)
                .AllowDeselect(true)
                .Store
                (
                    X.StoreFor<Tms.Classes.Business.stock.FicheLotCertifieLivraison>()
                        .ID("storeListDeliveryNotes")
                        .AutoLoad(false)
                        .Proxy
                        (
                        X.AjaxProxy()
                            .Url(Url.Action("LoadListOfAvailableDeliveryNotes"))
                            .Reader(X.JsonReader().RootProperty("data"))
                        )
                             .Listeners(
                                ls =>
                                {
                                    ls.BeforeLoad.Handler = "Ext.net.Mask.show();";
                                    ls.Load.Handler = "SetAvailableNotesInfos(); Ext.net.Mask.hide();";
                                }
                            )
                             .Parameters
                             (
                               ps =>
                               {
                                   ps.Add(new StoreParameter("ItemFournisseur", "#{cmbFournisseurFD}.getValue()", ParameterMode.Raw));
                                   ps.Add(new StoreParameter("ItemPeriodStart", "#{dtpStartDateFD}.getRawValue()", ParameterMode.Raw));
                                   ps.Add(new StoreParameter("ItemPeriodEnd", "#{dtpEndDateFD}.getRawValue()", ParameterMode.Raw));
                                   ps.Add(new StoreParameter("ItemCertification", "#{cmbFiltreCertificationLiv}.getValue()", ParameterMode.Raw));
                               }
                             )
                             )
                             .ColumnModel
                             (
                                X.Column().Text("Date Livraison").DataIndex("DateLivraisonAstring").Flex(1).Hideable(false),
                                X.Column().Text("Note N°").DataIndex("NoteNumero").Flex(1).Hideable(false),
                                //X.Column().Text("Fournisseur").DataIndex("FournisseurNom").Flex(2).Hideable(false),
                                X.Column().Text("N° Livraison").DataIndex("LivraisonID").Flex(1).Hideable(false),
                                X.Column().Text("Nbr de sacs").DataIndex("NombreSacsLivraison").Flex(1).Hideable(false).Editor(X.NumberField().ID("NewNbrSacs").HideTrigger(true)),
                                X.Column().Text("Poids Net (Kg)").DataIndex("PoidsNetAccepteAsString").Flex(1).Hideable(false)
                             )
                             .Plugins
                             (
                                X.CellEditing().ClicksToEdit(1)
                            )
                            .Listeners(
                                ls => ls.BeforeEdit.Handler = "App.NewNbrSacs.setMaxValue(e.record.data.NombreSacs);"
                            )
                            .SelectionModel(
                               X.CheckboxSelectionModel()
                                    .ID("RowPendingBLforInvoice")
                                    .Mode(SelectionMode.Multi)
                           )
                       )

                       .Buttons
                       (
                           X.Button()
                            .Text("OK")
                            .ID("BtnSendBlDelivery")
                            .DirectEvents
                           (
                              de =>
                              {
                                  de.Click.Url = Url.Action("SubmitDeliveryNote");
                                  de.Click.ExtraParams.Add(new Parameter { Name = "selectedRows", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListDeliveryNotes}.getRowsValues({selectedOnly : true})" });
                              }
                           ),

                           X.Button()
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                            .Handler("App.FicheLotCertifie_SelectDeliveryNotes.doClose()")
                            .Cls("btncancel")

                          )

//)
)

@Scripts.Render("~/bundles/validation")









