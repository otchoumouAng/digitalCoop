<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <style type="text/css">
        .header_style {
            background-color: white;
        }

        .x-form-text-default {
            padding: 2px 10px 2px !important;
            min-height: 32px !important;
        }

            .x-form-text-default.x-form-textarea {
                line-height: 17px;
                min-height: 50px !important;
            }

        .title_style {
            color: black;
            font-size: small;
            line-height: inherit;
        }

        .frame_title_style {
            border: 1px solid transparent !important;
            border-bottom-width: 0px !important;
            color: black;
            font-size: small;
            line-height: inherit;
        }

        #txtSecondGrossWeight-inputEl, #txtFirstGrossWeight-inputEl {
            font-size: 30px !important;
            font-weight: bold !important;
            height: 40px !important;
            text-align: center !important;
            line-height: 34px !important;
        }

        .x-form-layout-auto-label > * > .x-form-item-label {
            width: 100px !important;
            font-weight: bold !important;
        }

        .x-panel .x-panel-header-default-framed-top {
            border-bottom-width: 0px !important;
        }
    </style>
    <script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
    <script type="text/javascript">
        var GetNbrOfPallets = function () {
            var nbrOfrows = App.grpListeBL.getStore().getCount();
            App.txtNombrePalette.setValue(nbrOfrows);
        };

      var CalculateValues = function () {
          var totalNbrSacs = App.storeListeLotVt.sum('NombreSacs') || 0;
          var totalPoidsBrut = App.storeListeLotVt.sum('PoidsBrut') || 0;
          var totalPoidsNet = App.storeListeLotVt.sum('PoidsNet') || 0;
          var totalMontant = App.storeListeLotVt.sum('Montant') || 0;
          var nbrOfrows = App.grpListeBL.getStore().getCount();

          App.txtNombreSacs.setValue(formatNumber(totalNbrSacs));
          App.txtPoidsBrut.setValue(formatNumber(totalPoidsBrut));

      };

      var CalculateNetWeight = function () {
          var totalNbrSacs = App.storeListeLotVt.sum('NombreSacs') || 0;
          var totalPoidsBrut = App.storeListeLotVt.sum('PoidsBrut') || 0;

          App.txtNetWeight.setValue(formatNumber(totalPoidsNet));
      };

      var CheckChangedData = function () {

       App.btnResumeTransfert.fireEvent('click', App.btnResumeTransfert);

      };

      var RoundInt = function (v) {
          try {
              if ((parseFloat(v) - parseInt(v)) > 0.5) {
                  return parseInt(v) + 1;
              }
              else {
                  return parseInt(v);
              }
          } catch (err) {
              return 0;
          }
      };
    </script>

</head>

