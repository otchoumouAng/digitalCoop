@model Tms.Classes.Business.Financement
@{
    Layout = null;
    var X = Html.X();
}

@(

    X.Window()
        .ID("frmCriteriaForFinancing")
        .Width(700)
        .Resizable(false)
        .Height(230)
        .Modal(true)
        .Y(100)
        .Title(ViewData["Titre"] + " : Critères")
        .Layout(LayoutType.Form)
        .Items
        (

            X.FormPanel().Layout(LayoutType.HBox)
                    .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Center })
                    .Items(
                            X.Panel().Layout(LayoutType.VBox)
                            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch })
                            .Flex(1)
                            .Items(
                                X.ComboBox()
                                        .ID("CpDetcmbSite")
                                        .FieldLabel("Site")
                                        .DisplayField("Nom")
                                        .ValueField("ID")
                                        .MatchFieldWidth(false)
                                        .ListConfig(new BoundList { MinWidth = 300 })
                                        .LabelAlign(LabelAlign.Right)
                                        .TypeAhead(false)
                                        .QueryMode(DataLoadMode.Local)
                                        .TriggerAction(TriggerAction.All)
                                        .ForceSelection(true)

                                        .ReadOnly(true)
                                        .Value(Model.Sites.ID)
                                        .Store(
                                                X.Store()
                                                .AutoLoad(true)
                                                .Model(
                                                        Html.X().Model()
                                                        .IDProperty("ID")
                                                        .Fields(
                                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                    new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                                                )
                                                    )
                                                .Proxy(
                                                            Html.X().AjaxProxy()
                                                            .Url(Url.Action("LoadSiteByAccess", "Site"))
                                                .Reader(
                                                            Html.X().JsonReader().RootProperty("data")
                                                            )
                                                )
                                        ).Listeners(
                                                ls =>
                                                {
                                                    ls.Select.Handler = "if (App.CpDetcmbSite.value) { App.cmbDetFournisseur.clearValue(); App.cmbDetFournisseur.getStore().load(); };";
                                                }
                                            ),
                                X.ComboBox()
                                .ID("cmbDetCropYear")
                                .FieldLabel("Campagne")
                                .DisplayField("Designation")
                                .QueryMode(DataLoadMode.Local)
                                .TriggerAction(TriggerAction.All)
                                .ValueField("Designation")
                                .LabelAlign(LabelAlign.Right)
                                .Store(
                                        X.Store()
                                            .AutoLoad(true)
                                            .Listeners(l => l.Load.Handler = "App.cmbDetCropYear.setValue(App.cmbDetCropYear.getStore().getAt(0));")
                                            .Model(
                                                    Html.X().Model()
                                                        .IDProperty("Designation")
                                                        .Fields(
                                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" },
                                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                                )
                                                    )
                                            .Proxy(
                                                    Html.X().AjaxProxy()
                                                    .Url(
                                                            Url.Action("LoadCampagneAll", "Campagne")
                                                    )
                                            .Reader(
                                                        Html.X().JsonReader().RootProperty("data")
                                                        )
                                            )
                                            ),
                            X.ComboBox()
                                .ID("cmbDetFournisseur")
                                .FieldLabel("Fournisseur")
                                .MatchFieldWidth(false)
                                .ListConfig(new BoundList { MinWidth = 350 })
                                .DisplayField("NameAndCode")
                                .ValueField("ID")
                                .LabelAlign(LabelAlign.Right)
                                .TypeAhead(false)
                                .ForceSelection(true)
                                .QueryMode(DataLoadMode.Local)
                                .TriggerAction(TriggerAction.All)
                                .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "-1" }); })
                                .Store(
                                        X.Store()
                                        .AutoLoad(true)
                                        .Listeners(l => l.Load.Handler = "App.cmbDetFournisseur.setValue(App.cmbDetFournisseur.getStore().getAt(0));")
                                        .Model(
                                                Html.X().Model()
                                                    .IDProperty("ID")
                                                        .Fields(
                                                        new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                        new ModelField("NameAndCode", ModelFieldType.String) { Mapping = "NameAndCode" }
                                                        )
                                                )
                                        .Proxy(Html.X().AjaxProxy()
                                        .Url(Url.Action("LoadAllSupplierBySite", "Fournisseur"))
                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                        ).Parameters
                                                        (
                                                        ps => { ps.Add(new StoreParameter("siteID", "App.CpDetcmbSite.getValue()", ParameterMode.Raw)); }
                                                        )

                                        ),
                            X.ComboBox()
                                .ID("cmbDetTypeFinancing")
                                .FieldLabel("Type")
                                .DisplayField("Designation")
                                .ValueField("ID")
                                .MatchFieldWidth(false)
                                .ListConfig(new BoundList { MinWidth = 350 })
                                .LabelAlign(LabelAlign.Right)
                                .TypeAhead(false)
                                .QueryMode(DataLoadMode.Local)
                                .TriggerAction(TriggerAction.All)
                                .ForceSelection(true)
                                .Store(
                                        X.Store()
                                        .Listeners(l => l.Load.Handler = "#{cmbDetTypeFinancing}.setValue(App.cmbDetTypeFinancing.getStore().getAt(0));")
                                        .AutoLoad(true)
                                        .Model(
                                                Html.X().Model()
                                                .IDProperty("ID")
                                                .Fields(
                                                            new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                            new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                        )
                                            )
                                .Proxy(
                                            Html.X().AjaxProxy()
                                            .Url(
                                                    Url.Action("LoadAll", "FinancementType")
                                                    )
                                .Reader(
                                            Html.X().JsonReader().RootProperty("data")
                                            )
                                )
                            )
            ),
            X.Panel()
                .Layout(LayoutType.Form)
                .Flex(1)
                .Items(
                        X.DateField().ID("dtfDetStartDate").FieldLabel("Date Debut").LabelAlign(LabelAlign.Right).SelectedDate(Model.DateFinancement)
                        ,
                        X.DateField().ID("dtfDetEndDate").FieldLabel("Date Fin").LabelAlign(LabelAlign.Right).SelectedDate(Model.DateEcheance)
                        ,
                        X.ComboBox()
                            .ID("cmbDetStatus")
                            .FieldLabel("Statut")
                            .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "%%" }); })
                            .DisplayField("Nom")
                            .ValueField("ID")
                            .LabelAlign(LabelAlign.Right)
                            .TypeAhead(true)
                            .ForceSelection(true)
                            .Items(
                                    new ListItem("{Tous}", "%%"),
                                    new ListItem("Approuvé", "AP"),
                                    new ListItem("Non Approuvé", "NA")
                                    ),
                        X.ComboBox()
                            .ID("cmbDetOption")
                                                .FieldLabel("Option")
                                                .LabelAlign(LabelAlign.Right)
                                                //.MatchFieldWidth(false)
                                                //.ListConfig(new BoundList { MinWidth = 200 })
                                                .TypeAhead(false)
                                                .QueryMode(DataLoadMode.Local)
                                                .TriggerAction(TriggerAction.All)
                                                .Items(
                                                        new ListItem("{Tous}", "NO"),
                                                        new ListItem("Payé", "PA"),
                                                        new ListItem("Non payé", "NP")
                                                    )
                                                .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "NO" }); })
                        )
                )
        )
        .Buttons
        (
            X.Button()
                .Text("OK")
                .ID("BtnOk")
                .DirectEvents
                (
                    d =>
                    {
                        d.Click.Url = Url.Action(ViewData["actionToDo"].ToString(), ViewData["ControllerName"].ToString());
                        d.Click.ExtraParams.Add(new Parameter { Name = "cropyear", Value = "#{cmbDetCropYear}.getRawValue()", Encode = false, Mode = ParameterMode.Raw });
                        d.Click.ExtraParams.Add(new Parameter { Name = "fournisseur", Value = "#{cmbDetFournisseur}.getValue()", Encode = false, Mode = ParameterMode.Raw });
                        d.Click.ExtraParams.Add(new Parameter { Name = "fournisseurText", Value = "#{cmbDetFournisseur}.getRawValue()", Encode = false, Mode = ParameterMode.Raw });
                        d.Click.ExtraParams.Add(new Parameter { Name = "typefinancement", Value = "#{cmbDetTypeFinancing}.getValue()", Encode = false, Mode = ParameterMode.Raw });
                        d.Click.ExtraParams.Add(new Parameter { Name = "typefinancementText", Value = "#{cmbDetTypeFinancing}.getRawValue()", Encode = false, Mode = ParameterMode.Raw });
                        d.Click.ExtraParams.Add(new Parameter { Name = "statut", Value = "#{cmbDetStatus}.getValue()", Encode = false, Mode = ParameterMode.Raw });
                        d.Click.ExtraParams.Add(new Parameter { Name = "statutText", Value = "#{cmbDetStatus}.getRawValue()", Encode = false, Mode = ParameterMode.Raw });
                        d.Click.ExtraParams.Add(new Parameter { Name = "startDate", Value = "#{dtfDetStartDate}.getRawValue()", Encode = false, Mode = ParameterMode.Raw });
                        d.Click.ExtraParams.Add(new Parameter { Name = "endDate", Value = "#{dtfDetEndDate}.getRawValue()", Encode = false, Mode = ParameterMode.Raw });
                        d.Click.ExtraParams.Add(new Parameter { Name = "siteID", Value = "#{CpDetcmbSite}.getValue()", Encode = false, Mode = ParameterMode.Raw });
                        d.Click.ExtraParams.Add(new Parameter { Name = "siteNom", Value = "#{CpDetcmbSite}.getRawValue()", Encode = false, Mode = ParameterMode.Raw });
                        d.Click.FormID = "#(return this.up('window').down('form');)";
                    }
                ),
            X.Button()
                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                .Handler("App.frmCriteriaForFinancing.doClose()")
                .Cls("btncancel")
        )

)






