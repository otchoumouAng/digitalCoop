@*@model IEnumerable<Tms2017.MVC.Models.Module>*@
@model IEnumerable<Tms.Classes.Security.Application>
<script type="text/javascript" src="~/Scripts/jquery-1.10.2.js"></script>
<script type="text/javascript">
    function submit(id) {

        $.ajax({
            'url': 'ShowUserModule/?AppID=' + id,
            'content-type':'application/html; charset=utf-8',
            'type':'GET',
            'dataType':'html'
                })
                .success(function (result) {
                  
                    $('#wrapper').html(result);

                    var array = $('#' + id).siblings().each(function (index, item) { item.className = ''; });                    
                    
                    $('#'+id).addClass('item_selected');
                    
                })
                .error(function(xhr, status) {

                    alert(status);
                })

    }
</script>
<style type="text/css">
.x-body 
{
    color: #404040;
    font-size: 13px;
    line-height: 17px;
    font-weight: 300;
    font-family: 'Open Sans', 'Helvetica Neue', helvetica, arial, verdana, sans-serif;
    background: #FAFAFA  !important;
}
</style>


<div id="Menu" style="width:800px; margin:20px auto 0 auto;">
    @if (Model.Count() > 0)
    {
        foreach (var item in Model)
        {
            <a id="@item.ID" href="javascript:submit('@item.ID')">@item.Nom</a> <text>|</text>
        }
    }               
</div>


