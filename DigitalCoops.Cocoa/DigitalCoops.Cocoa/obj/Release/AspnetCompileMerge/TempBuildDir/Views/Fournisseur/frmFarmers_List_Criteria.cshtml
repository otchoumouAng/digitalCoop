@{
    Layout = null;
    var X = Html.X();
}
<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
    width: 70px !important;
}
</style>
@(                        
X.Window()
    .ID("frmSuppliersList")
    .Width(610)
    .Resizable(false)
    .Height(200)
    .Modal(true)
    .Y(100)
    .Title("Liste des Fournisseurs : Criteres")
    //.Layout(LayoutType.HBox)
    //.LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Center })
    .Items
    (
        X.FormPanel()
            .Layout(LayoutType.HBox)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
            .Items(

                    X.Panel()
                        .ID("pnlRepLeft")
                        .Layout(LayoutType.Form)
                        .Flex(1)
                        .Items
                        (
                            X.ComboBox()
                                .ID("cmbRepSite")
                                .FieldLabel("Site")
                                .DisplayField("Nom")
                                .ValueField("ID")
                                .MatchFieldWidth(false)
                                .ListConfig(new BoundList { MinWidth = 300 })
                                .LabelAlign(LabelAlign.Right)
                                .TypeAhead(false)
                                .QueryMode(DataLoadMode.Local)
                                .TriggerAction(TriggerAction.All)
                                .ForceSelection(true)
                                //.ReadOnly(true)
                                .Value((int)ViewData["SiteParDefaut"])
                                .Store(
                                        X.Store()
                                        .Listeners(l => l.Load.Handler = "App.cmbRepSite.setValue(App.cmbRepSite.getStore().getAt(0));")
                                        .AutoLoad(true)
                                        .Model(
                                                Html.X().Model()
                                                .IDProperty("ID")
                                                .Fields(
                                                            new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                            new ModelField("Nom", ModelFieldType.String) { Mapping = "Designation" }
                                                        )
                                            )
                                .Proxy(
                                            Html.X().AjaxProxy()
                                            .Url(Url.Action(ViewData["UrlSite"].ToString(), "Site"))
                                .Reader(
                                            Html.X().JsonReader().RootProperty("data")
                                            )
                                )
                                ),
                            X.ComboBox()
                                .ID("cmbRepGroupeFournisseur")
                                .FieldLabel("Groupe")
                                //.LabelWidth(50)
                                .DisplayField("Designation")
                                .ValueField("ID")
                                .LabelAlign(LabelAlign.Right)
                                .ForceSelection(true)
                                //.ListConfig(new BoundList { Width = 600, MinWidth = 500 })
                                .TypeAhead(true)
                                .QueryMode(DataLoadMode.Local)
                                .TriggerAction(TriggerAction.All)
                                .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "-1" }); })
                                .Store(
                                        X.Store()
                                            .AutoLoad(true)
                                            .Model(Html.X().Model()
                                            .IDProperty("ID")
                                                    .Fields(
                                                        new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                        new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                    )
                                                )
                                            .Proxy(Html.X().AjaxProxy()
                                                .Url(Url.Action("LoadGroupFournisseurAll", "FournisseurGroupe"))
                                                .Reader(Html.X().JsonReader().RootProperty("data"))
                                            )
                                ),

                             X.ComboBox()
                                .ID("cmbRepFournisseurType")
                                .FieldLabel("Type de fournisseur")
                                .DisplayField("Designation")
                                .ValueField("ID")
                                //.LabelWidth(60)
                                .LabelAlign(LabelAlign.Right)
                                .ForceSelection(true)
                                //.ListConfig(new BoundList { Width = 600, MinWidth = 500 })
                                .TypeAhead(true)
                                .QueryMode(DataLoadMode.Local)
                                .TriggerAction(TriggerAction.All)
                                .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "-1" }); })
                                .Store
                                (
                                    X.Store()
                                        .AutoLoad(true)
                                        .Model
                                        (
                                                Html.X().Model()
                                                .IDProperty("ID")
                                                .Fields
                                                (
                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                )
                                        )
                                        .Proxy
                                        (
                                                Html.X().AjaxProxy()
                                                .Url(Url.Action("LoadFournisseurTypeAll", "FournisseurType"))
                                                .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )
                                )
                            ),
                        X.Panel()
                            .ID("pnlRepRight")
                            .Layout(LayoutType.Form)
                            .Flex(1)
                            //.Width(250)
                            //.Height(140)
                            .Items
                            (
                                         X.ComboBox()
                                            .ID("cmbRepStatus")
                                            .FieldLabel("Statut")
                                            .DisplayField("Description")
                                            .ValueField("ID")
                                            //.LabelWidth(60)
                                            .LabelAlign(LabelAlign.Right)
                                            .ForceSelection(true)
                                            //.ListConfig(new BoundList { Width = 600, MinWidth = 500 })
                                            .TypeAhead(true)
                                            .QueryMode(DataLoadMode.Local)
                                            .TriggerAction(TriggerAction.All)
                                            .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "-1" }); })
                                            .Store
                                            (
                                                    X.Store()
                                                    .AutoLoad(true)
                                                    .Model
                                                        (
                                                            Html.X().Model()
                                                            .IDProperty("ID")
                                                            .Fields
                                                                    (
                                                                        new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                        new ModelField("Description", ModelFieldType.String) { Mapping = "Description" }
                                                                    )
                                                        )
                                                    .Proxy
                                                    (
                                                        Html.X().AjaxProxy()
                                                        .Url(Url.Action("LoadForSuppliers", "StatusString"))
                                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                                    )
                                             ),
                                                X.ComboBox()
                                                .ID("cmbRepCertification")
                                                .FieldLabel("Certification")
                                                .DisplayField("Designation")
                                                .ValueField("ID")
                                                //.LabelWidth(90)
                                                .LabelAlign(LabelAlign.Right)
                                               .ForceSelection(true)
                                                //.ListConfig(new BoundList { Width = 600, MinWidth = 500 })
                                                .TypeAhead(true)
                                                .QueryMode(DataLoadMode.Local)
                                                .TriggerAction(TriggerAction.All)
                                                .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "-1" }); })
                                                .Store(
                                                        X.Store()
                                                        .AutoLoad(true)
                                                        .Model
                                                            (
                                                                Html.X().Model()
                                                                .IDProperty("ID")
                                                                .Fields
                                                                        (
                                                                            new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                            new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                                        )
                                                            )
                                                        .Proxy
                                                            (
                                                                Html.X().AjaxProxy()
                                                                .Url(Url.Action("LoadCertificationAll", "Certification"))
                                                                .Reader(Html.X().JsonReader().RootProperty("data"))
                                                            )
                                                       )
                                        ,

                                                X.ComboBox()
                                                .ID("cmbRepApproval")
                                                .FieldLabel("Approuvé")
                                                .DisplayField("Description")
                                                .ValueField("ID")
                                                //.LabelWidth(90)
                                                .LabelAlign(LabelAlign.Right)
                                                .ForceSelection(true)
                                                //.ListConfig(new BoundList { Width = 600, MinWidth = 500 })
                                                .TypeAhead(true)
                                                .QueryMode(DataLoadMode.Local)
                                                .TriggerAction(TriggerAction.All)
                                                .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "-1" }); })
                                                .Store
                                                (
                                                        X.Store()
                                                        .AutoLoad(true)
                                                        .Model
                                                            (
                                                                Html.X().Model()
                                                                .IDProperty("ID")
                                                                .Fields
                                                                        (
                                                                            new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                            new ModelField("Description", ModelFieldType.String) { Mapping = "Description" }
                                                                        )
                                                            )
                                                        .Proxy
                                                            (
                                                                Html.X().AjaxProxy()
                                                                .Url(Url.Action("LoadForSuppliersApproval", "StatusString"))
                                                                .Reader(Html.X().JsonReader().RootProperty("data"))
                                                            )
                                              )

                                        )
                                        )
                        )
                         .Buttons
                        (
                            X.Button()
                            .Text("OK")
                            .ID("BtnOk")
                            .DirectEvents
                            (
                                de =>
                                {
                                    de.Click.Url = Url.Action("OnPrintSupplierList");
                                    de.Click.EventMask.ShowMask = true;
                                    de.Click.FormID = "#(return this.up('window').down('form');)";
                                    //de.Click.ExtraParams.Add(new Parameter { Name = "vCertified", Mode = ParameterMode.Raw, Encode = true, Value = "#{cmbRepCertification}.getValue()" });
                                    //de.Click.ExtraParams.Add(new Parameter { Name = "vCertifiedText", Mode = ParameterMode.Raw, Encode = true, Value = "#{cmbRepCertification}.getRawValue()" });
                                    //de.Click.ExtraParams.Add(new Parameter { Name = "vIsApproved", Mode = ParameterMode.Raw, Encode = true, Value = "#{cmbRepApproval}.getValue()" });
                                    //de.Click.ExtraParams.Add(new Parameter { Name = "vIsApprovedText", Mode = ParameterMode.Raw, Encode = true, Value = "#{cmbRepApproval}.getRawValue()" });
                                    //de.Click.ExtraParams.Add(new Parameter { Name = "vSupplierGroupID", Mode = ParameterMode.Raw, Encode = true, Value = "#{cmbRepGroupeFournisseur}.getValue()" });

                                    //de.Click.ExtraParams.Add(new Parameter { Name = "vIsDisabledText", Mode = ParameterMode.Raw, Encode = true, Value = "#{cmbRepStatus}.getRawValue()" });
                                    //de.Click.ExtraParams.Add(new Parameter { Name = "vIsDisabled", Mode = ParameterMode.Raw, Encode = true, Value = "#{cmbRepStatus}.getValue()" });

                                    //de.Click.ExtraParams.Add(new Parameter { Name = "vSupplierGroupName", Mode = ParameterMode.Raw, Encode = true, Value = "#{cmbRepGroupeFournisseur}.getRawValue()" });
                                    //de.Click.ExtraParams.Add(new Parameter { Name = "vSupplierTypeID", Mode = ParameterMode.Raw, Encode = true, Value = "#{cmbRepFournisseurType}.getValue()" });
                                    //de.Click.ExtraParams.Add(new Parameter { Name = "vSupplierTypeName", Mode = ParameterMode.Raw, Encode = true, Value = "#{cmbRepFournisseurType}.getRawValue()" });
                                }
                            )
                            //.Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult)


                            ,
                            X.Button()
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                            .Handler("App.frmSuppliersList.doClose()")
                            .Cls("btncancel")
                        )



)

