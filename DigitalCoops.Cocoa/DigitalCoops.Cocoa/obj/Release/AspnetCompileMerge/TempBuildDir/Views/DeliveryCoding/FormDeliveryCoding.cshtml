@model Tms.Classes.Business.LivraisonViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style type="text/css">
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 100px !important;
    }
</style>
<script type="text/javascript">              

    var OverviewCode =
    {
        SetButtons: function () {

            if (App.rowCode.hasSelection()) {
                if (App.CdhiddenPermRemove.value == 'true')
                    App.BtnRemoveCode.enable();

                if (App.CdhiddenPermPrintCode.value == 'true')
                    App.BtnPrintCode.enable();

            } else {

                App.BtnRemoveCode.disable();
                App.BtnPrintCode.disable();

            }
        }
    };


</script>
@(X.FormPanel()        
    .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
    .Items(
            X.Window()
            .ID("FormDeliveryCoding")
            .Width(500)
            .Resizable(false)
            .Height(470)
            .CloseAction(Ext.Net.CloseAction.Destroy)
            .Listeners(l =>
            {
                l.Close.Handler = "App.TmsViewPort.unmask();";

                if (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult)
                {
                    l.Show.Handler = "App.grpDeliveryCodeListe.getStore().load(); App.BtnGenerateCode.setDisabled(true);";
                }
                else
                {
                    l.Show.Handler = "App.grpDeliveryCodeListe.getStore().load(); App.TxtDeliveryNum.focus();";
                }
            })
            //.X(400)
            .Y(20)
            .Title("Codification : Detail")
            .Layout(LayoutType.Form)
            .Items(
                        X.Hidden().ID("CdhiddenPermRemove").Value(ViewData["HavPermissionRemove"]).ReadOnly(true),
                        X.Hidden().ID("CdhiddenPermPrintCode").Value(ViewData["HavPermissionPrint"]).ReadOnly(true),
                    X.FormPanel().ID("DeliveryCodingFormPanel")
                        .Layout(LayoutType.VBox)
                        .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch })
                        .Items(
                                X.Panel()
                                    .Layout(LayoutType.Form)                                    
                                    .Items(
                                            X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                                            X.Hidden().ID("hiddenRowversion").Value(Model._Livraison.RowVersionKey),
                                            X.Hidden().ID("hiddenMaxCodeAnalyseGenerate").Value(Model._Parametres.MaxCodeAnalyseGenere),                                            
                                            X.Hidden().ID("TxtDeliveryCodingID").Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.ID : Guid.Empty),                                            
                                            X.TextField().ID("TxtDeliveryNum").FieldLabel("Livraison N°").LabelAlign(LabelAlign.Right).Flex(1).AllowBlank(false).IndicatorIconCls("IndicatorRedStar").IndicatorText("*")
                                            .ReadOnly(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew? true : false)
                                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.Numero.ToString() : string.Empty)                                                
                                                .Listeners(ls =>
                                                {
                                                    ls.SpecialKey.Fn = "enterKeyPressHandler";
                                                })
                                                ,
                                            X.Button().ID("BtnSearchDeliveryInfo").Text("OK").Hidden(true)
                                            .DirectEvents(de => {
                                                de.Click.Url = Url.Action("SelectDeliveryInfo");
                                                de.Click.ExtraParams.Add(new Parameter { Name = "ItemDeliveryNumber", Mode = ParameterMode.Raw, Value = "#{TxtDeliveryNum}.getRawValue()" });

                                            }),                                                                        
                                            X.TextField()
                                                .ID("TxtDeliveryDate")
                                                .FieldLabel("Date Livraison")
                                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.DateLivraison.ToString() : string.Empty)
                                                .LabelAlign(LabelAlign.Right)
                                                .ReadOnly(true),
                                            X.TextField()
                                                .ID("TxtDeliveryType")
                                                .FieldLabel("Type de livraison")
                                                .LabelAlign(LabelAlign.Right)
                                                .ReadOnly(true)
                                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.LivraisonType.Designation.ToString() : string.Empty),
                                            X.TextField()
                                                .ID("TxtSupplier")
                                                .FieldLabel("Fournisseur")
                                                .LabelAlign(LabelAlign.Right)
                                                .ReadOnly(true)
                                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.Fournisseur.Nom.ToString() : string.Empty),
                                            X.TextField()
                                                .ID("TxtTruckID")
                                                .FieldLabel("Immatriculation")
                                                .LabelAlign(LabelAlign.Right)
                                                .ReadOnly(true)
                                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.Immatriculation.ToString() : string.Empty)

                                            ),
                           X.Panel()
                           .Layout(LayoutType.Fit)
                           .TopBar(
                               new Toolbar()
                               {
                                   Items =
                                   {
                                       X.Button()
                                            .ID("BtnGenerateCode")
                                            .IconCls("action_new_02")
                                            .Border(false)
                                            .Cls("ButtonStyle")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                                            .Disable(false)
                                            .Disabled(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? true : false)
                                            .DirectEvents( de =>
                                            {
                                                de.Click.Url  = Url.Action("GenerateCode");
                                                de.Click.ExtraParams.Add( new Parameter { Name = "StoreNbrOfRows", Mode = ParameterMode.Raw, Value = "#{storeDeliveryCodeListe}.getCount()" });
                                                de.Click.EventMask.ShowMask = true;
                                            } ),
                                        X.Button()
                                            .ID("BtnRemoveCode")
                                            //.IconCls("action_filter_02")
                                            .Icon(Icon.Delete)
                                            .Border(false)
                                            .Cls("ButtonStyle")
                                            .Text("Retirer")
                                            .Disabled(true)
                                            .DirectEvents(de =>
                                            {
                                                de.Click.Url = Url.Action("OnRemove");
                                                de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpDeliveryCodeListe}.getSelectionModel().getSelection()[0].data" });
                                                de.Click.ExtraParams.Add(new Parameter { Name = "storeListeDelivery", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListeCodeOverview.getRowsValues({selectedOnly : false})" });
                                                de.Click.EventMask.ShowMask = true;
                                                de.Click.Confirmation.ConfirmRequest = true;
                                                de.Click.Confirmation.BeforeConfirm = "config.confirmation.title = 'Codification : Retirer'; config.confirmation.message = 'Voulez-vous retirer ce code ? ';";
                                            }),
                                        X.Button()
                                            .ID("BtnPrintCode")
                                            .IconCls("action_print_02")
                                            .Border(false)
                                            .Cls("ButtonStyle")
                                            .Text("Imprimer Code")
                                            .Disabled(true)
                                            .DirectEvents( de =>
                                            {
                                                de.Click.Url  = Url.Action("OnPrintCode");
                                                de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Value = "#{grpDeliveryCodeListe}.getSelectionModel().getSelection()[0].data.Code" });
                                                de.Click.EventMask.ShowMask = true;
                                            } )
                                    }
                               })
                            .Items(
                                    X.GridPanel()
                                       .Layout(LayoutType.Fit)
                                       .ID("grpDeliveryCodeListe")
                                       .Region(Region.Center)
                                       .ForceFit(true)
                                       .Border(true)
                                       .Height(150)
                                       .AllowDeselect(true)
                                       .Store(
                                                X.StoreFor<Tms.Classes.Business.AnalyseCode>()
                                                    .ID("storeDeliveryCodeListe")
                                                    .AutoLoad(false)
                                                    .Proxy(
                                                           Html.X().AjaxProxy()
                                                           .Url(Url.Action("SelectCode"))
                                                           .Reader(
                                                                    Html.X().JsonReader().RootProperty("data")
                                                                    )
                                                      )
                                                    .Parameters(ps =>
                                                    {
                                                        ps.Add(new StoreParameter("ItemDelivery", "#{TxtDeliveryCodingID}.getValue()", ParameterMode.Raw));
                                                        ps.Add(new StoreParameter("ItemExecMode", "#{hiddenExecMode}.getValue()", ParameterMode.Raw));
                                                    })
                                        )
                                        .ColumnModel
                                        (
                                            Html.X().Column().Text("Code").DataIndex("Code").Hideable(false),
                                            Html.X().Column().Text("Coding Date").DataIndex("DateCodeAsString").Hideable(false)
                                        )
                                        .SelectionModel(
                                                        X.RowSelectionModel()
                                                            .ID("rowCode")
                                                            .Mode(SelectionMode.Single)
                                                            .AllowDeselect(true)
                                            )
                                        .Listeners(l =>
                                        {
                                            if (Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Consult)
                                            {
                                                l.Select.Fn = "OverviewCode.SetButtons";
                                                l.Deselect.Fn = "OverviewCode.SetButtons";
                                            }


                                        }
                                    )
                            )

                    )

            )
            .Buttons(
                        X.Button().Text("OK")
                        .ID("BtnSaveCode")
                        .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                        .DirectEvents(de =>
                        {
                            de.Click.Url = Url.Action("SubmitFormMethod");
                            //de.Click.Success = "ShowNotifaction();";
                            de.Click.Before = "return validNew(App.FormDeliveryCoding.id);";
                            de.Click.ExtraParams.Add(new Parameter { Name = "storerows", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpDeliveryCodeListe.getRowsValues({selectedOnly : false})" });
                            de.Click.ExtraParams.Add(new Parameter { Name = "storeListeDelivery", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListeCodeOverview.getRowsValues({selectedOnly : false})" });
                        }),
                        X.Button()
                            .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                            .Handler("App.FormDeliveryCoding.doClose()").Cls("btncancel")

                    )

            )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
                    /*alert(winId);*/
                    /*var winId = #{FormFournisseur}.id;*/
                    var areAllrequiredFieldsFilled = isFormValid(winId);

                    /*
                   *   Vérification de la saisie des champs obligatoires
                   */
                    if (!areAllrequiredFieldsFilled) {
                        console.log('error fileds');
                        Ext.Msg.show({ title: 'Codification : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Please enter the delivery ID', buttons: Ext.Msg.OK });
                        return false;
                    }

                }

        /*Ext.onReady(function() {
         #{BtnOk}.on(#{BtnOk}.clickEvent,validNew );
        //})*/
</script>
<script type="text/javascript" language="javascript">
    var enterKeyPressHandler = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            /*Ext.net.DirectMethod.request({ url: "/DeliveryCoding/SelectDeliveryInfo"});*/
            App.BtnSearchDeliveryInfo.fireEvent('click', App.BtnSearchDeliveryInfo);
            e.stopEvent();
        } 
    };

    var ShowNotifaction = function () {
        Ext.Msg.notify("Codification", "Code has been saved !");
    };
</script>
