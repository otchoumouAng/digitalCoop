<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Erreur : Transfert ', msg: 'Veuillez saisir les champs réquis svp !', buttons: Ext.Msg.OK });
            return false;
        }

    };

    var calculerNetLivre = function () {
        var tareBags = parseInt(unformatNumber(App.txtTareSac.value), 10) || 0;
        var tarePallets = parseInt(unformatNumber(App.txtTarePalette.value), 10) || 0;
        var poidsbrut = parseInt(unformatNumber(App.txtPoidsBrut.value), 10) || 0;
        var poidsnet = poidsbrut - tareBags - tarePallets;

        poidsnet = formatNumber(poidsnet);
        App.txtNetWeight.setValue(poidsnet);

    };

    var enterKeyPressHandler = function (f, e) {
        /*if (e.getKey() == e.ENTER || e.getKey() === 9) {
            var param = App.txtOrdreProduction.value;
            var baseurl = App.baseUrlVal.value;
            Ext.net.DirectMethod.request({ url: baseurl + "/PeseeAvantUsinage/SubmitOrdreProduction?ItemNumero=" + param });
            e.stopEvent();

        }*/
    };

    var onSearchByDeliveryID = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            var param = App.txtSiteID.value;
            var baseurl = App.baseUrlVal.value;
            Ext.net.DirectMethod.request({ url: baseurl + "/PeseeAgence/GetDelivery?ItemNumero=" + param });
            e.stopEvent();
        }
    };

    var CheckFieldsToFill = function () {
        /*if (App.cmbProduction.value && App.hiddenExecMode.value == 'AddNew')
        {
            App.btnAddNewLivraison.enable();
        };

        if (App.cmbProduction.value && App.txtDeliveryNumero.value) {
            App.txtDeliveryNumero.setValue("");
            App.txtNombreSacsDelivery.setValue("");
            App.txtBonDeLivraisonID.setValue("");
        };*/
    };

    var SetFieldsToFill = function () {
        var _CanFill = App.cmbMagasin.getSelectedRecord().data.APontBascule;
        if (_CanFill) {
            App.txtPoidsBrut.setReadOnly(false);
            App.txtTareSac.setReadOnly(false);
            App.txtTarePalette.setReadOnly(false);
            App.txtNetWeight.setReadOnly(false);
            App.txtNombreSacs.setReadOnly(false);
        } else {
            App.txtPoidsBrut.setReadOnly(true);
            App.txtTareSac.setReadOnly(true);
            App.txtTarePalette.setReadOnly(true);
            App.txtNetWeight.setReadOnly(true);
            App.txtNombreSacs.setReadOnly(true);
        }
    };
</script>








