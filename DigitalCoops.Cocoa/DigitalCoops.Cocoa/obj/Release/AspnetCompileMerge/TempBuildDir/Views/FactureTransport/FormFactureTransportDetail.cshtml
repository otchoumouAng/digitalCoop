
@model Tms.Classes.Business.FactureTransportViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />

</head>
<script src="~/Scripts/FormatAmount.js"></script>
<script src="~/Scripts/renderers.js"></script>
@(X.FormPanel()
        .FieldDefaults(fd => fd.ReadOnly = true)
    .Items(
            X.Window()
            .ID("FormFactureTransportDetail")
            .Width(1250)
            .Resizable(false)
            .Height(470)
            .CloseAction(Ext.Net.CloseAction.Destroy)
            .Listeners(l =>
            {
                l.Close.Handler = "App.TmsViewPort.unmask();";
                l.Show.Handler = "App.grpListeFactureTransportDetail.getStore().load();";

            })
            //.X(400)
            .Y(15)
            .Title("Facture Transport : Detail")
            .Layout(LayoutType.VBox)
            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Start })
            .Items(
                                //X.Panel().ID("DeliveryCodingFormPanel")
                                //    .Layout(LayoutType.Form)
                                //    //.LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
                                //.Items(
                                X.Panel()
                                    .Layout(LayoutType.Form)
                                    .MaxWidth(500)
                                    .Items(
                                            X.Hidden().ID("FactureTransportHiddenExecMode").Value(Model._ExecMode),
                                            X.Hidden().ID("hiddenRowversion").Value(Model._FactureTransport.RowVersionKey),
                                            X.Hidden().ID("hiddenFactureTransportID").Value(Model._FactureTransport.ID),
                                            X.Hidden().ID("hiddenFactureTransportTotalTonnage").Value(Model._FactureTransport.Tonnage),
                                            // X.Container().Layout(LayoutType.HBox).LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Top }).Items(
                                            X.FieldContainer()
                                                        .Layout(LayoutType.HBox).Width(350).FieldLabel("Date Facture").LabelAlign(LabelAlign.Right)
                                                        .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.StretchMax })
                                                        .Items(
                                                                    X.DateField()
                                                                        .Width(130)
                                                                        .ID("")
                                                                        .LabelAlign(LabelAlign.Right)
                                                                        .Text(Model._FactureTransport.DateFactureTransport.ToShortDateString())
                                                                        .AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                                                                        .MarginSpec("0 10 0 0"),
                                                                    X.TimeField()
                                                                        .ID("")
                                                                        .LabelAlign(LabelAlign.Right)
                                                                        .Text(Model._FactureTransport.DateFactureTransport.ToShortTimeString())
                                                                )
                                                ,
                                            X.TextField()
                                                .FieldLabel("Transporteur")
                                                .LabelAlign(LabelAlign.Right)
                                                .Value(Model._FactureTransport.Transporteur.Nom)
                                                .MarginSpec("0 10 0 0")
                                                ,
                                            X.TextField()
                                                .FieldLabel("Mode Of Payement")
                                                .LabelAlign(LabelAlign.Right)
                                                .Value(Model._FactureTransport.PayementMode.Designation)
                                                .MarginSpec("0 10 0 0")

                                            // )
                                            ),
                           X.Panel()
                                .Layout(LayoutType.Fit)
                                .MarginSpec("10 10 5 10")
                                .Items(
                                    X.GridPanel()
                                       .Layout(LayoutType.Fit)
                                       .ID("grpListeFactureTransportDetail")
                                       .Region(Region.Center)
                                       .ForceFit(true)
                                       .Border(true)
                                       .Height(150)
                                       .AllowDeselect(true)
                                       .Store(
                                                X.StoreFor<Tms.Classes.Business.FactureDeduction>()
                                                    .ID("storeListeFactureTransportDetail")
                                                    .AutoLoad(false)
                                                    .Proxy(
                                                           Html.X().AjaxProxy()
                                                           .Url(Url.Action("SelectDetailsFactureTransportItems"))
                                                           .Reader(
                                                                    Html.X().JsonReader().RootProperty("data")
                                                                    )
                                                      )
                                                    .Parameters(ps =>
                                                    {
                                                        ps.Add(new StoreParameter("factureTransportID", "#{hiddenFactureTransportID}.value", ParameterMode.Raw));
                                                    })
                                                    .Listeners(ls => ls.Load.Fn = "GetTotalAmount" )
                                        )
                                        .ColumnModel
                                        (
                                            Html.X().Column().Text("Date").DataIndex("DateFacture").Flex(1).Hideable(false),
                                            Html.X().Column().Text("Facture N°").DataIndex("Facture").Renderer("renderObject").Flex(1).Hideable(false),
                                            Html.X().Column().Text("Livraison N°").DataIndex("NumeroLivraison").Flex(1).Hideable(false),
                                            Html.X().Column().Text("Fournisseur").DataIndex("NomFournisseur").Flex(2).Hideable(false),
                                            Html.X().Column().Text("Tonnage").DataIndex("Tonnage").Flex(1).Hideable(false),
                                            //Html.X().Column().Text("Taux").DataIndex("Taux").Width(70),
                                            Html.X().Column().Text("Montant").DataIndex("MontantAsString").Flex(1).Hideable(false).EmptyCellText("0"),
                                            Html.X().Column().Text("Deduction").DataIndex("DeductionTransportAsString").Flex(1).Hideable(false).EmptyCellText("0")
                                        )
                                        .SelectionModel(
                                            X.RowSelectionModel()
                                            .Mode(SelectionMode.Single)
                                            .AllowDeselect(true)

                                        )
                            ),
                           X.Panel()
                           .MarginSpec("0 10 0 0")
                            .Layout(LayoutType.VBox)
                            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Right })
                            .Items(
                                    X.TextField()
                                        .ID("TxtTotalFactureTransportDetail")
                                        .FieldLabel("Total")
                                        .LabelStyle("font-weight:bold;")
                                        .LabelAlign(LabelAlign.Right).Text("0")
                                        .ReadOnly(true)
                                        .FieldStyle("text-align: right; font-weight: bold;")
                            //.DirectEvents(de =>
                            //{
                            //    de.Change.Url = Url.Action("SetAmountToLetter");
                            //    de.Change.ExtraParams.Add(new Parameter { Name = "Amount", Mode = ParameterMode.Raw, Value = "App.TxtTotalFactureTransportDetail.value" });
                            //})
                            ),
                           X.Panel()
                           .MarginSpec("0 10 0 0")
                            .Layout(LayoutType.VBox)
                            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Right })
                            .Items(
                                    X.TextField()
                                        .ID("TxtDeductionFactureTransport")
                                        .FieldLabel("Deductions")
                                        .LabelStyle("font-weight:bold;")
                                        .LabelAlign(LabelAlign.Right).Text("0")
                                        .EmptyText("0")
                                        .ReadOnly(true)
                                        .Value(Model._FactureTransport.DeductionAsString)
                                        .FieldStyle("text-align: right; font-weight: bold;")
                            //.Listeners(ls =>
                            //{
                            //    ls.Change.Handler = "CalculateTotalInvoice();";
                            //    ls.Focus.Handler = "if (App.TxtPrice.value) { #{TxtDeductionFactureTransport}.setRawValue(unformatNumber(#{TxtDeductionFactureTransport}.getValue()));}";

                            //})                            
                            ),
                           X.Panel()
                           .MarginSpec("0 10 0 0")
                            .Layout(LayoutType.VBox)
                            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Right })
                            .Items(
                                    X.TextField()
                                        .ID("TxtTotalInvoiceFactureTransport")
                                        .FieldLabel("Montant à payer")
                                        .LabelStyle("font-weight:bold;")
                                        .LabelAlign(LabelAlign.Right).Text("0")
                                        .ReadOnly(true)
                                        .EmptyText("0")
                                        .Value(Model._FactureTransport.MontantAsString)
                                        .FieldStyle("text-align: right; font-weight: bold;")                                        
                                        .DirectEvents(de =>
                                        {
                                            de.Change.Url = Url.Action("SetAmountToLetter");
                                            de.Change.ExtraParams.Add(new Parameter { Name = "Amount", Mode = ParameterMode.Raw, Value = "App.TxtTotalInvoiceFactureTransport.value" });
                                        })
                            ),
                           X.Panel()
                            .MarginSpec("0 10 0 10")
                            .Layout(LayoutType.VBox)
                            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch })
                            .Items(
                                    X.DisplayField()
                                        .ID("TxtTotalFactureTransportInLetter")
                                        .LabelAlign(LabelAlign.Right)
                                        .FieldCls("AmountLetterStyle")
                            )

            )
            .Buttons(
                        X.Button().Text("Fermer").ID("").Handler("App.FormFactureTransportDetail.doClose()")

                    )

            )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
                    /*alert(winId);*/
                    /*var winId = #{FormTransporteur}.id;*/
                    var areAllrequiredFieldsFilled = isFormValid(winId);

                    /*
                   *   Vérification de la saisie des champs obligatoires
                   */
                    if (!areAllrequiredFieldsFilled) {
                        console.log('error fileds');
                        Ext.Msg.show({ title: 'Facture Transport : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Please enter the delivery ID', buttons: Ext.Msg.OK });
                        return false;
                    }

                }

        /*Ext.onReady(function() {
         #{BtnOk}.on(#{BtnOk}.clickEvent,validNew );
        //})*/
</script>
<script type="text/javascript">
    var GetTotalAmount = function () {
        var nbr = App.grpListeFactureTransportDetail.getStore().getCount();
        var total = parseFloat(0);
        var totaltonnage = parseFloat(0);
        if (nbr > 0) {

            for (var i = 0; i < nbr; i++) {
                var newvalue = parseFloat(App.grpListeFactureTransportDetail.getRowsValues()[i].Montant);
                var newTnvalue = parseFloat(App.grpListeFactureTransportDetail.getRowsValues()[i].Tonnage);
                total += newvalue;
                totaltonnage += newTnvalue;
            }
            var tot = FormatAmount(total);
            App.TxtTotalFactureTransportDetail.setValue(tot);            
            App.hiddenFactureTransportTotalTonnage.setValue(totaltonnage);
        } else {
            App.TxtTotalFactureTransportDetail.setValue(0);
            App.hiddenFactureTransportTotalTonnage.setValue(0);
        }

    };
    var CalculateAmountBeforeDeductions = function () {
        var totalinvoice = parseFloat(unformatNumber(App.TxtTotalInvoiceFactureTransport.value)) || 0;
        var deduction = parseFloat(unformatNumber(App.TxtDeductionFactureTransport.value)) || 0;
        var totalBefore = totalinvoice + deduction;

    };
</script>




