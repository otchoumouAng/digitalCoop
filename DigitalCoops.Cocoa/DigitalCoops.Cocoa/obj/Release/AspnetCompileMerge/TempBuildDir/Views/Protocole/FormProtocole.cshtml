
@model Tms.Classes.Shared.ProtocoleViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
@(X.FormPanel()
    .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
    .Items(
            X.Window()
            .ID("FormProtocole")
            .Width(500)
            .Resizable(false)
            .Height(150)
            .CloseAction(Ext.Net.CloseAction.Destroy)
            .Listeners(l =>
            {
                l.Close.Handler = "App.TmsViewPort.unmask();";
                l.Show.Handler = "#{TxtDesignationProtocole}.focus();";
            })
            //.X(400)
            .Y(20)
            .Title("Protocol : Detail")
            .Layout(LayoutType.VBox)
            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
                .Items(
                        X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                        X.Hidden().ID("hiddenRowversion").Value(Model._Protocole.RowVersionKey),
                        X.Hidden().ID("TxtProtocoleID").Value(Model._Protocole.ID),
                        X.TextField().ID("TxtDesignationProtocole").FieldLabel("Designation")
                        .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Protocole.Designation.ToString() : string.Empty)
                        .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                        .MarginSpec("0 5 0 0")
                    )
            .Buttons(
                X.Button().Text("OK").ID("BtnSubmitProtocole")
                .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                .DirectEvents(de =>
                {
                    de.Click.Url = Url.Action("SubmitFormMethod");
                    de.Click.Before = "return validNew(App.FormProtocole.id);";
                }),
                X.Button()
                    .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                    .Handler("App.FormProtocole.doClose()")
                    .Cls("btncancel")

                )

            )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormProtocole}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Protocol : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }


    };


</script>


















