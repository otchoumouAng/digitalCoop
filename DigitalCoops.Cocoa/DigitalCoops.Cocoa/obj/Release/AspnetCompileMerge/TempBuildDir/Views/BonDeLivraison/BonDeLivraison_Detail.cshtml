<script src="~/Scripts/FunctionHelpers.js"></script>
<script src="~/Scripts/FormatAmount.js"></script>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNewBL = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Bon De Livraison : Data Validation', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }
    };

    var enterKeyPressHandler = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            var param = App.txtDeliveryID.value;
            var baseurl = App.baseUrlVal.value;
            Ext.net.DirectMethod.request({ url: baseurl +"/BonDeLivraison/SubmitDeliveryByNumber?ItemDeliveryNumber=" + param });
            /*App.BtnSearchDeliveryInfo.fireEvent('click', App.BtnSearchDeliveryInfo);*/
            e.stopEvent();

        }
    };



    var CalculateRetention = function () {

        try
        {
            if (App.grpDetailAnalysis.hasSelection())
            {
                var RowsCount = App.grpDetailAnalysis.getRowsValues().length;

                if (RowsCount > 1)
                {
                
                    App.txtRetHumidite.setValue('0');
                    App.txtRetME.setValue('0');
                    App.txtRetBrisure.setValue('0');
                    App.txtTotalRetention.setValue('0');
                    App.txtPoidsNet.setValue('0');

                    App.BtnOkDetail.enable();

                    var mStdHumidite = parseFloat(App.txtStdHumidite.value.replace(',', '.'));
                    var mStdME = parseFloat(App.txtStdME.value.replace(',', '.'));
                    var mStdBrisure = parseFloat(App.txtStdBrisure.value.replace(',', '.'));
                    var PoidsLivre = unformatNumber(App.txtDelivered.value) || '0';
                    var GrossWeight = unformatNumber(App.txtGrossWeight.value) || '';
                    var TotalRetention = unformatNumber(App.txtTotalRetention.value) || '';
                    var TareOfBags = App.txtTareSacs.value || '0';
                    var TareOfPalets = App.txtTarePalettes.value || '0';                    


                    var mListSelected = App.grpDetailAnalysis.getRowsValues({ selectedOnly: true });
                    if (mListSelected.length > 0)
                    {
                        var mObjectSelected = mListSelected[0];

                        var mAnHumidite = mObjectSelected.Humidite;
                        var mAnME = mObjectSelected.MatiereEtrangere;
                        var mAnBrisure = mObjectSelected.Brisure;
                        var mAnSieving = mObjectSelected.Tamis;                        
                        var mCodingID = mObjectSelected.AnalyseCode.ID;
                        
                        App.hiddenCodingID.setValue(mCodingID);                       
                        App.hiddenHumidite.setValue(mAnHumidite.toString().replace('.', ','));
                        App.hiddenME.setValue(mAnME.toString().replace('.', ','));
                        App.hiddenBrisure.setValue(mAnBrisure.toString().replace('.', ','));
                        App.hiddenSieving.setValue(mAnSieving.toString().replace('.', ','));

                        var RetHumidite = 0;
                        var RetME = 0;
                        var RetBrisure = 0;

                        var RetHumiditeFinal = 0;
                        var RetMEFinal = 0;
                        var RetBrisureFinal = 0;

                        var TotalRetention = 0;
                        var PoidsNet = 0;

                        if (Ext.isNumeric(mAnHumidite) && Ext.isNumeric(mStdHumidite) && (mAnHumidite - mStdHumidite > 0) && Ext.isNumeric(PoidsLivre)) {
                            RetHumidite = (mAnHumidite - mStdHumidite) * PoidsLivre / (100 - mStdHumidite);                            
                            if (RetHumidite > 0)
                            {
                                RetHumiditeFinal = RetHumidite.toFixed(0);
                                App.txtRetHumidite.setValue(RetHumiditeFinal.toString().replace('.', ','));
                            }
                        }
                                           
                        if (Ext.isNumeric(mAnME) && Ext.isNumeric(mStdME) && (mAnME - mStdME > 0) && Ext.isNumeric(PoidsLivre)) {                            
                            RetME = (mAnME - mStdME) * PoidsLivre / 100;
                            if (RetME > 0)
                            {
                                RetMEFinal = RetME.toFixed(0);
                                App.txtRetME.setValue(RetMEFinal.toString().replace('.', ','));
                            }                                                        
                        }
                        /*Consider Sieving*/
                        if (Ext.isNumeric(mAnSieving) && Ext.isNumeric(mStdBrisure) && (mAnSieving - mStdBrisure > 0) && Ext.isNumeric(PoidsLivre)) {
                            /*RetBrisure = (mAnBrisure - mStdBrisure) * PoidsLivre / 100;*/
                            RetBrisure = (mAnSieving - mStdBrisure) * PoidsLivre / 100;
                            if (RetBrisure > 0)
                            {
                                RetBrisureFinal = RetBrisure.toFixed(0);
                                App.txtRetBrisure.setValue(RetBrisureFinal.toString().replace('.', ','));
                            }

                        }

                        if (Ext.isNumeric(RetHumiditeFinal) && Ext.isNumeric(RetMEFinal) && Ext.isNumeric(RetBrisureFinal)) {

                            TotalRetention = parseFloat(RetHumiditeFinal) + parseFloat(RetMEFinal) + parseFloat(RetBrisureFinal);
                            App.txtTotalRetention.setValue(formatNumber(TotalRetention));

                            if (Ext.isNumeric(GrossWeight) && Ext.isNumeric(TotalRetention) && Ext.isNumeric(TareOfBags) && Ext.isNumeric(TareOfPalets)) {
                                PoidsNet = RoundInt(GrossWeight - TareOfBags - TareOfPalets - TotalRetention);
                                App.txtPoidsNet.setValue(formatNumber(PoidsNet));                                
                            }

                        }
                    }


                }

            }

        }
        catch (err) {
            Ext.Msg.show({ title: 'Bon De Livraison : Retention Calculation ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating retention.', buttons: Ext.Msg.OK });

        }

    };

    var UpdateNetWeight = function () {        
        try {            
              var GrossWeight = unformatNumber(App.txtGrossWeight.value) || '0';
              var TotalRetention = unformatNumber(App.txtTotalRetention.value) || '0';
              var TareOfBags = App.txtTareSacs.value || '0';
              var TareOfPalets = App.txtTarePalettes.value || '0';
              var PoidsNet = 0;
              App.BtnOkDetail.enable();
              if (Ext.isNumeric(GrossWeight) && Ext.isNumeric(TotalRetention) && Ext.isNumeric(TareOfBags) && Ext.isNumeric(TareOfPalets)) {
                  PoidsNet = RoundInt(GrossWeight - TareOfBags - TareOfPalets - TotalRetention);                  
                  App.txtPoidsNet.setValue(formatNumber(PoidsNet));
              }
        }
        catch (err) {
            Ext.Msg.show({ title: 'Bon De Livraison : Update Poids Net ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating net weight.', buttons: Ext.Msg.OK });

        }

    };


    var RoundInt = function (v) {
      try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    }

</script>




