@model Tms.Classes.Business.LivraisonViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 140px !important;
    }

    .x-form-text-default.x-form-textarea {
        line-height: 17px;
        min-height: 50px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
@(
X.Window()
    .ID("BonDeLivraison_Classify")
    .Width(400)
    .Resizable(false)
    .Height(260)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Y(20)
    .BodyPadding(5)
    .Title("Bon De Reception : Reclassification")
    .Items
    (
        X.FormPanel()
            .Layout(LayoutType.VBox)
            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
            .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .Items(
    #region zone A                    
                    X.Hidden().ID("hiddenExecMode").ReadOnly(true).Value(Model._ExecMode),
                    X.Hidden().ID("hiddenLivraisonID").ReadOnly(true).Value(Model._Livraison.ID),
                    X.ComboBox()
                          .ID("OldCertificationID")
                          .FieldLabel("Old Certification")
                          .DisplayField("Designation")
                          .ValueField("ID")
                          .LabelAlign(LabelAlign.Right)
                          .ForceSelection(true)
                          .LabelWidth(150)
                          .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.AncienneCertification.ID : Model._Livraison.Certification.ID)
                          .Store
                          (
                             X.Store()
                              .AutoLoad(true)
                              .Model
                              (
                                Html.X().Model()
                                .IDProperty("ID")
                                .Fields
                                (
                                  new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                  new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                )
                               )
                               .Proxy
                               (
                                 Html.X().AjaxProxy()
                                 .Url(Url.Action("LoadCertification", "Certification"))
                                 .Reader(Html.X().JsonReader().RootProperty("data"))
                               )
                          ),
                    X.ComboBox()
                        .ID("NewCertificationID")
                        .FieldLabel("New Certification")
                        .DisplayField("Designation")
                        .ValueField("ID")
                        .LabelWidth(150)
                        .LabelAlign(LabelAlign.Right)
                        .ForceSelection(true)
                        .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.NouvelleCertification.ID : (int?)null)
                        .Store
                        (
                            X.Store()
                            .AutoLoad(true)
                            .Model
                            (
                            Html.X().Model()
                            .IDProperty("ID")
                            .Fields
                            (
                                new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                            )
                            )
                            .Proxy
                            (
                                Html.X().AjaxProxy()
                                .Url(Url.Action("LoadCertification", "Certification"))
                                .Reader(Html.X().JsonReader().RootProperty("data"))
                            )
                        ),
                    X.TextArea()
                        .ID("txtRaison")
                        .FieldLabel("Commentaire")
                        .TabIndex(5)
                        .LabelWidth(150)
                        .AllowBlank(true)
                        .IndicatorCls("IndicatorRedStar")
                        .IndicatorText("")
                        .LabelAlign(LabelAlign.Right)
                        .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.RaisonReclassement : string.Empty)

    #endregion                    
            )
    )
    .Buttons
    (
        X.Button()
            .Text("OK")
            .ID("BtnOk")
            .TabIndex(14)
            .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .DirectEvents
            (
                de =>
                {
                    de.Click.Url = Url.Action("UpdateCertification");
                    de.Click.FormID = "#(return this.up('window').down('form');)";
                    de.Click.Before = "return validNew(App.BonDeLivraison_Classify.id);";
                }
            ),
        X.Button()
            .TabIndex(15)
            .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
            .Handler("App.BonDeLivraison_Classify.doClose()")
            .Cls("btncancel")
    )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Bon De Reception - Lot : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }        


    };   
      

</script>


