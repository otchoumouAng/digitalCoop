@model Tms.Classes.Business.BonDeLivraison
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style>
    .x-btn-default-toolbar-small {
        padding: 2px 7px 2px 7px !important;
    }
</style>
<script src="~/Scripts/FunctionHelpers.js"></script>
<script src="~/Scripts/FormatAmount.js"></script>
<script src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script>
    var SummaryBLOth = function () {
        var nbrOfrows = App.grpListeOtherBL.getStore().getCount();
        var totalNet = App.storeListeOtherBL.sum('PoidsNetAccepte') || 0;
        var totalNbrOfBags = App.storeListeOtherBL.sum('NbreSacs') || 0;
        
        totalNet = FormatAmount(totalNet);
        totalNbrOfBags = FormatAmount(totalNbrOfBags);
        App.lblSummaryOtherBL.setText("Poids Total : " + totalNet + " Kg , Total Nbr de sacs : " + totalNbrOfBags);

    };

    /*var SetBtnOK = function () {
        if (App.rowSelectBLPendingDeliveries.hasSelection())
            App.BtnSendDelivery.enable();
        else
            App.BtnSendDelivery.disable();
    };*/
</script>

   
