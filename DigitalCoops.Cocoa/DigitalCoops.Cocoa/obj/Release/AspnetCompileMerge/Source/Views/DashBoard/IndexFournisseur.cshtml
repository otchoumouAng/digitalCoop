<script>        
    var SetCriteriaTitle = function (fournisseur) {
        App.panelSuppliersVolume.title = "";
        var texttitle = "";

        /*if (begin) texttitle += " Du : " + begin;

        if (end) texttitle += " Au : " + end*/

        if (fournisseur) texttitle += "Volume ( Campagne à ce jour) | Fournisseur : " + fournisseur;       

        App.panelSuppliersVolume.setTitle(texttitle);
    };

    var SetCriteriaTitleFin = function (fournisseur) {
        App.FinancingCropYearToDatePanel.title = "";
        var texttitle = "";

        /*if (begin) texttitle += " Du : " + begin;

        if (end) texttitle += " Au : " + end;*/

        if (fournisseur) texttitle += "Financement ( Campagne à ce jour) | Fournisseur : " + fournisseur;        

        App.FinancingCropYearToDatePanel.setTitle(texttitle);
    };

        var tipRendererSupplierChartCrCv = function (toolTip, storeItem, item) {
            var total = 0;
            total = parseInt(App.storeListeSupplierVolume.getRecordsValues()[2].Accepted);
            /*App.PieSupplierVolumeCrCv.getStore().each(function (rec) {
                total += rec.get('Total');
            });*/

            toolTip.setTitle(storeItem.get('Libelle') + ': ' + Math.round(storeItem.get('Total') / total * 100) + '%');
        };

        var tipRendererSupplierChartAcRj = function (toolTip, storeItem, item) {
            var total = 0;
            total = parseInt(App.storeListeSupplierVolume.getRecordsValues()[2].InProcess) + parseInt(App.storeListeSupplierVolume.getRecordsValues()[2].Accepted) + parseInt(App.storeListeSupplierVolume.getRecordsValues()[2].Rejected);
            /*App.PieSupplierVolumeCrCv.getStore().each(function (rec) {
                total += rec.get('Total');
            });*/

            toolTip.setTitle(storeItem.get('Libelle') + ': ' + Math.round(storeItem.get('Total') / total * 100) + '%');
        };

        var tipRendererChartFinancingSupplier = function (toolTip, storeItem, item) {
            var total = 0;

            App.storeListeFinancingChartSupplier.each(function (rec) {
                total += rec.get('Total');                
            });

            toolTip.setTitle(storeItem.get('Libelle') + ': ' + Math.round(storeItem.get('Total') / total * 100) + '%');
        };

        var saveChart = function (btn) {
            Ext.MessageBox.confirm('Confirm Download', 'Would you like to download the chart as an image?', function (choice) {
                if (choice === 'yes') {
                    btn.up('panel').down('polar').download();
                }
            });
        };   

        var LoadFinancingChartOfSupplier = function (model, records) {
                  
            if (records.length > 0) {
                var SelectedRows = [];
                var json;
                var rec;

                for (var i = 1; i < (records.length); i++) {
                    rec = records[i];
                    json = {
                        'Libelle': rec.get('Designation'),
                        'Total': rec.get('Allocated')
                    };
                    SelectedRows[i - 1] = json;
                }
                App.storeListeFinancingChartSupplier.loadData(SelectedRows);
            }
            else
            {
                true;
                /*App.storeListeFinancingChartSupplier.removeAll();*/
            }
            

        };

        var LoadSupplierVolume = function (model, records) {            
            var rec = records[2];            
            var json1 = [{
                'Libelle': 'Accepté',
                'Total': rec.get('Accepted')
            }, {
                'Libelle': 'Refoulé',
                'Total': rec.get('Rejected')
            }];
            var json2 = [{
                'Libelle': 'Certifié',
                'Total': rec.get('Certified')
            }, {
                'Libelle': 'Conventionnel',
                'Total': rec.get('Conventional')
            }];

            App.storePieSupplierVolumeCrCv.loadData(json2);            
            App.storePieSupplierVolumeAcRj.loadData(json1);

            App.storeSupplierVolumeEvolution.load();

            
        };

</script>
