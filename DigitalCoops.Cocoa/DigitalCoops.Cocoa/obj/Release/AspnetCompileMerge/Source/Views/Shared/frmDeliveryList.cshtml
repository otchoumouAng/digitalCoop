                                     //       li.Change.Handler = "App.cmbDetSupplier.clearValue(); App.cmbDetSupplier.getStore().load()";
                                     //   }
                                     //)
                                     .Store
                                     (
                                             X.Store()
                                             .AutoLoad(true)
                                             .Model
                                             (
                                                     Html.X()
                                                     .Model()
                                                     .IDProperty("ID")
                                                     .Fields
                                                     (
                                                         new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                         new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                     )
                                             )
                                             .Proxy
