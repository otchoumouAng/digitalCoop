                            .AutoLoad(true)
                            .Model(
                                                        Html.X().Model()
                                                        .IDProperty("ID")
                                                        .Fields(
                                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                    new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                                                )
                                                    )
                                                .Proxy(
                                                            Html.X().AjaxProxy()
                                                            .Url(Url.Action(ViewData["UrlSite"].ToString(), "Site"))
                                                .Reader(
                                                            Html.X().JsonReader().RootProperty("data")
                                                            )
                                                )
                                    ).Listeners(
                                                ls =>
                                                {
                                                    ls.Select.Handler = "if (App.cmbDetSite.value) { App.cmbDetSupplier.clearValue(); App.cmbDetSupplier.getStore().load(); };";
                                                }
