                                                 Html.X()
                                                 .AjaxProxy()
                                                 .Url(Url.Action("LoadLivraisonTypeAll", "LivraisonType"))
                                                 .Reader(Html.X().JsonReader().RootProperty("data"))
                                             )
                                     )

                                    ,

                                    X.ComboBox()
                                        .ID("cmbDetSupplier")
                                        .FieldLabel("Fournisseur")
                                        .DisplayField("FournisseurNameAndCode")
                                        .ValueField("ID")
                                        .LabelWidth(110)
                                        .LabelAlign(LabelAlign.Right)
                                        .ListConfig(new BoundList { Width = 600, MinWidth = 500 })
                                        .TypeAhead(true)
                                        .QueryMode(DataLoadMode.Local)
                                        .ForceSelection(true)
                                        .Value(-1)
                                        .Store
                                        (
                                                X.Store()
                                                .AutoLoad(true)
                                                .Listeners(l => l.Load.Handler = "App.cmbDetSupplier.setValue(App.cmbDetSupplier.getStore().getAt(0));")
                                                .Model(Html.X().Model()
                                                .IDProperty("ID")
                                                        .Fields(
