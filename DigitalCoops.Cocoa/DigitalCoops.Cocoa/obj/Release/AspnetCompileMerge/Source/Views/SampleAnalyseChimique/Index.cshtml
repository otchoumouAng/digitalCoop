<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script src="~/Scripts/FunctionHelpers.js"></script>
<script type="text/javascript">
    var GetNbrStoreRows = function () {
        var nbr = App.grpListeEchantillon.getRowsValues().length;
        App.LblSummaryListeSample.setText(nbr + ' Analysis');
    };

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeEchantillon.columnManager.getColumns(), App.grpListeEchantillon.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var SetCriteriaTitle = function (status, begin, end) {
        App.SampleAnalyseChimiqueCP.title = "";
        var texttitle = "";

        if (begin) texttitle += " Du : " + begin;

        if (end) texttitle += " Au : " + end;

        if (status) texttitle += " | Statut : " + status;

        App.SampleAnalyseChimiqueCP.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {        
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
            else if (value == 3) {
                return 'glyphicon-file red'; // glyphicon glyphicon-file blue
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            if (App.rowEchantillon.hasSelection()) {

                var isDisabled = App.rowEchantillon.selected.items[0].data.Desactive;                

                if (isDisabled === true) {
                    App.mnuPrintSample.disable();
                    App.mnuCancelAnalysePhysique.disable();
                    App.btnModifyAnalysePhysique.disable();
                    App.mnuCancelAnalysePhysique.setText('Activer');                    
                    App.mnuCancelAnalysePhysique.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.SmhiddenPermModifier.value == 'true')
                        App.btnModifyAnalysePhysique.enable();

                    if (App.SmhiddenPermPrintSampleSheet.value == 'true')
                        App.mnuPrintSample.enable();

                    if (App.SmhiddenPermDesactiver.value == 'true')
                        App.mnuCancelAnalysePhysique.enable();                                         

                    App.mnuCancelAnalysePhysique.setText('Annuler');
                    App.mnuCancelAnalysePhysique.setIconCls('glyphicon glyphicon-remove red');

                    
                }
            } else {
                
                App.btnModifyAnalysePhysique.disable();
                App.mnuCancelAnalysePhysique.disable();
                App.mnuPrintSample.disable();
            }
        }
    }


</script>
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}

@(Html.X().ResourceManager().AjaxTimeout(36000000))

<form id="tms_form">
    @(X.Viewport()
    .Layout(LayoutType.Border)
    .ID("TmsViewPort")
    .Items(
                X.Hidden().ID("BaseUrl").Value(@BaseUrl),               
                X.Hidden().ID("SmhiddenPermModifier").ReadOnly(true),                
                X.Hidden().ID("SmhiddenPermDesactiver").ReadOnly(true),
                X.Hidden().ID("SmhiddenPermPrintSampleSheet").ReadOnly(true),                                
                X.Hidden().ID("AphiddenPermSuperDesactiver").ReadOnly(true),
    #region Criteres
            X.Panel()
                .ID("pnlNorth")
                .Region(Region.North)
                .Layout(LayoutType.Border)
                .TopBar(new Toolbar()
                {
                    Items =
                    {
                        X.Button()
                            .ID("btnFilterAnalysePhysique")
                            .IconCls("action_filter_02")
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                            .Disabled(false)
                            .DirectEvents
                            (
                                de =>
                                {
                                    de.Click.Url  = Url.Action("OnFilter");
                                    de.Click.EventMask.ShowMask = true;
                                }
                            ),
                        X.Button()
                            .ID("btnRefreshAnalysePhysique")
                            .IconCls("action_refresh_01")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Disable(false)
                            .DirectEvents
                            (
                                de =>
                                {
                                    de.Click.Url  = Url.Action("onRefresh");
                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemCampagne", Encode=false, Value= "#{cmbFiltreCampagne}.getValue()", Mode=ParameterMode.Raw});
                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemExportateur", Encode=true, Value= "#{cmbFiltreExportateur}.getValue()", Mode=ParameterMode.Raw});

                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodStart", Value= "#{TxtPeriodStart}.getRawValue()",   Mode=ParameterMode.Raw});
                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodEnd", Value= "#{TxtPeriodEnd}.getRawValue()",     Mode=ParameterMode.Raw});
                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatut", Value= "#{CmbFiltreStatut}.getValue()",     Mode=ParameterMode.Raw});
                                    de.Click.Success = "App.SampleAnalyseChimiqueCP.setTitle('Campagne : '+ App.cmbFiltreCampagne.rawValue + ', Exportateur = '+ App.cmbFiltreExportateur.rawValue + ', Statut : '+ App.CmbFiltreStatut.rawValue + ', du  '+ App.TxtPeriodStart.rawValue + ' au '+ App.TxtPeriodEnd.rawValue )";
                                    de.Click.EventMask.ShowMask = true;
                                }
                            ),
                        X.Button()
                            .ID("btnNewSample")
                            .IconCls("action_new_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Disable(false)
                            .DirectEvents
                            (
                                de =>{
                                    de.Click.Url  = Url.Action("OnAdd");
                                    de.Click.Success = "App.FormSampleAnalysePhysique.setTitle('Chemical Analysis - Sample : Nouveau')";
                                    de.Click.EventMask.ShowMask = true;
                                }
                            ),
                        X.Button()
                            .ID("btnModifyAnalysePhysique")
                            .IconCls("action_modify_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Disabled(true)
                            .DirectEvents
                            (
                                de =>{
                                    de.Click.Url  = Url.Action("OnEdit");
                                    de.Click.Success = "App.FormSampleAnalysePhysique.setTitle('Chemical Analysis - Sample : Modifier')";
                                    de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeEchantillon}.getSelectionModel().getSelection()[0].data"});
                                    de.Click.EventMask.ShowMask = true;
                                }
                            ),
                        X.SplitButton()
                            .ID("btnPrint")
                            .IconCls("action_print_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                            .Disable(false)
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Menu
                            (
                                new Menu()
                                {
                                    Items =
                                    {
                                        X.MenuItem()
                                            .ID("mnuPrintSample")
                                            .Text("Sample Sheet")
                                            .Disabled(true)
                                            .DirectEvents
                                            (
                                                de=>
                                                {
                                                    de.Click.Url = Url.Action("OnPrintSample");
                                                    de.Click.ExtraParams.Add(new Parameter {  Name = "Sample" , Mode= ParameterMode.Raw, Value = "#{grpListeEchantillon}.getSelectionModel().getSelection()[0].data.ID" });
                                                }
                                            ),
                                        X.MenuItem()
                                            .ID("mnuPrintSampleList")
                                            .Text("Sample List")
                                            .Disabled(false)
                                            .DirectEvents
                                            (
                                                de=>
                                                {
                                                    de.Click.Url = Url.Action("OnPrintSampleList");
                                                    de.Click.EventMask.ShowMask = true;
                                                }
                                            )
                                    }
                                }
                            ),
                        X.ToolbarFill(),
                        X.Button()
                            .ID("btnActions")
                            .Text("Actions")
                            .Border(false)
                            .Cls("ButtonStyle")
                            .IconCls("menu_04")
                            .Disable(false)
                            .Menu(new Menu()
                            {
                                Items = {
                                         X.MenuItem()
                                            .ID("mnuExportPhysicalAnalysis")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                            .Icon(Icon.PageExcel)
                                            .Handler("SetExcelList();"),
                                        X.MenuItem()
                                            .ID("mnuCancelAnalysePhysique")
                                            .IconCls("glyphicon glyphicon-remove red")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                                            .Cls("ButtonStyle")
                                            .Border(false)
                                            .Disabled(true)
                                            .DirectEvents(de =>
                                                    {
                                                        de.Click.Url = Url.Action("OnActivateDeactivate");
                                                        de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeEchantillon}.getSelectionModel().getSelection()[0].data" });
                                                        de.Click.EventMask.ShowMask = true;
                                                        de.Click.Confirmation.ConfirmRequest = true;
                                                        de.Click.Confirmation.Title = "Sample Analyse Physique";
                                                        de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListeEchantillon}.getSelectionModel().getSelection()[0].data.Desactive)";
                                                        de.Click.Success = "Overview.resetButtons();";
                                                    })

                                            }
                                    })
                                }
                }),
    #endregion
    #region Criteres
        X.FormPanel()
            .ID("SampleAnalyseChimiqueCP")
            .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Chemical Analysis - Sample - overview" })
            .Region(Region.North)
            .Floatable(false)
            .Border(false)
            .Collapsed(true)
            .Collapsible(true)
            //.CollapsedCls("panelcollapse")
            .BodyPadding(5)
            .Frame(true)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Start })
            .Items(
                     X.Container()
                        .Flex(1)
                        .Layout(LayoutType.VBox)
                        .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
                        .Items(
                                 X.ComboBox()
                                    .ID("cmbFiltreCampagne")
                                    .FieldLabel("Campagne")
                                    .DisplayField("Designation")
                                    .ValueField("Designation")
                                    .LabelAlign(LabelAlign.Right)
                                    //.Value(@CurrentCampagne)
                                    .Store
                                        (
                                        X.Store()
                                        .AutoLoad(true)
                                        .Model
                                        (
                                            Html.X().Model()
                                                .IDProperty("Designation")
                                                .Fields
                                                (
                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" },
                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                )
                                            )
                                            .Proxy
                                            (
                                                Html.X().AjaxProxy()
                                            .Url(Url.Action("LoadCampagneAll", "Campagne"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                            )

                                        ),
                                X.ComboBox()
                                                        .ID("cmbFiltreExportateur")
                                                        .FieldLabel("Exportateur")
                                                        .DisplayField("Nom")
                                                        .QueryMode(DataLoadMode.Local)
                                                        .TriggerAction(TriggerAction.All)
                                                        .ValueField("ID")
                                                        .LabelAlign(LabelAlign.Right)
                                                        .Store
                                                        (
                                                            X.Store()
                                                            .AutoLoad(true)
                                                            .Model
                                                            (
                                                               Html.X().Model()
                                                               .IDProperty("ID")
                                                               .Fields
                                                               (
                                                                 new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                 new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                                                )
                                                              )
                                                              .Proxy
                                                              (
                                                                 Html.X().AjaxProxy()
                                                                 .Url(Url.Action("LoadExportateurAllActive", "Exportateur"))
                                                                 .Reader(Html.X().JsonReader().RootProperty("data"))
                                                              )

                                                          )
                                                          .SelectedItems
                                                          (
                                                            it =>
                                                            {
                                                                it.Add(new ListItem { Text = "{Tous}", Value = "-1" });
                                                            }
                                                          )

                                ),
                     X.Container()
                        .Flex(1)
                        .Layout(LayoutType.VBox)
                        .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
                        .Items(
                                X.DateField().ID("TxtPeriodStart").FieldLabel("Date Debut").LabelAlign(LabelAlign.Right).Text(""),
                                X.DateField().ID("TxtPeriodEnd").FieldLabel("Date Fin").LabelAlign(LabelAlign.Right).Text(""),
                                X.ComboBox()
                                    .ID("CmbFiltreStatut")
                                    .ForceSelection(true)
                                    .FieldLabel("Statut")
                                    .TypeAhead(true)
                                    .ForceSelection(true)
                                    .LabelAlign(LabelAlign.Right)
                                    .Items(
                                            new ListItem("{Tous}", "-1"),
                                            new ListItem("Active", "0"),
                                            new ListItem("Inactive", "1")
                                        )
                                    .SelectedItems(se => { se.Add(new ListItem { Text = "Active", Value = "0" }); })

                                ),
                     X.Container()
                        .ID("")
                        .Flex(3)
                        .Layout(LayoutType.HBox)
                        .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                        .Items(
                                X.Label()
                                    .ID("LblSummaryListeSample")
                                    .Text("Resume ici")
                                    .EmptyText("")
                                )
                    ),
    #endregion
    #region GridPanel
        X.GridPanel()
            .Layout(LayoutType.Fit)
            .ID("grpListeEchantillon")
            .Region(Region.Center)
            .ForceFit(false)
            .AllowDeselect(false)
            .Store(
                    X.StoreFor<Tms.Classes.Business.stock.AnalyseChimiqueEchantillon>()
                        .ID("storeListeEchantillon")
                        .PageSize(100)
                        .RemotePaging(false)
                        .Proxy(Html.X().AjaxProxy()
                            .Url(Url.Action("Select", "SampleAnalyseChimique"))
                            .Reader(Html.X().JsonReader().RootProperty("data"))
                        )
                        .Listeners(ls =>
                        {
                            ls.Load.Handler = "GetNbrStoreRows(); Ext.net.Mask.hide();";
                            ls.Add.Handler = "SelectNewRecordAddedOnGrid(records, #{grpListeEchantillon}.id); GetNbrStoreRows();";
                            ls.BeforeLoad.Handler = "Ext.net.Mask.show();";
                        })
                                .Parameters(ps =>
                                {
                                    ps.Add(new StoreParameter("ItemCampagne", "#{cmbFiltreCampagne}.getValue()", ParameterMode.Raw));
                                    ps.Add(new StoreParameter("ItemExportateur", "#{cmbFiltreExportateur}.getValue()", ParameterMode.Raw));
                                    ps.Add(new StoreParameter("ItemPeriodStart", "#{TxtPeriodStart}.getRawValue()", ParameterMode.Raw));
                                    ps.Add(new StoreParameter("ItemPeriodEnd", "#{TxtPeriodEnd}.getRawValue()", ParameterMode.Raw));
                                    ps.Add(new StoreParameter("ItemStatut", "#{CmbFiltreStatut}.getValue()", ParameterMode.Raw));
                                }
                            )
                    )
                    .ColumnModel
                    (
                        Html.X().Column().Text("").DataIndex("mIcon").Renderer("renderIcon").Hideable(false).Width(40).Filterable(false),
                        Html.X().Column().Text("Date/Heure").DataIndex("DateEchantillonAsString").Flex(1),
                        Html.X().Column().Text("Campagne").DataIndex("CampagneAsString").Flex(1),
                        Html.X().Column().Text("Exportateur").DataIndex("ExportateurAsString").Flex(1),
                        Html.X().Column().Text("Sample N°").DataIndex("NumeroEchantillon").Flex(1),
                       Html.X().Column().Text("Lot").DataIndex("NumeroLots").Flex(4),
                        X.Column().Text("Utilisation Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                        X.DateColumn().Text("Date Creation").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                        X.Column().Text("Utilisation Modification").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                        X.DateColumn().Text("Date Modification").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")
                    )
                    .BottomBar(
                                Html.X().PagingToolbar()
                                .HideRefresh(true)
                        .Plugins(Html.X().ProgressBarPager())
                )
                .Plugins(
                    X.FilterHeader()
                )
                .View(
                            Html.X().GridView().LoadingText("Chargement...")
                    )
                .SelectionModel(
                    X.RowSelectionModel()
                        .ID("rowEchantillon")
                        .Mode(SelectionMode.Single)
                        .AllowDeselect(false)
                ).Listeners(l =>
                {
                    l.Select.Fn = "Overview.resetButtons";
                    l.Deselect.Fn = "Overview.resetButtons";

                }
                )
                .DirectEvents(de =>
                {
                    de.RowDblClick.Url = Url.Action("OnConsult");
                    de.RowDblClick.CleanRequest = true;
                    de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowEchantillon}.getSelected().items[0].data" });
                    de.RowDblClick.EventMask.ShowMask = true;
                }
                )
    #endregion
    )
    )

</form>

<script type="text/javascript">
    var GenerateSample = function (sample, BaseUrl) {
        Ext.net.DirectMethod.request({ url: BaseUrl + "/SampleAnalyseChimique/OnPrintSample?Sample=" + sample + "&IsCopy=0" });
    };
</script>