@model Tms.Classes.Business.stock.AnalyseChimiqueEchantillonViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style type="text/css">
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 100px !important;
    }
</style>
<script type="text/javascript">
    var SampleIconRender = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = OverviewSample.getIcons(value);

        return Ext.String.format(tpl, icon_url);
    };

    var OverviewSample =
    {
        SetButtons: function () {

            if (App.rowCode.hasSelection()) {                
                    App.BtnRemoveLot.enable();                
            } else {

                App.BtnRemoveLot.disable();                

            }
        },

        getIcons: function (value) {
            if (value === 4) {
                return 'glyphicon-file green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
        }
    };


</script>
@(
X.Window()
    .ID("FormSampleAnalysePhysique")
    .Width(540)
    .Resizable(false)
    .Height(530)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Y(10)
    .Title("Echantillon Analyse Chimique : Detail")
    //.Layout(LayoutType.Form)
    .Items(
            X.FormPanel()
                .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                .Layout(LayoutType.VBox)
                .LayoutConfig(new VBoxLayoutConfig {Align = VBoxAlign.Stretch })
                .Items(
                        X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                        X.Hidden().ID("TxtEchantillonID").Value(Model._AnalyseChimiqueEchantillon.ID),
                        X.Hidden().ID("hiddenRowversion").Value(Model._AnalyseChimiqueEchantillon.RowVersionKey),

                        X.Panel()
                            .Layout(LayoutType.Form)
                            .MarginSpec("5 20")
                            .Items(
                                        X.TextField()
                                            .ID("txtNumeroEchantillon")
                                            .FieldLabel("Echantillon N°")
                                            .LabelAlign(LabelAlign.Right)
                                            .ReadOnly(true),
                                        //.AllowBlank(false)
                                        //.IndicatorIconCls("IndicatorRedStar")
                                        //.IndicatorText("*")
                                        //.Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Livraison.Numero.ToString() : string.Empty)

                                        X.ComboBox()
                                            .ID("cmbCampagne")
                                            .FieldLabel("Campagne")
                                            .DisplayField("Designation")
                                            .AllowBlank(false)
                                            .IndicatorCls("IndicatorRedStar")
                                            .IndicatorText("*")
                                            .ValueField("Designation")
                                            .QueryMode(DataLoadMode.Local)
                                            .TriggerAction(TriggerAction.All)
                                            .LabelAlign(LabelAlign.Right)
                                            .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._AnalyseChimiqueEchantillon.Campagne.Designation : Model._DefaultCampagne)
                                            .Store
                                            (
                                                X.Store()
                                                    .AutoLoad(true)
                                                    .Model
                                                    (
                                                        Html.X().Model()
                                                            .IDProperty("Designation")
                                                            .Fields
                                                            (
                                                                new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" },
                                                                new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                            )
                                                        )
                                                    .Proxy
                                                    (
                                                        X.AjaxProxy().Url(Url.Action("LoadCampagne", "Campagne"))
                                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                                    )
                                            ),
                                           X.ComboBox()
                                                 .ID("cmbExportateur")
                                                 .EmptyText("")
                                                 .TabIndex(3)
                                                 .ForceSelection(true)
                                                 .TypeAhead(true)
                                                 .QueryMode(DataLoadMode.Local)
                                                 .TriggerAction(TriggerAction.All)
                                                 .AllowBlank(false)
                                                 .IndicatorCls("IndicatorRedStar")
                                                 .IndicatorText("*")
                                                 .FieldLabel("Exportateur")
                                                 .DisplayField("Nom")
                                                 //.MatchFieldWidth(false)
                                                 .ListConfig(new BoundList { MinWidth = 300 })
                                                 .ValueField("ID")
                                                 .LabelAlign(LabelAlign.Right)
                                                 .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._AnalyseChimiqueEchantillon.Exportateur.ID : Model._DefaultExportateur)
                                                 .Store
                                                 (
                                                    X.Store()
                                                    .AutoLoad(true)
                                                    .Model
                                                    (
                                                         Html.X().Model()
                                                        .IDProperty("ID")
                                                        .Fields
                                                        (
                                                          new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                          new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                                        )
                                                     )
                                                    .Proxy
                                                    (
                                                       Html.X().AjaxProxy()
                                                       .Url(Url.Action("LoadExportateurActive", "Exportateur"))
                                                       .Reader(Html.X().JsonReader().RootProperty("data"))
                                                    )
                                                ),
                                            X.DateField()
                                                .ID("txtDateEchantillon")
                                                .FieldLabel("Date")
                                                .AllowBlank(false)
                                                .IndicatorIconCls("IndicatorRedStar")
                                                .IndicatorText("*")
                                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._AnalyseChimiqueEchantillon.DateEchantillon.ToString() : DateTime.Now.ToString())
                                                .LabelAlign(LabelAlign.Right)

                                    ),
                                    X.GridPanel()
                                       .Layout(LayoutType.Fit)
                                       .ID("grpListeSelectedLots")
                                       .Region(Region.Center)
                                       .ForceFit(true)
                                       .Margin(5)
                                       .Border(true)
                                       .Height(295)
                                       .AllowDeselect(true)
                                       .Store(
                                                X.StoreFor<Tms.Classes.Business.stock.AnalyseChimiqueEchantillonLot>()
                                                    .ID("storeListeSelectedLots")
                                                    .AutoLoad(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? true : false)
                                                    .Proxy(
                                                           Html.X().AjaxProxy()
                                                           .Url(Url.Action("GetSampleLots"))
                                                           .Reader(
                                                                    Html.X().JsonReader().RootProperty("data")
                                                                    )
                                                      )
                                                    .Parameters(ps =>
                                                    {
                                                        ps.Add(new StoreParameter("ItemEchantillon", Model._AnalyseChimiqueEchantillon.ID.ToString(), ParameterMode.Value));
                                                    }
                                                    )
                                                    .Listeners(
                                                        ls =>
                                                        {
                                                            ls.Add.Handler = "App.NombreOfLots.setText(App.grpListeSelectedLots.getRowsValues().length + ' Lots');";
                                                            ls.Remove.Handler = "App.NombreOfLots.setText(App.grpListeSelectedLots.getRowsValues().length + ' Lots');";
                                                            ls.Load.Handler = "App.NombreOfLots.setText(App.grpListeSelectedLots.getRowsValues().length + ' Lots');";
                                                        }
                                                    )
                                        )
                                        .ColumnModel
                                        (
                                            Html.X().Column().Text("").DataIndex("mIcon").Renderer("SampleIconRender").Hideable(false).Width(40).Filterable(false),
                                            Html.X().Column().Text("Lot N°").DataIndex("NumeroLot").Hideable(false),
                                            Html.X().Column().Text("Nbr de sacs").DataIndex("NombreSacs").Hideable(false)
                                        )
                                        .DockedItems(
                                            X.Toolbar()
                                                .Dock(Dock.Top)
                                                .Items(
                                                            X.Label().ID("NombreOfLots").Text("Lots"),
                                                            X.ToolbarSpacer(15),
                                                            X.Button()
                                                                .ID("BtnAddLot")
                                                                .IconCls("action_new_02")
                                                                .Border(false)
                                                                .Cls("ButtonStyle")
                                                                .Text("Ajouter")
                                                                .Disable(false)
                                                                .DirectEvents(de =>
                                                                {
                                                                    de.Click.Url = Url.Action("OnSelectLot");
                                                                    de.Click.EventMask.ShowMask = true;
                                                                    de.Click.ExtraParams.Add(new Parameter { Name = "LotsAdded", Mode = ParameterMode.Raw, Encode = true, Value = "App.grpListeSelectedLots.getRowsValues({selectedOnly : false})" });

                                                                }),
                                                            X.Button()
                                                                .ID("BtnRemoveLot")
                                                                .Icon(Icon.Delete)
                                                                .Border(false)
                                                                .Cls("ButtonStyle")
                                                                .Text("Retirer")
                                                                .Disabled(true)
                                                                .DirectEvents(de =>
                                                                {
                                                                    de.Click.Url = Url.Action("RemoveLot");
                                                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "App.grpListeSelectedLots.getSelectionModel().getSelection()[0].data" });                                                                    
                                                                    de.Click.EventMask.ShowMask = true;
                                                                    de.Click.Confirmation.ConfirmRequest = true;
                                                                    de.Click.Confirmation.BeforeConfirm = "config.confirmation.title = 'Fiche Echantillon : Retirer'; config.confirmation.message = 'Voulez-vous retirer ce lot ? ';";
                                                                })
                                                        )
                                        )
                                        .SelectionModel(
                                                        X.RowSelectionModel()
                                                            .ID("rowCode")
                                                            .Mode(SelectionMode.Single)
                                                            .AllowDeselect(true)
                                            )
                                        .Listeners(l =>
                                        {
                                            if (Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Consult)
                                            {
                                                l.Select.Fn = "OverviewSample.SetButtons";
                                                l.Deselect.Fn = "OverviewSample.SetButtons";
                                            }
                                        }
                                    )

                )


            )
            .Buttons(
                        X.Button().Text("OK")
                        .ID("BtnSaveCode")
                        .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                        .DirectEvents(de =>
                        {
                            de.Click.Url = Url.Action("SubmitFormMethod");
                            //de.Click.Success = "ShowNotifaction();";
                            de.Click.Before = "return validNew(App.FormSampleAnalysePhysique.id);";
                            de.Click.FormID = "#(return this.up('window').down('form');)";
                            de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListeSelectedLots.getRowsValues({selectedOnly : false})" });
                        }),
                        X.Button()
                            .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                            .Handler("App.FormSampleAnalysePhysique.doClose()").Cls("btncancel")

                    )


)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
                    /*alert(winId);*/
                    /*var winId = #{FormFournisseur}.id;*/
                    var areAllrequiredFieldsFilled = isFormValid(winId);

                    /*
                   *   Vérification de la saisie des champs obligatoires
                   */
                    if (!areAllrequiredFieldsFilled) {
                        console.log('error fileds');
                        Ext.Msg.show({ title: 'Codification : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Please enter the delivery ID', buttons: Ext.Msg.OK });
                        return false;
                    }

                }

        /*Ext.onReady(function() {
         #{BtnOk}.on(#{BtnOk}.clickEvent,validNew );
        //})*/
</script>
<script type="text/javascript" language="javascript">
    var enterKeyPressHandler = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            /*Ext.net.DirectMethod.request({ url: "/DeliveryCoding/SelectDeliveryInfo"});*/
            App.BtnSearchDeliveryInfo.fireEvent('click', App.BtnSearchDeliveryInfo);
            e.stopEvent();
        }
    };

    var ShowNotifaction = function () {
        Ext.Msg.notify("Codification", "Code has been saved !");
    };
</script>

