<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 100px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeConteneurShip.columnManager.getColumns(), App.grpListeConteneurShip.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var GetNbrStoreRows = function () {
        var nbr = App.grpListeConteneurShip.getRowsValues().length;
        App.LblResumeConteneurShip.setText(nbr + ' Conteneur(s)');
    };

    var SetCriteriaTitle = function (status, type, campagne, compagnie) {

        App.ConteneurShipCriteriaPanel.title = "";
        var texttitle = "";
        if (campagne) texttitle += "Campagne : " + campagne;
        if (compagnie) texttitle += " | Ship. Line : " + compagnie;
        if (status) texttitle += " | Show only active Conteneur : YES ";
        else texttitle += " | Show only active Conteneur : NO ";


        App.ConteneurShipCriteriaPanel.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            if (App.rowSelectionConteneurShip.hasSelection()) {

                if (App.DsthiddenPermModifier.value == 'true')
                    App.btnModifyConteneurShip.enable();

                if (App.DsthiddenPermDesactiver.value == 'true')
                    App.mnuCancelConteneurShip.enable();

                var isDisabled = App.rowSelectionConteneurShip.selected.items[0].data.Desactive;

                if (isDisabled === true) {
                    App.mnuCancelConteneurShip.setText('Activer');
                    App.btnModifyConteneurShip.disable();

                    if (App.DsthiddenPermActiver.value == 'true')
                        App.mnuCancelConteneurShip.enable();

                    App.mnuCancelConteneurShip.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.DsthiddenPermModifier.value == 'true')
                        App.btnModifyConteneurShip.enable();

                    App.mnuCancelConteneurShip.setText('Annuler');
                    App.mnuCancelConteneurShip.setIconCls('glyphicon glyphicon-remove red');
                }

            } else {

                App.btnModifyConteneurShip.disable();
                App.mnuCancelConteneurShip.disable();

            }
        }
    }


</script>


@model Tms.Classes.Shared.Sales.ConteneurShip
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}

@(Html.X().ResourceManager())

<form id="tms_form">

    @(X.Viewport()
