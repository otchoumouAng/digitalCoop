                            .Border(false)
                            .Cls("ButtonStyle")
                            .Disable(false)
                            .DirectEvents( de =>{
                                de.Click.Url  = Url.Action("onRefresh");

                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatus", Value= "#{TxtStatus}.getValue()",     Mode=ParameterMode.Raw});
                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemType", Value= "#{CmbConteneurShipType}.getValue()",     Mode=ParameterMode.Raw});
                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemCampagne", Value= "#{cmbCropYear}.getValue()",     Mode=ParameterMode.Raw});
                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemCompagnie", Value= "#{cmbShippingLine}.getValue()",     Mode=ParameterMode.Raw});
                                de.Click.Success = "SetCriteriaTitle(App.TxtStatus.value, App.CmbConteneurShipType.rawValue,App.cmbCropYear.rawValue,App.cmbShippingLine.rawValue);";
                                de.Click.EventMask.ShowMask = true;


                            } ),

                                 X.Button()
                                .ID("btnNewConteneurShip")
                                .IconCls("action_new_02")
                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                                .Cls("ButtonStyle")
                                .Border(false)
                                .Disable(false)
                                .DirectEvents( de =>{
                de.Click.Url  = Url.Action("OnAdd");
                                    de.Click.Success = "App.FormConteneurShip.setTitle('Conteneur : Nouveau')";
                de.Click.EventMask.ShowMask = true;
            } ),

                             X.Button()
                            .ID("btnModifyConteneurShip")
                            .IconCls("action_modify_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Disabled(true)
                            .DirectEvents( de =>{
                de.Click.Url  = Url.Action("OnEdit");
                                de.Click.Success = "App.FormConteneurShip.setTitle('Conteneur : Modifier')";
                de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeConteneurShip}.getSelectionModel().getSelection()[0].data"});
                de.Click.EventMask.ShowMask = true;
            } ),


                         //        X.SplitButton()
                         //       .ID("btnPrint")
                         //       .IconCls("action_print_02")
                         //       .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                         //       .Disable(false)
                         //       .Cls("ButtonStyle")
                         //       .Border(false)
                         //       .Menu(new Menu()
                         //       {
                         //           Items =
                         //           {


                         //}

                         //       })
                         //       ,

                                X.ToolbarFill(),

                                 X.Button()
                                .ID("btnActions")
                                .Text("Actions")
                                .Border(false)
                                .Cls("ButtonStyle")
                                .IconCls("menu_04")
                                .Disable(false)
                                 .Menu(new Menu()
                                 {
                                     Items = {
                                         X.MenuItem()
                                            .ID("mnuExportListConteneurShip")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                            .Icon(Icon.PageExcel)
                                            .Handler("SetExcelList();"),
                                                X.MenuItem()
                                                .ID("mnuCancelConteneurShip")
                                                .IconCls("glyphicon glyphicon-remove red")
                                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                                                .Cls("ButtonStyle")
                                                .Border(false)
                                                .Disabled(true)
                                                .DirectEvents(de =>
                                                {
                                                    de.Click.Url = Url.Action("OnActivateDeactivate");
                                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeConteneurShip}.getSelectionModel().getSelection()[0].data" });
                                                    de.Click.EventMask.ShowMask = true;
                                                    de.Click.Confirmation.ConfirmRequest = true;
                                                    de.Click.Confirmation.Title = "Conteneur";
                                                    de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListeConteneurShip}.getSelectionModel().getSelection()[0].data.Desactive)";
