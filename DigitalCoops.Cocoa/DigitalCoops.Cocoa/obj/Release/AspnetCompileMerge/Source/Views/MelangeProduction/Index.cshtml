<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeCompositionUsinage.columnManager.getColumns(), App.grpListeCompositionUsinage.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
            else if (value == 3) {
                return 'action_new_03';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
            else if (value == 3) {
                return 'glyphicon-folder-close green'; // glyphicon glyphicon-file blue
            }
        },

        SummaryComposition: function () {
            var nbrOfrows = App.grpListeCompositionUsinage.getStore().getCount();                        
            App.lblSummaryComposition.setHtml("Nbr : " + nbrOfrows);
        },

        resetButtons: function () {

            App.btnModify.disable();
            App.btnCancel.disable();
            App.btnApprove.disable();
            App.btnModifyComposition.disable();
            App.btnModifyComposition.setVisible(false);

            if (App.rowCompositionUsinage.hasSelection()) {

                var isDesactive = App.rowCompositionUsinage.selected.items[0].data.Desactive;
                var IsApproved = App.rowCompositionUsinage.selected.items[0].data.IsApproved;

                if (isDesactive === false) {

                    if (App.MlhiddenPermPrintSheet.value == 'true')
                        App.mnuPrintBlendingSheet.enable();

                    if (IsApproved === false) {
                        if (App.MlhiddenPermApprove.value == 'true')
                            App.btnApprove.enable();                        

                        if (App.MlhiddenPermModifier.value == 'true')
                            App.btnModify.enable();

                        if (App.MlhiddenPermDesactiver.value == 'true')
                            App.btnCancel.enable();                        
                    } else {
                        if (App.MlhiddenPermSupModifier.value == 'true') {
                            App.btnModifyComposition.enable();
                            App.btnModifyComposition.setVisible(true);
                            App.btnModify.enable();
                            return;
                        }

                        App.btnApprove.disable();
                        App.btnModify.disable();
                        App.btnCancel.disable();                        
                    }                      
                }
                else {
                    App.btnModify.disable();
                    App.btnCancel.disable();
                    App.btnApprove.disable();
                    App.mnuPrintBlendingSheet.disable();
                    App.btnModifyComposition.disable();
                    App.btnModifyComposition.setVisible(false);
                }

            }
        }
    }

</script>

