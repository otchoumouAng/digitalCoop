<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeCompteBancaire.columnManager.getColumns(), App.grpListeCompteBancaire.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var GetNbrStoreRows = function () {
        var nbr = App.grpListeCompteBancaire.getRowsValues().length;
        App.LblResumeCompteBancaire.setText(nbr + ' Account(s)');
    };

    var SetCriteriaTitle = function (status) {

        App.CompteBancaireCriteriaPanel.title = "";
        var texttitle = "";

        if (status) texttitle += "Show only active Account : YES ";
        else texttitle += "Show only active Accounts : NO ";

        App.CompteBancaireCriteriaPanel.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            if (App.rowSelectionCompteBancaire.hasSelection()) {
                if (App.cbhiddenPermModify.value == 'true')
                    App.btnModifyCompteBancaire.enable();

                if (App.cbhiddenPermDesactiver.value == 'true')
                    App.mnuCancelCompteBancaire.enable();

                var isDisabled = App.rowSelectionCompteBancaire.selected.items[0].data.Desactive;

                if (isDisabled === true) {
                    if (App.cbhiddenPermActiver.value == 'true')
                        App.mnuCancelCompteBancaire.enable();

                    App.mnuCancelCompteBancaire.setText('Activer');
                    App.btnModifyCompteBancaire.disable();
                    App.mnuCancelCompteBancaire.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.cbhiddenPermModify.value == 'true')
                        App.btnModifyCompteBancaire.enable();

                    App.mnuCancelCompteBancaire.setText('Annuler');
                    App.mnuCancelCompteBancaire.setIconCls('glyphicon glyphicon-remove red');
                }

            } else {

                App.btnModifyCompteBancaire.disable();
                App.mnuCancelCompteBancaire.disable();

            }
        }
    }


</script>
@model Tms.Classes.Shared.Sales.CompteBancaire
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}

@(Html.X().ResourceManager())

<form id="tms_form">
    @(X.Viewport()
    .Layout(LayoutType.Border)
    .ID("TmsViewPort")
    .Items(
            X.Hidden().ID("BaseUrl").Value(@BaseUrl),
            X.Hidden().ID("cbhiddenPermModify").ReadOnly(true),
            X.Hidden().ID("cbhiddenPermDesactiver").ReadOnly(true),
            X.Hidden().ID("cbhiddenPermActiver").ReadOnly(true),
            X.Panel()
                .ID("pnlNorth")
                .Region(Region.North)
                .Layout(LayoutType.Border)
                .TopBar(new Toolbar()
                {
                    Items =
                    {
                        X.Button()
                            .ID("btnFilterCompteBancaire")
                            .IconCls("action_filter_02")
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                            .Disabled(false)
                            .DirectEvents( de =>{
                                de.Click.Url  = Url.Action("OnFilter");
                                de.Click.EventMask.ShowMask = true;
                            } ),
                        X.Button()
                            .ID("btnRefreshCompteBancaire")
                            .IconCls("action_refresh_01")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Disable(false)
                            .DirectEvents( de =>{
                                de.Click.Url  = Url.Action("onRefresh");
                                de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatus", Value= "#{TxtStatus}.getValue()",     Mode=ParameterMode.Raw});
                                de.Click.Success = "SetCriteriaTitle(App.TxtStatus.value);";
                                de.Click.EventMask.ShowMask = true;
                            } ),
                        X.Button()
                            .ID("btnNewCompteBancaire")
                            .IconCls("action_new_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Disable(false)
                            .DirectEvents( de =>{
                                de.Click.Url  = Url.Action("OnAdd");
                                de.Click.Success = "App.FormCompteBancaire.setTitle('Account : Nouveau')";
                                de.Click.EventMask.ShowMask = true;
                            } ),
                        X.Button()
                            .ID("btnModifyCompteBancaire")
                            .IconCls("action_modify_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Disabled(true)
                            .DirectEvents( de =>{
                                de.Click.Url  = Url.Action("OnEdit");
                                de.Click.Success = "App.FormCompteBancaire.setTitle('Account : Modifier')";
                                de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeCompteBancaire}.getSelectionModel().getSelection()[0].data"});
                                de.Click.EventMask.ShowMask = true;
                            } ),
                        X.ToolbarFill(),
                        X.Button()
                            .ID("btnActions")
                            .Text("Actions")
                            .Border(false)
                            .Cls("ButtonStyle")
                            .IconCls("menu_04")
                            .Disable(false)
                            .Menu(new Menu()
                            {
                                Items = {
                                    X.MenuItem()
                                        .ID("mnuExportListCompteBancaire")
                                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                        .Icon(Icon.PageExcel)
                                        .Handler("SetExcelList();"),
                                    X.MenuItem()
                                        .ID("mnuCancelCompteBancaire")
                                        .IconCls("glyphicon glyphicon-remove red")
                                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                                        .Cls("ButtonStyle")
                                        .Border(false)
                                        .Disabled(true)
                                        .DirectEvents(de =>
                                        {
                                            de.Click.Url = Url.Action("OnActivateDeactivate");
                                            de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeCompteBancaire}.getSelectionModel().getSelection()[0].data" });
                                            de.Click.EventMask.ShowMask = true;
                                            de.Click.Confirmation.ConfirmRequest = true;
                                            de.Click.Confirmation.Title = "Account";
                                            de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListeCompteBancaire}.getSelectionModel().getSelection()[0].data.Desactive)";
                                            de.Click.Success = "Overview.resetButtons();";
                                        })

                                    }
                            })
                    }
                }),
        X.FormPanel()
            .ID("CompteBancaireCriteriaPanel")
            .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Account - overview" })
            .Region(Region.North)
            .Floatable(false)
            .Border(false)
            .Collapsed(true)
            .Collapsible(true)
            //.CollapsedCls("panelcollapse")
            .BodyPadding(5)
            .Frame(true)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Start })
            .Items(
                    X.Panel()
                        .Border(false)
                        //.Frame(true)
                        //.Margin(10)
                        .Width(400)
                        .Height(40)
                        //.Title("Criteria")
                        .Layout(LayoutType.Form)
                        //.BodyPadding(6)
                        .Items(
                                    X.Checkbox().ID("TxtStatus").FieldLabel("Show only active Accounts").LabelAlign(LabelAlign.Right)
                                ),
                    X.Container()
                            .ID("")
                            .Height(40)
                            .Flex(1)
                            .Layout(LayoutType.VBox)
                            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Center, Pack = BoxPack.Center })
                            .Items(X.Label().ID("LblResumeCompteBancaire").Text("Resume ici").EmptyText(""))
                        ),
                        X.GridPanel()
                       .Layout(LayoutType.Fit)
                       .ID("grpListeCompteBancaire")
                       .Region(Region.Center)
                       .ForceFit(false)
                       .AllowDeselect(false)
                        .Store(
                            X.StoreFor<Tms.Classes.Shared.Sales.CompteBancaire>().ID("storeListeCompteBancaire")
                            .PageSize(50)
                            .RemotePaging(false)
                            .Proxy(Html.X().AjaxProxy()
                                        .Url(Url.Action("Select"))
                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                    )
                                    .Listeners(ls =>
                                    {
                                        ls.Load.Fn = "GetNbrStoreRows";
                                        ls.Add.Fn = "GetNbrStoreRows";
                                    })

                            )
                            .ColumnModel
                            (
                                Html.X().Column().Text("").DataIndex("mIcon").Renderer("renderIcon").Width(40).Hideable(false).Filterable(false),
                                Html.X().Column().Text("Account Number").DataIndex("Numero").Flex(1),
                                Html.X().Column().Text("Bank").DataIndex("BanqueAsString").Flex(1),
                                Html.X().Column().Text("Exportateur").DataIndex("ExportateurAsString").Flex(1),
                                X.Column().Text("Utilisation Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                                X.DateColumn().Text("Date Creation").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                                X.Column().Text("Utilisation Modification").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                                X.DateColumn().Text("Date Modification").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")

                            )
                            .BottomBar(
                                Html.X().PagingToolbar()
                                .HideRefresh(true)
                            .Plugins(Html.X().ProgressBarPager())
                            )
                            .Plugins(
                                X.FilterHeader()
                            )
                            .SelectionModel(
                                X.RowSelectionModel()
                                    .ID("rowSelectionCompteBancaire")
                                    .Mode(SelectionMode.Single)
                                    .AllowDeselect(false)
                            )
                            .Listeners(l =>
                            {
                                l.Select.Fn = "Overview.resetButtons";
                                l.Deselect.Fn = "Overview.resetButtons";

                            }
                            )
                            .DirectEvents(de =>
                            {
                                de.RowDblClick.Url = Url.Action("OnConsult");
                                de.RowDblClick.CleanRequest = true;
                                de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowSelectionCompteBancaire}.getSelected().items[0].data" });
                                de.RowDblClick.EventMask.ShowMask = true;
                            }
                            )

    )
    )

</form>