<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeRetourEmpotage.columnManager.getColumns(), App.grpListeRetourEmpotage.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {

        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },

        SummaryBL: function () {
            var nbrOfrows = App.grpListeRetourEmpotage.getStore().getCount();
            var totalNetAccepte = App.storeListeRetourEmpotage.sum('PoidsNetAccepte') || 0;
            var totalNetLivre = App.storeListeRetourEmpotage.sum('PoidsLivre') || 0;
            var totalQuantite = App.storeListeRetourEmpotage.sum('Quantite') || 0;
            var totalPoidsBrut = App.storeListeRetourEmpotage.sum('PoidsBrut') || 0;

            totalNetAccepte = FormatAmount(totalNetAccepte);
            totalNetLivre = FormatAmount(totalNetLivre);
            totalQuantite = FormatAmount(totalQuantite);
            totalPoidsBrut = FormatAmount(totalPoidsBrut);
            App.lblSummaryBES.setHtml("Nbr Of Adjustment : " + nbrOfrows + "<br/>Total Quantity : " + totalQuantite + "<br/>Total Poids Brut (Kg) : " + totalPoidsBrut + "<br/>Total Livré (Kg) : " + totalNetLivre + "<br/>Total Accepted (Kg) : " + totalNetAccepte);
        },

        resetButtons: function () {

            App.btnModify.disable();
            App.btnCancel.disable();

            if (App.rowRetourEmpotage.hasSelection()) {

                var isDesactive = App.rowRetourEmpotage.selected.items[0].data.Desactive;

                if (isDesactive === false) {
                    if (App.ashiddenPermModifier.value == 'true')
                        App.btnModify.enable();

                    if (App.ashiddenPermDesactiver.value == 'true')
                        App.btnCancel.enable();
                }

                else {
                    App.btnModify.disable();
                    App.btnCancel.disable();
                }

            }
        }
    }

</script>

