<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListePeseeAvtUsinage.columnManager.getColumns(), App.grpListePeseeAvtUsinage.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {        
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return  'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }
        },

        SummaryPAU: function () {
            var nbrOfrows = App.grpListePeseeAvtUsinage.getStore().getCount();
            var totalNet = App.storeListePeseeAvtUsinage.sum('PoidsNet') || 0;
            var totalGrossWeight = App.storeListePeseeAvtUsinage.sum('PoidsBrut') || 0;
            var totalNbrOfBags = App.storeListePeseeAvtUsinage.sum('NombreSacs') || 0;
            
            totalNet = FormatAmount(totalNet);
            totalGrossWeight = FormatAmount(totalGrossWeight);
            totalNbrOfBags = FormatAmount(totalNbrOfBags);
            App.lblSummaryPAU.setHtml("Nbr de Pesées : " + nbrOfrows + "<br/> Nbr de sacs : " + totalNbrOfBags);
            App.lblSummary2.setHtml("Poids Brut (Kg) : " + totalGrossWeight + " <br/> Poids Net (Kg) : " + totalNet);
        },

        resetButtons: function () {

            App.btnModify.disable();
            App.btnCancel.disable();            
            App.mnuPrintTicket.disable();
            if (App.rowPeseeAvantUsinage.hasSelection()) {

                var isDesactive = App.rowPeseeAvantUsinage.selected.items[0].data.Desactive;
                var EstFinalise = App.rowPeseeAvantUsinage.selected.items[0].data.EstFinalise;

                if (isDesactive === false) {
                    if (App.phiddenPermPrintSheet.value == 'true')
                        App.mnuPrintTicket.enable();

                    if (EstFinalise === false)
                    {
                        if (App.phiddenPermFinalize.value == 'true')
                            App.btnModify.enable();

                        if (App.phiddenPermDesactiver.value == 'true')
                            App.btnCancel.enable();

                    }

                    if (EstFinalise === true) {                        

                        if (App.phiddenPermDesactiverSup.value == 'true')
                            App.btnCancel.enable();
                    }                                                              
                }
                else {
                    App.btnModify.disable();
                    App.btnCancel.disable();
                    App.mnuPrintTicket.disable();
                }

            }
        }
    }

</script>

