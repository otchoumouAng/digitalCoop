

@model Tms.Classes.Business.LivraisonViewModel
@{
    Layout = null;
    var X = Html.X();
    string StartDate = DateTime.Now.AddDays(-30).ToShortDateString();
    string EndDate = DateTime.Now.ToShortDateString();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>

@(X.FormPanel()
                    .Items
                    (
                        X.Window()
                        .ID("ListOfDeliveries")
                        .Width(880)
                        .Resizable(false)
                        .Height(470)
                        .CloseAction(Ext.Net.CloseAction.Destroy)
                        .Listeners
                        (
                            l =>
                            {
                                //l.BeforeClose.Handler = "App.TmsViewPort.unmask();";
                                //l.Close.Handler = "App.TmsViewPort.unmask();";
                                //l.Show.Handler = "App.grpListDeliveriesSP.getStore().load();";
                            }
                        )
                        .X(200)
                        .Y(20)
                        .Title("Liste des livraisons disponibles")
                        .Layout(LayoutType.Form)
                        .Items
                        (
                            X.Panel()
                            .ID("pnlNorthDelivery")
                            .MarginSpec("0 0 0 0")
                            .Height(40)
                            .Border(false)
                            .Frame(true)
                            .Region(Region.North)
                            .Layout(LayoutType.Border)
                            .TopBar
                            (
                               new Toolbar()
                               {
                                   Items =
                                 {
                                   X.Button()
                                    .ID("btnRefreshDelivery")
                                    .MarginSpec("0 0 0 0")
                                    .IconCls("action_refresh_01")
                                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                                    .Border(false)
                                    .Cls("ButtonStyle")
                                    .Disable(false)
                                    .DirectEvents
                                    (
                                      de =>
                                      {
                                        de.Click.Url  = Url.Action("OnRefreshForAvailableDeliveries");
                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemFournisseur", Encode=true, Value= "#{cmbFournisseurFD}.getValue()", Mode=ParameterMode.Raw});
                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodStart", Value= "#{dtpStartDateFD}.getRawValue()",   Mode=ParameterMode.Raw});
                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodEnd", Value= "#{dtpEndDateFD}.getRawValue()",     Mode=ParameterMode.Raw});
                                        de.Click.Success = "App.CriteriaPanelFD.setTitle('Fournisseur : ' + App.cmbFournisseurFD.rawValue + ' , du  '+ App.dtpStartDateFD.rawValue  + ' au  '+ App.dtpEndDateFD.rawValue )";
                                        de.Click.EventMask.ShowMask = true;
                                      }
                                   )
                                 }
                               }
                            ),

                            X.FormPanel()
                            .ID("CriteriaPanelFD")
                            .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Delivery Note - Livraisons disponibles", Height=20, MarginSpec = "0 0 0 0" })
                            .Region(Region.North)
                            .Border(false)
                            .Collapsed(true)
                            .Collapsible(true)
                            .BodyPadding(0)
                            .Frame(true)
                            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Start })
                            .Width(863)
                            .Height(170)
                            .Items
                             (
                                X.Panel()
                                 .Border(false)
                                 .Frame(true)
                                 .Margin(10)
                                 .Width(350)
                                 .Height(100)
                                 .Layout(LayoutType.Form)
                                 .BodyPadding(0)
                                 .Items
                                 (
                                       X.ComboBox()
                                        .ID("cmbFournisseurFD")
                                        .FieldLabel("Fournisseur")
                                        .LabelWidth(30)
                                        .DisplayField("Nom")
                                        .ValueField("ID")
                                        .Width(340)
                                        .LabelAlign(LabelAlign.Right)
                                        .TypeAhead(true)
                                        .ForceSelection(true)

                                        .Store
                                        (
                                          X.Store()
                                           .AutoLoad(true)
                                           .Model
                                           (
                                             Html.X().Model()
                                             .IDProperty("ID")
                                             .Fields
                                             (
                                               new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                               new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                             )
                                           )
                                           .Proxy
                                           (
                                             Html.X().AjaxProxy()
                                             .Url(Url.Action("LoadFournisseurAll", "Fournisseur"))
                                             .Reader(Html.X().JsonReader().RootProperty("data"))
                                           )
                                         )
                                         .SelectedItems
                                         (
                                           it =>
                                           {
                                               it.Add(new ListItem { Text = "{Tous}", Value = "-1" });
                                           }
                                         ),

                                        X.FieldContainer()
                                         .LabelWidth(90)
                                         .FieldLabel("From/To")
                                         .LabelAlign(LabelAlign.Right)
                                         .Layout(LayoutType.HBox)
                                         .Width(340)
                                         .Items
                                         (
                                            X.DateField().ID("dtpStartDateFD").Text(@StartDate).Width(125).Height(25),
                                            X.DateField().ID("dtpEndDateFD").Text(@EndDate).Width(120).Height(25)
                                         )

                                   ),


                               X.Panel()
                                .ID("formOverviewBL")
                                .Width(500)
                                .Margin(10)
                                .Flex(1)
                                .Frame(true)
                                .Height(100)
                                .TitleConfig(new PanelTitle { Text = "Summary", Cls = "title_font_color" })
                                .Border(false)
                                .BodyPadding(0)
                                .Layout(LayoutType.HBox)
                                .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                                .Items
                                 (
                                    X.Container()
                                    .ID("")
                                    .Layout(LayoutType.VBox)
                                    .LayoutConfig(new VBoxLayoutConfig { Pack = BoxPack.Center })
                                    .Items(X.Label().ID("").Text("Montant").EmptyText(""))
                                 )

                               ),

                           X.Hidden()
                            .ID("TxtExecMode").Value(Model._ExecMode),
                           X.GridPanel()
                            .Layout(LayoutType.Fit)
                            .ID("grpListDeliveries")
                            .MinHeight(130)
                            .AllowDeselect(true)
                            .Store
                            (
                               X.StoreFor<Tms.Classes.Business.Livraison>()
                                .ID("storeListDeliveries")
                                .AutoLoad(true)
                             .Proxy
                             (
                              Html.X().AjaxProxy()
                                  .Url(Url.Action("LoadListOfAvailableDeliveries", "Livraison"))
                                  .Reader(Html.X().JsonReader().RootProperty("data"))
                             )
                             .Parameters
                             (
                               ps =>
                               {
                                   ps.Add(new StoreParameter("ItemFournisseur", "#{cmbFournisseurFD}.getValue()", ParameterMode.Raw));
                                   ps.Add(new StoreParameter("ItemPeriodStart", "#{dtpStartDateFD}.getRawValue()", ParameterMode.Raw));
                                   ps.Add(new StoreParameter("ItemPeriodEnd", "#{dtpEndDateFD}.getRawValue()", ParameterMode.Raw));
                               }
                             )
                             )
                             .ColumnModel
                             (
                                Html.X().Column().Text("").DataIndex("mIcon").Width(40).Renderer("renderIcon"),
                                Html.X().DateColumn().Text("Date Livraison").DataIndex("DateLivraison").Width(130),
                                Html.X().Column().Text("Fournisseur").DataIndex("FournisseurNameAsString").Width(280),
                                Html.X().Column().Text("N° Livraison").DataIndex("Numero").Width(150),
                                Html.X().Column().Text("Immatriculation").DataIndex("Immatriculation").Width(110),
                                Html.X().Column().Text("Net Livré (Kg)").DataIndex("PoidsLivre").Width(140)
                             )

                            .SelectionModel(X.RowSelectionModel().Mode(SelectionMode.Single)

                           )
                       )

                       .Buttons
                       (
                           X.Button()
                            .Text("OK")
                            .ID("BtnSendDelivery")
                           //.Handler("validNew(App.FormFournisseur.id)")
                           .DirectEvents
                           (
                              de =>
                              {
                                  de.Click.Url = Url.Action("SubmitDelivery", "BonDeLivraison");
                                  de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListDeliveries}.getSelectionModel().getSelection()[0].data" });
                              }
                           ),

                           X.Button()
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                            .Handler("App.ListOfDeliveries.doClose()")
                            .Cls("btncancel")

                          )

                )
)

@Scripts.Render("~/bundles/validation")





