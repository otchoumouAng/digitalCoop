    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <script type="text/javascript">
        var SetDefaultSite = function (val) {
            if (App.cmbDetFournisseur.value) {
                var DefaultFournisseur_Type = parseInt(App.hiddenTypeFournisseur.value) || 0;
                var fournisseurtypeid = parseInt(App.cmbDetFournisseur.getSelectedRecord().data.FournisseurTypeID) || 0;
                var agenceid = parseInt(App.cmbDetFournisseur.getSelectedRecord().data.DefaultAgenceFournisseurID) || 0;

                if (DefaultFournisseur_Type == fournisseurtypeid) {
                    if (App.hiddenExecMode.value.toString() == "AddNew") {                        
                        App.cmbDetAgence.setValue(agenceid);
                        App.cmbDetAgence.setReadOnly(false);
                    } else if (App.hiddenExecMode.value.toString() == "Update") {
                        App.cmbDetAgence.setReadOnly(false);
                    }
                }
                else {
                    var DfSite = parseInt(App.hiddenDefaultSite.value) || 0;
                    App.cmbDetAgence.setReadOnly(true);
                    App.cmbDetAgence.setValue(null);
                }
            }
        };

        var setDestinationExecMode = function ()
        {
            var combo = App.cmbDetDestination;
            records = combo.getStore().getRecordsValues();            
            var execMode = App.hiddenExecMode.value;
            if (records.length > 0)
            {                
                var firstComboElt = records[0][combo.valueField];

                if (execMode == "AddNew")
                    combo.setValue(App.hiddenDestinationDefaultID.getValue());
                
                combo.setReadOnly(false);
                if (execMode == "Consult" || App.HiddenStatutLivraison.value == 2) {
                    combo.setReadOnly(true);
                    return;
                }

                if (App.hiddenDestinationDefaultID.getValue() == firstComboElt)
                {                    
                    combo.setReadOnly(true);
                    combo.setValue(App.hiddenDestinationDefaultID.getValue());
                }

                /*if (App.cmbDetDeliveryType.getStore().isLoaded() == true) {
                    var selectedDeliveryType = App.cmbDetDeliveryType.getSelectedRecord().data;
                    DefinirZonesObligatoires(selectedDeliveryType);
                } */
            }
        };
        
        var setOrigineExecMode = function ()
        {
            var combo = App.cmbDetOrigin;
            
            records = combo.getStore().getRecordsValues();           

            var execMode = App.hiddenExecMode.value;

            if (records.length > 0)
            {
                
                var firstComboElt = records[0][combo.valueField];
                
                if (execMode == "AddNew")
                    combo.setValue(App.hiddenOriginDefaultID.getValue());
                
                combo.setReadOnly(false);
                if (execMode == "Consult" || App.HiddenStatutLivraison.value == 2) {
                    combo.setReadOnly(true);
                    return;
                }

                if (App.hiddenOriginDefaultID.getValue() == firstComboElt)
                {
                    combo.setReadOnly(true);
                    combo.setValue(App.hiddenOriginDefaultID.getValue());
                }

                /*if (App.cmbDetDeliveryType.getStore().isLoaded() == true) {
                    var selectedDeliveryType = App.cmbDetDeliveryType.getSelectedRecord().data;
                    DefinirZonesObligatoires(selectedDeliveryType);
                } */
            }
        };

        var setCtrlIsRequired = function (field, value)
        {
            field.allowBlank = !value;
            
            field.setIndicator("");
            field.setIndicatorCls('');
            field.showIndicator();

            if (value == true)
            {
                
                field.setIndicator("*");
                field.setIndicatorCls('IndicatorRedStar');
                field.showIndicator();
            }

            /*Champ Ext Waybill en lecture seule*/


            /*if (App.cmbDetDeliveryType.getValue() == 41 && App.cmbDetDeliveryType.getValue() != null) {
                App.btnAddExterWaybill.enable();
            } else {
                App.btnAddExterWaybill.disable();
            }*/
        };

        var DefinirZonesObligatoires = function (record) {

            App.btnAddExterWaybill.disable();
            App.txtExternalWayBill.setReadOnly(false);
            setCtrlIsRequired(App.txtExternalWayBill, false);

            /*if (record.SaisieNumTransfert == true) {
                App.btnAddExterWaybill.enable();
                App.txtExternalWayBill.setReadOnly(true);
                setCtrlIsRequired(App.txtExternalWayBill, true);
            }/*

            /*Numero Lot*/
            setCtrlIsRequired(App.txtLotNumber, false);
            if (record.SaisieNumLot == true) {
                setCtrlIsRequired(App.txtLotNumber, true);
            }

            /*Numero OT*/
            setCtrlIsRequired(App.txtShipmentNumber, false);
            if (record.SaisieNumOT == true) {
                setCtrlIsRequired(App.txtShipmentNumber, true);
            }

            /*Seal number*/
            setCtrlIsRequired(App.txtSealNumber, false);
            if (record.SaisieNumPlomb == true) {
                setCtrlIsRequired(App.txtSealNumber, true);
            }

            /*container number*/
            setCtrlIsRequired(App.txtContainerNumber, false);
            setCtrlIsRequired(App.cmbDetTransporter, false);
            if (record.SaisieNumConteneur == true) {
                setCtrlIsRequired(App.txtContainerNumber, true);
                setCtrlIsRequired(App.cmbDetTransporter, true)
            }

            /*certification */
            setCtrlIsRequired(App.cmbDetCertification, false);
            if (record.SaisieCertification == true) {
                setCtrlIsRequired(App.cmbDetCertification, true);
            }

            /*Transitaire */
            setCtrlIsRequired(App.cmbDetTransitaire, false);
            if (record.SaisieTransitaire == true) {
                setCtrlIsRequired(App.cmbDetTransitaire, true);
            }

            /*Connaiss Externe */
            setCtrlIsRequired(App.txtExternalWayBill, false);
            if (record.SaisieNumExterne == true) {
                setCtrlIsRequired(App.txtExternalWayBill, true);
            }

            /*Centre d'achats */
            setCtrlIsRequired(App.cmbDetSite, false);
            if (record.SaisieCentreAchat == true) {
                setCtrlIsRequired(App.cmbDetSite, true);
            }
        };

        var CheckDeclaredWeight = function (record)
        {
            /*console.log(record);*/

            if (!record)
                return;

            if (App.txtNbrOfBags.value != null && App.txtEstimatedTonnage.value != null)
            {

                var mNbSacsDeclares = parseInt(App.txtNbrOfBags.value, 10);

                var mPoidsDeclare   = parseInt(App.txtEstimatedTonnage.value,10);               

                /*console.log('Poids Max :' + record.PoidsMax);
                console.log('Est. Poids Max :' + record.PoidsMax * mNbSacsDeclares);
                console.log('Est. Poids Min :' + record.PoidsMin * mNbSacsDeclares);
                console.log('Poids declare. :' + mPoidsDeclare);*/

                if (record.PoidsMax > 0)
                {
                    if ((mPoidsDeclare > record.PoidsMax * mNbSacsDeclares) || (mPoidsDeclare < record.PoidsMin * mNbSacsDeclares))
                    {
                        /*App.txtEstimatedTonnage.setValue('');
                        App.txtEstimatedTonnage.focus(true);*/
                        Ext.Msg.show({ title: 'Erreur : Livraison ', msg: 'Le poids estimé est hors marge theorique Poids. Min= ' + record.PoidsMin * mNbSacsDeclares + ' ,Max= ' + record.PoidsMax * mNbSacsDeclares, buttons: Ext.Msg.OK });
                    }
                }

            }
        };

        var validEstimatedWeight = function ()
        {
            var combo = App.cmbDetPackaging;
            record = App.cmbDetPackaging.getSelectedRecord().data;

            if (records.length > 0)
            {
                var firstComboElt = record;                
                CheckDeclaredWeight(firstComboElt);
            }
        };

    </script>

