@model Tms.Classes.Shared.Sales.FactureCommercialeDeductionTypeViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
@(
X.Window()
    .ID("FormFactureCommercialeDeductionType")
    .Width(500)
    .Resizable(false)
    .Height(200)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Y(20)
    .Title("Facture Commerciale Deduction Type : Detail")    
    .BodyPadding(6) 
    .Modal(true)   
    .Items(
            X.FormPanel()
                .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                .Layout(LayoutType.Form)
                //.LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
                .Items(
                            X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                            X.Hidden().ID("hiddenRowversion").Value(Model._FactureCommercialeDeductionType.RowVersionKey),
                            X.Hidden().ID("TxtFactureCommercialeDeductionTypeID").Value(Model._FactureCommercialeDeductionType.ID),
                            X.TextField().ID("TxtDesignation").FieldLabel("Designation")
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FactureCommercialeDeductionType.Designation.ToString() : string.Empty)
                                .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*"),
                            X.Checkbox().ID("ChkIsAuto").FieldLabel("Is Auto")
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FactureCommercialeDeductionType.Auto : false)
                                .LabelAlign(LabelAlign.Right),
                            X.NumberField()
                                .ID("TxtTauxDeduction")
                                .FieldLabel("Taux")
                                .AllowDecimals(true)
                                .MinValue(0)
                                .HideTrigger(true)
                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FactureCommercialeDeductionType.Taux : (decimal?)null)
                                .LabelAlign(LabelAlign.Right)
                    )
    )
    .Buttons(
                X.Button()
                    .Text("OK")
                    .ID("BtnSubmitFactureDeductionType")
                    .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                    .DirectEvents(de =>
                    {
                        de.Click.Url = Url.Action("SubmitFormMethod");
                        de.Click.FormID = "#(return this.up('window').down('form');)";
                        de.Click.Before = "return validNew(App.FormFactureCommercialeDeductionType.id);";
                    }),                    
                X.Button()
                    .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                    .Handler("App.FormFactureCommercialeDeductionType.doClose()").Cls("btncancel")

    )

)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Type De Deduction Facture : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }
    };
</script>












