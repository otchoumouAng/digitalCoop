                    console.log('error fileds');
                    Ext.Msg.show({ title: 'Prix Negocié : Data Validation ',icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
                    return false;
                }
                /*else {
                    var prixnegocie = App.LabelPrixJournalier.value;
                    var tolerance = App.TxtTolerancePrixNegocie.value;
                    var margeInf = prixnegocie - ((prixnegocie * tolerance) / 100);
                    var margeSup = (parseFloat(prixnegocie) + ((parseFloat(prixnegocie) * tolerance) / 100));

                    if ((val < margeInf) || (val > margeSup)) {
                        Ext.Msg.show({ title: 'Prix Negocié : Price ', msg: 'Price must be in ' + tolerance + '% range of daily price', icon: Ext.MessageBox.WARNING, buttons: Ext.Msg.OK });
                        return false;
                    } 

                }*/
                /*if (App.ModeApplicationID.value != 2) {

                    var startdate = App.TxtStartDate.rawValue;
                    var duedate = App.TxtDueDate.rawValue;

                    var arrStartDate = startdate.split("/");
                    var datebegin = new Date(arrStartDate[2], arrStartDate[1], arrStartDate[0]);
                    var arrEndDate = duedate.split("/");
                    var dateend = new Date(arrEndDate[2], arrEndDate[1], arrEndDate[0]);

                    if (dateend < datebegin) {
                        Ext.Msg.show({ title: 'Prix Negocié : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Date Fin must be equal/Higher to start date !', buttons: Ext.Msg.OK });
                        return false;
                    }
                }*/
            };

            /*var checkfield = function (mode, fournisseur) {
                if (!mode || !fournisseur) {
                    Ext.Msg.show({ title: 'Prix Negocié : Price ', msg: 'Please choose Mode Application and one supplier.', icon: Ext.MessageBox.WARNING, buttons: Ext.Msg.OK });
                    return false;
                }
                else if (mode && fournisseur) return true;
                else return false;
            };*/

            var showdate = function (item) {
                if (item) {
                    if (item == "1") {
                        App.TxtStartDate.setReadOnly(false);
                        App.TxtStartDate.allowBlank = (false);
                        App.TxtStartDate.validate();
                        App.TxtStartDate.setIndicator("*");
                        App.TxtDueDate.setReadOnly(false);
                        App.TxtDueDate.allowBlank = (false);
                        App.TxtDueDate.validate();
                        App.TxtDueDate.setIndicator("*");
                        /*App.DeliveryNumber.setReadOnly(true);*/
                    } else if (item == "2") {
                        /*App.DeliveryNumber.setReadOnly(false);*/
                        App.TxtStartDate.setReadOnly(true);
                        App.TxtStartDate.allowBlank = (true);
                        App.TxtStartDate.setValue(" ");
                        App.TxtStartDate.validate();
                        App.TxtStartDate.setIndicator("");
                        App.TxtDueDate.setReadOnly(true);
                        App.TxtDueDate.allowBlank = (true);
                        App.TxtDueDate.setValue(" ");
                        App.TxtDueDate.validate();
                        App.TxtDueDate.setIndicator("");
                    }
                }
            };

            var checkList = function () {                
                if ((App.FournisseurID.value) && (App.ModeApplicationID.value == 2)) {                    
                        App.btnNewDelivery.enable();
                } else {                    
                        App.btnNewDelivery.disable();
                    }
                
            };

            var CheckPriceRange = function () {
                var prixnegocie = parseFloat(unformatNumber(App.LabelPrixJournalier.value)) || 0;
                var tolerance = parseFloat(App.TxtTolerancePrixNegocie.value) || 0;
                var margeInf = prixnegocie - ((prixnegocie * tolerance) / 100);
                var margeSup = (parseFloat(prixnegocie) + ((parseFloat(prixnegocie) * tolerance) / 100));
                var val = parseFloat(unformatNumber(App.TxtPrice.value)) || 0;
                if ((val < margeInf) || (val > margeSup)) {
                    Ext.Msg.show({ title: 'Prix Negocié : Price ', msg: 'Price must be in ' + tolerance + '% range of daily price', icon: Ext.MessageBox.WARNING, buttons: Ext.Msg.OK });
                    /*return false;*/
                }
            };

    var CalculatePN = function () {
        try {

            var PriceJour = unformatNumber(App.LabelPrixJournalier.value) || 0;
            var mCommission = unformatNumber(App.TxtCommission.value) || 0;
            var Amount = 0;

            App.TxtPrixNegocie.setValue('');

            if (Ext.isNumeric(PriceJour) && Ext.isNumeric(mCommission)) {
                App.TxtPrixNegocie.setValue('');
                Amount = RoundInt(parseInt(PriceJour) + parseInt(mCommission));
                App.TxtPrixNegocie.setValue(formatNumber(Amount));
            }
        }
        catch (err) {
            Ext.Msg.show({ title: 'PN : Calcul Du Montant ', icon: Ext.MessageBox.WARNING, msg: 'Erreur lors du calcul du montant.', buttons: Ext.Msg.OK });
        }
    };

    var setPrice = function () {
        try {
            var res = App.ChkAFacturer.value;            
            var _prixNeg = unformatNumber(App.TxtPrixNegocie.value) || 0;
            var _Prix = unformatNumber(App.LabelPrixJournalier.value) || 0;

            App.TxtPrice.setValue('');
            if (res === true) 
                App.TxtPrice.setValue(formatNumber(_Prix));
            else App.TxtPrice.setValue(formatNumber(_prixNeg));
            
        }
        catch (err) {
            Ext.Msg.show({ title: 'PN : Calcul Du Montant ', icon: Ext.MessageBox.WARNING, msg: 'Erreur lors du calcul du montant.', buttons: Ext.Msg.OK });

        }
    };
</script>




