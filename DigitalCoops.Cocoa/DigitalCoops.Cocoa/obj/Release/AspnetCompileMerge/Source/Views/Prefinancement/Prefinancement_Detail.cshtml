<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Financing : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        var Amount = Number(unformatNumber(App.txtAmount.value));
        

        if(!Ext.isNumeric(Amount) && parseFloat(Amount) < 0 ) {
            Ext.Msg.show({ title: 'Prefinnancing : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Amount invalid', buttons: Ext.Msg.OK });
            return false;
        }


        /**Verifiaction d'articles**/
        if (App.grpDetailPaiementCheque.getRowsValues().length <= 0) {
            Ext.Msg.show({ title: 'Prefinnancing:  Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Please make sure you add payments.', buttons: Ext.Msg.OK });
            return false;
        }

        /**Verification des payments en etat de modification**/
        if (App.grpDetailPaiementCheque.getRowsValues().length >= 1) {
            var compteur = 0;
            for (i = 0; i < App.grpDetailPaiementCheque.getRowsValues().length; i++) {
                if (App.grpDetailPaiementCheque.getRowsValues()[i].Desactive == 0) {
                    compteur++;

                }
            }

            if (compteur == 0) {
                Ext.Msg.show({ title: 'Prefinnancing: Data Validation', icon: Ext.MessageBox.WARNING, msg: 'Please make sure you add payments.', buttons: Ext.Msg.OK });
                return false;
            }

        }

        /******/
        var AmountPayment =  0;
        
        if (App.grpDetailPaiementCheque.getRowsValues().length >= 1) {
            var compteur = 0;
            for (i = 0; i < App.grpDetailPaiementCheque.getRowsValues().length; i++) {
                if (App.grpDetailPaiementCheque.getRowsValues()[i].Desactive == 0) {
                    AmountPayment = AmountPayment + App.grpDetailPaiementCheque.getRowsValues()[i].Montant;

                }
            }

        }

        if (parseFloat(Amount) != AmountPayment) {
            Ext.Msg.show({ title: 'Prefinnancing : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'please check the sum of the payment amounts', buttons: Ext.Msg.OK });
            return false;
        }
    };

    var ChangeType = function () {

        try {
            var Type = App._cmbType.lastSelection[0].data.ID;
            var TypeParam = App.hiddenTypeApc.value;
            console.log(App._cmbType.lastSelection[0].data.ID);
            console.log(TypeParam);
            if (Type == TypeParam) {

                App.txtTonnage.setValue('');
                App.txtPrice.setValue('');
                App.txtPaid.setValue('');
                App.txtAmount.setValue('');

                App.txtTonnage.setReadOnly(false);
                App.txtTonnage.allowBlank = (false);
                App.txtTonnage.setIndicator("*");

                App.txtPrice.setReadOnly(false);
                App.txtPrice.allowBlank = (false);
                App.txtPrice.setIndicator("*");

                App.txtPaid.setReadOnly(false);
                App.txtPaid.allowBlank = (false);
                App.txtPaid.setIndicator("*");

                App.txtAmount.setReadOnly(true);
                App.txtAmount.allowBlank = (false);
                App.txtAmount.setIndicator("*");

            }
            else
            {
                

                App.txtTonnage.setValue('');
                App.txtPrice.setValue('');
                App.txtPaid.setValue('');
                App.txtAmount.setValue('');

                App.txtTonnage.setReadOnly(true);
                App.txtTonnage.allowBlank = (true);
               

                App.txtPrice.setReadOnly(true);
                App.txtPrice.allowBlank = (true);

                App.txtPaid.setReadOnly(true);
                App.txtPaid.allowBlank = (true);

                App.txtAmount.setReadOnly(false);
                App.txtAmount.allowBlank = (false);
                App.txtAmount.setIndicator("*");
            }

            


        }
        catch (err) {
            Ext.Msg.show({ title: 'Prefinancing : Amount Calculation ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating amount.', buttons: Ext.Msg.OK });

        }

    };
   
    var CalculAmountTonnage = function () {

        var Tonnage = unformatNumber(App.txtTonnage.value) || '';

        if (isNumeric(Tonnage) && Tonnage > 0)
        {
            var Paid = RoundIntSup(Tonnage);
            App.txtPaid.setValue(formatNumber(Paid));

            var Price = unformatNumber(App.txtPrice.value.replace(",", ".")) || '';

            if(isNumeric(Price) && Price > 0)
            {
                var Amount = RoundInt(Paid * Price);
               
                App.txtAmount.setValue(formatNumber(Amount));
            }
        }
        else
        {
            App.txtTonnage.setValue('');
            App.txtPaid.setValue('');
            App.txtAmount.setValue('');
        }
       
        
    };

    var CalculAmountPrice = function () {

        var Price = unformatNumber(App.txtPrice.value.replace(",", ".")) || '';

        if (isNumeric(Price) && Price >= 0) {
            var Paid = unformatNumber(App.txtPaid.value) || '';

            if (isNumeric(Paid) && Paid > 0) {
               
                var Amount = RoundInt(Paid * Price);
                
                App.txtAmount.setValue(formatNumber(Amount));    
                
            }
            else
            {
                App.txtTonnage.setValue('');
                App.txtPaid.setValue('');
                App.txtAmount.setValue('');
            }
        }
        else
        {
            App.txtPrice.setValue('');
            App.txtAmount.setValue('');
        }
       

    };


    var CalculAmountPaid = function () {

        
        var Paid = unformatNumber(App.txtPaid.value) || '';
        if (isNumeric(Paid) && Paid > 0) {
            
            var Price = unformatNumber(App.txtPrice.value.replace(",", ".")) || '';
        if ( isNumeric(Price) && Price >= 0) {

                var Amount = RoundInt(Paid * Price);

                App.txtAmount.setValue(formatNumber(Amount));

            }
            else {
               
                App.txtPrice.setValue('');
                App.txtAmount.setValue('');
            }
        }
        else {
            
            App.txtPaid.setValue('');
            App.txtAmount.setValue('');
        }


    };

    var ConvertAmount = function () {
        var AmountCFA = unformatNumber(App.txtAmount.value) || 0;
        var taux = unformatNumber(App.hiddenTauxDevise.value) || 0;
        var AmountEuro = (AmountCFA / taux).toFixed(3);
        console.log(taux);
        console.log(AmountEuro);
        App.txtAmountEuro.setValue(formatNumberDecimal(AmountEuro));
    };

    var LoadAmountTotal = function () {
       
        var amount = parseFloat(App.storeListPaiementCheque.sum('Montant')) || 0;
        
        App.txtAmountTotal.setValue(formatNumber(amount));

    };


    function formatNumberDecimal(amount) {
        console.log(amount);
        amount = thousands_separators(amount.toString().replace(".", ","));
        console.log(amount);
        formatted = amount.replace(".", ",");

        return formatted;
    };

    function unformatNumberDecimal(amount) {
        formatted = amount.replace(" ", "");

        return formatted;
    };

    function thousands_separators(num) {
        var num_parts = num.toString().split(".");
        num_parts[0] = num_parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, " ");
        return num_parts.join(".");
    }
    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

    var RoundIntSup = function (v) {
        try {
                if (v < 1000)
                {
                    var valeur = (v / 100);
                    return RoundInt(valeur)*100;
                }
                else
                {
                    var valeur = (v / 1000);
                    return RoundInt(valeur)*1000;

                }
            
        } catch (err) {
            return 0;
        }
    };

    

</script>
