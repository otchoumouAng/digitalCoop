    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">


    var Detail =
    {
        resetButtons: function () {

            App.btnEditPaiementCheque.disable();
            App.btnRemovePaiementCheque.disable();

            if (App.rowSelectionPaiementCheque.hasSelection()) {


                if (App.PaymentPermissionEdit.value == 'true')
                    App.btnEditPaiementCheque.enable();
                else
                    App.btnEditPaiementCheque.disable();



                if (App.PaymentPermissionRemove.value == 'true')
                {
                    if (App.rowSelectionPaiementCheque.lastSelected.data.Desactive == false) {
                        App.btnRemovePaiementCheque.setText("Remove");
                        App.btnRemovePaiementCheque.setIconCls('glyphicon glyphicon-minus-sign red');
                        App.btnRemovePaiementCheque.enable();
                    } else {
                        App.btnRemovePaiementCheque.setText("Reset");
                        App.btnRemovePaiementCheque.setIconCls('glyphicon glyphicon-ok-sign green');
                        App.btnRemovePaiementCheque.enable();
                    }
                }
                else
                {
                    if (App.rowSelectionPaiementCheque.lastSelected.data.Desactive == false) {
                        App.btnRemovePaiementCheque.setText("Remove");
                        App.btnRemovePaiementCheque.setIconCls('glyphicon glyphicon-minus-sign red');
                        App.btnRemovePaiementCheque.disable();
                    } else {
                        App.btnRemovePaiementCheque.setText("Reset");
                        App.btnRemovePaiementCheque.setIconCls('glyphicon glyphicon-ok-sign green');
                        App.btnRemovePaiementCheque.disable();
                    }
                }




            }
            else {
                App.btnRemovePaiementCheque.setText("Remove");
                App.btnRemovePaiementCheque.setIconCls('glyphicon glyphicon-minus-sign red');
                App.btnRemovePaiementCheque.disable();
            }







        }

    }

</script>
