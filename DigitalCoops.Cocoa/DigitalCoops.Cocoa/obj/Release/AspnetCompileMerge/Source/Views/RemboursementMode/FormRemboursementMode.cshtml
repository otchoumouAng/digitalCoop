
@model Tms.Classes.Shared.RemboursementModeViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
@(X.FormPanel()
    .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
    .Items(
            X.Window()
            .ID("FormRemboursementMode")
            .Width(500)
            .Resizable(false)
            .Height(150)
            .CloseAction(Ext.Net.CloseAction.Destroy)
            .Listeners(l =>
            {
                l.Close.Handler = "App.TmsViewPort.unmask();";
                l.Show.Handler = "#{TxtDesignationRemboursementMode}.focus();";
            })
            //.X(400)
            .Y(20)
            .Title("Refund Mode : Detail")
            .Layout(LayoutType.VBox)
            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
            .BodyPadding(6)
            .Items(
                    X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                    X.Hidden().ID("hiddenRowversion").Value(Model._RemboursementMode.RowVersionKey),
                    X.Hidden().ID("TxtRemboursementModeID").Value(Model._RemboursementMode.ID),
                    X.TextField().ID("TxtDesignationRemboursementMode").FieldLabel("Nom")
                        .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._RemboursementMode.Designation.ToString() : string.Empty)
                        .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                    )
            .Buttons(
                        X.Button().Text("OK").ID("BtnSubmitRemboursementMode")
                        .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                        .DirectEvents(de =>
                        {
                            de.Click.Url = Url.Action("SubmitFormMethod");
                            de.Click.Before = "return validNew(App.FormRemboursementMode.id);";
                        }),
                        X.Button()
                        .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                        .Handler("App.FormRemboursementMode.doClose()").Cls("btncancel")
                )

            )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Refund Mode : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }


    };


</script>















