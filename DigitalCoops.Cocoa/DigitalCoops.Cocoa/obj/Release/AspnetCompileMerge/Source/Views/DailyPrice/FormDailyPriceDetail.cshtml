<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Prix Journalier : Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez Renseigner les champs réquis svp.', buttons: Ext.Msg.OK });
            return false;
        }

        var startdate = App.TxtStartDate.rawValue;
        var duedate = App.TxtDueDate.rawValue;
        var olddate = App.TxtOldDateToExtend.value;

        var arrStartDate = startdate.split("/");
        var datebegin = new Date(arrStartDate[2], arrStartDate[1], arrStartDate[0]);
        var arrEndDate = duedate.split("/");
        var dateend = new Date(arrEndDate[2], arrEndDate[1], arrEndDate[0]);

        if (olddate) {
            var arrOldDate = olddate.split("/");
            var DateOld = new Date(arrOldDate[2], arrOldDate[1], arrOldDate[0]);
        }
    };
</script>