@model Tms.Classes.Business.FournisseurViewModel
@{
    Layout = null;
    var X = Html.X();
    var wzFieldPattern = @"^[1-9]\d{2}\.\d{3}\.\d{4}";
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style type="text/css">
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 70px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script>
    var TypeFournisseurChanged = function (item) {
        var Fournisseur_Type = App.hiddenTypeFournisseur.value;

        if (App.hiddenExecMode.value.toString() != "Consult") {

            /*var agence = App.cmbAgenceFrs.value || '';
            if (agence) {
                App.cmbAgenceFrs.setValue(agence);
            }*/

            if (item == Fournisseur_Type) {
                App.cmbAgenceFrs.setReadOnly(false);
                App.cmbAgenceFrs.allowBlank = false;
                App.cmbAgenceFrs.validate();
                App.cmbAgenceFrs.setIndicator("*");
                App.cmbAgenceFrs.setIndicatorCls('IndicatorRedStar');
                App.cmbAgenceFrs.showIndicator();
            }
            else if (Ext.isNumeric(item)) {
                App.cmbAgenceFrs.setReadOnly(true);
                App.cmbAgenceFrs.allowBlank = true;
                App.cmbAgenceFrs.validate();
                App.cmbAgenceFrs.setIndicator("");
                App.cmbAgenceFrs.setValue(-1);
            }
        }
        else {
            App.cmbAgenceFrs.setReadOnly(true);
        }

    };

</script>
@( 
X.Window()
    .ID("Fournisseur_AddSite")
    .Width(350)
    .Resizable(false)
    .Modal(true)
    .Height(340)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    //.X(200)
    .Y(20)
    .BodyPadding(10)
    .Title(Model.Title)
    .Items(
        X.FormPanel()
            .Layout(LayoutType.HBox)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Top, Pack = BoxPack.Center })
            .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .Items(

                    X.Hidden()
                        .ID("hiddenExecMode")
                        .Value(Model._ExecMode)
                        ,
                    X.Hidden()
                        .ID("hiddenTypeFournisseur")
                        .Value(Model.IdChefAgence),
                    X.Hidden()
                        .ID("hiddenRowversion")
                        .Value(Model.Rowversion),
                    X.TextField()
                        .ID("TxtFournisseurID")
                        .FieldLabel("ID")
                        .Text(Model.ID)
                        .Hidden(true).LabelAlign(LabelAlign.Right),

                X.Container()
                    .Layout(LayoutType.VBox)
                    .Flex(1)
                    //.Disabled(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? true : false)
                    .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch })
                    .Items
                    (

    #region Grid
                            X.GridPanel()
                                       .Layout(LayoutType.Fit)
                                       .ID("grpListeAutreSite")
                                       .Flex(3)
                                       .Frame(true)
                                       .Region(Region.Center)
                                       .ForceFit(true)
                                       .Height(220)
                                       .MarginSpec("0 5 0 0")
                                       .AllowDeselect(true)
                                       .Store(
                                                X.StoreFor<Tms.Classes.Business.Sites.FournisseurAutreSites>()
                                                    .ID("storeListeAutreSite")
                                                    .AutoLoad(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? true : false)
                                                    .Proxy(
                                                            X.AjaxProxy()
                                                                .Url(
                                                                        Url.Action("SelectFrsAutreSite","FournisseurAgence")
                                                                )
                                                                .Reader(
                                                                        X.JsonReader().RootProperty("data")
                                                                )
                                                      )
                                                      .Parameters(
                                                        ps => ps.Add(new StoreParameter("fournisseurID", "#{TxtFournisseurID}.getValue()", ParameterMode.Raw))
                                                    )

                                        )
                                        .ColumnModel
                                        (
                                            //X.RowNumbererColumn(),
                                            X.Column().Text("Site").Flex(2).DataIndex("SiteAsString").Hideable(false)
                                        )
                                        .DockedItems(
                                                X.Toolbar()
                                                    .Dock(Dock.Top)
                                                    .Items(
                                                            X.Label().Text("Other Site(s)"),
                                                            X.ToolbarSpacer(15),
                                                            X.Button()
                                                                .ID("btnAddSite")
                                                                .IconCls("action_new_02")
                                                                .Border(false)
                                                                .Cls("ButtonStyle")
                                                                .Text("Ajouter")
                                                                .DirectEvents(de =>
                                                                {
                                                                    de.Click.Url = Url.Action("onSelectSite");
                                                                    de.Click.EventMask.ShowMask = true;
                                                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSite", Mode = ParameterMode.Value, Encode = false, Value = Model._Fournisseur.Agence.ID.ToString() });
                                                                }),
                                                            X.Button()
                                                                .ID("btnRemoveSite")
                                                                //.IconCls("action_filter_02")
                                                                .Icon(Icon.Delete)
                                                                .Border(false)
                                                                .Cls("ButtonStyle")
                                                                .Text("Retirer")
                                                                .Disabled(true)
                                                                .DirectEvents(de =>
                                                                {
                                                                    de.Click.Url = Url.Action("RemoveSiteToUser","FournisseurAgence");
                                                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "App.grpListeAutreSite.getRowsValues({selectedOnly : true})" });
                                                                    //de.Click.ExtraParams.Add(new Parameter { Name = "storeListeDelivery", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListeCodeOverview.getRowsValues({selectedOnly : false})" });
                                                                    de.Click.EventMask.ShowMask = true;
                                                                    de.Click.Confirmation.ConfirmRequest = true;
                                                                    de.Click.Confirmation.BeforeConfirm = "config.confirmation.title = 'Site : Retirer'; config.confirmation.message = 'Voulez-vous retirer ce site ? ';";
                                                                })
                                                            )
                                        )
                                        .SelectionModel(
                                                        X.RowSelectionModel()
                                                            .ID("rowSiteFS")
                                                            .Mode(SelectionMode.Single)
                                                            .AllowDeselect(true)
                                        )
                                        .Listeners(l =>
                                        {
                                            if (Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Consult)
                                            {
                                                l.Select.Handler = "App.btnRemoveSite.enable();";
                                                l.Deselect.Handler = "App.btnRemoveSite.disable();";
                                            }
                                        }
                                    )

    #endregion
                   )
                )
            )
            .Buttons
            (
                X.Button()
                .Text("OK")
                .ID("BtnOk")
                .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult)
                .DirectEvents(de =>
                {
                    de.Click.Url = Url.Action("SubmitSite");
                    de.Click.FormID = "#(return this.up('window').down('form');)";
                    de.Click.Before = "return validNew(App.Fournisseur_AddSite.id);";
                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "App.grpListeAutreSite.getRowsValues({selectedOnly : false})" });
                }),
                X.Button()
                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                    .Handler("App.Fournisseur_AddSite.doClose()")
                    .Cls("btncancel")

                )

            
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {

            var areAllrequiredFieldsFilled = isFormValid(winId);

            /*
           *   Vérification de la saisie des champs obligatoires
           */
            if (!areAllrequiredFieldsFilled) {

                Ext.Msg.show({ title: 'Erreur : Supplier ', msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
                return false;
            }

        }


</script>


