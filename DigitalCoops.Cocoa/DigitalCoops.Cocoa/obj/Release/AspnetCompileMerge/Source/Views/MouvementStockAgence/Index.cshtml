<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeMouvementStock.columnManager.getColumns(), App.grpListeMouvementStock.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {

        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value === 1) {
                return 'glyphicon-arrow-right blue';
            }
            else if (value == -1) {
                return 'glyphicon-arrow-left green';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
        },
        SummaryPanelMouvement: function (){
            App.MouvementStockCP.setTitle('Site : ' + App.cmbFiltreSite.rawValue + ', Campagne : ' + App.cmbFiltreCampagne.rawValue + ', Magasin : ' + App.cmbFiltreMagasin.rawValue + ', Sens : ' + App.cmbFiltreDirection.rawValue + ', Type : ' + App.cmbFiltreMouvementType.rawValue + ', Statut : ' + App.CmbFiltreStatut.rawValue);
        },

        SummaryMouvement: function () {
            var nbrOfrows = App.grpListeMouvementStock.getStore().getCount();
            var totalNetAccepte = App.storeListeMouvementStock.sum('PoidsNetAccepte') || 0;
            var totalNetLivre = App.storeListeMouvementStock.sum('PoidsNetLivre') || 0;
            var totalQuantite = App.storeListeMouvementStock.sum('Quantite') || 0;
            var totalPoidsBrut = App.storeListeMouvementStock.sum('PoidsBrut') || 0;

            totalNetAccepte = FormatAmount(totalNetAccepte);
            totalNetLivre = FormatAmount(totalNetLivre);
            totalQuantite = FormatAmount(totalQuantite);
            totalPoidsBrut = FormatAmount(totalPoidsBrut);
            App.lblSummaryMouvement.setHtml("Nbr De Mouvement : " + nbrOfrows + "<br/>Nbr De Sacs : " + totalQuantite + "<br/>Total Poids Brut (Kg) : " + totalPoidsBrut + "<br/>Total Livré (Kg) : " + totalNetLivre + "<br/>Total Accepté (Kg) : " + totalNetAccepte);
        },

        resetButtons: function () {
            App.btnCancel.disable();
            App.btnChangePosition.disable();
            if (App.rowMouvementStock.hasSelection()) {
                var isDesactive = App.rowMouvementStock.selected.items[0].data.Desactive;
                if (isDesactive === false) {
                    if (App.mvhiddenPermDesactiver.value == 'true')
                        App.btnCancel.enable();

                    if (App.mvhiddenPermChangePosition.value == 'true')
                        App.btnChangePosition.enable();
                }
                else {
                    App.btnCancel.disable();
                }

            }
        }
    }    
    
</script>

