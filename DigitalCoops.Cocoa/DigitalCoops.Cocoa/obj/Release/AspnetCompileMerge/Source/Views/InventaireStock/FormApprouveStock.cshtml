@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
        *   Vérification de la saisie des champs obligatoires
        */
        if (!areAllrequiredFieldsFilled) {
            console.log('error fileds');
            Ext.Msg.show({ title: 'Inventaire : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Please Fill empty fields', buttons: Ext.Msg.OK });
            return false;
        }

    };

    var CalculateQtyAjusted = function () {

        var qteTheorique = parseFloat(unformatNumber(App.txtQuantiteTheorique.value)) || 0;
        var qtePhysique = parseFloat(unformatNumber(App.txtQuantitePhysique.value)) || 0;

        var result = qteTheorique - qtePhysique;

        App.txtQuantiteAjusteeHid.setValue(result);

        if (result >= 0)
            result = formatNumber(result);

        App.txtQuantiteAjustee.setValue(result);

    };

    var CalculateWgtAjusted = function () {

        var poidsTheorique = parseFloat(unformatNumber(App.txtPoidsTheorique.value)) || 0;
        var poidsPhysique = parseFloat(unformatNumber(App.txtPoidsPhysique.value)) || 0;

        var result = poidsTheorique - poidsPhysique;

        App.txtPoidsAjusteHid.setValue(result);

        if (result >= 0)
            result = formatNumber(result);

        App.txtPoidsAjuste.setValue(result);

    };


    var CalculatePhysicalWeight = function () {
        var poidsTheorique = parseFloat(unformatNumber(App.txtPoidsTheorique.value)) || 0;
        var quantiteTheorique = parseFloat(unformatNumber(App.txtQuantiteTheorique.value)) || 0;
        var quantitePhysique = parseFloat(unformatNumber(App.txtQuantitePhysique.value)) || 0;
        var totalWeight = 0;

        totalWeight = (quantitePhysique * poidsTheorique) / quantiteTheorique;
        App.txtPoidsPhysique.setValue(formatNumber(totalWeight));
    };
</script>


