</head>
<style type="text/css">
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 300px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">


    var OverviewCode =
    {
        SetButtons: function () {

            if (App.rowCode.hasSelection()) {
                if (App.CdhiddenPermRemove.value == 'true')
                    App.BtnRemoveCode.enable();

                if (App.CdhiddenPermPrintCode.value == 'true')
                    App.BtnPrintCode.enable();

            } else {

                App.BtnRemoveCode.disable();
                App.BtnPrintCode.disable();

            }
        }
    };

    var SummaryInventaire = function () {
        var nbrOfrows = App.grpInventaireEcart.getStore().getCount();
        var qteTheorique = App.storeInventaireEcart.sum('Quantite') || 0;
        var poidsTheorique = App.storeInventaireEcart.sum('PoidsBrut') || 0;

        var qtePhysique = App.storeInventaireEcart.sum('QuantitePhysique') || 0;
        var poidsPhysique = App.storeInventaireEcart.sum('PoidsBrutPhysique') || 0;
        var qte = qteTheorique - qtePhysique;
        var poids = poidsTheorique - poidsPhysique;
        App.txtQuantiteAjustee.setValue(FormatAmount(qte));
        App.txtPoidsAjuste.setValue(FormatAmount(poids));
    };
</script>
