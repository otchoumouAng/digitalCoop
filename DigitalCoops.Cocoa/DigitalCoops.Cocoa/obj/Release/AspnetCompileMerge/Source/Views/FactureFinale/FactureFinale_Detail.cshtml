@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Facture : Data Validation', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }
    };

    



    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

    var FormatNetWeight = function () {
        try
        {
            var mNetWeight = parseFloat(App.txtNetWeight.value.toString().replace(' ', ''));
            var NetWeightFormat = FormatAmount(mNetWeight);
            App.txtNetWeight.setValue(NetWeightFormat);
        }
        catch (err)
        {
            return 0;
        }
    };

    var ChangeBonusRate = function () {
        var taux = parseFloat(App.txtRateBonus.value);
        var totalSurplus = unformatNumber(App.txtTotalSurplus.value) || 0;
        var prixCaf = unformatNumber(App.txtPriceCAF.value.replace(",", ".")) || 0;
        var prixFob = unformatNumber(App.txtPriceFob.value.replace(",", ".")) || 0;
       
        var poidsStandard = unformatNumber(App.txtStandardWeight.value) || 0;
        var poidsEchantillon = unformatNumber(App.txtSampleWeight.value) || 0;
        var poidsSurplus = unformatNumber(App.txtWeightSurplus.value) || 0;
        var montantFactureCom = unformatNumber(App.txtCommercialInvoice.value.replace(",",".")) || 0;
        var montantBonus =(((totalSurplus * taux) / 100) * (prixCaf/1000)).toFixed(3);
       
        if(Ext.isNumeric(montantBonus) && montantBonus >= 0)
        {
            var montantBrut = ((poidsStandard * (prixFob/1000)) + (poidsEchantillon * (prixFob/1000)) + (poidsSurplus * (prixCaf/1000)) + Number(montantBonus)).toFixed(3);
           
            var montantNet = (montantBrut - montantFactureCom).toFixed(3);

            App.txtAmountBonus.setValue(formatAmountDecimal(montantBonus));
            App.txtGrossAmount.setValue(formatAmountDecimal(montantBrut));
            App.txtNetAmount.setValue(formatAmountDecimal(montantNet));
        }
        else
        {
            Ext.Msg.show({ title: 'Final invoice : Data Validation', icon: Ext.MessageBox.WARNING, msg: 'Bonus Rate invalid.', buttons: Ext.Msg.OK });
            return false;
        }
    };
    
    

    function formatNumberDecimal(amount) {
        amount = thousands_separators(amount.replace(".", ","));
        formatted = amount.replace(".", ",");

        return formatted;
    };

    function formatAmountDecimal(amount) {
        amount = FormatAmount(amount);
        formatted = amount.replace(".", ",");

        return formatted;
    };

    function unformatNumberDecimal(amount) {
        formatted = amount.replace(" ", "");

        return formatted;
    };

    function thousands_separators(num) {
        var num_parts = num.toString().split(".");
        num_parts[0] = num_parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, " ");
        return num_parts.join(".");
    }

 
</script>





