    <script type="text/javascript">

        var setCtrlIsRequired = function (field, value)
        {
            field.allowBlank = !value;

            field.setIndicator("");
            field.setIndicatorCls('');
            field.showIndicator();

            if (value == true)
            {

                field.setIndicator("*");
                field.setIndicatorCls('IndicatorRedStar');
                field.showIndicator();
            }
        };

        var calculerNbrSacsAcceptes = function ()
        {
                var checkBox = App.chkIsRejected;

            
                if (App.txtUnloadledBags.value != '' && App.txtAcceptedBags.value != '')
                {
                    var sacsDecharges = parseInt(App.txtUnloadledBags.value, 10) || 0;
                    /*var sacsRejetes = parseInt(App.txtRejectedBags.value, 10) || 0;*/
                    var sacsAcceptes = parseInt(App.txtAcceptedBags.value, 10) || 0;

                    App.txtRejectedBags.setValue(sacsDecharges - sacsAcceptes);                    
                    
                    if (checkBox.checked == false)
                    {
                        /*Added  by AA on 30th of Sept.*/
                        App.txtGoodBags.setValue(sacsAcceptes);
                        App.txtBadBags.setValue('0');
                    }
                }           
            
        };

        var calculerNbrSacsNylon = function () {
            var checkBox = App.chkIsRejected;
            
            var nylon = parseInt(App.txtNylonBags.value, 10) || 0;
            var sacsDecharges = parseInt(App.txtUnloadledBags.value, 10) || 0;
            var sacsAcceptes = parseInt(App.txtAcceptedBags.value, 10) || 0;
            sacsAcceptes = sacsAcceptes - nylon;
            /*App.txtRejectedBags.setValue(sacsDecharges - sacsAcceptes);*/
            App.txtAcceptedBags.setValue(sacsAcceptes);
            if (checkBox.checked == false) {
                /*Added  by AA on 30th of Sept.
                App.txtGoodBags.setValue(sacsAcceptes);
                App.txtBadBags.setValue('0');*/
            }
            
        };

        var calculerTareSacsAcceptes = function ()
        {
            var checkBox = App.chkIsRejected;

            if (checkBox.checked == false)
            {
                if (App.txtAcceptedBags.value != '')
                {
                    var sacsAcceptes = parseInt(App.txtAcceptedBags.value, 10) || 0;
                    /*var tareSacsUnitaire = parseInt(App.hiddenTareSacsLivraison.value, 10) || 0;*/
                    var tareSacsUnitaire = parseFloat(App.hiddenTareSacsLivraison.value.replace(',', '.')) || 0;
                                        
                    var tareSacsNylon = parseFloat(0);

                    if (App.hiddenTareSacsNylon.value != '') {
                        tareSacsNylon = App.hiddenTareSacsNylon.value;                        
                        tareSacsNylon = tareSacsNylon.toString().replace(',', '.')
                    } else
                        tareSacsNylon = 0;

                    /*alert(tareSacsNylon);*/
                    var nbreNylonBags = parseInt(App.txtNylonBags.value, 10) || 0;
                    var valTareNylon = 0;                    
                    if (nbreNylonBags > 0) {
                        sacsAcceptes = sacsAcceptes - nbreNylonBags;
                        valTareNylon = (tareSacsNylon * nbreNylonBags);                        
                        valTareNylon = Math.ceil(valTareNylon);
                    }
                    /*Added  by AA on 30th of Sept.*/
                    if (App.hiddenCalculateVgm.value == 'false') {
                        var totaltareSacsAccpetes = parseFloat(0);
                        totaltareSacsAccpetes = Math.ceil(parseFloat(sacsAcceptes * tareSacsUnitaire));                        
                        App.txtTareOfBags.setValue(totaltareSacsAccpetes + valTareNylon);
                        /*App.txtTareOfBags.setValue(sacsAcceptes * tareSacsUnitaire);*/
                    }
                    else
                        App.txtTareOfBags.setValue(0);

                    calculerPoidsBrut();

                    calculerNbrSacsAcceptes();
                }
            }
            else
            {
                calculerPoidsBrut();
                
                calculerNbrSacsAcceptes();
                
            }   
        };

        var calculerPoidsNet = function ()
        {
            /*if (App.txtDeliveryGrossWeight.value != '' && App.txtTareOfBags.value != '' && App.txtTareOfPallets.value != '')
            {*/

                var grossWeight = parseInt(App.txtDeliveryGrossWeight.value, 10) || 0;
                var tareBags = parseInt(App.txtTareOfBags.value, 10) || 0;
                var tarePallets = parseInt(App.txtTareOfPallets.value, 10) || 0;
                var netWeight = grossWeight - tareBags - tarePallets;

                console.log(tareBags);

                App.txtDeliveryNetWeight.setValue(netWeight);

            /*}*/
        };

        var calculerPoidsBrut = function () {
            if (App.txtFirstGrossWeight.value != '' && App.txtSecondGrossWeight.value != '')
            {

                var firstWeight = parseInt(App.txtFirstGrossWeight.value, 10) || 0;
                var secondWeight = parseInt(App.txtSecondGrossWeight.value, 10) || 0;

                var poidsBrut = Math.abs(firstWeight - secondWeight);
                /*var tarePalletes = parseInt(App.txtTareOfPallets.value, 10);
                var tareSacs = parseInt(App.txtTareOfBags.value, 10);*/

                App.txtDeliveryGrossWeight.setValue(poidsBrut);


                calculerPoidsNet();
            }
        };

        var calculePoidsVGM = function () {
            if (App.hiddenCalculateVgm.value == 'true') {
                var poidsnet = 0;

                var poidsConteneur = 0;

                poidsnet = parseInt(App.txtDeliveryNetWeight.value) || 0;

                poidsConteneur = parseInt(App.txtTareConteneur.value) || 0;

                var poidsVGM = 0;

                poidsVGM = poidsnet + poidsConteneur;


                /*if (poidsConteneur > 0) {
                    poidsVGM = poidsnet + poidsConteneur;
                }
                else*/


                App.txtWeighingVgm.setValue(poidsVGM);

            }
            else
                App.txtTareConteneur.setValue(0);
        };

        var verifierNbrSacs = function ()
        {
            var nbrBagsLivraison = parseInt(App.txtNbrOfBags.value, 10) || 0;
            var sacsDecharges = parseInt(App.txtUnloadledBags.value, 10) || 0;

            /*if (nbrBagsLivraison < sacsDecharges)
            {
                App.txtUnloadledBags.setValue('');
                App.txtUnloadledBags.focus(true);
                Ext.Msg.show({ title: 'Erreur : Weighing ', msg: 'The number of bags of the delivery is different from the number of bags unloaded.', buttons: Ext.Msg.OK });
            }*/

        };

        var verifierNbrSacsAcceptes = function ()
        {
            var sacsAcceptes = parseInt(App.txtAcceptedBags.value, 10) || 0;
            var sacsDecharges = parseInt(App.txtUnloadledBags.value, 10) || 0;
            var checkBox = App.chkIsRejected;

            if (checkBox.checked == false)
            {
                if (sacsAcceptes > sacsDecharges)
                {
                    App.txtAcceptedBags.setValue('');
                    App.txtAcceptedBags.focus(true);
                    Ext.Msg.show({ title: 'Erreur : Weighing ', msg: 'The number of bags accapted must be lesser or equels to the number of bags unloaded.', buttons: Ext.Msg.OK });
                }

            }
        };

        var verifierNbrSacsBons = function ()
        {
            var checkBox = App.chkIsRejected;

            if (checkBox.checked == false)
            {

                var nbrBagsLivraison = parseInt(App.txtAcceptedBags.value, 10) || 0;
                var sacsDecharges = parseInt(App.txtUnloadledBags.value, 10) || 0;
                var sacsBons = parseInt(App.txtGoodBags.value, 10) || 0;
                var sacsMauvais = parseInt(App.txtBadBags.value, 10) || 0;

                if ((sacsBons + sacsMauvais) > sacsDecharges) {
                    App.txtGoodBags.setValue('');
                    App.txtBadBags.setValue('');
                    App.txtGoodBags.focus(true);
                    Ext.Msg.show({ title: 'Erreur : Weighing ', msg: 'The number of good and bad bags must be lesser than the number of unloaded bags.', buttons: Ext.Msg.OK });
                }
            }


            /*if (sacsMauvais > sacsBons) {
                App.txtBadBags.setValue('');
                Ext.Msg.show({ title: 'Erreur : Weighing ', msg: 'The number of bad bags must be lesser than the number of good bags.', buttons: Ext.Msg.OK });
            }*/

        };

        var verifierNbrSacsNylonEtOpa = function ()
        {
            var checkBox = App.chkIsRejected;

            if (checkBox.checked == false)
            {
                var sacsBons = parseInt(App.txtGoodBags.value, 10) || 0;
                var sacNylon = parseInt(App.txtNylonBags.value, 10) || 0;
                var sacsOpa = parseInt(App.txtOPABags.value, 10) || 0;                
                if ((sacNylon + sacsOpa) > sacsBons) {
                    /*App.txtNylonBags.setValue('');
                    App.txtOPABags.setValue('');
                    App.txtNylonBags.focus(true);*/
                    Ext.Msg.show({ title: 'Erreur : Weighing ', msg: 'The sum of nylon bags and OPA bags must be equals to good  bags.', buttons: Ext.Msg.OK });
                }
            }

        };




        var setControlsForUnloading = function ()
        {
            var checkBox = App.chkIsRejected;

            if(checkBox.checked == true)
            {
                /* activer refoulement immédiat */
                /* retirer les zones obligatoires */
                setCtrlIsRequired(App.txtNylonBags, false);
                setCtrlIsRequired(App.txtOPABags, false);
                setCtrlIsRequired(App.txtGoodBags, false);
                setCtrlIsRequired(App.txtBadBags, false);
                setCtrlIsRequired(App.txtNbrOfPalets, false);
                setCtrlIsRequired(App.txtTareOfPallets, false);
                /* mettre à zéro */
                App.txtNylonBags.setValue(0);
                App.txtOPABags.setValue(0);
                App.txtGoodBags.setValue(0);
                App.txtBadBags.setValue(0);
                App.txtNbrOfPalets.setValue(0);
                App.txtTareOfPallets.setValue(0);
                App.txtTareOfBags.setValue(0);



                /* Calculer la tare des sacs acceptés à partir de ce qui est saisi dans le nbr de sacs acceptés*/
                calculerTareSacsAcceptes();
                calculerPoidsNet();


                /* Mettre en readOnly */
                App.txtNylonBags.setReadOnly(true);
                App.txtOPABags.setReadOnly(true);
                App.txtGoodBags.setReadOnly(true);
                App.txtBadBags.setReadOnly(true);
                App.txtNbrOfPalets.setReadOnly(true);
                App.txtTareOfPallets.setReadOnly(true);



                /* changer les libellés de nos controles de sacs déchargés et de sacs acceptés / rejetés*/
                App.fldAcceptedRejected.setFieldLabel('Refoulé / Sacs acc.');
                App.txtUnloadledBags.setFieldLabel('Sacs Chargés');

            }
            else
            {
                /* activer refoulement immédiat */
                /* activer les zones obligatoires */
                setCtrlIsRequired(App.txtNylonBags, true);
                setCtrlIsRequired(App.txtOPABags, true);
                setCtrlIsRequired(App.txtGoodBags, true);
                setCtrlIsRequired(App.txtBadBags, true);
                setCtrlIsRequired(App.txtNbrOfPalets, true);
                setCtrlIsRequired(App.txtTareOfPallets, true);

                /* mettre à zéro */
                App.txtNylonBags.setValue(0);
                App.txtOPABags.setValue(0);
                App.txtGoodBags.setValue(0);
                App.txtBadBags.setValue(0);
                App.txtNbrOfPalets.setValue(0);
                App.txtTareOfPallets.setValue(0);
                App.txtTareOfBags.setValue(0);

                /* Calculer la tare des sacs acceptés à partir de ce qui est saisi dans le nbr de sacs acceptés*/
                calculerTareSacsAcceptes();
                calculerPoidsNet();
                /*App.txtTareOfBags.setValue(0);*/

                App.txtNylonBags.setReadOnly(false);
                App.txtOPABags.setReadOnly(false);
                App.txtGoodBags.setReadOnly(false);
                App.txtBadBags.setReadOnly(false);
                App.txtNbrOfPalets.setReadOnly(false);
                App.txtTareOfPallets.setReadOnly(false);



                /* changer les libellés de nos controles de sacs déchargés et de sacs acceptés / rejetés*/
                App.fldAcceptedRejected.setFieldLabel('Sacs Acceptés / Rej.');
                App.txtUnloadledBags.setFieldLabel('Sacs dechargés');
            }
        };
    </script>
</head>
