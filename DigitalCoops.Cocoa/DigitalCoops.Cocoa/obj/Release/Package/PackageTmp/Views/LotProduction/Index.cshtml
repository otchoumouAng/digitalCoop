<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeLots.columnManager.getColumns(), App.grpListeLots.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {        
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return  'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }
        },

        SummaryLot: function () {
            var nbrOfrows = App.grpListeLots.getStore().getCount();
            var totalNet = App.storeListeLots.sum('PoidsNet') || 0;
            var totalNbrOfBags = App.storeListeLots.sum('NombreSacs') || 0;
            var totalPoidsBrut = App.storeListeLots.sum('PoidsBrut') || 0;            
           
            totalNet = FormatAmount(totalNet);
            totalNbrOfBags = FormatAmount(totalNbrOfBags);
            totalPoidsBrut = FormatAmount(totalPoidsBrut);                        
            App.lblSummaryLot.setHtml("Nbr de lots : " + nbrOfrows + "<br/>Nbr de sacs : " + totalNbrOfBags + "<br/>Total Poids Brut (Kg) : " + totalPoidsBrut + "<br/>Total Livré (Kg) : " + totalNet);
        },

        resetButtons: function () {

            App.btnModify.disable();
            App.btnCancel.disable();            

            if (App.rowLot.hasSelection()) {

                var isDesactive = App.rowLot.selected.items[0].data.Desactive;
                var estManuel = App.rowLot.selected.items[0].data.EstManuel;

                if (isDesactive === false) {

                    if (App.lthiddenPermModify.value == 'true' && estManuel === true)
                        App.btnModify.enable();

                    if (App.lthiddenPermDesactiver.value == 'true')
                        App.btnCancel.enable();                    
                }
                else {
                    App.btnModify.disable();
                    App.btnCancel.disable();
                }
            }
        }
    }
</script>

