<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Expenses : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        var Amount = Number(unformatNumber(App.txtAmount.value));
        

        if(!Ext.isNumeric(Amount) && parseFloat(Amount) < 0 ) {
            Ext.Msg.show({ title: 'Expenses : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Amount invalid', buttons: Ext.Msg.OK });
            return false;
        }




        /**Verifiaction d'articles**/
        if (App.grpDetailPaiementChequeAgence.getRowsValues().length <= 0) {
            Ext.Msg.show({ title: 'Expenses:  Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Please make sure you add payments.', buttons: Ext.Msg.OK });
            return false;
        }

        /**Verification des payments en etat de modification**/
        if (App.grpDetailPaiementChequeAgence.getRowsValues().length >= 1) {
            var compteur = 0;
            for (i = 0; i < App.grpDetailPaiementChequeAgence.getRowsValues().length; i++) {
                if (App.grpDetailPaiementChequeAgence.getRowsValues()[i].Desactive == 0) {
                    compteur++;

                }
            }

            if (compteur == 0) {
                Ext.Msg.show({ title: 'Expenses: Data Validation', icon: Ext.MessageBox.WARNING, msg: 'Please make sure you add payments.', buttons: Ext.Msg.OK });
                return false;
            }

        }

        /******/
        var AmountPayment =  0;
        
        if (App.grpDetailPaiementChequeAgence.getRowsValues().length >= 1) {
            var compteur = 0;
            for (i = 0; i < App.grpDetailPaiementChequeAgence.getRowsValues().length; i++) {
                if (App.grpDetailPaiementChequeAgence.getRowsValues()[i].Desactive == 0) {
                    AmountPayment = AmountPayment + App.grpDetailPaiementChequeAgence.getRowsValues()[i].Montant;

                }
            }

        }

        if (AmountPayment > parseFloat(Amount)) {
            Ext.Msg.show({ title: 'Expenses : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'please check the sum of the payment amounts', buttons: Ext.Msg.OK });
            return false;
        }
    };

     var LoadAmountTotal = function () {
       
        var amount = parseFloat(App.storeListPaiementChequeAgence.sum('Montant')) || 0;
        
        App.txtAmountTotal.setValue(formatNumber(amount));

    };


    function formatNumberDecimal(amount) {
        console.log(amount);
        amount = thousands_separators(amount.toString().replace(".", ","));
        console.log(amount);
        formatted = amount.replace(".", ",");

        return formatted;
    };

    function unformatNumberDecimal(amount) {
        formatted = amount.replace(" ", "");

        return formatted;
    };

    function thousands_separators(num) {
        var num_parts = num.toString().split(".");
        num_parts[0] = num_parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, " ");
        return num_parts.join(".");
    }
    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

    var RoundIntSup = function (v) {
        try {
                if (v < 1000)
                {
                    var valeur = (v / 100);
                    return RoundInt(valeur)*100;
                }
                else
                {
                    var valeur = (v / 1000);
                    return RoundInt(valeur)*1000;

                }
            
        } catch (err) {
            return 0;
        }
    };

    

</script>
