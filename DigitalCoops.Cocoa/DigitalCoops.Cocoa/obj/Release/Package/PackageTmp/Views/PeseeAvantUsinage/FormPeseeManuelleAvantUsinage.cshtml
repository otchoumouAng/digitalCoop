@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Erreur : Weighing ', msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        var firstW = parseInt(App.txtFirstGrossWeight.value) || 0;
        var secondW = parseInt(App.txtSecondGrossWeight.value) || 0;
        if (firstW > 0 && secondW > 0) {
            if (secondW == 0) {
                Ext.Msg.show({ title: 'Erreur : Weighing ', msg: 'Second Weight is incorrect !', buttons: Ext.Msg.OK });
                return false;
            }

            /*if (secondW >= firstW) {
                Ext.Msg.show({ title: 'Erreur : Weighing ', msg: 'Second Weight must be lower than first Weight !', buttons: Ext.Msg.OK });
                return false;
            }*/
        }

    };

    var enterKeyPressHandler = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            var param = App.txtDeliveryID.value;
            var baseurl = App.baseUrlVal.value;
            Ext.net.DirectMethod.request({ url: baseurl + "/PeseeProduction/SubmitDeliveryNumber?ItemDeliveryNumber=" + param });
            /*App.BtnSearchDeliveryInfo.fireEvent('click', App.BtnSearchDeliveryInfo);*/
            e.stopEvent();
        }
    };

</script>






