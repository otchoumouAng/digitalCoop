<script type="text/javascript">
     var WeighingSummaryInfo =  function ()
     {
         var mItemsCount = App.grpListe.getRowsValues().length || 0;
         var mTotalEstimatedBags = App.storeListe.sum('DeliveryEstimatedBags') || 0;
         var mTotalEstimatedTonnage = App.storeListe.sum('DeliveryEstimatedTonnage') || 0;
         var mTotalUnloadedBags = App.storeListe.sum('SacsDecharges') || 0;
         var mTotalGrossWeight = App.storeListe.sum('PoidsBrut') || 0;
         var mTotalDelivered = App.storeListe.sum('PoidsNetLivre') || 0;

         var mChaine = Ext.String.format('Pesée(s) : {0} <br/> Total Sacs Estimé : {1} <br/> Poids Total Estimé : {2} (Kg) <br/> Sacs dechargés : {3} <br/> Poids Brut : {4} (Kg) <br/> Net livré : {5} (Kg)', formatNumber(mItemsCount), formatNumber(mTotalEstimatedBags), formatNumber(mTotalEstimatedTonnage), formatNumber(mTotalUnloadedBags), formatNumber(mTotalGrossWeight), formatNumber(mTotalDelivered));
         App.LblWeighingSummary.setHtml(mChaine);

         /*App.rowSelectionListe.deselectAll(true);*/

         //Overview.resetButtons();
     };

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListe.columnManager.getColumns(), App.grpListe.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';        

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }
    var Overview =
    {
        getBootStrapIcons: function (value)
        {
            if (value === 0)
            {
                return 'glyphicon-remove red'; // Cancelled
            }
            else if (value == 2)
            {
                return  'glyphicon-ok green'; // 2nd Weigh.
            }
            else if (value == 1)
            {
                return 'glyphicon-file blue'; // 1st weigh.
            }
            else if (value == 3)
            {
                return 'glyphicon-hand-right blue'; // Manual
            }
            else if (value == 4)
            {
                return 'glyphicon-ban-circle red'; // Rejected
            }
        },
        resetButtons: function () {            

            /*App.btnUnloadTruck.disable();*/
            App.btnSecondWeight.disable();          
            App.btnCancel.disable();
            App.btnFirstWeight.disable();
            App.mnuChangeDeliveryType.disable();
            App.mnuCorrectWeightManually.disable();
            App.mnuPrintTicket.disable();           

            var canFirstWeighing = true;
            var canManualWeighing = true;
            var canChangeDeliveryType = true;
            var canCorrectWeightManually = true;


            if (canFirstWeighing === true)   App.btnFirstWeight.enable();

            if (canManualWeighing === true) App.mnuManualWeighing.enable();
                     

            if (App.rowSelectionListe.hasSelection())
            {
                var isFirstWeighing      = App.rowSelectionListe.selected.items[0].data.DateP2 == null;
                var isSecondWeighing     = App.rowSelectionListe.selected.items[0].data.DateP2 != null;

                var isReadyForUnloading  = App.rowSelectionListe.selected.items[0].data.DateP1 != null
                                           && App.rowSelectionListe.selected.items[0].data.DateP2 == null
                                           && App.rowSelectionListe.selected.items[0].data.Livraison.LivraisonType.EstAchat == true;

                var isCancelled = App.rowSelectionListe.selected.items[0].data.Cancelled === true;

                var canCancel = true;

                if (isFirstWeighing === true && !isCancelled)
                    if (App.PehiddenPermSecondWeight.value == 'true')
                        App.btnSecondWeight.enable();

                    else
                        if (App.PehiddenPermFirstWeight.value == 'true')
                            App.btnFirstWeight.enable();


                if (isSecondWeighing === true && (App.PehiddenPermPrintWeighingTicket.value == 'true'))
                {

                    App.mnuPrintTicket.enable();                    
                }                    
                else
                {
                    App.mnuPrintTicket.disable();                    
                }

               /* if (isReadyForUnloading == true) App.btnUnloadTruck.enable();*/
                
                console.log(isCancelled);

                if (isCancelled === true) {
                    App.btnCancel.setIconCls("glyphicon glyphicon-ok green");
                    App.btnCancel.setText('Activer');
                }

                else {
                    App.btnCancel.setIconCls("glyphicon glyphicon-remove red");
                    App.btnCancel.setText('Desactiver');
                }
                
                if (canCancel === true && isCancelled === false && App.PehiddenPermDesactiver.value == 'true') App.btnCancel.enable();
                
                if (canChangeDeliveryType === true && isCancelled === false && App.PehiddenPermChangeDeliveryType.value == 'true') App.mnuChangeDeliveryType.enable();

                if (canCorrectWeightManually === true && isCancelled === false && App.PehiddenPermCorrectWeight.value == 'true') App.mnuCorrectWeightManually.enable();
            }
        }
    }


</script>

