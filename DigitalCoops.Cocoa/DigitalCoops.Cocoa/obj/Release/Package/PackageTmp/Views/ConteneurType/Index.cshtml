<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeConteneurType.columnManager.getColumns(), App.grpListeConteneurType.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var GetNbrStoreRows = function () {
        var nbr = App.grpListeConteneurType.getRowsValues().length;
        App.LblResumeConteneurType.setText(nbr + ' Type Of Container(s)');        
    };

    var SetCriteriaTitle = function (status) {

        App.ConteneurTypeCriteriaPanel.title = "";
        var texttitle = "";

        if (status) texttitle += "Show only active Type Of Containers : YES ";
        else texttitle += "Show only active Type Of Containers : NO ";

        App.ConteneurTypeCriteriaPanel.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            if (App.rowSelectionConteneurType.hasSelection()) {
                if (App.CthiddenPermModifier.value == 'true')
                    App.btnModifyConteneurType.enable();

                if (App.CthiddenPermDesactiver.value == 'true')
                    App.mnuCancelConteneurType.enable();

                var isDisabled = App.rowSelectionConteneurType.selected.items[0].data.Desactive;

                if (isDisabled === true) {
                    if (App.CthiddenPermActiver.value == 'true')
                        App.mnuCancelConteneurType.enable();

                    App.mnuCancelConteneurType.setText('Activer');
                    App.btnModifyConteneurType.disable();
                    App.mnuCancelConteneurType.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.CthiddenPermModifier.value == 'true')
                        App.btnModifyConteneurType.enable();

                    App.mnuCancelConteneurType.setText('Desactiver');
                    App.mnuCancelConteneurType.setIconCls('glyphicon glyphicon-remove red');
                }

            } else {

                App.btnModifyConteneurType.disable();                
                App.mnuCancelConteneurType.disable();

            }
        }
    }


</script>


