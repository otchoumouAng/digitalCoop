@model Tms.Classes.Business.Sites.TransfertFeves
@{
    Layout = null;
    var X = Html.X();
}

@(

    X.Window()
        .ID("FormListTransfertCritere")
        .Width(700)
        .Resizable(false)
        .Height(200)
        .Modal(true)
        .Y(100)
        .Title(ViewData["Titre"] + " : Critères")
        .Layout(LayoutType.Form)
        .Items
        (

            X.FormPanel().Layout(LayoutType.HBox)
                    .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Center })
                    .Items(
                            X.Panel().Layout(LayoutType.VBox)
                            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch })
                            .Flex(1)
                            .Items(
                                 X.ComboBox()
                                        .ID("cmbDetSite")
                                        .FieldLabel("Site")
                                        .DisplayField("Nom")
                                        .ValueField("ID")
                                        .MatchFieldWidth(false)
                                        .ListConfig(new BoundList { MinWidth = 300 })
                                        .LabelAlign(LabelAlign.Right)
                                        .TypeAhead(false)
                                        .QueryMode(DataLoadMode.Local)
                                        .TriggerAction(TriggerAction.All)
                                        .ForceSelection(true)
                                        //.ReadOnly(true)
                                        .Value((int)ViewData["SiteParDefaut"])
                                        .Store(
                                                X.Store()
                                                .AutoLoad(true)
                                                .Model(
                                                        Html.X().Model()
                                                        .IDProperty("ID")
                                                        .Fields(
                                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                    new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                                                )
                                                    )
                                                .Proxy(
                                                            Html.X().AjaxProxy()
                                                            .Url(Url.Action(ViewData["UrlSite"].ToString(), "Site"))
                                                .Reader(
                                                            Html.X().JsonReader().RootProperty("data")
                                                            )
                                                )
                                        ),
                                X.ComboBox()
                                .ID("cmbDetCropYear")
                                .FieldLabel("Campagne")
                                .DisplayField("Designation")
                                .QueryMode(DataLoadMode.Local)
                                .TriggerAction(TriggerAction.All)
                                .ValueField("Designation")
                                .LabelAlign(LabelAlign.Right)
                                .Store(
                                        X.Store()
                                            .AutoLoad(true)
                                            .Listeners(l => l.Load.Handler = "App.cmbDetCropYear.setValue(App.cmbDetCropYear.getStore().getAt(0));")
                                            .Model(
                                                    Html.X().Model()
                                                        .IDProperty("Designation")
                                                        .Fields(
                                                                    new ModelField("ID", ModelFieldType.String) { Mapping = "Designation" },
                                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                                )
                                                    )
                                            .Proxy(
                                                    Html.X().AjaxProxy()
                                                    .Url(
                                                            Url.Action("LoadCampagneAll", "Campagne")
                                                    )
                                            .Reader(
                                                        Html.X().JsonReader().RootProperty("data")
                                                        )
                                            )
                                )


            ),
            X.Panel()
                .Layout(LayoutType.Form)
                .Flex(1)
                .Items(
                        X.DateField().ID("dtfDetStartDate").FieldLabel("Date Debut").LabelAlign(LabelAlign.Right).SelectedDate((DateTime)ViewData["datedebut"])
                        ,
                        X.DateField().ID("dtfDetEndDate").FieldLabel("Date Fin").LabelAlign(LabelAlign.Right).SelectedDate((DateTime)ViewData["datefin"])
                        ,
                        X.ComboBox()
                            .ID("cmbDetStatus")
                            .FieldLabel("Statut")
                            .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "-1" }); })
                            .DisplayField("Nom")
                            .ValueField("ID")
                            .LabelAlign(LabelAlign.Right)
                            .TypeAhead(true)
                            .ForceSelection(true)
                            .Items(
                                    new ListItem("{Tous}", "-1"),
                                    new ListItem("Approuvé", "AP"),
                                    new ListItem("Non Approuvé", "NA"),
                                    new ListItem("Annulé", "CA")
                                    )
                        )
                )
        )
        .Buttons
        (
            X.Button()
                .Text("OK")
                .ID("BtnOk")
                .DirectEvents
                (
                    d =>
                    {
                        d.Click.Url = Url.Action("PrintList");
                        d.Click.EventMask.ShowMask = true;
                        d.Click.FormID = "#(return this.up('window').down('form');)";
                    }
                ),
            X.Button()
                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                .Handler("App.FormListTransfertCritere.doClose()")
                .Cls("btncancel")
        )

)





