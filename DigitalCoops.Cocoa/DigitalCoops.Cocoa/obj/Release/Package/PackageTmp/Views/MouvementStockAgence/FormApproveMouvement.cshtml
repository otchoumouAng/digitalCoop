<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script src="~/Scripts/FormatAmount.js"></script>
<script>
    var SetPendingListeResume = function () {
        var nbr = App.grpListPendingMouvement.getStore().getCount();
        var tNetAccepte = App.storeListPendingMouvement.sum('PoidsNetAccepte') || 0;
        var tNetLivre = App.storeListPendingMouvement.sum('PoidsNetLivre') || 0;
        var tQuantite = App.storeListPendingMouvement.sum('Quantite') || 0;
        var tPoidsBrut = App.storeListPendingMouvement.sum('PoidsBrut') || 0;

        tNetAccepte = FormatAmount(tNetAccepte);
        tNetLivre = FormatAmount(tNetLivre);
        tQuantite = FormatAmount(tQuantite);
        tPoidsBrut = FormatAmount(tPoidsBrut);
        App.lblSummaryPendingMouvement.setHtml("Nbr Of Pending Movement : " + nbr + "<br/>Total Nbr de sacs : " + tQuantite + "<br/>Total Poids Brut : " + tPoidsBrut + "<br/>Total Livré : " + tNetLivre + "<br/>Total Accepted : " + tNetAccepte);       

    };

    var SetBtnApprove = function () {
        if (App.rowPendingMouvement.hasSelection())
            App.btnApproveMouvement.enable();
        else
            App.btnApproveMouvement.disable();
    };
    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = ovListe.getIcons(value);

        return Ext.String.format(tpl, icon_url);
    };
    var ovListe =
    {
        getIcons: function (value) {
            if (value === 1) {
                return 'glyphicon-arrow-right green';
            }
            else {
                return 'glyphicon-arrow-left green';
            }            
        }

    };

</script>
