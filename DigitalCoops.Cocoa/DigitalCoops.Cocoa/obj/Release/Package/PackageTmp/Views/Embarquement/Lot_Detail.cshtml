@Scripts.Render("~/bundles/validation")

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validAdd = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Shipment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

       

        var PoidsBrut = unformatNumber(App.txtGrossWeight2.value) || '';

      
        if (App.grpDetailLot2.getRowsValues().length < 1) {

            Ext.Msg.show({ title: 'Lot : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Please add lots.', buttons: Ext.Msg.OK });
            return false;
        }

        if (PoidsBrut < 0 ) {
            Ext.Msg.show({ title: 'Lot : Data Validation ', icon: Ext.MessageBox.WARNING, msg: '.', buttons: Ext.Msg.OK });
            return false;
        }



    };


    var RefreshLot2 = function () {
        /*var totalNetAccepte = App.storeListeMouvementStock.sum('PoidsNetAccepte') || 0;*/

        /***Calcul des poids***/
       
        var NbreSac = 0;
        var StdBrutUnitaire = Number(App.HiPoidsStdBrutUnitaire.value) || 0;
        var StdNetUnitaire = Number(App.HiPoidsStdNetUnitaire.value) || 0;
        NbreSac = App.storeListLot2.sum('NombreSacs') || 0;
        
        var PoidsNet = NbreSac * StdNetUnitaire;
        var PoidsBrut = NbreSac * StdBrutUnitaire;

        App.txtGrossWeight2.setValue(formatNumber(PoidsBrut));
        App.txtNetWeight2.setValue(formatNumber(PoidsNet));
        App.txtTotalBags.setValue(formatNumber(NbreSac));
        /**Control**/
        
        /*if (App.grpDetailLot2.getRowsValues().length >= 1) {
                for (i = 0; i < App.grpDetailLot2.getRowsValues().length; i++) {
                    if (App.grpDetailLot2.getRowsValues()[i].Desactive == 0) {
    
                        NbreSac = NbreSac + App.grpDetailLot2.getRowsValues()[i].NombreSacs;
    
                    }
                }
    
            }*/
    };
</script>


