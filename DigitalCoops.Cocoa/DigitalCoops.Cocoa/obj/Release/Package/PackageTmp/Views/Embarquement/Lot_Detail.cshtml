
@model Tms.Classes.Business.stock.LotViewModel
@{
    Layout = null;
    var X = Html.X();    
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />

</head>
<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 120px !important;
    }

    .x-form-text-default.x-form-textarea {
        line-height: 17px;
        min-height: 50px !important;
    }
</style>
<style>
    .x-table-form-item {
        margin-bottom: 5px;
    }

    #txtGrossWeight2-labelTextEl, #txtNetWeight2-labelTextEl, #txtTotalBags-labelTextEl {
        font-weight: bold;
    }

    #txtGrossWeight2-inputEl, #txtNetWeight2-inputEl, #txtTotalBags-inputEl {
        text-align: left !important;
        font-weight: bold !important;
    }
</style>
<script type="text/javascript">


    var Detail =
    {
        resetButtons: function () {

            App.btnRemove.disable();

            if (App.rowSelectionListLot2.hasSelection()) {



                if (App.LotPermissionRemove.value == 'true')
                {
                    if (App.rowSelectionListLot2.lastSelected.data.Desactive == false) {
                        App.btnRemove.setText("Remove");
                        App.btnRemove.setIconCls('glyphicon glyphicon-minus-sign red');
                        App.btnRemove.enable();
                    }
                }
                else
                {
                    if (App.rowSelectionListLot2.lastSelected.data.Desactive == false) {
                        App.btnRemove.setText("Remove");
                        App.btnRemove.setIconCls('glyphicon glyphicon-minus-sign red');
                        App.btnRemove.disable();
                    }
                }
            }
            else {
                App.btnRemove.setText("Remove");
                App.btnRemove.setIconCls('glyphicon glyphicon-minus-sign red');
                App.btnRemove.disable();
            }
        }
    }

</script>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
