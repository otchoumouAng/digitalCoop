<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeAgentProduction.columnManager.getColumns(), App.grpListeAgentProduction.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    // Preserve the original static method (in order to be able to call it)
    var tmp = Ext.net.FilterHeader.behaviour.boolean[0].getValue;

    // This override will allow filtering by 'yes' and 'no' on the boolean column.
    Ext.define('Ext.net.FilterHeader.behaviour.boolean_ovr', {
        override: 'Ext.net.FilterHeader.behaviour.defaultBooleanBehaviour',
        getValue: function (value, field) {
            var bool = null;
            if (value.length > 0 && value.toLowerCase() === "Yes".substr(0, value.length)) {
                bool = true;
            }
            else if (value.length > 0 && value.toLowerCase() === "No".substr(0, value.length)) {
                bool = false;
            };

            if (bool == null) {
                // Fall back to original filtering mechanism
                return this.callSuper(value, field);
            }

            // filter is always valid. if an invalid input is set, it will filter 0 records
            return { value: bool, valid: true };
        }
    });

    // "Emulate" the this.callSuper behavior (will conflict with other methods inside
    // FilterHeader.behaviour static block)
    Ext.net.FilterHeader.behaviour.boolean[0].callSuper = tmp;

    var GetNbrStoreRows = function () {
        var nbr = App.grpListeAgentProduction.getRowsValues().length;
        App.LblResumeAgentProduction.setText(nbr + ' Agent Production(s)');
    };

    var SetCriteriaTitle = function (status, canapprove, typeAgent) {

        App.AgentProductionCP.title = "";
        var texttitle = "";

        if (status) texttitle += "Show only active Production Agents : YES ";
        else texttitle += "Show only active Production Agents : NO ";

        if (canapprove) texttitle += " | Production Agents can Approve : YES ";
        else texttitle += " | Production Agents can Approve : NO ";
        texttitle += " | Type : " + typeAgent;
        App.AgentProductionCP.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    };



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    };


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            if (App.rowAgentProduction.hasSelection()) {
                if (App.AghiddenPermModifier.value == 'true')
                    App.btnModifyAgentProduction.enable();

                if (App.AghiddenPermDesactiver.value == 'true')
                    App.mnuCancelAgentProduction.enable();

                var isDisabled = App.rowAgentProduction.selected.items[0].data.Desactive;

                if (isDisabled === true) {
                    App.mnuCancelAgentProduction.setText('Activer');
                    App.btnModifyAgentProduction.disable();

                    if (App.AghiddenPermActiver.value == 'true')
                        App.mnuCancelAgentProduction.enable();

                    App.mnuCancelAgentProduction.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.AghiddenPermModifier.value == 'true')
                        App.btnModifyAgentProduction.enable();

                    App.mnuCancelAgentProduction.setText('Annuler');
                    App.mnuCancelAgentProduction.setIconCls('glyphicon glyphicon-remove red');
                }

            } else {

                App.btnModifyAgentProduction.disable();
                App.mnuCancelAgentProduction.disable();

            }
        }
    }


</script>


@model Tms.Classes.Shared.stock.AgentProduction
