
@model Tms.Classes.Shared.Sales.NavireViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
@(
X.Window()
    .ID("FormNavire")
    .Width(400)
    .Resizable(false)
    .Height(150)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Listeners(l =>
    {
        l.Show.Handler = "#{TxtDesignationNavire}.focus()";
    })
    //.X(400)
    .Y(20)
    .Title("Ship : Detail")
    .Items(
            X.FormPanel()
                .Layout(LayoutType.VBox)
                .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
                .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                .Items(
                        X.Hidden().ID("hiddenNavExecMode").Value(Model._ExecMode),
                        X.Hidden().ID("hiddenNavRowversion").Value(Model._Navire.RowVersionKey),
                        X.Hidden().ID("TxtNavireID").Value(Model._Navire.ID),
                        X.Hidden().ID("hiddenSatutForm").Value(ViewData["StatutForm"]),
                        X.TextField().MarginSpec("5 0 0 0").ID("TxtDesignationNavire").FieldLabel("Nom")
                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Navire.Nom.ToString() : string.Empty)
                            .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                   )
    )
    .Buttons
    (
        X.Button()
            .Text("OK")
            .ID("BtnSubmitNavire")
            .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .DirectEvents(de =>
            {
                de.Click.Url = Url.Action("SubmitFormMethod");
                de.Click.Before = "return validNew(App.FormNavire.id);";
                de.Click.FormID = "#(return this.up('window').down('form');)";
            }),
        X.Button()
            .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
            .Handler("App.FormNavire.doClose()").Cls("btncancel")

    )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            
            Ext.Msg.show({ title: 'Ship : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }


    };


</script>











