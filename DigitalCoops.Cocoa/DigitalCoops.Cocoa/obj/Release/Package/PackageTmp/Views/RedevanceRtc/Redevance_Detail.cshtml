<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Shipment Fees : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        if (App.grpDetailShipFees.getRowsValues().lenght <= 0) {

            Ext.Msg.show({ title: 'Shipment Fees : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'No fee added.', buttons: Ext.Msg.OK });
            return false;
        }
    };

    var ChargeShipment = function () {
        var el = App.grpDetailShipFees.getRowsValues();

        var amount = parseFloat(App.storeListShipFees.sum('Montant')) || 0;
        var _taux = parseFloat(App.hiddenRtcTaux.value) || 0;
        var _nbConteneur = App.txtNbrContainer.value;
        /*var _taxeRtc = amount * parseFloat(_nbConteneur) * _taux;*/
        var _taxeRtc = amount * _taux;
        var _totalAmount = amount + _taxeRtc;
        App.txtAmount.setValue(formatNumber(amount));
        App.txtTaxeRtc.setValue(formatNumber(_taxeRtc));
        App.txtAmountTotal.setValue(formatNumber(_totalAmount));

    };


    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };



</script>

