<script type="text/javascript">


    var Detail =
    {
        resetButtons: function () {

            App.btnEditFee.disable();
            App.btnRemoveFee.disable();

            if (App.rowSelectionShipFees.hasSelection()) {


                if (App.RedevancePermissionEdit.value == 'true' && App.rowSelectionShipFees.lastSelected.data.Auto == false && App.rowSelectionShipFees.lastSelected.data.Desactive == false )
                    App.btnEditFee.enable();
                else
                    App.btnEditFee.disable();




                if (App.RedevancePermissionRemove.value == 'true' && App.rowSelectionShipFees.lastSelected.data.Auto == false)
                {
                    if (App.rowSelectionShipFees.lastSelected.data.Desactive == false) {
                        App.btnRemoveFee.setText("Remove");
                        App.btnRemoveFee.setIconCls('glyphicon glyphicon-minus-sign red');
                        App.btnRemoveFee.enable();
                    } else {
                        App.btnRemoveFee.setText("Reset");
                        App.btnRemoveFee.setIconCls('glyphicon glyphicon-ok-sign green');
                        App.btnRemoveFee.enable();
                    }
                }
                else
                {
                    if (App.rowSelectionShipFees.lastSelected.data.Desactive == false) {
                        App.btnRemoveFee.setText("Remove");
                        App.btnRemoveFee.setIconCls('glyphicon glyphicon-minus-sign red');
                        App.btnRemoveFee.disable();
                    } else {
                        App.btnRemoveFee.setText("Reset");
                        App.btnRemoveFee.setIconCls('glyphicon glyphicon-ok-sign green');
                        App.btnRemoveFee.disable();
                    }
                }




            }
            else {
                App.btnRemoveFee.setText("Remove");
                App.btnRemoveFee.setIconCls('glyphicon glyphicon-minus-sign red');
                App.btnRemoveFee.disable();
            }
        }
    }

</script>
