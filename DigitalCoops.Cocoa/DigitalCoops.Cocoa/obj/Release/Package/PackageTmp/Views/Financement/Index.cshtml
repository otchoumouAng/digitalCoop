                                                //.MatchFieldWidth(false)
                                                //.ListConfig(new BoundList { MinWidth = 200 })
                                                .TypeAhead(false)
                                                .QueryMode(DataLoadMode.Local)
                                                .TriggerAction(TriggerAction.All)
                                                .Items(
                                                        new ListItem("{Tous}", "NO"),
                                                        new ListItem("Payé", "PA"),
                                                        new ListItem("Non payé", "NP")
                                                    )
                                                .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "NO" }); })
                                             ),


                               X.Panel()
                                .ID("formOverview")
                                .Flex(3)
                                //.TitleConfig(new PanelTitle { Text = "Summary", Cls = "title_font_color" })
                                .Border(false)
                                .Layout(LayoutType.HBox)
                                .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                                .Items
                                 (
                                    X.Container()
                                    .ID("")
                                    .Layout(LayoutType.VBox)
                                    .LayoutConfig(new VBoxLayoutConfig { Pack = BoxPack.Center })
                                    .Items(X.Label().ID("lblSummaryFI").Text("Montant").EmptyText(""))
                                 )
                        ),

                        X.GridPanel()
                       .Layout(LayoutType.Fit)
                       .ID("grpListeFinancement")
                       .Region(Region.Center)
                       .ForceFit(false)
                       .AllowDeselect(false)
                       .Store
                       (
                          X.StoreFor<Tms.Classes.Business.Financement>()
                          .ID("storeListeFinancement")
                          .RemotePaging(false)
                          .PageSize(100)
                          .AutoLoad(true)
                          .Proxy
                            (
                                Html.X().AjaxProxy()
                                .Url(Url.Action("LoadListOfFinancing"))
                                .Reader(Html.X().JsonReader().RootProperty("data"))
                            )
                          .Parameters
                          (
                            ps =>
                            {
                                ps.Add(new StoreParameter("ItemCampagne", "#{cmbCampagne}.getValue()", ParameterMode.Raw));
                                ps.Add(new StoreParameter("ItemFournisseur", "#{cmbFournisseur}.getValue()", ParameterMode.Raw));
                                ps.Add(new StoreParameter("ItemType", "#{cmbType}.getValue()", ParameterMode.Raw));
                                ps.Add(new StoreParameter("ItemPeriodStart", "#{dtpStartDate}.getRawValue()", ParameterMode.Raw));
                                ps.Add(new StoreParameter("ItemPeriodEnd", "#{dtpEndDate}.getRawValue()", ParameterMode.Raw));
                                ps.Add(new StoreParameter("ItemStatus", "#{cmbStatus}.getValue()", ParameterMode.Raw));
                                ps.Add(new StoreParameter("ItemOption", "#{cmbOption}.getValue()", ParameterMode.Raw));
                            }
                          )

                          .Listeners
                          (
                            ls =>
                            {
                                ls.Load.Handler = "Overview.SummaryFI(); Ext.net.Mask.hide();";
                                ls.Add.Handler = "SelectNewRecordAddedOnGrid(records, #{grpListeFinancement}.id); Overview.SummaryFI();";
                                ls.BeforeLoad.Handler = "Ext.net.Mask.show();" ;
                                ls.Update.Handler = "Overview.resetButtons();";
                            }
                       )
                       )
                       .ColumnModel
                       (
                            Html.X().Column().Text("").DataIndex("mIcon").Width(40).Hideable(false).Filterable(false).Renderer("renderIcon"),
                            Html.X().DateColumn().Text("Date").DataIndex("DateFinancement").Flex(1),
                            Html.X().Column().Text("Numero").DataIndex("Numero").Flex(1),
                            Html.X().Column().Text("Site").DataIndex("SiteAsString").Flex(1),
                            Html.X().Column().Text("Fournisseur").DataIndex("FournisseurNameAndCode").Flex(2),
                            Html.X().Column().Text("Type").DataIndex("LibelleFinancementType").Flex(1),
                            Html.X().Column().Text("Tonnage (Kg)").DataIndex("TonnageAsString").Flex(1),
                            Html.X().Column().Text("Prix").DataIndex("Prix").Flex(1).Hidden(true),
                            Html.X().Column().Text("Poids Brut").DataIndex("MontantBrutAsString").Flex(1),
                            Html.X().Column().Text("Taux (%)").DataIndex("PaymentTaux").Flex(1),
                            Html.X().Column().Text("Montant").DataIndex("MontantAsString").Flex(1),
                            Html.X().Column().Text("Mode Remb.").DataIndex("LibellePrelevementMode").Flex(1).Hidden(true),
                            Html.X().Column().Text("Taux Remb.").DataIndex("PrelevementTauxAsString").Flex(1).Hidden(true),
                            Html.X().Column().Text("Solde").DataIndex("SoldeAsString").EmptyCellText("0").Flex(1),
                            Html.X().Column().Text("Couv.(%)").DataIndex("Coverage").Flex(1),
                            Html.X().Column().Text("Date Fin").DataIndex("DateEcheanceAsString").Flex(1),
                            Html.X().Column().Text("Utilisateur Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                            Html.X().DateColumn().Text("Date Creation ").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                            Html.X().Column().Text("Utilisateur Modification").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                            Html.X().DateColumn().Text("Date Modification").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong"),
                            Html.X().Column().Text("Utilisateur Approb").DataIndex("UtilisateurApprobation").Flex(1).Hidden(true),
                            Html.X().DateColumn().Text("Date Approbation").DataIndex("DateApprobation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                            Html.X().Column().Text("Rejection User").DataIndex("UtilisateurRejet").Flex(1).Hidden(true),
                            Html.X().DateColumn().Text("Rejection Date").DataIndex("DateRejet").Flex(1).Hidden(true).Renderer("renderDateLong")

                         )
                         .BottomBar
                         (
                             Html.X().PagingToolbar()
                            .HideRefresh(true)
                            .Plugins(Html.X().ProgressBarPager())
                         )
                         .Plugins
                         (
                           X.FilterHeader()
                         )
                         .View(
                            Html.X().GridView().LoadingText("Chargement...")
                    )
                        .SelectionModel
                        (
                          X.RowSelectionModel()
                           .ID("rowSelectionListeFinancement")
                           .Mode(SelectionMode.Single)
                           .AllowDeselect(false)
                        )
                       .Listeners
                       (
                         l =>
                         {
                             l.Select.Fn = "Overview.resetButtons"; l.Deselect.Fn = "Overview.resetButtons";
                         }
                       )
                       .DirectEvents(de =>
                       {
                           de.RowDblClick.Url = Url.Action("OnConsult");
                           de.RowDblClick.CleanRequest = true;
                           de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowSelectionListeFinancement}.getSelected().items[0].data" });
                           de.RowDblClick.EventMask.ShowMask = true;
                           de.RowDblClick.Success = "App.Financement_Detail.setTitle('Financement : Detail')";
                       }
                        )

        )
    )

</form>