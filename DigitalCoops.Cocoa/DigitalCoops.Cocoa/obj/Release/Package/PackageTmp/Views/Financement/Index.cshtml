<script type="text/javascript">
    var CloseWindow = function () {
        App.TmsViewPort.unmask();
        App.FormPrintFinancingReport.doClose();
    };
    
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeFinancement.columnManager.getColumns(), App.grpListeFinancement.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';        

        var icon_url = Overview.getBootStrapIcons(value);
        
        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
            else if (value == 3) {
                return 'action_new_03';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return  'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }

            else if (value == 5) {
                return 'glyphicon-saved green';
            }
        },

        SummaryFI: function () {
            var nbrOfrows = App.grpListeFinancement.getStore().getCount();
            var totalAmount = parseFloat(App.storeListeFinancement.sum('Montant')) || 0;
            var totalBalance = parseFloat(App.storeListeFinancement.sum('Solde')) || 0;
            /*for (var i = 0; i < nbrOfrows; i++) {
                if (App.grpListeFinancement.getRowsValues()[i].IsPaid) {
                    totalAmount += parseFloat(App.grpListeFinancement.getRowsValues()[i].Montant);
                    totalBalance += parseFloat(App.grpListeFinancement.getRowsValues()[i].Solde);
                }
            }*/
            totalAmount = FormatAmount(totalAmount);
            totalBalance = FormatAmount(totalBalance);
            App.lblSummaryFI.setText("Montant Total : " + totalAmount + " FCFA, Cumul Solde : " + totalBalance + " FCFA");
        },
        resetButtons: function () {
           
            App.btnModify.disable();
            App.btnSetToLoss.disable();
            App.btnCancel.disable();
            App.mnuPrintAgreement.disable();
                  
            if (App.rowSelectionListeFinancement.hasSelection()) {
                  
                var isActive = App.rowSelectionListeFinancement.selected.items[0].data.IsActive;
                var isApproved = App.rowSelectionListeFinancement.selected.items[0].data.IsApproved;
                var isSetToLoss = App.rowSelectionListeFinancement.selected.items[0].data.IsSetToLoss;

                if (isActive === true || isApproved === true)
                {
                    if (App.fihiddenPermModifier.value == 'true' && isApproved === false)
                        App.btnModify.enable();                                        

                    if ((App.fihiddenPermDesactiver.value == 'true' && isApproved === false))
                        App.btnCancel.enable();

                    if ((App.fihiddenPermDesactiverApresApprouve.value == 'true' && isApproved === true))
                        App.btnCancel.enable();

                    if (App.fihiddenPermPrintAgrement.value == 'true')
                        App.mnuPrintAgreement.enable();

                    if ((App.fihiddenPermPrintAgrement.value == 'true' && isApproved === true))
                        App.mnuPrintAgreement.enable();

                    if ((App.fihiddenPermSetToLoss.value == 'true' && isApproved === true))
                        App.btnSetToLoss.enable();

                    if (isApproved === true && isSetToLoss === true) {
                        App.btnSetToLoss.disable();
                        App.btnCancel.disable();
                    }
                }                
                else
                {
                  App.btnModify.disable();
                  App.btnSetToLoss.disable();
                  App.btnCancel.disable();                  
                }                
                
            }
        }
    }


</script>

