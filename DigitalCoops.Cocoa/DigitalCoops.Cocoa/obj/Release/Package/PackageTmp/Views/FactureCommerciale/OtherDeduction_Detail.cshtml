
@model Tms.Classes.Business.Sales.FactureCommercialeDeductionViewModel
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
    double TauxDevise = (new Tms.Classes.Shared.Parametres(0).ValeurTauxEuro);
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 140px !important;
    }

</style>

@(

      X.Window()
            .ID("OtherDeduction_Detail")
            .Width(400)
            .Modal(true)
            .Resizable(false)
            .AutoScroll(true)
            .Scrollable(ScrollableOption.Vertical)
            .Height(250)
            .BodyPadding(5)
            .CloseAction(Ext.Net.CloseAction.Destroy)
            .Title("Other Deduction")
            .Items
            (


                X.FormPanel()

                .Items(

                 X.Hidden().ID("baseUrlVal").Value(@BaseUrl),


                    X.Panel()
                        .Frame(false)
                        .Border(false)
                        .FrameHeader(false)
                        .ID("pnlFlexEvenOD")
                        .Layout(LayoutType.HBox)
                        .MarginSpec("0 0 5 0")
                        .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                        .Items
                        (
                            X.Hidden()
                                            .ID("hiddenExecModeOD")
                                            .Value(Model._ExecMode)
                                            ,
                                            X.Hidden()
                                                .ID("hiddenRowversionOD")
                                                .Value(Model._FactureCommercialeDeduction.RowVersionKey)
                                                ,

                                            X.Hidden()
                                                .ID("txtFactureCommercialeDeductionID")
                                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FactureCommercialeDeduction.ID : Guid.Empty)
                                                ,
                                            X.Hidden()
                                                .ID("hiddenTauxDeviseOD")
                                                .Value(@TauxDevise)
                                                ,
                                                X.Panel()
                                                 .ID("firstColOD")
                                                 .Layout(LayoutType.Form)
                                                 .Flex(1)
                                                 .Items
                                                 (


                                                    X.ComboBox()
                                                     .ID("_cmbDeductionType")
                                                     .TypeAhead(true)
                                                     .QueryMode(DataLoadMode.Local)
                                                     .TriggerAction(TriggerAction.All)
                                                     .AllowBlank(true)
                                                     .IndicatorCls("IndicatorRedStar")
                                                     .IndicatorText("*")
                                                     .FieldLabel("Type Of Deduction")
                                                     .DisplayField("Designation")
                                                     .ListConfig(new BoundList { MinWidth = 300 })
                                                     .ValueField("ID")
                                                     .LabelAlign(LabelAlign.Right)
                                                     .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew && Model._FactureCommercialeDeduction.FactureCommercialeDeductionType != null ? Model._FactureCommercialeDeduction.FactureCommercialeDeductionType.ID : (int?)null)
                                                     .Store
                                                     (
                                                        X.Store()
                                                        .AutoLoad(true)
                                                        .Model
                                                        (
                                                             Html.X().Model()
                                                            .IDProperty("ID")
                                                            .Fields
                                                            (
                                                              new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                              new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                            )
                                                         )
                                                        .Proxy
                                                        (
                                                           Html.X().AjaxProxy()
                                                           .Url(Url.Action("LoadDeductionTypeActiveNotAuto", "FactureCommercialeDeductionType"))
                                                           .Reader(Html.X().JsonReader().RootProperty("data"))
                                                        )

                                                    )
                                                     .Listeners
                                                     (

                                                       ls =>
                                                       {
                                                           ls.Select.Handler = "App.txtRate.setReadOnly(false)";
                                                       }

                                                    )
                                                    ,


                                                    X.TextField()
                                                    .FieldLabel("Taux")
                                                    .LabelAlign(LabelAlign.Right)
                                                    .ReadOnly(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? true : false)
                                                    .ID("txtRate")
                                                    .AllowBlank(false)
                                                    .IndicatorCls("IndicatorRedStar")
                                                    .IndicatorText("*")
                                                    .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FactureCommercialeDeduction.Taux : (decimal?)null)
                                                    .Listeners
                                                     (
                                                       ls =>
                                                       {
                                                           ls.Change.Fn = "CalculAmount";
                                                           ls.Blur.Handler = "if (App.txtRate.value && !App.txtRate.readOnly) {#{txtRate}.setValue(formatNumber(#{txtRate}.getValue()))}";
                                                           ls.Focus.Handler = "if (App.txtRate.value && !App.txtRate.readOnly) { #{txtRate}.setRawValue(unformatNumber(#{txtRate}.getValue()));}";

                                                       }

                                                    ),

                                                     X.TextField()
                                                    .FieldLabel("Montant (CFA)")
                                                    .LabelAlign(LabelAlign.Right)
                                                    .ReadOnly(true)
                                                    .ID("txtAmountOD")
                                                    .AllowBlank(false)
                                                    .IndicatorCls("IndicatorRedStar")
                                                    .IndicatorText("*")
                                                    .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FactureCommercialeDeduction.MontantCFAAsString: string.Empty)
                                                    ,
                                                     X.TextField()
                                                    .FieldLabel("Amount (Euro)")
                                                    .LabelAlign(LabelAlign.Right)
                                                    .ReadOnly(true)
                                                    .ID("txtAmountEuroOD")
                                                    .AllowBlank(false)
                                                    .IndicatorCls("IndicatorRedStar")
                                                    .IndicatorText("*")
                                                    .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._FactureCommercialeDeduction.MontantAsString : string.Empty)


                                     //1stCol
                                     )

                                  //End first panel
                                  )
                    //End formPanel
                    )
            //End Windows
            )
            .Buttons
                (
                    X.Button()
                    .Text("OK")
                    .ID("BtnOkAdd")
                    .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? "Validate" : "Ok")
                    .DirectEvents
                    (
                        de =>
                        {
                            de.Click.Url = Url.Action("SubmitOnAddOtherDeduction");
                            de.Click.Before = "return validAdd(App.OtherDeduction_Detail.id); ";

                            de.Click.Confirmation.ConfirmRequest = Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? true : false;
                            de.Click.Confirmation.BeforeConfirm = "config.confirmation.title = 'Other Deduction : Edit Other Deduction'; config.confirmation.message = 'Do you want to edit this item? ';";

                            de.Click.FormID = "#(return this.up('window').down('form');)";
                        }
                    ),

                    X.Button()
                    .TabIndex(13)
                    .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                    .Handler("App.OtherDeduction_Detail.doClose()")
                    .Cls("btncancel")

                //End Button
                )

)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validAdd = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Other Deduction : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        var Amount = Number(App.txtAmountOD.value);

        if (Ext.isNumeric(Amount) && parseFloat(Amount) < 0 ) {
            Ext.Msg.show({ title: 'Other Deduction : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Amount invalid', buttons: Ext.Msg.OK });
            return false;
        }



    };

    var CalculAmount = function () {
        var taux = unformatNumber(App.txtRate.value) || 0;
        
        if (isNumeric(taux) && taux >= 0) {

            var tauxDevise = Number(App.hiddenTauxDeviseOD.value);
            var tauxEuro = (taux / tauxDevise).toFixed(3);
            App.txtAmountOD.setValue(formatNumber(taux));
            App.txtAmountEuroOD.setValue(formatNumberDecimal(tauxEuro));
        }
        else {
            App.txtAmountOD.setValue(0);
            App.txtAmountEuroOD.setValue(0);

        }
       

    };

    function formatNumberDecimal(amount) {

        amount = thousands_separators(amount.toString().replace(".", ","));

        formatted = amount.toString().replace(".", ",");

        return formatted;
    };

    function unformatNumberDecimal(amount) {
        formatted = amount.toString().replace(" ", "");

        return formatted;
    };

    function thousands_separators(num) {
        var num_parts = num.toString().split(".");
        num_parts[0] = num_parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, " ");
        return num_parts.join(".");
    };
    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };



</script>

