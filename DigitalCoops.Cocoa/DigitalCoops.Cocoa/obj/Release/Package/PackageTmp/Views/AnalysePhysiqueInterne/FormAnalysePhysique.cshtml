<script type="text/javascript">
    var CalculatePourCent = function (id) {
        if (id)
        {

            var fieldResultId = id + "Pr";

            var num = Ext.getCmp(id).value;

            var pourcentage = (num * 100) / App.TxtNbrOfBeans.value;
            pourcentage = RoundIntToPrecision(pourcentage);
           /* pourcentage = Math.round(pourcentage * 100) / 100;*/
            Ext.getCmp(fieldResultId).setValue(pourcentage);

        }
    };

    var CalculateDefective = function () {
        var flat = parseFloat(App.TxtFlatPr.value ? App.TxtFlatPr.value : 0);
        var weevil = parseFloat(App.TxtWeevilPr.value ? App.TxtWeevilPr.value : 0);
        var germinated = parseFloat(App.TxtGerminatedPr.value ? App.TxtGerminatedPr.value : 0);

        var defective = flat + weevil + germinated;
        App.TxtDefectives.setValue(defective);
    };

    var CalculateUnfermented = function () {
        var slaty = parseFloat(App.TxtSlaty.value) / 3;
        slaty = RoundIntToPrecision(slaty);
        App.TxtUnFermented.setValue(slaty);
    };

    var RoundIntToPrecision = function (v) {
        try {
            var partieEntiere = parseInt(v);
            var partieDecimale = parseFloat(v) - parseInt(v);
            partieDecimale = partieDecimale.toFixed(2);

            if (partieDecimale == 0)
                return partieEntiere;
            else if (partieDecimale < 0.34)
                return partieEntiere + 0.33;
            else if (partieDecimale <= 0.67)
                return partieEntiere + 0.66;
            else
                return partieEntiere + 1;

        } catch (err) {
            return 0;
        }
    };

    var numInput;
    window.onload = function () {
        numInput = document.ge('input.number');
        numInput.onkeypress = numInput.onkeydown = numInput.onblur = numInput.onkeyup = function () {
            numInput.value = numInput.value.replace(/[^0-9]+/, "");
        }
    }
</script>







