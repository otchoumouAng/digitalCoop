<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeRemboursementDirect.columnManager.getColumns(), App.grpListeRemboursementDirect.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
            else if (value == 3) {
                return 'action_new_03';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return  'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-file green';
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }
        },

        SummaryRD: function () {
            var nbrOfrows = App.grpListeRemboursementDirect.getStore().getCount();
            var totalAmount = parseFloat(App.storeListeRemboursementDirect.sum('MontantIfIsActive')) || 0;
            /*for (var i = 0; i < nbrOfrows; i++) {
                if (App.grpListeRemboursementDirect.getRowsValues()[i].IsActive) {
                    totalAmount += parseFloat(App.grpListeRemboursementDirect.getRowsValues()[i].Montant);
                }
            }*/
            totalAmount = FormatAmount(totalAmount);
            App.lblSummaryRD.setText("Montant Total : " + totalAmount + " FCFA");
        },

        resetButtons: function () {

            App.btnModify.disable();
            App.btnApprove.disable();
            App.btnCancel.disable();

            if (App.rowSelectionListeRD.hasSelection()) {

                var isDesActive = App.rowSelectionListeRD.selected.items[0].data.Desactive;
                var EstFinalise = App.rowSelectionListeRD.selected.items[0].data.IsApproved;

                if (isDesActive === false)
                {
                    if (App.RdhiddenPermModifier.value == 'true')
                        App.btnModify.enable();

                    if (EstFinalise === false) {
                        if (App.RdhiddenPermApprove.value == 'true')
                            App.btnApprove.enable();

                        if (App.RdhiddenPermDesactiver.value == 'true')
                            App.btnCancel.enable();
                    }

                    if (EstFinalise === true && App.RdhiddenPermDesactiverSup.value == 'true') {                        
                            App.btnCancel.enable();
                    }
                }

                else
                {
                  App.btnModify.disable();
                  App.btnApprove.disable();
                  App.btnCancel.disable();
                }

            }
        }
    }


</script>

