<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListePrixNegocieAgence.columnManager.getColumns(), App.grpListePrixNegocieAgence.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var GetNbrStoreRows = function () {        
        var nbr = App.grpListeSpotPrice.getRowsValues().length;
        App.LblTonnage.setText(nbr + ' Prix Negocié(s)');
    };

    var SetCriteriaTitle = function (fournisseur, begin, end) {

        App.CriteriaPanelPrixNegocieAgence.title = "";
        var texttitle = "";

        if (fournisseur) texttitle += "Fournisseur : " + fournisseur + " | ";

        if (begin) texttitle += "Du : " + begin;

        if (end) texttitle += " Au : " + end;

        App.CriteriaPanelPrixNegocieAgence.setTitle(texttitle);
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    };



    var iconRenderer = function (value, metaData, record) {
        metaData.css = Overview.getIcons(value);
    };


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';
                /*Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');*/
            }
            else if (value == 1) {
                return 'action_approve_02';
                /*// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');*/
            }
            else if (value == 2) {
                return 'action_new_02';
                /*//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New*/
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; /* glyphicon glyphicon-remove red*/
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; /*glyphicon glyphicon-file blue*/
            }
        },

        resetButtons: function () {            

            if (App.rowSelectionListePrixNegocieAgence.hasSelection()) {

                if (App.PNAhiddenPermDesactiver.value == 'true')
                        App.mnuCancelPrixNegocieAgence.enable();                

                var isDisabled = App.rowSelectionListePrixNegocieAgence.selected.items[0].data.PrixNegocieAgence.Desactive;                
                var isApprouve = App.rowSelectionListePrixNegocieAgence.selected.items[0].data.PrixNegocieAgence.Statut;

                if (isDisabled === true) {
                    App.btnApprovePrixNegocieAgence.disable();
                    App.btnModifyPrixNegocieAgence.disable();
                    App.mnuCancelPrixNegocieAgence.setText('Activer');
                    App.mnuCancelPrixNegocieAgence.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.PNAhiddenPermApprove.value == 'true')
                        App.btnApprovePrixNegocieAgence.enable();

                    if (App.PNAhiddenPermModifier.value == 'true')
                        App.btnModifyPrixNegocieAgence.enable();
                   
                    App.mnuCancelPrixNegocieAgence.setText('Annuler');
                    App.mnuCancelPrixNegocieAgence.setIconCls('glyphicon glyphicon-remove red');
                }

                if (isApprouve == "AP" && (isDisabled === false || isDisabled === true)) {
                    if (App.PNAhiddenPermApprove.value == 'true')
                        App.btnApprovePrixNegocieAgence.disable();

                    if (App.PNAhiddenPermModifier.value == 'true')
                        App.btnModifyPrixNegocieAgence.disable();

                }

            } else {
                App.btnModifyPrixNegocieAgence.disable();
                App.btnApprovePrixNegocieAgence.disable();                
                App.mnuCancelPrixNegocieAgence.disable();
            }
        }
    };


</script>


