<script type="text/javascript">
    var LoadStore = function() {
        if (App.cmbFournisseur.getStore().isLoaded() == false) {
            App.cmbFournisseur.getStore().load();
        }
    };

    var CalculateTonnage = function () {        
        var nbrOfrows = App.grpListePrixNegocieAgence.getRowsValues().length;
        var total = parseFloat(App.storeListePrixNegocieAgence.sum('Tonnage')) || 0;        
        
        total = FormatAmount(total);
        App.LblTonnage.setText("Poids Total : " + total + " (T)");
    };
</script>
