<script type="text/javascript">


    var Detail2 =
    {
        resetButtons2: function () {

            /*App.btnEditLot.disable();*/
            App.btnRemoveLot.disable();

            if (App.rowSelectionListLot.hasSelection()) {


                /*if (App.LotPermissionEdit.value == 'true')
                    App.btnEditLot.enable();
                else
                    App.btnEditLot.disable();*/



                if (App.LotPermissionRemove.value == 'true')
                {
                    if (App.rowSelectionListLot.lastSelected.data.Desactive == false) {
                        App.btnRemoveLot.setText("Remove");
                        App.btnRemoveLot.setIconCls('glyphicon glyphicon-minus-sign red');
                        App.btnRemoveLot.enable();
                    }
                }
                else
                {
                    if (App.rowSelectionListLot.lastSelected.data.Desactive == false) {
                        App.btnRemoveLot.setText("Remove");
                        App.btnRemoveLot.setIconCls('glyphicon glyphicon-minus-sign red');
                        App.btnRemoveLot.disable();
                    }
                }




            }
            else {
                App.btnRemoveLot.setText("Remove");
                App.btnRemoveLot.setIconCls('glyphicon glyphicon-minus-sign red');
                App.btnRemoveLot.disable();
            }
        }

    }

</script>
