@Scripts.Render("~/bundles/validation")

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNewContainer = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Container : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        if (App.grpDetailLot.getRowsValues().length < 1) {

            Ext.Msg.show({ title: 'Lot : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Please add lots.', buttons: Ext.Msg.OK });
            return false;
        }



    };


    var LoadBagTotal = function () {

        var number = App.storeListLot.sum('NbreSacs') || 0;

        App.txtNbreSacsTotal.setValue(number);

    };

    
</script>



