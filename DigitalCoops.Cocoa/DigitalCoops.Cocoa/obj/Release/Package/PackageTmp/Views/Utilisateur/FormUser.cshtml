
@model Tms.Classes.Security.UtilisateurViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<script type="text/javascript">


    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    };


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';/*Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');*/
            }
            else if (value == 1) {
                return 'action_approve_02';/* 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');*/
            }
            else if (value == 2) {
                return 'action_new_02';/*'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok*/
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-file green';
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
        },
        resetButtons: function () {

            if (App.UshiddenPermSetRole.value == 'true')
                App.BtnAddRoleToUser.enable();

            if (App.rowSelectionRoleUser.hasSelection() && App.UshiddenPermRemoveRole.value == 'true') {
                App.BtnRemoveRoleToUser.enable();
            } else {
                App.BtnRemoveRoleToUser.disable();
            }
        }
    };


</script>

@(
X.Window()
    .ID("FormUser")
    .Width(800)
    .Resizable(false)
    .Height(400)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Modal(true)
    .Y(20)
    .Title("Utilisateur : Detail")
    .Items(
            X.FormPanel()
                .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                .Layout(LayoutType.VBox)
                .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch })
                .Items(

                        X.Hidden().ID("UshiddenPermSetRole").Value(ViewData["HavPermissionSetRole"]).ReadOnly(true),
                        X.Hidden().ID("UshiddenPermRemoveRole").Value(ViewData["HavPermissionRemoveRole"]).ReadOnly(true),
                        X.Panel().Layout(LayoutType.HBox)
                        .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch })
                        .Items(
                                X.Panel().Layout(LayoutType.Form).Flex(1)
                                .Items(
                                            X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                                            X.Hidden().ID("hiddenRowversion").Value(Model._Utilisateur.RowVersionKey),
                                            X.Hidden().ID("TxtUserID").Value(Model._Utilisateur.IDUtilisateur),
                                            X.Hidden().ID("TxtDefaultSiteID").Value(Model._Utilisateur.BasedInLocation.ID),

                                            X.TextField().ID("TxtUser").FieldLabel("Nom")
                                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Utilisateur.Name : string.Empty)
                                            .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                                              ,
                                            X.TextField().ID("TxtUserName").FieldLabel("Nom Utilisateur")
                                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Utilisateur.UserName : string.Empty)
                                            .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                                            ,
                                            X.TextField().ID("TxtUserMail").FieldLabel("Email")
                                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Utilisateur.Email : string.Empty)
                                            .LabelAlign(LabelAlign.Right).InputType(Ext.Net.InputType.Email).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                                        ),
                                X.Panel().Layout(LayoutType.Form).Flex(1)
                                .Items(

                                            X.TextField().ID("TxtUserNumber").FieldLabel("Matricule")
                                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Utilisateur.EmployeeNumber : string.Empty)
                                            .LabelAlign(LabelAlign.Right)
                                              ,
                                            X.TextField().ID("TxtUserFunction").FieldLabel("Fonction")
                                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Utilisateur.FunctionName : string.Empty)
                                            .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*"),
                                            X.ComboBox()
                                                .ID("cmbSite")
                                                .FieldLabel("Site")
                                                .DisplayField("Nom")
                                                .ValueField("ID")
                                                .MatchFieldWidth(false)
                                                .ListConfig(new BoundList { MinWidth = 300 })
                                                .LabelAlign(LabelAlign.Right)
                                                .TypeAhead(false)
                                                .QueryMode(DataLoadMode.Local)
                                                .TriggerAction(TriggerAction.All)
                                                .ForceSelection(true)
                                                //.ReadOnly(true)
                                                .Value(Model._Utilisateur.BasedInLocation.ID)
                                                .Store(
                                                X.Store()
                                                .AutoLoad(true)
                                                .Model(
                                                        Html.X().Model()
                                                        .IDProperty("ID")
                                                        .Fields(
                                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                    new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                                                )
                                                    )
                                                .Proxy(
                                                            Html.X().AjaxProxy()
                                                            .Url(Url.Action("LoadSite", "Site"))
                                                .Reader(
                                                            Html.X().JsonReader().RootProperty("data")
                                                        )
                                                )
                                        ),
                                              X.ComboBox()
                                                .ID("cmbMagasin")
                                                .FieldLabel("Magasin")
                                                .DisplayField("Designation")
                                                .ValueField("ID")
                                                .MatchFieldWidth(false)
                                                .ListConfig(new BoundList { MinWidth = 300 })
                                                .LabelAlign(LabelAlign.Right)
                                                .TypeAhead(false)
                                                .QueryMode(DataLoadMode.Local)
                                                .TriggerAction(TriggerAction.All)
                                                .ForceSelection(true)
                                                //.ReadOnly(true)
                                                .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Utilisateur.Magasin.ID : (int?)null)
                                                .Store(
                                                X.Store()
                                                .AutoLoad(true)
                                                .Model(
                                                        Html.X().Model()
                                                        .IDProperty("ID")
                                                        .Fields(
                                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                                )
                                                    )
                                                .Proxy(
                                                            Html.X().AjaxProxy()
                                                            .Url(Url.Action("LoadActiveMagasin", "Magasin"))
                                                .Reader(
                                                            Html.X().JsonReader().RootProperty("data")
                                                        )
                                                )
                                        )
                                        //,
                                        //X.TextField().ID("TxtUserPwd").FieldLabel("Temp Password")
                                        ////.Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Utilisateur.Password : string.Empty)
                                        //.LabelAlign(LabelAlign.Right).InputType( Ext.Net.InputType.Password).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                                        )
                                ),
                        X.Panel().Layout(LayoutType.Fit)
                        .TopBar(new Toolbar()
                        {
                            Items = {
                                        X.Button()
                                            .ID("BtnAddRoleToUser")
                                            .IconCls("action_new_02")
                                            .Border(false)
                                            .Cls("ButtonStyle")
                                            .Text("Ajouter")
                                            .Disabled(true)
                                            .Disabled(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                                            .DirectEvents( de =>{
                                                de.Click.Url  = Url.Action("AddRoleToUser");
                                                de.Click.EventMask.ShowMask = true;
                                                de.Click.ExtraParams.Add(new Parameter { Name = "ItemUser", Mode = ParameterMode.Raw, Value = "#{TxtUserID}.getRawValue()" });
                                            } ),
                                        X.Button()
                                        .ID("BtnRemoveRoleToUser")
                                        .Icon(Icon.Delete)
                                        .Border(false)
                                        .Cls("ButtonStyle")
                                        .Text("Retirer")
                                        .Disabled(true)
                                        .DirectEvents(de =>
                                                {
                                                    de.Click.Url = Url.Action("RemoveRoleToUser");
                                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeRoleUser}.getSelectionModel().getSelection()[0].data" });
                                                    de.Click.EventMask.ShowMask = true;
                                                    de.Click.Confirmation.ConfirmRequest = true;
                                                    de.Click.Confirmation.BeforeConfirm = "config.confirmation.title = 'Utilisateur : Retirer'; config.confirmation.message = 'Voulez-vous retirer ce role ? ';";
                                                }),

                                    }
                        }),
                            X.GridPanel()
                            .Layout(LayoutType.Fit)
                            .ID("grpListeRoleUser")
                            .ForceFit(true)
                            .AllowDeselect(true)
                            .Store(
                                    X.StoreFor<Tms.Classes.Security.RoleUser>().ID("storeListeRoleUser")
                                    .Proxy(Html.X().AjaxProxy()
                                                .Url(Url.Action("SelectRole"))
                                                .Reader(Html.X().JsonReader().RootProperty("data"))
                                            )
                                    .Parameters(ps =>
                                    {
                                        ps.Add(new StoreParameter("ItemUser", "#{TxtUserID}.getRawValue()", ParameterMode.Raw));
                                        ps.Add(new StoreParameter("ItemExecMode", "#{hiddenExecMode}.getRawValue()", ParameterMode.Raw));
                                    }
                                        )
                                )
                            .ColumnModel
                            (
                                Html.X().Column().Text("").DataIndex("mIcon").Width(20).Renderer("renderIcon").Width(40).Hideable(false),
                                Html.X().Column().Text("Role").DataIndex("RoleAsString").Flex(1).Hideable(false)
                            )
                            //.Plugins(
                            //    X.FilterHeader()
                            //    )
                            .SelectionModel(
                                    X.RowSelectionModel()
                                    .ID("rowSelectionRoleUser")
                                    .Mode(SelectionMode.Single)
                                    .AllowDeselect(true)
                                )
                            .Listeners(l =>
                            {
                                if (Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Consult)
                                {
                                    l.Select.Fn = "Overview.resetButtons";
                                    l.Deselect.Fn = "Overview.resetButtons";
                                }
                            }
                            )

                    )
            )
            .Buttons(
                        X.Button()
                            .Text("OK")
                            .ID("BtnSubmitUser")
                            .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                            .DirectEvents(de =>
                            {
                                de.Click.Url = Url.Action("SubmitFormMethod");
                                de.Click.Before = "return validNew(App.FormUser.id);";
                                de.Click.FormID = "#(return this.up('window').down('form');)";
                                de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "App.grpListeRoleUser.getRowsValues({selectedOnly : false})" });
                            })
                            ,
                        X.Button()
                            .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                            .Handler("App.FormUser.doClose()")
                            .Cls("btncancel")

                            )


)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Role : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }


    };


</script>







