                        {
                            de.RowDblClick.Url = Url.Action("OnConsult");
                            de.RowDblClick.CleanRequest = true;
                            de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowSelectionUser}.getSelected().items[0].data" });
