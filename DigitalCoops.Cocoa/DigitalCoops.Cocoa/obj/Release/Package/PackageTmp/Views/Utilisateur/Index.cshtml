                                })

                                }
                        })
                    }
                })
                ,
                X.FormPanel()
                .ID("UserCriteriaPanel")
                .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Utilisateur - Overview" })
                .Region(Region.North)
                .Floatable(false)
                .Border(false)
                .Collapsed(true)
                .Collapsible(true)
                //.CollapsedCls("panelcollapse")
                .BodyPadding(5)
                .Frame(true)
                .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Start })
                .Items(
                        X.Panel()
                        .Border(false)
                        //.Frame(true)
                        //.Margin(10)
                        .Width(400)
                        .Height(40)
                        //.Title("Criteria")
                        .Layout(LayoutType.Form)
                        //.BodyPadding(6)
                        .Items(
                                X.Checkbox().ID("TxtStatus").FieldLabel("Voir uniquement les utilisateurs actifs").LabelAlign(LabelAlign.Right)
                            ),

                        X.Panel()
                        .ID("formOvwUser")
                        //.Margin(10)
                        .Flex(1)
                        // .Frame(true)
                        .Height(40)
                        //.TitleConfig(new PanelTitle { Text = "Summary", Cls = "title_font_color" })
                        .Border(false)
                        //.BodyPadding(6)
                        .Layout(LayoutType.HBox)
                        .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                        .Items(X.Container()
                                .ID("")
                                .Layout(LayoutType.VBox)
                                .LayoutConfig(new VBoxLayoutConfig { Pack = BoxPack.Center })
                                .Items(X.Label().ID("LblResumeUser").Text("Resume ici").EmptyText(""))
                            )
                        ),
                        X.GridPanel()
                        .Layout(LayoutType.Fit)
                        .ID("grpListeUser")
                        .Region(Region.Center)
                        .ForceFit(false)
                        .AllowDeselect(false)
                        .Store(
                            X.StoreFor<Tms.Classes.Security.Utilisateur>()
                                .ID("storeListeUser")
                                .PageSize(50)
                                .RemotePaging(false)
                                .Proxy(
                                            Html.X().AjaxProxy()
                                        .Url(Url.Action("Select"))
                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                    ).Listeners(ls =>
                                    {
                                        ls.Load.Handler = "GetNbrStoreRows(); Ext.net.Mask.hide();";
                                        ls.Add.Handler = "SelectNewRecord(records, #{grpListeUser}.id); GetNbrStoreRows();";
                                        ls.BeforeLoad.Handler = "Ext.net.Mask.show();";
                                    })
                            )
                        .ColumnModel
                        (
                            Html.X().Column().Text("").DataIndex("mIcon").Renderer("renderUserIcon").Width(40).Hideable(false).Filterable(false),
                            Html.X().Column().Text("Nom").DataIndex("Name").Flex(1),
                            Html.X().Column().Text("Nom Utilisateur").DataIndex("UserName").Flex(1),
                            Html.X().Column().Text("Site").DataIndex("SiteAsString").Flex(1),
                            Html.X().Column().Text("Fonction").DataIndex("FunctionName").Flex(1),
                            Html.X().Column().Text("Email").DataIndex("Email").Flex(1),
                            X.DateColumn().Text("Dernier Chang. Mot de PAsse").DataIndex("LastChangedPwdDate").Flex(1).Hidden(true).Renderer("renderDateLong"),
                            X.Column().Text("Utilisation Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                                X.DateColumn().Text("Date Creation").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
