<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/FunctionHelpers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript">
    var SelectNewRecord = function (record, grid) {
        var grid = Ext.getCmp(grid);
        var rec = grid.store.getById(record[0].data.IDUtilisateur);
        grid.store.loadPage(grid.store.findPage(rec), {
            callback: function () {
                grid.getSelectionModel().select(rec);
            }
        });
    };
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeUser.columnManager.getColumns(), App.grpListeUser.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var GetNbrStoreRows = function () {
        var nbr = App.grpListeUser.getRowsValues().length;
        App.LblResumeUser.setText(nbr + ' Utilisateur(s)');        
    };

    var SetCriteriaTitle = function (status) {

        App.UserCriteriaPanel.title = "";
        var texttitle = "";

        if (status) texttitle += "Voir uniquement les utilisateurs actifs : YES ";
        else texttitle += "Voir uniquement les utilisateurs actifs : NO ";

        App.UserCriteriaPanel.setTitle(texttitle);
    };

    var renderUserIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';        

        var icon_url = Ovw.getBootStrapUserIcons(value);        

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Ovw.getIcons(value);


    };


    var Ovw =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapUserIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-user red'; 
            }
            else if (value == 1) {
                return 'glyphicon-user green';
            }
            else if (value == 2) {
                return 'glyphicon-user blue'; 
            }
        },
        resetUserButtons: function () {
            
            if (App.rowSelectionUser.hasSelection()) {

                if (App.UshiddenPermModifier.value == 'true')
                    App.btnModifyUser.enable();
                
                if (App.UshiddenPermResetPassword.value == 'true')
                    App.btnResetPwd.enable();

                if (App.UshiddenPermDesactiver.value == 'true')
                    App.mnuCancelUser.enable();

                var isDisabled = App.rowSelectionUser.selected.items[0].data.IsDisabled;

                if (isDisabled === true) {
                    App.btnModifyUser.disable();
                    App.mnuCancelUser.setText('Activer');

                    if (App.UshiddenPermActiver.value == 'true')
                        App.mnuCancelUser.enable();
                    else
                        App.mnuCancelUser.disable();



                    App.mnuCancelUser.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.UshiddenPermDesactiver.value == 'true')
                        App.mnuCancelUser.enable();
                    else
                        App.mnuCancelUser.disable();

                    App.mnuCancelUser.setText('Desactiver');
                    App.mnuCancelUser.setIconCls('glyphicon glyphicon-remove red');

                    if (App.UshiddenPermModifier.value == 'true')
                        App.btnModifyUser.enable();
                }

            } else {
                App.btnResetPwd.disable();                
                App.btnModifyUser.disable();                
                App.mnuCancelUser.disable();
            }
        }
    }


</script>


@model Tms.Classes.Security.Utilisateur
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}

@(Html.X().ResourceManager())

<form id="tms_form">

    @(X.Viewport()
        .Layout(LayoutType.Border)
        .ID("TmsViewPort")
        .Items(
                X.Hidden().ID("BaseUrl").Value(@BaseUrl),
                X.Hidden().ID("UshiddenPermCreer").ReadOnly(true),
                X.Hidden().ID("UshiddenPermModifier").ReadOnly(true),
                X.Hidden().ID("UshiddenPermActiver").ReadOnly(true),
                X.Hidden().ID("UshiddenPermDesactiver").ReadOnly(true),
                X.Hidden().ID("UshiddenPermPrintUsersList").ReadOnly(true),
                X.Hidden().ID("UshiddenPermExporterExcel").ReadOnly(true),
                X.Hidden().ID("UshiddenPermResetPassword").ReadOnly(true),
                X.Hidden().ID("UshiddenPermOverview").ReadOnly(true),

            X.Panel()
                .ID("pnlNorth")
                .Region(Region.North)
                .Layout(LayoutType.Border)
                .TopBar(new Toolbar()
                {
                    Items = {
                        X.Button()
                        .ID("btnFilterUser")
                        .IconCls("action_filter_02")
                        .Border(false)
                        .Cls("ButtonStyle")
                        .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                        .Disabled(false)
                        .DirectEvents( de =>{
                            de.Click.Url  = Url.Action("OnFilter");
                            de.Click.EventMask.ShowMask = true;
                            } ),
                        X.Button()
                        .ID("btnRefreshUser")
                        .IconCls("action_refresh_01")
                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                        .Border(false)
                        .Cls("ButtonStyle")
                        .Disable(false)
                        .DirectEvents( de =>{
                            de.Click.Url  = Url.Action("onRefresh");

                            de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatus", Encode=true, Value= "#{TxtStatus}.getValue()", Mode=ParameterMode.Raw});
                            de.Click.Success = "SetCriteriaTitle(App.TxtStatus.value);";
                            de.Click.EventMask.ShowMask = true;
                        } ),

                        X.Button()
                        .ID("btnNewUser")
                        .IconCls("action_new_02")
                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                        .Cls("ButtonStyle")
                        .Border(false)
                        .Disable(false)
                        .DirectEvents( de =>{
                            de.Click.Url  = Url.Action("OnAdd");
                            de.Click.Success = "App.FormUser.setTitle('Utilisateur : Nouveau');";
                            de.Click.EventMask.ShowMask = true;
                        } ),

                        X.Button()
                        .ID("btnModifyUser")
                        .IconCls("action_modify_02")
                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                        .Cls("ButtonStyle")
                        .Border(false)
                        .Disabled(true)
                        .DirectEvents( de =>{
                            de.Click.Url  = Url.Action("OnEdit");
                            de.Click.Success = "App.FormUser.setTitle('Utilisateur : Modifier');";
                            de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeUser}.getSelectionModel().getSelection()[0].data"});
                            de.Click.EventMask.ShowMask = true;
                        } ),
                        X.Button()
                        .ID("btnResetPwd")
                        .IconCls("action_modify_02")
                        .Text("Reinitialiser Mot de Passe")
                        .Disabled(true)
                        .Cls("ButtonStyle")
                        .Border(false)
                        .DirectEvents( de =>{
                            de.Click.Url  = Url.Action("OnResetPassWord");
                            de.Click.ExtraParams.Add(new Parameter { Name="ItemUser", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeUser}.getSelectionModel().getSelection()[0].data"});
                            de.Click.EventMask.ShowMask = true;
                            de.Click.Confirmation.ConfirmRequest = true;
                            de.Click.Confirmation.Title = "Utilisateur : Reset Password";
                            de.Click.Confirmation.Message = "Do you want to reset PassWord ?";
                            de.Click.Success = "Ovw.resetUserButtons();";
                        } ),
                        //X.Button()
                        //.ID("btnOpenItemUser")
                        //.IconCls("action_modify_02")
                        //.Text("Module")
                        //.Cls("ButtonStyle")
                        //.Border(false)
                        //.Disabled(true)
                        //.DirectEvents( de =>{
                        //    de.Click.Url  = Url.Action("OnOpenFormModuleUsers");
                        //    de.Click.Success = "App.FormModuleUser.setTitle('Utilisateur : Module');";
                        //    de.Click.ExtraParams.Add(new Parameter { Name="ItemUser", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeUser}.getSelectionModel().getSelection()[0].data"});
                        //    de.Click.EventMask.ShowMask = true;
                        //} ),

                        X.SplitButton()
                        .ID("btnPrintUser")
                        .IconCls("action_print_02")
                        .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                        .Disable(false)
                        .Cls("ButtonStyle")
                        .Border(false)
                        .Menu(new Menu()
                        {
                            Items =
                            {
                                X.MenuItem()
                                    .ID("mnuPrintUserList")
                                    .Text("Utilisateur")
                                    .DirectEvents
                                    (
                                        de=>
                                        {
                                            de.Click.Url = Url.Action("OnPrintUserList");
                                            de.Click.EventMask.ShowMask = true;
                                        }
                                    )
                            }

                        }),

                        X.ToolbarFill(),

                        X.Button()
                        .ID("btnActions")
                        .Text("Actions")
                        .Border(false)
                        .Cls("ButtonStyle")
                        .IconCls("menu_04")
                        .Disable(false)
                        .Menu(new Menu()
                        {
                            Items = {
                                X.MenuItem()
                                    .ID("mnuExportListUser")
                                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                    .Icon(Icon.PageExcel)
                                    .Handler("SetExcelList();"),
                                X.MenuItem()
                                .ID("mnuCancelUser")
                                .IconCls("glyphicon glyphicon-remove red")
                                .Text("Desactiver")
                                .Cls("ButtonStyle")
                                .Border(false)
                                .Disabled(true)
                                .DirectEvents(de =>
                                {
                                    de.Click.Url = Url.Action("OnActivateDeactivate");
                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeUser}.getSelectionModel().getSelection()[0].data" });
                                    de.Click.EventMask.ShowMask = true;
                                    de.Click.Confirmation.ConfirmRequest = true;
                                    de.Click.Confirmation.Title = "Utilisateur";
                                    de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListeUser}.getSelectionModel().getSelection()[0].data.IsDisabled)";
