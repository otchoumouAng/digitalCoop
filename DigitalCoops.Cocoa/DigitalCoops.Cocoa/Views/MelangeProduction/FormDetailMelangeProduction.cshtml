@model Tms.Classes.Business.stock.CompositionUsinageViewModel
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style type="text/css">
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 300px !important;
    }

    .x-btn-icon > .x-btn-icon-el {
        font-family: "Glyphicons Halflings";
    }
</style>
<script type="text/javascript">
    var OverviewCode =
    {
        SetButtons: function () {

            if (App.rowCode.hasSelection()) {
                if (App.CdhiddenPermRemove.value == 'true')
                    App.BtnRemoveCode.enable();

                if (App.CdhiddenPermPrintCode.value == 'true')
                    App.BtnPrintCode.enable();

            } else {

                App.BtnRemoveCode.disable();
                App.BtnPrintCode.disable();

            }
        }
    };

</script>
@(
X.Window()
    .ID("FormDetailMelangeProduction")
    .Width(400)
    .Resizable(false)
    .Height(280)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Modal(true)
    .Y(5)
    .Title("Production - Melange : Modifier")
    .Items(
            X.Hidden().ID("baseUrlVal").Value(@BaseUrl),
            X.FormPanel()
                .Layout(LayoutType.Form)
                //.LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Start })
                //.FieldDefaults(d => d.ReadOnly = (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult) || (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve) ? true : false)
                .Items(
                        X.Hidden().ID("txtCompositionID").ReadOnly(true).Value(Model._CompositionUsinage.ID),
                        X.Hidden().ID("hiddenExecMode").ReadOnly(true).Value(Model._ExecMode),
                        X.Hidden().ID("txtOrdreProductionID").ReadOnly(true).Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._CompositionUsinage.OrdreProduction.ID : (Guid?)null),
                        X.ComboBox()
                            .ID("cmbLaboratoire")
                            .FieldLabel("Laboratoire")
                            .DisplayField("Designation")
                            .QueryMode(DataLoadMode.Local)
                            .TriggerAction(TriggerAction.All)
                            .ValueField("ID")
                            .AllowBlank(false)
                            .IndicatorCls("IndicatorRedStar")
                            .IndicatorText("*")
                            .LabelAlign(LabelAlign.Right)
                            .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._CompositionUsinage.Laboratoire.ID : Model._DefaultLaboratoire)
                            .Store
                            (
                                X.Store()
                                    .AutoLoad(true)
                                    .Model
                                    (
                                        X.Model()
                                            .IDProperty("ID")
                                            .Fields
                                            (
                                                new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                            )
                                    )
                                    .Proxy
                                    (
                                        X.AjaxProxy()
                                            .Url(Url.Action("LoadLaboratoire", "Laboratoire"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                    )

                            ),
                        X.ComboBox()
                            .ID("cmbOldProduction")
                            .AllowBlank(false)
                            .IndicatorCls("IndicatorRedStar")
                            .IndicatorText("*")
                            .FieldLabel("Ancien N° Production")
                            .DisplayField("NumeroProduction")
                            .ValueField("ID")
                            .LabelAlign(LabelAlign.Right)
                            .ForceSelection(true)
                            .TypeAhead(true)
                            .QueryMode(DataLoadMode.Local)
                            .TriggerAction(TriggerAction.All)
                            .ReadOnly(true)
                            .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._CompositionUsinage.OrdreProduction.ID : (Guid?)null)
                            .Store
                            (
                                X.Store()
                                    .AutoLoad(true)
                                    .Model
                                    (
                                        Html.X().Model()
                                        .IDProperty("ID")
                                        .Fields
                                        (
                                            new ModelField("ID", ModelFieldType.Object) { Mapping = "ID" },
                                            new ModelField("NumeroProduction", ModelFieldType.String) { Mapping = "NumeroProduction" }
                                        )
                                    )
                                    .Proxy
                                    (
                                        X.AjaxProxy()
                                            .Url(Url.Action("LoadProduction", "OrdreProduction"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                    )
                            ),
                        X.ComboBox()
                            .ID("cmbProduction")
                            .AllowBlank(false)
                            .IndicatorCls("IndicatorRedStar")
                            .IndicatorText("*")
                            .FieldLabel("Nouveau N° Production")
                            .DisplayField("NumeroProduction")
                            .ValueField("ID")
                            .LabelAlign(LabelAlign.Right)
                            .ForceSelection(true)
                            .TypeAhead(true)
                            .QueryMode(DataLoadMode.Local)
                            .TriggerAction(TriggerAction.All)
                            .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._CompositionUsinage.OrdreProduction.ID : (Guid?)null)
                            .Store
                            (
                                X.Store()
                                    .AutoLoad(true)
                                    .Model
                                    (
                                        Html.X().Model()
                                        .IDProperty("ID")
                                        .Fields
                                        (
                                            new ModelField("ID", ModelFieldType.Object) { Mapping = "ID" },
                                            new ModelField("NumeroProduction", ModelFieldType.String) { Mapping = "NumeroProduction" }
                                        )
                                    )
                                    .Proxy
                                    (
                                        X.AjaxProxy()
                                            .Url(Url.Action("LoadProduction", "OrdreProduction"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                    )
                            ),
                        X.ComboBox()
                            .ID("cmbTypeLot")
                            .TabIndex(6)
                            .AllowBlank(false)
                            .IndicatorCls("IndicatorRedStar")
                            .IndicatorText("*")
                            .FieldLabel("Type")
                            .DisplayField("Designation")
                            .ValueField("ID")
                            .LabelAlign(LabelAlign.Right)
                            .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._CompositionUsinage.LotType.ID : (int?)null)
                            .Store
                            (
                                X.Store()
                                    .AutoLoad(true)
                                    .Model
                                    (
                                        Html.X().Model()
                                        .IDProperty("ID")
                                        .Fields
                                        (
                                            new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                            new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                        )
                                    )
                                    .Proxy
                                    (
                                        Html.X().AjaxProxy()
                                        .Url(Url.Action("LoadActiveLotType", "LotType"))
                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                    )
                            ),
                        X.DateField()
                            .ID("txtDateComposition")
                            .FieldLabel("Date Melange")
                            .LabelAlign(LabelAlign.Right)
                            .AllowBlank(false)
                            .IndicatorCls("IndicatorRedStar")
                            .IndicatorText("*")
                            .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._CompositionUsinage.DateComposition.ToShortDateString() : DateTime.Now.ToShortDateString())
                )

    )
    .Buttons(
                X.Button()
                    .Text("OK")
                    .ID("BtnUpdateProduction")
                    .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve || Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                    .DirectEvents
                    (
                        de =>
                        {
                            de.Click.Url = Url.Action("UpdateProduction");
                            de.Click.Before = "return validNew(App.FormDetailMelangeProduction.id);";
                            de.Click.FormID = "#(return this.up('window').down('form');)";
                        }
                    ),
                X.Button()
                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                    .Handler("App.FormDetailMelangeProduction.doClose()")
                    .Cls("btncancel")

    )
)
@Scripts.Render("~/bundles/validation")
<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Erreur : Weighing ', msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }
    };       
</script>