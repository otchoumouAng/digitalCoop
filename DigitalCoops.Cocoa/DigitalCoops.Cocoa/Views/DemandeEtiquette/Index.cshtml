<script type="text/javascript">

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeDemandeEtiquette.columnManager.getColumns(), App.grpListeDemandeEtiquette.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return  'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }
        },

        SummaryDemandeEtiquette: function () {
            var nbrOfrows = App.grpListeDemandeEtiquette.getStore().getCount();
            console.log(App.grpListeDemandeEtiquette.getStore());
             @* var totalNet = App.storeListeDemandeEtiquette.sum('PoidsNet') || 0;
            var totalNbrOfBags = App.storeListeDemandeEtiquette.sum('NombreSacs') || 0;
            var totalPoidsBrut = App.storeListeDemandeEtiquette.sum('PoidsBrut') || 0;

            totalNet = FormatAmount(totalNet);
            totalNbrOfBags = FormatAmount(totalNbrOfBags);
            totalPoidsBrut = FormatAmount(totalPoidsBrut); *@
            App.lblSummaryDemandeEtiquette.setHtml("Nbr d'Demande Etiquettes : " + nbrOfrows);
        },

        resetButtons: function () {

            App.btnModify.disable();
            App.btnCancel.disable();
            App.btnApprove.disable();
            App.btnImprimerPalette.disable();

            if (App.rowDemandeEtiquette.hasSelection()) {

                var isApproved = App.rowDemandeEtiquette.selected.items[0].data.IsApproved;



                if (isApproved == false) {

                    if (App.arhiddenPermModify.value == 'true')
                        App.btnModify.enable();

                    if (App.arhiddenPermDesactiver.value == 'true')
                        App.btnCancel.enable();

                    if (isApproved === false) {
                        if (App.arhiddenPermApprove.value == 'true') {
                            App.btnApprove.enable();
                        }
                    }
                }
                if (isApproved == true) {
                    App.btnImprimerPalette.enable();
                    App.btnModify.disable();
                    return;
                }
                if (isDesactive === true) {
                    App.btnCancel.setIconCls("glyphicon glyphicon-ok green");
                    App.btnCancel.setText('Activer');
                }

                else {
                    App.btnCancel.setIconCls("glyphicon glyphicon-remove red");
                    App.btnCancel.setText('Desactiver');
                }

                if (App.arhiddenPermDesactiver.value == 'true')
                    App.btnCancel.enable();

            }
        }
    }
</script>

