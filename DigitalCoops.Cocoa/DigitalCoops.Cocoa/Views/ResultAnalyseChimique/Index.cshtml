<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script src="~/Scripts/FunctionHelpers.js"></script>
<script type="text/javascript">
    var GetNbrStoreRows = function () {
        var nbr = App.grpListeAnalyseChimique.getRowsValues().length;
        App.LblResumeAnalyseChimique.setText(nbr + ' Analyses');
    };

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeAnalyseChimique.columnManager.getColumns(), App.grpListeAnalyseChimique.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var SetCriteriaTitle = function (status, begin, end) {
        App.AnalyseChimiqueCP.title = "";
        var texttitle = "";

        if (begin) texttitle += " Du : " + begin;

        if (end) texttitle += " Au : " + end;

        if (status) texttitle += " | Statut : " + status;

        App.AnalyseChimiqueCP.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
            else if (value == 3) {
                return 'glyphicon-file red'; // glyphicon glyphicon-file blue
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            if (App.rowAnalyseChimique.hasSelection()) {

                var isDisabled = App.rowAnalyseChimique.selected.items[0].data.Desactive;
                var isApprouve = App.rowAnalyseChimique.selected.items[0].data.Confirmation;
                var resultat = App.rowAnalyseChimique.selected.items[0].data.Resultat;

                if (isDisabled === true) {
                    App.mnuCancelAnalyseChimique.disable();
                    App.btnModifyAnalyseChimique.disable();
                    App.mnuCancelAnalyseChimique.setText('Activer');
                    App.btnApproveAnalyseChimique.disable();
                    App.mnuCancelAnalyseChimique.setIconCls('glyphicon glyphicon-ok green');
                }
                else {
                    if (App.RahiddenPermModifier.value == 'true')
                        App.btnModifyAnalyseChimique.enable();

                    if (App.RahiddenPermDesactiver.value == 'true')
                        App.mnuCancelAnalyseChimique.enable();

                    if (App.RahiddenPermApprove.value == 'true')
                        App.btnApproveAnalyseChimique.enable();

                    App.mnuCancelAnalyseChimique.setText('Annuler');
                    App.mnuCancelAnalyseChimique.setIconCls('glyphicon glyphicon-remove red');

                    if (isApprouve === true && isDisabled === false) {
                        App.btnApproveAnalyseChimique.disable();
                        App.btnModifyAnalyseChimique.disable();

                        if (App.AphiddenPermSuperDesactiver.value == 'true')
                            App.mnuCancelAnalyseChimique.enable();
                        else
                            App.mnuCancelAnalyseChimique.disable();

                        return;
                    }
                }
            } else {

                App.btnApproveAnalyseChimique.disable();
                App.btnModifyAnalyseChimique.disable();
                App.mnuCancelAnalyseChimique.disable();
            }
        }
    }


</script>
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}

@(Html.X().ResourceManager().AjaxTimeout(36000000))

<form id="tms_form">

    @(X.Viewport()
    .Layout(LayoutType.Border)
    .ID("TmsViewPort")
    .Items(
                X.Hidden().ID("BaseUrl").Value(@BaseUrl),                
                X.Hidden().ID("RahiddenPermModifier").ReadOnly(true),
                X.Hidden().ID("RahiddenPermApprove").ReadOnly(true),
                X.Hidden().ID("RahiddenPermDesactiver").ReadOnly(true),                                                
                X.Hidden().ID("AphiddenPermSuperDesactiver").ReadOnly(true),
    #region Boutons Actions
            X.Panel()
                .ID("pnlNorth")
                .Region(Region.North)
                .Layout(LayoutType.Border)
                .TopBar(new Toolbar()
                {
                    Items = {
                        X.Button()
                            .ID("btnFilterAnalyseChimique")
                            .IconCls("action_filter_02")
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                            .Disabled(false)
                            .DirectEvents
                            (
                                de =>{
                                        de.Click.Url  = Url.Action("OnFilter");
                                        de.Click.EventMask.ShowMask = true;
                                }
                            ),

                        X.Button()
                            .ID("btnRefreshAnalyseChimique")
                            .IconCls("action_refresh_01")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)
                            .Border(false)
                            .Cls("ButtonStyle")
                            .Disable(false)
                            .DirectEvents
                            (
                                de =>
                                {
                                    de.Click.Url  = Url.Action("onRefresh");
                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodStart", Value= "#{TxtPeriodStart}.getRawValue()",   Mode=ParameterMode.Raw});
                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodEnd", Value= "#{TxtPeriodEnd}.getRawValue()",     Mode=ParameterMode.Raw});
                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatus", Encode=true, Value= "#{CmbStatutAnalyse}.getValue()",     Mode=ParameterMode.Raw});
                                    de.Click.EventMask.ShowMask = true;
                                    de.Click.Success = "SetCriteriaTitle(App.CmbStatutAnalyse.rawValue, App.TxtPeriodStart.rawValue, App.TxtPeriodEnd.rawValue);";

                                }
                            ),
                        X.Button()
                            .ID("btnNewAnalyseChimique")
                            .IconCls("action_new_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Disable(false)
                            .DirectEvents
                            (
                                de =>
                                {
                                    de.Click.Url  = Url.Action("OnAdd");
                                    de.Click.Success = "App.FormResultAnalyseChimique.setTitle('Resulat Analyse Chimique : Nouveau')";
                                    de.Click.EventMask.ShowMask = true;
                                }
                            ),
                        X.Button()
                            .ID("btnModifyAnalyseChimique")
                            .IconCls("action_modify_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Disabled(true)
                            .DirectEvents
                            (
                                de =>{
                                    de.Click.Url  = Url.Action("OnEdit");
                                    de.Click.Success = "App.FormResultAnalyseChimique.setTitle('Resulat Analyse Chimique : Modifier')";
                                    de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeAnalyseChimique}.getSelectionModel().getSelection()[0].data"});
                                    de.Click.EventMask.ShowMask = true;
                                }
                            ),
                        X.Button()
                            .ID("btnApproveAnalyseChimique")
                            .IconCls("glyphicon glyphicon-ok green")
                            .Text("Confirm")
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Disabled(true)
                            .DirectEvents
                            (
                                de =>{
                                            de.Click.Url  = Url.Action("onApprove");
                                            de.Click.Success = "App.FormApproveAnalyseChimique.setTitle('Resulat Analyse Chimique : Approuver')";
                                            de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true,Value="#{grpListeAnalyseChimique}.getSelectionModel().getSelection()[0].data"});
                                            de.Click.EventMask.ShowMask = true;
                                            //de.Click.Success = "Overview.resetButtons();";
                                            //de.Click.Confirmation.ConfirmRequest = true;
                                            //de.Click.Confirmation.BeforeConfirm = "config.confirmation.title = 'Analyse Physique : Approuver'; config.confirmation.message = 'Voulez-vous approuver cette analyse ?'";
                                }
                            ),

                        X.SplitButton()
                            .ID("btnPrint")
                            .IconCls("action_print_02")
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                            .Disable(false)
                            .Cls("ButtonStyle")
                            .Border(false)
                            .Menu
                            (new Menu()
                                {
                                Items =
                                {

                                    X.MenuItem()
                                        .ID("mnuPrintAnalyseChimiqueList")
                                        .Text("Chemical Analysis Average")
                                        .DirectEvents
                                        (
                                            de=>
                                            {
                                                de.Click.Url = Url.Action("OnDisplayAnalysePhysiqueCriteria");
                                                de.Click.EventMask.ShowMask = true;
                                            }
                                        )


                                    }

                                })
                                ,

                        X.ToolbarFill(),

                        X.Button()
                            .ID("btnActions")
                            .Text("Actions")
                            .Border(false)
                            .Cls("ButtonStyle")
                            .IconCls("menu_04")
                            .Disable(false)
                            .Menu(new Menu()
                                 {
                                     Items = {
                                         X.MenuItem()
                                            .ID("mnuExportChemicalAnalysis")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)
                                            .Icon(Icon.PageExcel)
                                            .Handler("SetExcelList();"),
                                        X.MenuItem()
                                            .ID("mnuCancelAnalyseChimique")
                                            .IconCls("glyphicon glyphicon-remove red")
                                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                                            .Cls("ButtonStyle")
                                            .Border(false)
                                            .Disabled(true)
                                            .DirectEvents(de =>
                                                    {
                                                        de.Click.Url = Url.Action("OnActivateDeactivate");
                                                        de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeAnalyseChimique}.getSelectionModel().getSelection()[0].data" });
                                                        de.Click.EventMask.ShowMask = true;
                                                        de.Click.Confirmation.ConfirmRequest = true;
                                                        de.Click.Confirmation.Title = "Analyse Chimique";
                                                        de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListeAnalyseChimique}.getSelectionModel().getSelection()[0].data.Desactive)";
                                                        de.Click.Success = "Overview.resetButtons();";
                                                    })
                                            }
                                        })
                                    }
                }
                ),
    #endregion
    #region Critere
        X.FormPanel()
            .ID("AnalyseChimiqueCP")
            .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Resulat Analyse Chimique - overview" })
            .Region(Region.North)
            .Floatable(false)
            .Border(false)
            .Collapsed(true)
            .Collapsible(true)
            //.CollapsedCls("panelcollapse")
            .BodyPadding(5)
            .Frame(true)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Start })
            .Items(

    #region Zone A
                    X.Container()
                        .Layout(LayoutType.Form)
                        .Flex(1)
                        .Items(

                                X.DateField().ID("TxtPeriodStart").FieldLabel("Date Debut").LabelAlign(LabelAlign.Right).Text(""),
                                X.DateField().ID("TxtPeriodEnd").FieldLabel("Date Fin").LabelAlign(LabelAlign.Right).Text(""),
                                X.ComboBox()
                                    .ID("CmbStatutAnalyse")
                                    .ForceSelection(true)
                                    .FieldLabel("Statut")
                                    .LabelWidth(110)
                                    .TypeAhead(true)
                                    .ForceSelection(true)
                                    .LabelAlign(LabelAlign.Right)
                                    .Items(
                                            new ListItem("{Tous}", "-1"),
                                            new ListItem("Saisi", "0"),
                                            new ListItem("Confirmé", "1")
                                        )
                                    .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "-1" }); })

                                ),
    #endregion
    #region Zone B
                    X.Container()
                        .ID("")
                        .Flex(4)
                        .Layout(LayoutType.VBox)
                        .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Center, Pack = BoxPack.Center })
                        .Items(
                                X.Label()
                                    .ID("LblResumeAnalyseChimique")
                                    .Text("Resume ici")
                                    .EmptyText("")
                            )

    #endregion

            ),
    #endregion
    #region GridPanel
        X.GridPanel()
            .Layout(LayoutType.Fit)
            .ID("grpListeAnalyseChimique")
            .Region(Region.Center)
            .ForceFit(false)
            .AllowDeselect(false)
            .Store(
                    X.StoreFor<Tms.Classes.Business.stock.AnalyseChimique>()
                        .ID("storeListeAnalyseChimique")
                        .PageSize(100)
                        .RemotePaging(false)
                        .Proxy(Html.X().AjaxProxy()
                            .Url(Url.Action("Select", "ResultAnalyseChimique"))
                            .Reader(Html.X().JsonReader().RootProperty("data"))
                        )
                        .Listeners(ls =>
                        {
                            ls.Load.Handler = "GetNbrStoreRows(); Ext.net.Mask.hide();";
                            ls.Add.Handler = "SelectNewRecordAddedOnGrid(records, #{grpListeAnalyseChimique}.id); GetNbrStoreRows();";
                            ls.BeforeLoad.Handler = "Ext.net.Mask.show();";
                        })
                        .Parameters
                        (
                            ps =>
                            {
                                ps.Add(new StoreParameter("ItemPeriodStart", "#{TxtPeriodStart}.getRawValue()", ParameterMode.Raw));
                                ps.Add(new StoreParameter("ItemPeriodEnd", "#{TxtPeriodEnd}.getRawValue()", ParameterMode.Raw));
                                ps.Add(new StoreParameter("ItemStatus", "#{CmbStatutAnalyse}.getValue()", ParameterMode.Raw));
                            }
                        )
            )
            .ColumnModel
            (
                Html.X().Column().Text("").DataIndex("mIcon").Renderer("renderIcon").Hideable(false).Width(40).Filterable(false),
                Html.X().Column().Text("Analyse Date/Heure").DataIndex("DateAnalyseAsString").Flex(2),                
                Html.X().Column().Text("Echantillon N°").DataIndex("NumeroEchantillon").Flex(1),
                Html.X().Column().Text("%FC 4.5% shell").DataIndex("PrFc45").Flex(1),
                Html.X().Column().Text("%FC 3% shell").DataIndex("PrFc35").Flex(1),
                Html.X().Column().Text("%FC 1% shell").DataIndex("PrFc1").Flex(1),
                Html.X().Column().Text("%Fat Content").DataIndex("FatContentPc").Flex(1),
                Html.X().Column().Text("%FFA").DataIndex("FFA").Flex(1),
                Html.X().Column().Text("%shell content").DataIndex("ShellContentPc").Flex(1),
                Html.X().Column().Text("Humidite").DataIndex("Moisture").Flex(1),
                Html.X().Column().Text("pH").DataIndex("PH").Flex(1),
                Html.X().Column().Text("KOH").DataIndex("KOH").Flex(1),
                Html.X().Column().Text("FFA").DataIndex("FFA").Flex(1),
                X.Column().Text("User Approval").DataIndex("Approbateur").Flex(1).Hidden(true),
                X.DateColumn().Text("Date Approval").DataIndex("DateApprobation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                X.Column().Text("Utilisation Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                X.DateColumn().Text("Date Creation").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                X.Column().Text("Utilisation Modification").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                X.DateColumn().Text("Date Modification").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")
            )
            .BottomBar(
                                Html.X().PagingToolbar()
                                .HideRefresh(true)
                        .Plugins(Html.X().ProgressBarPager())
            )
                .Plugins(
                    X.FilterHeader()
                )
                .View(
                            Html.X().GridView().LoadingText("Chargement...")
                    )
                .SelectionModel(
                    X.RowSelectionModel()
                        .ID("rowAnalyseChimique")
                        .Mode(SelectionMode.Single)
                        .AllowDeselect(false)
                ).Listeners(l =>
                {
                    l.Select.Fn = "Overview.resetButtons";
                    l.Deselect.Fn = "Overview.resetButtons";

                }
                )
                .DirectEvents(de =>
                {
                    de.RowDblClick.Url = Url.Action("OnConsult");
                    de.RowDblClick.CleanRequest = true;
                    de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowAnalyseChimique}.getSelected().items[0].data" });
                    de.RowDblClick.EventMask.ShowMask = true;
                }
                )
    #endregion

    )
    )

</form>