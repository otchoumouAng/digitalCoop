@Scripts.Render("~/bundles/validation")
<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            console.log('error fields');
            Ext.Msg.show({ title: 'Analyse Physique : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        if ((App.CmbAnalyseur.value && App.CmbSuperviseur.value) && (App.CmbAnalyseur.value == App.CmbSuperviseur.value)) {
            Ext.Msg.show({ title: 'Analyse Physique : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Please change Reviewer or Analyzeur', buttons: Ext.Msg.OK });
            return false;
        }

    };        
</script>

<script type="text/javascript">
    var CalculatePrShellContent = function () {
        var poidsfeves = parseFloat(App.TxtPoidsFeves.value) || 0;
        var weightShell = parseFloat(App.TxtWeightShell.value) || 0;
        var result = (weightShell / poidsfeves) * 100;
        App.TxtShellContentPc.setValue(result);
    };

    var CalculatePrMoisture = function () {
        var WGroudBeans = parseFloat(App.TxtWeightGroundBeans.value) || 0;
        var WGroundAlu = parseFloat(App.TxtWeightGroundBeansAndAluminium.value) || 0;
        var WGroudBeansAluClean = parseFloat(App.TxtWeightGroundBeansAluminumClean.value) || 0;
        
        var result = ((WGroundAlu - WGroudBeansAluClean) / WGroudBeans) * 100;
        App.TxtMoisture.setValue(result);
    };

    var CalculateWeightOfFat = function () {
        var WPumice = parseFloat(App.TxtWeightDryFlaskPumice.value) || 0;
        var WFlask = parseFloat(App.TxtWeightFlaskFatClean.value) || 0;
        var result = WFlask - WPumice;
        App.TxtWeightFat.setValue(result);
    };

    var CalculatePrFatContent = function () {
        var WFat = parseFloat(App.TxtWeightFat.value) || 0;
        var WGroundBeans = parseFloat(App.TxtWeightGroundBeans2.value) || 0;
        var result = (WFat / WGroundBeans) * 100;
        App.TxtFatContentPc.setValue(result);
    };

    var CalculatePrActualFatContent = function () {
        var PrFat = parseFloat(App.TxtFatContentPc.value) || 0;
        var Blank = parseFloat(App.TxtBlankFromPetroleum.value) || 0;
        var result = (PrFat - Blank);
        App.TxtActualFatContent.setValue(result);
    };

    var CalculateFFA = function () {
        var koh = parseFloat(App.TxtKOH.value) || 0;
        var Wfat = parseFloat(App.TxtWeightFat.value) || 0;
        var result = (koh * 2.82) / Wfat;
        App.TxtFFA.setValue(result);
    };

    var RoundIntToPrecision = function (v) {
        try {
            var partieEntiere = parseInt(v);
            var partieDecimale = parseFloat(v) - parseInt(v);
            partieDecimale = partieDecimale.toFixed(2);

            if (partieDecimale == 0)
                return partieEntiere;
            else if (partieDecimale < 0.34)
                return partieEntiere + 0.33;
            else if (partieDecimale <= 0.67)
                return partieEntiere + 0.66;
            else
                return partieEntiere + 1;

        } catch (err) {
            return 0;
        }
    };

    var numInput;
    window.onload = function () {
        numInput = document.ge('input.number');
        numInput.onkeypress = numInput.onkeydown = numInput.onblur = numInput.onkeyup = function () {
            numInput.value = numInput.value.replace(/[^0-9]+/, "");
        }
    }
</script>








