<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <style type="text/css">
        .header_style {
            background-color: white;
        }

        .x-form-text-default.x-form-textarea {
            line-height: 17px;
            min-height: 50px !important;
        }

        .title_style {
            color: black;
            font-size: small;
            line-height: inherit;
        }

        .frame_title_style {
            border: 1px solid transparent !important;
            border-bottom-width: 0px !important;
            color: black;
            font-size: small;
            line-height: inherit;
        }

        #txtSecondGrossWeight-inputEl, #txtFirstGrossWeight-inputEl {
            font-size: 30px !important;
            font-weight: bold !important;
            height: 40px !important;
            text-align: center !important;
            line-height: 34px !important;
        }

        .x-form-layout-auto-label > * > .x-form-item-label {
            width: 100px !important;
        }

        .x-panel .x-panel-header-default-framed-top {
            border-bottom-width: 0px !important;
        }
    </style>
    <script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
    <script type="text/javascript">

        var CalculateValues = function () {
            var totalNbrSacs = App.storeListePoidsCertifie.sum('NombreSacs') || 0;
            var totalPoidsBrut = App.storeListePoidsCertifie.sum('PoidsBrut') || 0;
            var TareUnitaire = parseFloat(App.cmbTypeLot.getSelectedRecord().data.TareSacsUnitaire) || 0;
            App.txtNombreSacs.setValue(totalNbrSacs);
            App.txtPoidsBrut.setValue(formatNumber(totalPoidsBrut));
            App.txtTareSacs.setValue(totalNbrSacs * TareUnitaire);
        };

        var CalculateNetWeight = function () {
            var totalNbrSacs = App.storeListePoidsCertifie.sum('NombreSacs') || 0;
            var totalPoidsBrut = App.storeListePoidsCertifie.sum('PoidsBrut') || 0;
            var TareUnitaire = parseFloat(App.cmbTypeLot.getSelectedRecord().data.TareSacsUnitaire) || 0;
            var tareSacs = parseFloat(totalNbrSacs * TareUnitaire) || 0;            
            var tarePalettes = App.txtTarePalettes.value;            
            if (App.txtTarePalettes.value != "0")
                tarePalettes = parseFloat(unformatNumber(App.txtTarePalettes.value)) || 0;

            var netWeight = parseFloat(totalPoidsBrut) - tareSacs - tarePalettes;

            App.txtNetWeight.setValue(formatNumber(netWeight));
        };

    </script>
</head>
