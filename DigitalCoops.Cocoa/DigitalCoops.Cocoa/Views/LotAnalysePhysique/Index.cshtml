                    Html.X().Column().Text("Fiche N°").DataIndex("FicheNumero").Flex(1),
                    Html.X().Column().Text("Lot N°").DataIndex("NumeroLot").Flex(1),
                    Html.X().Column().Text("Hum (%)").DataIndex("Humidite").Flex(1),
                    Html.X().Column().Text("Grainage").DataIndex("Grainage").Flex(1),
                    Html.X().Column().Text("Light Crop").DataIndex("LightCrop").Flex(1),
                    Html.X().Column().Text("Moisie (%)").DataIndex("Moisie").Flex(1),
                    Html.X().Column().Text("Plate (%)").DataIndex("Plate").Flex(1),
                    Html.X().Column().Text("Insecte (%)").DataIndex("Weevil").Flex(1),
                    Html.X().Column().Text("Germee (%)").DataIndex("Germee").Flex(1),
                    Html.X().Column().Text("Ardoisee (%)").DataIndex("Ardoisee").Flex(1),
                    Html.X().Column().Text("Violette (%)").DataIndex("Violette").Flex(1),
                    Html.X().Column().Text("Tamis (%)").DataIndex("Tamis").Flex(1).Hidden(true),
                    Html.X().Column().Text("Matiere Etrangere (%)").DataIndex("MatiereEtrangere").Flex(1).Hidden(true),
                    Html.X().Column().Text("Fragment (%)").DataIndex("Fragment").Flex(1).Hidden(true),
                    Html.X().Column().Text("Brisure").DataIndex("Brisure").Flex(1).Hidden(true),
                    Html.X().Column().Text("Bean Cluster").DataIndex("BeansCluster").Flex(1).Hidden(true),
                    Html.X().Column().Text("CRM").DataIndex("CRM").Flex(1).Hidden(true),
                    X.Column().Text("User Approval").DataIndex("Approbateur").Flex(1).Hidden(true),
                    X.DateColumn().Text("Date Approval").DataIndex("DateApprobation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                    X.Column().Text("Utilisation Creation").DataIndex("UtilisateurCreation").Flex(1).Hidden(true),
                    X.DateColumn().Text("Date Creation").DataIndex("DateCreation").Flex(1).Hidden(true).Renderer("renderDateLong"),
                    X.Column().Text("Utilisation Modification").DataIndex("UtilisateurModification").Flex(1).Hidden(true),
                    X.DateColumn().Text("Date Modification").DataIndex("DateModification").Flex(1).Hidden(true).Renderer("renderDateLong")
                )
                .BottomBar(
                            X.PagingToolbar()
                                    .HideRefresh(true)
                                    .Plugins(Html.X().ProgressBarPager())
                )
                .Plugins(
