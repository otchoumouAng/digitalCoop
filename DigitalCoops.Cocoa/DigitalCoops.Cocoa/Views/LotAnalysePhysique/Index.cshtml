                    X.RowSelectionModel()
                        .ID("rowAnalysePhysiqueExport")
                        .Mode(SelectionMode.Single)
                        .AllowDeselect(false)
                )
                .Listeners
                (
                    l =>
                    {
                        l.Select.Fn = "Overview.resetButtons";
                        l.Deselect.Fn = "Overview.resetButtons";
                    }
                )
                .DirectEvents
                (
                    de =>
                    {
                        de.RowDblClick.Url = Url.Action("OnConsult");
                        de.RowDblClick.CleanRequest = true;
                        de.RowDblClick.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{rowAnalysePhysiqueExport}.getSelected().items[0].data" });
                        de.RowDblClick.EventMask.ShowMask = true;
                    }
                )
    #endregion
        )
    )

</form>