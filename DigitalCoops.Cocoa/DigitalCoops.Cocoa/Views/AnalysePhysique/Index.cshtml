                                Html.X().Column().Text("Analyse Date/Heure").DataIndex("DateAnalyseAsString").Flex(2),
                                //Html.X().Column().Text("Coding Date/Heure").DataIndex("CodeAnalyseDate").Width(150),
                                Html.X().Column().Text("Code").DataIndex("CodeAnalyse").Flex(1),
                                Html.X().Column().Text("Fiche N°").DataIndex("FicheNumero").Flex(1),
                                Html.X().Column().Text("Grainage").DataIndex("Grainage").Flex(1),
                                Html.X().Column().Text("Moisie (%)").DataIndex("Moisie").Flex(1),
                                Html.X().Column().Text("Plate (%)").DataIndex("Plate").Flex(1),
                                Html.X().Column().Text("Weevil (%)").DataIndex("Weevil").Flex(1),
                                Html.X().Column().Text("Germee (%)").DataIndex("Germee").Flex(1),
                                Html.X().Column().Text("Ardoisee (%)").DataIndex("Ardoisee").Flex(1),
                                Html.X().Column().Text("Violette (%)").DataIndex("Violette").Flex(1),
                                Html.X().Column().Text("Humidite (%)").DataIndex("Humidite").Flex(1),
                                Html.X().Column().Text("M. Etrangere (%)").DataIndex("MatiereEtrangere").Flex(1),
                                Html.X().Column().Text("Tamis (%)").DataIndex("Tamis").Flex(1).Hidden(true),
                                Html.X().Column().Text("BC (Grainage) (%)").DataIndex("NombreFevesPc").Flex(1).Hidden(true),
                                Html.X().Column().Text("Fragment (%)").DataIndex("Fragment").Flex(1).Hidden(true),
                                Html.X().Column().Text("Brisure (%)").DataIndex("Brisure").Flex(1).Hidden(true),
                                Html.X().Column().Text("Grade").DataIndex("NomClassificationFeves").Flex(1).Hidden(true),
