                            .Region(Region.Center)
                            .ForceFit(false)
                            .AllowDeselect(false)
                            .Store(
                                    X.StoreFor<Tms.Classes.Business.AnalysePhysique>()
                                        .ID("storeListeAnalysePhysique")
                                        .PageSize(100)
                                        .RemotePaging(false)
                                        .Proxy(Html.X().AjaxProxy()
                                            .Url(Url.Action("Select"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )
                                        .Listeners(ls =>
                                        {
                                            ls.Load.Handler = "GetNbrStoreRows(); Ext.net.Mask.hide();";
                                            ls.Add.Handler = "SelectNewRecordAddedOnGrid(records, #{grpListeAnalysePhysique}.id); GetNbrStoreRows();";
                                            ls.BeforeLoad.Handler = "Ext.net.Mask.show();";
                                        })
                                        .Parameters(ps =>
                                        {
                                            ps.Add(new StoreParameter("ItemPeriodStart", "#{TxtPeriodStart}.getRawValue()", ParameterMode.Raw));
