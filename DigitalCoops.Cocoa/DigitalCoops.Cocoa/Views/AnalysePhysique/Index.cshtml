<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script src="~/Scripts/FunctionHelpers.js"></script>
<script type="text/javascript">
    var GetNbrStoreRows = function () {
        var nbr = App.grpListeAnalysePhysique.getRowsValues().length;        
        App.LblResumeAnalysePhysique.setText(nbr + ' Analyses');
    };

    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeAnalysePhysique.columnManager.getColumns(), App.grpListeAnalysePhysique.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var SetCriteriaTitle = function (site,status, begin, end) {
        App.AnalysePhysiqueCriteriaPanel.title = "";
        var texttitle = "";
        if (site) texttitle += "Site : " + site;
        if (begin) texttitle += ", Du : " + begin;

        if (end) texttitle += " Au : " + end;

        if (status) texttitle += " | Statut : " + status;

        App.AnalysePhysiqueCriteriaPanel.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';
        

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
            else if (value == 3) {
                return 'glyphicon-file red'; // glyphicon glyphicon-file blue
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {            

            if (App.rowSelectionAnalysePhysique.hasSelection()) {                

                var isDisabled = App.rowSelectionAnalysePhysique.selected.items[0].data.Desactive;
                var isApprouve = App.rowSelectionAnalysePhysique.selected.items[0].data.Confirmation;
                var resultat = App.rowSelectionAnalysePhysique.selected.items[0].data.Resultat;
                                
                if (isDisabled === true) {
                    App.mnuCancelAnalysePhysique.disable();
                    App.btnModifyAnalysePhysique.disable();
                    App.mnuCancelAnalysePhysique.setText('Activer');                    
                    App.btnApproveAnalysePhysique.disable();
                    App.mnuCancelAnalysePhysique.setIconCls('glyphicon glyphicon-ok green');                    
                }
                else {
                    if (App.AphiddenPermModifier.value == 'true')
                        App.btnModifyAnalysePhysique.enable();

                    if (App.AphiddenPermDesactiver.value == 'true')
                        App.mnuCancelAnalysePhysique.enable();

                    if (App.AphiddenPermApprove.value == 'true')
                        App.btnApproveAnalysePhysique.enable();

                    App.mnuCancelAnalysePhysique.setText('Annuler');
                    App.mnuCancelAnalysePhysique.setIconCls('glyphicon glyphicon-remove red');

                    if (isApprouve === true && isDisabled === false) {
                        App.btnApproveAnalysePhysique.disable();
                        App.btnModifyAnalysePhysique.disable();

                        if (App.AphiddenPermSuperDesactiver.value == 'true')
                            App.mnuCancelAnalysePhysique.enable();
                        else
                            App.mnuCancelAnalysePhysique.disable();

                        return;
                    } 
                }                
            } else {

                App.btnApproveAnalysePhysique.disable();
                App.btnModifyAnalysePhysique.disable();                                
                App.mnuCancelAnalysePhysique.disable();
            }
        }
    }


</script>


@model Tms.Classes.Business.AnalysePhysique
@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}

@(Html.X().ResourceManager().AjaxTimeout(36000000))

<form id="tms_form">

    @(X.Viewport()
        .Layout(LayoutType.Border)
        .ID("TmsViewPort")
        .Items(
                X.Hidden().ID("BaseUrl").Value(@BaseUrl),
                X.Hidden().ID("AphiddenPermCreer").ReadOnly(true),
                X.Hidden().ID("AphiddenPermModifier").ReadOnly(true),
                X.Hidden().ID("AphiddenPermApprove").ReadOnly(true),
                X.Hidden().ID("AphiddenPermDesactiver").ReadOnly(true),
                X.Hidden().ID("AphiddenPermPrintQualityAverage").ReadOnly(true),
                X.Hidden().ID("AphiddenPermExporterExcel").ReadOnly(true),
                X.Hidden().ID("AphiddenPermOverview").ReadOnly(true),
                X.Hidden().ID("AphiddenPermSuperDesactiver").ReadOnly(true),

            X.Panel()
                .ID("pnlNorth")
                .Region(Region.North)
                .Layout(LayoutType.Border)
                .TopBar(new Toolbar()
                {
                    Items = { X.Button()
                                    .ID("btnFilterAnalysePhysique")
                                    .IconCls("action_filter_02")
                                    .Border(false)
                                    .Cls("ButtonStyle")
                                    .Text(DigitalCoops.Cocoa.Properties.Resources.btnFilter)
                                    .Disabled(false)
                                    .DirectEvents( de =>{
                                        de.Click.Url  = Url.Action("OnFilter");
                                        de.Click.EventMask.ShowMask = true;
                                            }
                                        ),

                            X.Button()
                                    .ID("btnRefreshAnalysePhysique")
                                    .IconCls("action_refresh_01")
                                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnRefresh)                                    
                                    .Border(false)
                                    .Cls("ButtonStyle")
                                    .Disable(false)
                                    .DirectEvents( de =>{
                                                    de.Click.Url  = Url.Action("onRefresh");

                                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodStart", Value= "#{TxtPeriodStart}.getRawValue()",   Mode=ParameterMode.Raw});

                                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemPeriodEnd", Value= "#{TxtPeriodEnd}.getRawValue()",     Mode=ParameterMode.Raw});

                                                    de.Click.ExtraParams.Add(new Parameter {  Name ="ItemStatus", Encode=false, Value= "#{CmbStatutAnalyse}.getValue()",     Mode=ParameterMode.Raw});
                                        de.Click.ExtraParams.Add(new Parameter {  Name ="ItemSite", Encode=true, Value= "#{cmbSite}.getValue()",     Mode=ParameterMode.Raw});

                                                    de.Click.EventMask.ShowMask = true;

                                                    de.Click.Success = "SetCriteriaTitle(App.cmbSite.rawValue,App.CmbStatutAnalyse.rawValue, App.TxtPeriodStart.rawValue, App.TxtPeriodEnd.rawValue);";

                                    } ),

                            X.Button()
                                    .ID("btnNewAnalysePhysique")
                                    .IconCls("action_new_02")
                                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnNew)                                    
                                    .Cls("ButtonStyle")
                                    .Border(false)
                                    .Disable(false)
                                    .DirectEvents( de =>{
                                                    de.Click.Url  = Url.Action("OnAdd");
                                                    de.Click.Success = "App.FormAnalysePhysique.setTitle('Analyse Physique : Nouveau')";
                                                    de.Click.EventMask.ShowMask = true;
                                                }
                                    ),

                             X.Button()
                                    .ID("btnModifyAnalysePhysique")
                                    .IconCls("action_modify_02")
                                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnModify)                                    
                                    .Cls("ButtonStyle")
                                    .Border(false)
                                    .Disabled(true)
                                    .DirectEvents( de =>{
                                                    de.Click.Url  = Url.Action("OnEdit");
                                                    de.Click.Success = "App.FormAnalysePhysique.setTitle('Analyse Physique : Modifier')";
                                                    de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true, Value="#{grpListeAnalysePhysique}.getSelectionModel().getSelection()[0].data"});
                                                    de.Click.EventMask.ShowMask = true;
                                    }
                                    ),

                            X.Button()
                                    .ID("btnApproveAnalysePhysique")
                                    .IconCls("glyphicon glyphicon-ok green")
                                    .Text("Confirmer")
                                    .Cls("ButtonStyle")
                                    .Border(false)
                                    .Disabled(true)
                                    .DirectEvents( de =>{
                                                    de.Click.Url  = Url.Action("onApprove");
                                                    de.Click.Success = "App.FormAnalysePhysique.setTitle('Analyse Physique : Approuver')";
                                                    de.Click.ExtraParams.Add(new Parameter { Name="ItemSelected", Mode=ParameterMode.Raw, Encode=true,Value="#{grpListeAnalysePhysique}.getSelectionModel().getSelection()[0].data"});
                                                    de.Click.EventMask.ShowMask = true;
                                                    //de.Click.Success = "Overview.resetButtons();";
                                                    //de.Click.Confirmation.ConfirmRequest = true;
                                                    //de.Click.Confirmation.BeforeConfirm = "config.confirmation.title = 'Analyse Physique : Approuver'; config.confirmation.message = 'Voulez-vous approuver cette analyse ?'";
                                    }
                                    ),

                            X.SplitButton()
                                    .ID("btnPrint")
                                    .IconCls("action_print_02")
                                    .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)                                    
                                    .Disable(false)
                                    .Cls("ButtonStyle")
                                    .Border(false)
                                    .Menu(new Menu()
                                        {
                                        Items =
                                        {

                                            X.MenuItem()
                                                .ID("mnuPrintAnalysePhysiqueList")
                                                .Text("Analyse Physique")
                                                .DirectEvents
                                                (
                                                    de=>
                                                    {
                                                        de.Click.Url = Url.Action("OnDisplayAnalysePhysiqueCriteria");
                                                        de.Click.EventMask.ShowMask = true;
                                                    }
                                                )

                                            }

                                        })
                                        ,

                            X.ToolbarFill(),

                                 X.Button()
                                        .ID("btnActions")
                                        .Text("Actions")
                                        .Border(false)
                                        .Cls("ButtonStyle")
                                        .IconCls("menu_04")
                                        .Disable(false)
                                 .Menu(new Menu()
                                 {
                                     Items = {
                                         X.MenuItem()
                                                .ID("mnuExportPhysicalAnalysis")
                                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnPrint)                                                
                                                .Icon(Icon.PageExcel)
                                                .Handler("SetExcelList();"),
                                                X.MenuItem()
                                                .ID("mnuCancelAnalysePhysique")
                                                .IconCls("glyphicon glyphicon-remove red")
                                                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)                                                
                                                .Cls("ButtonStyle")
                                                .Border(false)
                                                .Disabled(true)
                                                .DirectEvents(de =>
                                                        {
                                                            de.Click.Url = Url.Action("OnActivateDeactivate");
                                                            de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeAnalysePhysique}.getSelectionModel().getSelection()[0].data" });
                                                            de.Click.EventMask.ShowMask = true;
                                                            de.Click.Confirmation.ConfirmRequest = true;
                                                            de.Click.Confirmation.Title = "Analyse Physique";
                                                            de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListeAnalysePhysique}.getSelectionModel().getSelection()[0].data.Desactive)";
                                                            de.Click.Success = "Overview.resetButtons();";
                                                        })

                                                }
                                        })
                                    }
                })

                                ,
        X.FormPanel()
            .ID("AnalysePhysiqueCriteriaPanel")
            .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Analyse Physique - overview" })
            .Region(Region.North)
            .Floatable(false)
            .Border(false)
            .Collapsed(true)
            .Collapsible(true)
            //.CollapsedCls("panelcollapse")
            .BodyPadding(5)
            .Frame(true)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Start })
            .Items(
                 X.Panel()
                    .Flex(1)
                    .Layout(LayoutType.Form)
                    .Items(
                                X.ComboBox()
                                    .ID("CmbSite")
                                    .FieldLabel("Site")
                                    .DisplayField("Nom")
                                    .ValueField("ID")
                                    .MatchFieldWidth(false)
                                    .ListConfig(new BoundList { MinWidth = 300 })
                                    .LabelAlign(LabelAlign.Right)
                                    .TypeAhead(false)
                                    .QueryMode(DataLoadMode.Local)
                                    .TriggerAction(TriggerAction.All)
                                    .ForceSelection(true)
                                    .Value(ViewBag.SiteParDefaut)
                                    .Store(
                                        X.Store()
                                        //.Listeners(l => l.Load.Handler = "App.CmbSite.setValue(App.CmbSite.getStore().getAt(0));")
                                        .AutoLoad(true)
                                        .Model(
                                                Html.X().Model()
                                                .IDProperty("ID")
                                                .Fields(
                                                            new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                            new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                                        )
                                            )
                                .Proxy(
                                            Html.X().AjaxProxy()
                                            .Url(Url.Action("LoadSiteAll", "Site"))
                                .Reader(
                                            Html.X().JsonReader().RootProperty("data")
                                            )
                                )
                            ),
                                X.ComboBox()
                                    .ID("CmbStatutAnalyse")
                                    .ForceSelection(true)
                                    .FieldLabel("Statut")
                                    .LabelWidth(110)
                                    .TypeAhead(true)
                                    .ForceSelection(true)
                                    .LabelAlign(LabelAlign.Right)
                                    .Value(-1)
                                    .Items(
                                            new ListItem("{Tous}", "-1"),
                                            new ListItem("Saisi", "0"),
                                            new ListItem("Confirmé", "1")
                                        )
                                    //.SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "-1" }); })
                                ),
                 X.Panel()
                    .Flex(1)
                    .Layout(LayoutType.Form)
                    .Items(

                                X.DateField().ID("TxtPeriodStart").FieldLabel("Date Debut").LabelAlign(LabelAlign.Right).Text(""),
                                X.DateField().ID("TxtPeriodEnd").FieldLabel("Date Fin").LabelAlign(LabelAlign.Right).Text("")

                     ),                            

                    X.Panel()
                        .ID("formOverview")
                        .Flex(1)
                        //.TitleConfig(new PanelTitle { Text = "Summary", Cls = "title_font_color" })
                        .Border(false)
                        //.BodyPadding(6)
                        .Layout(LayoutType.HBox)
                        .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                        .Items(
                                    X.Container()
                                        .ID("")
                                        .Layout(LayoutType.VBox)
                                        .LayoutConfig(new VBoxLayoutConfig { Pack = BoxPack.Center })
                                        .Items(
                                                X.Label()
                                                    .ID("LblResumeAnalysePhysique")
