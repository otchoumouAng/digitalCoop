                                                                        .EmptyText("0")
                                                                        .Text("0")
                                                                        .RawText("0")
                                                                        .MaskRe("[0123456789]")
                                                                        .ReadOnly(true)
                                                                        .LabelAlign(LabelAlign.Right)
                                                                        .ID("txtNetWeight")
                                                                        .AllowBlank(false)
                                                                            .IndicatorCls("IndicatorRedStar")
                                                                            .IndicatorText("*")
                                                                        .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._PeseeAvantUsinage.PoidsNet.ToString("#,#") : string.Empty)
                                                                    )
                                                        )
                                    )
    #endregion
                        )


            )
    )
    .Buttons
    (
        X.Button()
            .Text("Finaliser")
            .ID("BtnFinalizeWeight")
            .Disabled(!(bool)ViewData["CanFinalize"])
            .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .DirectEvents(de =>
            {
                de.Click.Url = Url.Action("Finalize");
                de.Click.Before = "return validNew(App.FormPeseeAvantUsinage.id);";
                de.Click.FormID = "#(return this.up('window').down('form');)";
                de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "App.grpListeWeightPAU.getRowsValues({selectedOnly : false})" });
            }),
        X.Button()
            .Text("Ok Et Continuer")
            .ID("BtnOkSecondWeight")
            .Hidden(true)
            //.Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .DirectEvents(de =>
            {
                de.Click.Url = Url.Action("SubmitFormMethod");
                de.Click.Before = "return validNew(App.FormPeseeAvantUsinage.id);";
                de.Click.FormID = "#(return this.up('window').down('form');)";
                de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "App.grpListeWeightPAU.getRowsValues({selectedOnly : false})" });
            }),
        X.Button()
            .Text("Fermer")
            .Handler("App.FormPeseeAvantUsinage.doClose();")
            .Cls("btncancel")
    )
)
@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Erreur : Weighing ', msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }
        
    };

    var enterKeyPressHandler = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            var param = App.txtOrdreProduction.value;
            var baseurl = App.baseUrlVal.value;
            Ext.net.DirectMethod.request({ url: baseurl + "/PeseeAvantUsinage/SubmitOrdreProduction?ItemNumero=" + param });            
            e.stopEvent();

        }
    };
    
    var onSearchByDeliveryID = function (f, e) {
        if (e.getKey() == e.ENTER || e.getKey() === 9) {
            var param = App.txtOrdreProduction.value;
            var baseurl = App.baseUrlVal.value;
            Ext.net.DirectMethod.request({ url: baseurl + "/PeseeAvantUsinage/GetDelivery?ItemNumero=" + param });
            e.stopEvent();
        }
    };

    var CheckFieldsToFill = function () {
        if (App.cmbProduction.value && App.hiddenExecMode.value == 'AddNew')
        {
            App.btnSelectDelivery.enable();
        };

        if (App.cmbProduction.value && App.txtDeliveryNumero.value) {
            App.txtDeliveryNumero.setValue("");
            App.txtNombreSacsDelivery.setValue("");
            App.txtBonDeLivraisonID.setValue("");
        };
    }
</script>






