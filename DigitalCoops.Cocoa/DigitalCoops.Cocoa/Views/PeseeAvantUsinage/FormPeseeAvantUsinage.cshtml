                                                                           //.Disabled(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? true : false)
                                                                           .DirectEvents
                                                                           (
                                                                               de =>
                                                                               {
                                                                                   //de.Click.Url = Url.Action("OnSelectDelivery", "Livraison");
                                                                                   de.Click.Url = Url.Action("OnCaptureTare");
                                                                                   de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "App.grpListeWeightPAU.getRowsValues({selectedOnly : false})" });
                                                                                   //de.Click.EventMask.ShowMask = true;
                                                                               }
                                                                            )
                                                                        ),

                                                                    X.TextField()
                                                                        .FieldLabel("Poids Net")
