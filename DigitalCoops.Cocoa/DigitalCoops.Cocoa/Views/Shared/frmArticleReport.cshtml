@model Tms.Classes.Business.Fournisseur
@{
    Layout = null;
    var X = Html.X();
}

@(

X.Window()
    .ID("frmArticleForReport")
    .Width(420)
    .Resizable(false)
    .Height(240)
    .Modal(true)
    .Y(100)
    .BodyPadding(5)
    .Title(ViewData["Titre"] + " : Critères")
    .Items
    (
        X.FormPanel()
            .Layout(LayoutType.VBox)
            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
            .Items(

                    X.ComboBox()
                        .ID("RPcmbTypeProduit")
                        .FieldLabel("Type Produit")
                        .DisplayField("Designation")
                        .ValueField("ID")
                        .MatchFieldWidth(false)
                        .ListConfig(new BoundList { MinWidth = 300 })
                        .LabelAlign(LabelAlign.Right)
                        .TypeAhead(false)
                        .QueryMode(DataLoadMode.Local)
                        .TriggerAction(TriggerAction.All)
                        .ForceSelection(true)
                        .Value(-1)
                        .Store(
                                X.Store()
                                    .AutoLoad(true)
                                    .Model(
                                            X.Model()
                                                .IDProperty("ID")
                                                .Fields(
                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                )
                                    )
                                    .Proxy(
                                            X.AjaxProxy()
                                                .Url(Url.Action("LoadProduitTypeAll", "ProduitType"))
                                    .Reader(
                                        Html.X().JsonReader().RootProperty("data")
                                        )
                                    )
                        ),

                    X.ComboBox()
                        .ID("RPcmbProduit")
                        .FieldLabel("Produit")
                        .DisplayField("Designation")
                        .ValueField("ID")
                        .MatchFieldWidth(false)
                        .ListConfig(new BoundList { MinWidth = 300 })
                        .LabelAlign(LabelAlign.Right)
                        .TypeAhead(false)
                        .QueryMode(DataLoadMode.Local)
                        .TriggerAction(TriggerAction.All)
                        .ForceSelection(true)
                        .Value(-1)
                        .Store(
                                X.Store()
                                    .AutoLoad(true)
                                    .Model(
                                            X.Model()
                                                .IDProperty("ID")
                                                .Fields(
                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                )
                                    )
                                    .Proxy(
                                            X.AjaxProxy()
                                                .Url(Url.Action("LoadProduitFiniAll", "ProduitFini"))
                                    .Reader(
                                        Html.X().JsonReader().RootProperty("data")
                                        )
                                    )
                        ),

                    X.ComboBox()
                        .ID("RPcmbMarqueProduit")
                        .FieldLabel("Marque Produit")
                        .DisplayField("Designation")
                        .ValueField("ID")
                        .MatchFieldWidth(false)
                        .ListConfig(new BoundList { MinWidth = 300 })
                        .LabelAlign(LabelAlign.Right)
                        .TypeAhead(false)
                        .QueryMode(DataLoadMode.Local)
                        .TriggerAction(TriggerAction.All)
                        .ForceSelection(true)
                        .Value(-1)
                        .Store(
                                X.Store()
                                    .AutoLoad(true)
                                    .Model(
                                            X.Model()
                                                .IDProperty("ID")
                                                .Fields(
                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                )
                                    )
                                    .Proxy(
                                            X.AjaxProxy()
                                                .Url(Url.Action("LoadMarqueProduitAll", "MarqueProduit"))
                                    .Reader(
                                        Html.X().JsonReader().RootProperty("data")
                                        )
                                    )
                        ),
                    X.ComboBox()
                            .ID("RPcmbStatut")
                            .LabelAlign(LabelAlign.Right)
                            .FieldLabel("Statut")
                            .DisplayField("Description")
                            .ValueField("ID")
                            .LabelAlign(LabelAlign.Right)
                            .TypeAhead(true)
                            .ForceSelection(true)
                            .Items
                            (
                                it =>
                                {
                                    it.Add(new ListItem { Text = "{Tous}", Value = "-1" });
                                    it.Add(new ListItem { Text = "Non approuvé", Value = "NA" });
                                    it.Add(new ListItem { Text = "Approuvé", Value = "AP" });
                                    it.Add(new ListItem { Text = "Annulé", Value = "CA" });
                                }
                            )
                            .SelectedItems
                            (
                            it =>
                            {
                                it.Add(new ListItem { Text = "{Tous}", Value = "-1" });
                            }
                            ),

X.ComboBox()
    .ID("RPcmbActif")
    .FieldLabel("Actif/Inactif")
    .LabelAlign(LabelAlign.Right)
    .Editable(false)
    .Store(
        X.Store()
            .ID("storeRPcmbActif")
            .Fields(
                new ModelField("Id", ModelFieldType.String),
                new ModelField("Name", ModelFieldType.String)
            )
            .Data(new object[] {
                new { Id = -1, Name = "{Tous}" },
                new { Id = 0, Name = "Actif" },
                new { Id = 1, Name = "Inactif" }
            })
    )
    .DisplayField("Name")
    .ValueField("Id").SelectedItems
                            (
                            it =>
                            {
                                it.Add(new ListItem { Text = "{Tous}", Value = "-1" });
                            }
                            )
                        )
                )
        
        .Buttons
        (
            X.Button()
                .Text("OK")
                .ID("BtnOk")
                .DirectEvents
                (
                    d =>
                    {
                        d.Click.Url = Url.Action(ViewData["actionToDo"].ToString(), ViewData["ControllerName"].ToString());
                        d.Click.FormID = "#(return this.up('window').down('form');)";
                        
                    }
                ),
            X.Button()
                .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
                .Handler("App.frmArticleForReport.doClose()")
                .Cls("btncancel")
        )

)



