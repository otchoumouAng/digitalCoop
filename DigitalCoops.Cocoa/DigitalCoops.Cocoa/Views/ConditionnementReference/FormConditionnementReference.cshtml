

@model Tms.Classes.Shared.Sales.ConditionnementReferenceViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
@(X.FormPanel()
    .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
    .Items(
            X.Window()
            .ID("FormConditionnementReference")
            .Width(500)
            .Resizable(false)
            .Height(180)
            .CloseAction(Ext.Net.CloseAction.Destroy)
            .Listeners(l =>
            {
                l.Close.Handler = "App.TmsViewPort.unmask();";
                l.Show.Handler = "#{TxtCodeConditionnementReference}.focus()";
            })
            //.X(400)
            .Y(20)
            .Title("Conditionnement Reference : Detail")
            .Layout(LayoutType.Form)
            .Items(
                    X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                    X.Hidden().ID("hiddenRowversion").Value(Model._ConditionnementReference.RowVersionKey),
                    X.Hidden().ID("TxtConditionnementReferenceID").Value(Model._ConditionnementReference.ID),
                   X.TextField().ID("TxtReferenceConditionnementReference").FieldLabel("Reference")
                    .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ConditionnementReference.Reference.ToString() : string.Empty)
                    .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                   ,


                    X.ComboBox().ID("CmbConditionnementProduit").FieldLabel("Conditionnement")
                    .DisplayField("Designation")
                    .ValueField("ID")
                    .TypeAhead(true)
                    .ForceSelection(true)
                    .AllowBlank(false)
                    .LabelAlign(LabelAlign.Right)
                    .TriggerAction(TriggerAction.All)
                    .SelectOnFocus(true)
                    .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ConditionnementReference.ConditionnementProduit.ID : 0)
                     .Store
                (
                   X.Store()
                        .AutoLoad(true)
                        .Model
                        (
                          X.Model()
                              .IDProperty("ID")
                              .Fields
                              (
                                new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                              )
                         )
                        .Proxy
                         (
                           Html.X().AjaxProxy()
                               .Url(Url.Action("Load", "ConditionnementProduit"))
                               .Reader(Html.X().JsonReader().RootProperty("data"))
                         )
                  ),


                   X.TextField().ID("TxtDescriptionConditionnementReference").FieldLabel("Description")
                    .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ConditionnementReference.Description.ToString() : string.Empty)
                    .LabelAlign(LabelAlign.Right).AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
            )
            .Buttons(
                X.Button()
                .Text("OK")
                .ID("BtnSubmitConditionnementReference")
                .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                .DirectEvents(de =>
                {
                    de.Click.Url = Url.Action("SubmitFormMethod");
                    de.Click.Before = "return validNew(App.FormConditionnementReference.id);";
                }),
                X.Button()
                .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                .Handler("App.FormConditionnementReference.doClose()").Cls("btncancel")

                )

            )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'ConditionnementReference Reference : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }


    };


</script>











