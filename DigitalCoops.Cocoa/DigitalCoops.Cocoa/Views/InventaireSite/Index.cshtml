<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeInventaire.columnManager.getColumns(), App.grpListeInventaire.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return  'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }
        },

        SummaryIV: function () {
            var nbrOfrows = App.grpListeInventaire.getStore().getCount();
            var totalNet = App.storeListeInventaire.sum('PoidsNetAccepte') || 0;

            totalNet = FormatAmount(totalNet);
            App.lblSummaryInventaire.setHtml("Nbre Inventaire : "+ nbrOfrows);
        },

        resetButtons: function () {

            App.btnCancel.disable();
            App.btnApprove.disable();
            App.btnAjust.disable();
            App.mnuPrintStockInventory.disable();
            if (App.rowInventaire.hasSelection()) {

                var isDesactive = App.rowInventaire.selected.items[0].data.Desactive;
                var isFinalized = App.rowInventaire.selected.items[0].data.EstFinalise;

                if (isDesactive === false) {

                    if (App.ivhiddenPermPrintInventory.value == 'true')
                        App.mnuPrintStockInventory.enable();

                    if (App.ivhiddenPermDesactiver.value == 'true' && isFinalized === false)
                        App.btnCancel.enable();

                    if (App.ivhiddenPermApprove.value == 'true' && isFinalized === false)
                        App.btnApprove.enable();

                    if (App.ivhiddenPermAjust.value == 'true' && isFinalized === false)
                        App.btnAjust.enable();
                }
                else {
                    App.btnCancel.disable();
                    App.btnApprove.disable();
                    App.btnAjust.disable();
                    App.mnuPrintStockInventory.disable();
                }

            }
        }
    }

</script>

