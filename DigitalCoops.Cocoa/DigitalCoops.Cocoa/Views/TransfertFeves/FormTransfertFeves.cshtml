            border-bottom-width: 0px !important;
        }
    </style>
    <script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
    <script type="text/javascript">
        var GetNbrOfPallets = function () {
            var nbrOfrows = App.grpListeBL.getStore().getCount();
            App.txtNombrePalette.setValue(nbrOfrows);

            /* set Fields to ReadOnly*/
            if (nbrOfrows > 0) {                
                App.btnAddNewLivraison.disable();
                App.PanelBtnSave.hide();
                /*App.BtnAddWeight.enable();*/
            } else {                
                App.btnAddNewLivraison.enable();
                App.PanelBtnSave.show();
                /*App.BtnAddWeight.disable();*/
            }
        };

      var CalculateValues = function () {
          var totalNbrSacs = App.storeListeBL.sum('NombreSacs') || 0;
          var totalPoidsBrut = App.storeListeBL.sum('PoidsBrut') || 0;
          var totaTare = App.storeListeBL.sum('TareSacs') || 0;
          var totalPrix = App.storeListeBL.sum('PrixMoyen') || 0;
          var totalMontant = App.storeListeBL.sum('Montant') || 0;
          var nbrOfrows = App.grpListeBL.getStore().getCount();

          if (nbrOfrows > 0) {
              totalPrix = (totalMontant / totalPoidsBrut);
              totalPrix = parseFloat(totalPrix).toFixed(2) || 0;
              if (totalPrix > 0)
                  totalPrix = totalPrix.replace('.', ',');
          }

          App.txtNombreSacs.setValue(formatNumber(totalNbrSacs));
          App.txtPoidsBrut.setValue(formatNumber(totalPoidsBrut));
          App.txtTareSacs.setValue(formatNumber(totaTare));
          /*App.txtPrixMoyen.setValue(formatNumber(totalPrix));*/
          App.txtPrixMoyen.setValue(totalPrix);
      };

      var CalculateNetWeight = function () {
          var totalNbrSacs = App.storeListeBL.sum('NombreSacs') || 0;
          var totalPoidsBrut = App.storeListeBL.sum('PoidsBrut') || 0;
          var tareSacs = App.storeListeBL.sum('TareSacs') || 0;
          /*var tareSacs = App.txtTareSacs.value;*/
          var tarePalettes = App.txtTarePalettes.value;
          if (App.txtTarePalettes.value != "0")
              tarePalettes = parseFloat(unformatNumber(App.txtTarePalettes.value)) || 0;


          var netWeight = parseFloat(totalPoidsBrut) - parseFloat(tareSacs) - parseFloat(tarePalettes);          
          App.txtNetWeight.setValue(formatNumber(netWeight));
      };

      var CheckChangedData = function () {          
          /*var totalNbrSacs = App.storeTransferList.sum('NombreSacs') || 0;
          var totalPoidsBrut = App.storeTransferList.sum('PoidsBrut') || 0;
          
          var fldNbrSacs = unformatNumber(App.txtNombreSacs.value) || 0;
          var fldPoidsBrut = unformatNumber(App.txtPoidsBrut.value) || 0;
          
          if (totalNbrSacs != fldNbrSacs || totalPoidsBrut != fldPoidsBrut)*/
              App.btnResumeTransfert.fireEvent('click', App.btnResumeTransfert);
          
      };

      var RoundInt = function (v) {
          try {
              if ((parseFloat(v) - parseInt(v)) > 0.5) {
                  return parseInt(v) + 1;
              }
              else {
                  return parseInt(v);
              }
          } catch (err) {
              return 0;
          }
      };
    </script>

