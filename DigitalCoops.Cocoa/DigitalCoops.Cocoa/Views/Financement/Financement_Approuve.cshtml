<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Financement : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }
        var rate = parseInt(App.txtTauxPaiement.value) || '';
        if ((rate < 0) || (rate > 100)) {

            Ext.Msg.show({ title: 'Financement : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Payment Rate must between 0 and 100 %.', buttons: Ext.Msg.OK });
            return false;
        }
    };

    var setCtrlIsRequired = function (field, value) {
        field.allowBlank = !value;

        field.setIndicator("");
        field.setIndicatorCls('');
        field.showIndicator();

        if (value == true) {

            field.setIndicator("*");
            field.setIndicatorCls('IndicatorRedStar');
            field.showIndicator();
        }
    };

    var DefinirEngagement = function (record) {
        setCtrlIsRequired(App.cmbEngagement, false);
        App.cmbEngagement.setReadOnly(true);
        var Engagement_Type = App.hiddenTypeEngagement.value;

        if (record.ID == Engagement_Type) {
            App.cmbEngagement.getStore().load();
            setCtrlIsRequired(App.cmbEngagement, true);
            App.cmbEngagement.setReadOnly(false);
        }
    };

    var TypeIndexChanged = function (item) {
        var Advance_Type = App.hiddenTypeAvance.value;
        var Engagement_Type = App.hiddenTypeEngagement.value;
        App.txtStartDate.setHidden(true);
        if (App.hiddenExecMode.value.toString() != "Consult" && App.hiddenExecMode.value.toString() != "Approve")
        {
            if (item == Advance_Type || item == Engagement_Type) {
                App.txtTonnage.setReadOnly(false);
                App.txtTonnage.allowBlank = (false);
                App.txtTonnage.setIndicator("*");

                if (item == Advance_Type) {
                    App.txtPrice.setReadOnly(false);
                    App.txtDueDate.setReadOnly(false);
                }
                else {
                    App.txtPrice.setReadOnly(true);
                    App.txtDueDate.setReadOnly(true);
                }

                /*if (App.hiddenExecMode.value.toString() == "Update")
                    App.cmbEngagement.setReadOnly(false);*/

                App.txtPrice.allowBlank = (false);
                App.txtPrice.setIndicator("*");

                App.txtGrossAmount.setReadOnly(true);
                App.txtGrossAmount.allowBlank = (false);
                App.txtGrossAmount.setIndicator("*");

             }
            else if (Ext.isNumeric(item)) {

                App.txtTonnage.setReadOnly(true);
                App.txtTonnage.allowBlank = (true);
                App.txtTonnage.validate();
                App.txtTonnage.setIndicator("");
                App.txtTonnage.setValue("");

                App.txtPrice.setReadOnly(true);
                App.txtPrice.allowBlank = (true);
                App.txtPrice.validate();
                App.txtPrice.setIndicator("");
                App.txtPrice.setValue("");

                App.txtGrossAmount.setReadOnly(false);
                App.txtGrossAmount.allowBlank = (false);
                App.txtGrossAmount.validate();
                App.txtGrossAmount.setIndicator("*");

                App.txtDueDate.setReadOnly(false);
                App.txtDueDate.validate();

                App.cmbEngagement.setReadOnly(true);
                App.cmbEngagement.allowBlank = (true);
                App.cmbEngagement.validate();
            }
        }
        else
        {
            App.txtPrice.setReadOnly(true);
            App.txtTonnage.setReadOnly(true);
            App.txtDate.setReadOnly(true);
            App.txtDueDate.setReadOnly(true);
            App.txtGrossAmount.setReadOnly(true);
        }

    };

    var EngagementIndexChanged = function (item) {
        console.log(parseFloat(App.cmbEngagement.getSelectedRecord().data.Balance));
        App.txtStartDate.setHidden(true);
        var Engagement_Type = App.hiddenTypeEngagement.value;
        if (App.hiddenExecMode.value.toString() != "Consult") {
            if (item == Engagement_Type) {

                var prix = parseFloat(App.cmbEngagement.getSelectedRecord().data.Prix) || (unformatNumber(App.txtPrice.value) || 0);
                App.txtPrice.setValue(formatNumber(prix));
                App.txtStartDate.setHidden(false);
                App.txtStartDate.setValue(App.cmbEngagement.getSelectedRecord().data.DateDebut);
                App.txtDueDate.setValue(App.cmbEngagement.getSelectedRecord().data.DateEcheance);
            }
        }
        else {
            App.txtPrice.setReadOnly(true);
            /*App.txtTonnage.setReadOnly(true);*/
            App.txtGrossAmount.setReadOnly(true);
            App.txtStartDate.setHidden(true);
        }

    };


    var ReimbModeIndexChanged = function (item) {
        var PerKg = App.hiddenModeRemboursementAuKilo.value;
        var Complete_Refund = App.hiddenModeRemboursementIntegral.value;
        var Fixed_Amount = App.hiddenModeRemboursementFixedAmount.value;

        if (App.hiddenExecMode.value.toString() != "Consult")
        {
            if (item == PerKg || item == Fixed_Amount) {
                App.txtTauxRemboursement.setReadOnly(false);
                App.txtTauxRemboursement.allowBlank = (false);

            }
            else if (Ext.isNumeric(item)) {
                var Amount = App.txtAmount.value || '';
                App.txtTauxRemboursement.setReadOnly(true);
                App.txtTauxRemboursement.validate();

                if (item == Complete_Refund)
                    App.txtTauxRemboursement.setValue(Amount);
                else
                    App.txtTauxRemboursement.setValue("0");
            }

        }
        else
        {
            App.txtTauxRemboursement.setReadOnly(true);
        }


    };


    var CalculateAmount = function () {

        try
        {
            var Type = App._cmbType.value;
            if (Type == App.hiddenTypeAvance.value || Type == App.hiddenTypeEngagement.value)
            {
              var Price = unformatNumber(App.txtPrice.value) || '';
              var Tonnage = unformatNumber(App.txtTonnage.value) || '';
              var Amount = '';

              App.txtGrossAmount.setValue('');

              if (Ext.isNumeric(Price) && Ext.isNumeric(Tonnage))
              {
                  App.txtGrossAmount.setValue('0');
                Amount = RoundInt(Price * Tonnage);
                App.txtGrossAmount.setValue(formatNumber(Amount));

                ReimbModeIndexChanged(App.cmbPrelevementType.value);

              }
            }


        }
        catch (err) {
            Ext.Msg.show({ title: 'Financement : Amount Calculation ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating amount.', buttons: Ext.Msg.OK });

        }

    };


    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

    var CalculateFinalAmount = function () {

        try {
            App.txtAmount.setValue('0');

            var tauxPaiment = parseFloat(App.txtTauxPaiement.rawValue.replace(',', '.')) || 0;

            if (tauxPaiment != '') {
                var grossAmount = parseFloat(unformatNumber(App.txtGrossAmount.value)) || 0;
                var Amount = 0;

                if (Ext.isNumeric(tauxPaiment) && Ext.isNumeric(grossAmount)) {

                    Amount = RoundInt((grossAmount * tauxPaiment) / 100);
                    App.txtAmount.setValue(formatNumber(Amount));
                    ReimbModeIndexChanged(App.cmbPrelevementType.value);
                }
            }


        }
        catch (err) {
            Ext.Msg.show({ title: 'Financement : Amount Calculation ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating Final amount.'+ err, buttons: Ext.Msg.OK });

        }

    };

</script>

