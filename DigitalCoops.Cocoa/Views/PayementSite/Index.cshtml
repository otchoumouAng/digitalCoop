@Scripts.Render("~/bundles/CommonScripts")
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListePayement.columnManager.getColumns(), App.grpListePayement.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var SetCriteriaTitle = function (site,cropyear, fournisseur, type, begin, end, status) {

        App.CriteriaPanelPayement.title = "";
        var texttitle = "";
        if (site) texttitle += "Site : " + site + " | ";
        if (cropyear) texttitle += "Campagne : " + cropyear + " | ";

        if (fournisseur) texttitle += "Fournisseur : " + fournisseur + " | ";

        if (type) texttitle += "Type de Paiement : " + type + " | ";

        if (begin) texttitle += "Du : " + begin;

        if (end) texttitle += " Au : " + end + " |";

        if (status) texttitle += "Statut : " + status;

        App.CriteriaPanelPayement.setTitle(texttitle);
    }

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderNameAndCode = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.NameAndCode)
                return value.NameAndCode;
        }

        return value;
    }


    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);


        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
        },
        resetButtons: function () {

            if (App.rowSelectionListePayement.hasSelection()) {

                if (App.PahiddenPermPrintCopyOfPayment.value == 'true')
                    App.mnuPrintVoucher.enable();

                if (App.PahiddenPermPrintCopyOfPaymentDet.value == 'true')
                    App.mnuPrintVoucherDet.enable();

                if (App.PahiddenPermDesactiver.value == 'true')
                    App.mnuCancelPayement.enable();

                var isDisabled = App.rowSelectionListePayement.selected.items[0].data.Desactive;

                if (isDisabled === true) {
                    App.mnuPrintVoucher.disable();
                    App.mnuCancelPayement.disable();
                    App.mnuPrintVoucherDet.disable();
                    /*App.mnuCancelPayement.setText('Activer');
                    App.mnuCancelPayement.setIconCls('glyphicon glyphicon-ok green');*/
                }
                else {
                    if (App.PahiddenPermPrintCopyOfPayment.value == 'true')
                        App.mnuPrintVoucher.enable();

                    App.mnuCancelPayement.setText('Annuler');
                    App.mnuCancelPayement.setIconCls('glyphicon glyphicon-remove red');
                }

            } else {

                App.mnuPrintVoucher.disable();
                App.mnuCancelPayement.disable();
                App.mnuPrintVoucherDet.disable();
            }
        }
    }


</script>


