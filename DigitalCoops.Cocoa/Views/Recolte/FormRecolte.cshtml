
@model Tms.Classes.Shared.RecolteViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
@(X.FormPanel()
        .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
        .Items(
                X.Window()
                .ID("FormRecolte")
                .Width(500)
                .Resizable(false)
                .Height(180)
                .CloseAction(Ext.Net.CloseAction.Destroy)
                .Listeners(l =>
                {
                    l.Close.Handler = "App.TmsViewPort.unmask();";
                    l.Show.Handler = "#{TxtDesignationRecolte}.focus();";
                })
                //.X(400)
                .Y(20)
                .Title("Crop Quality : Detail")
                .BodyPadding(10)
                .Layout(LayoutType.VBox)
                .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Center })
                    .Items(
                            X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                            X.Hidden().ID("hiddenRowversion").Value(Model._Recolte.RowVersionKey),
                            X.Hidden().ID("TxtRecolteID").Value(Model._Recolte.ID),

                            X.TextField()
                                .ID("TxtDesignationRecolte")
                                .FieldLabel("Designation")
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Recolte.Designation.ToString() : string.Empty)
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*"),
                            X.TextField()
                                .ID("TxtAbreviationRecolte")
                                .FieldLabel("Abbreviation")
                                .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._Recolte.Abreviation.ToString() : string.Empty)
                                .LabelAlign(LabelAlign.Right)
                                .AllowBlank(false)
                                .IndicatorCls("IndicatorRedStar")
                                .IndicatorText("*")

                    )
            .Buttons(
                X.Button()
                .Text("OK")
                .ID("BtnSubmitRecolte")
                .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
                .DirectEvents(de =>
                {
                    de.Click.Url = Url.Action("SubmitFormMethod");
                    de.Click.Before = "return validNew(App.FormRecolte.id);";
                })

                    ,
                X.Button()
                .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                .Handler("App.FormRecolte.doClose()").Cls("btncancel")

                )

            )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({ title: 'Crop Quality : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }


    };


</script>










