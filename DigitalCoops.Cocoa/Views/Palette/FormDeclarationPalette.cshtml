@model Tms.Classes.Shared.PaletteViewModel
@{
    Layout = null;
    var X = Html.X();
}

<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>

<style>
    /* Header vert clair */
    /*.x-window-header {
        background-color: #2ecc71 !important;
        background-image: none !important;
        border-bottom: 1px solid #2ecc71 !important;
    }*/

    /* Conteneur principal avec défilement global */
    .global-scroll-container {
        overflow-y: auto;
        padding: 15px 20px;
        height: calc(100% - 50px);
    }

    /* Conteneur des zones */
    .form-container {
        display: flex;
        gap: 30px;
        min-height: min-content;
    }

    /* Zones de formulaire */


    /* En-têtes de zone */
    .zone-header {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 15px;
        padding-bottom: 8px;
        border-bottom: 1px solid #eaeff2;
        font-size: 14px;
    }

    /* Éléments de formulaire */
    .x-form-item {
        margin-bottom: 16px;
    }

    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 180px !important;
        color: #546e7a;
        font-weight: 500;
    }

    /* Boutons */
    .button-container {
        display: flex;
        justify-content: flex-end;
