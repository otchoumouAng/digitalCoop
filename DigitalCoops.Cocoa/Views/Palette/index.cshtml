                      .DirectEvents(de =>{
                          de.Click.Url  = Url.Action("OnFilter");
                          de.Click.EventMask.ShowMask = true;
                      }),

                     X.Button()
                      .ID("btnRefreshPalette")
                      .IconCls("action_refresh_01")
                      .Text("Actualiser")
                      .Border(false)
                      .Cls("ButtonStyle")
                      .Disable(false)
                      .DirectEvents(de =>{
                          de.Click.Url  = Url.Action("onRefresh");
                          de.Click.ExtraParams.Add(new Parameter {  Name ="ItemAnnee", Value= "#{cmbAnne}.getValue()",     Mode=ParameterMode.Raw});
                          de.Click.ExtraParams.Add(new Parameter {  Name ="ItemSemaine", Value= "#{cmbSemaine}.getValue()",     Mode=ParameterMode.Raw});
                          de.Click.ExtraParams.Add(new Parameter {  Name ="ItemProduit", Value= "#{cmbProduit}.getValue()",     Mode=ParameterMode.Raw});
                          de.Click.ExtraParams.Add(new Parameter {  Name ="ItemProduitType", Value= "#{cmbProduitType}.getValue()",     Mode=ParameterMode.Raw});
