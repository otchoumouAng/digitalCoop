                          Items = {
                              X.MenuItem()
                                .ID("mnuExportListPalette")
                                .Text("Exporter")
                                .Icon(Icon.PageExcel)
                                .Handler("SetExcelList();"),
                              X.MenuItem()
                                .ID("mnuCancelPalette")
                                .IconCls("glyphicon glyphicon-remove red")
                                .Text("Annuler")
                                .Cls("ButtonStyle")
                                .Border(false)
                                .Disabled(true)
                                .DirectEvents(de =>
                                {
                                    de.Click.Url = Url.Action("OnActivateDeactivate");
                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListePalette}.getSelectionModel().getSelection()[0].data" });
                                    de.Click.EventMask.ShowMask = true;
                                    de.Click.Confirmation.ConfirmRequest = true;
                                    de.Click.Confirmation.Title = "Location";
                                    de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListePalette}.getSelectionModel().getSelection()[0].data.Desactive)";
