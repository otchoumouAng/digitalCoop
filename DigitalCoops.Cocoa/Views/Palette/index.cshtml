                           .TypeAhead(true)
                           .QueryMode(DataLoadMode.Local)
                           .TriggerAction(TriggerAction.All)
                           .DisplayField("Year")
                           .ValueField("Year")
                           .Value(currentYear)
                           .Store(
                               X.Store()
                                .AutoLoad(true)
                                .DataSource(years)
                                .Model(Html.X().Model().IDProperty("Year").Fields(new ModelField("Year")))
                           ),

