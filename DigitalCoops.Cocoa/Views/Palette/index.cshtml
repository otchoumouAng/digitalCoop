                      .ID("btnNewPalette")
                      .Icon(Icon.BrickAdd)
                      .Text("Déclarer une palette")
                      .Cls("ButtonStyle")
                      .Border(false)
                      .Disable(false)
                      .DirectEvents(de =>{
                          de.Click.Url  = Url.Action("OnAdd");
                          de.Click.EventMask.ShowMask = true;
                      }),

                     X.Button()
                      .ID("btnModifyPalette")
                      .IconCls("action_modify_02")
                      .Text("Modifier")
                      .Cls("ButtonStyle")
                      .Border(false)
