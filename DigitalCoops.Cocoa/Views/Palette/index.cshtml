             .ID("PaletteCriteriaPanel")
             .TitleConfig(new PanelTitle { Cls = "title_font_color", Text = "Location - overview" })
             .Region(Region.North)
             .Floatable(false)
             .Border(false)
             .Collapsed(true)
             .Collapsible(true)
             .CollapsedCls("panelcollapse")
             .BodyPadding(8)
             .Frame(true)
             .Layout("VBox")
             .Items(
                // Ligne principale : 2 colonnes (HBox)
