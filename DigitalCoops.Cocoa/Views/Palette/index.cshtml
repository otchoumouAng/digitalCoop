<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListePalette.columnManager.getColumns(), App.grpListePalette.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return '';
    };

    var GetNbrStoreRows = function () {
        var nbr = App.grpListePalette.getRowsValues().length;
        App.LblResumePalette.setText(nbr + ' Location(s)');
    };

    var SetCriteriaTitle = function (status) {
        App.PaletteCriteriaPanel.title = "";
        var texttitle = "";

        if (status) texttitle += "Show only active Locations : YES ";
        else texttitle += "Show only active Locations : NO ";

        App.PaletteCriteriaPanel.setTitle(texttitle);
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }

    var iconRenderer = function (value, metaData, record) {
        metaData.css = Overview.getIcons(value);
    }

    var Overview = {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';
            }
            else if (value == 1) {
                return 'action_approve_02';
            }
            else if (value == 2) {
                return 'action_new_02';
            }
            return '';
        },

        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            return '';
        },
        resetButtons: function () {
            var hasSel = App.rowSelectionPalette.hasSelection();

            // 1) Modifier
            if (hasSel && App.PalettehiddenPermModifier.value === 'true') {
                App.btnModifyPalette.enable();
            } else {
                App.btnModifyPalette.disable();
            }

            // 2) Activer / Annuler (mnuCancelPalette)
            if (hasSel && App.PalettehiddenPermDesactiver.value === 'true') {
                App.mnuCancelPalette.enable();
            } else {
                App.mnuCancelPalette.disable();
            }

            if (hasSel) {
                var isDisabled = App.rowSelectionPalette.selected.items[0].data.Desactive;
                if (isDisabled) {
                    if (App.PalettehiddenPermActiver.value === 'true') {
                        App.mnuCancelPalette.enable();
                    }
                    App.mnuCancelPalette.setText('Activer');
                    App.mnuCancelPalette.setIconCls('glyphicon glyphicon-ok green');
                    App.btnModifyPalette.disable();
                } else {
                    App.mnuCancelPalette.setText('Annuler');
                    App.mnuCancelPalette.setIconCls('glyphicon glyphicon-remove red');
                    if (App.PalettehiddenPermModifier.value === 'true') {
                        App.btnModifyPalette.enable();
                    }
                }
            }

            // 3) Fermer
            if (hasSel && App.PalettehiddenPermFermer.value === 'true') {
                App.btnClose.enable();
            } else {
                App.btnClose.disable();
            }

            // 4) Ouvrir
            if (hasSel && App.PalettehiddenPermOuvrir.value === 'true') {
                App.btnOpen.enable();
            } else {
                App.btnOpen.disable();
            }
        }
    };

    var renderIcon = function (value) {
        // Convertir le booléen en valeur numérique attendue par getBootStrapIcons
        var iconValue = value ? 0 : 2; // true (désactivé) -> 0, false (activé) -> 2
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';
        var icon_url = Overview.getBootStrapIcons(iconValue);
        return Ext.String.format(tpl, icon_url);
    };


</script>

@model Tms.Classes.Shared.Palette
@using System.Globalization

@{
    Layout = null;
    var X = Html.X();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}

@{
    // date courante
    var now = DateTime.Now;
    var currentYear = now.Year;

    var years = Enumerable
        .Range(DateTime.Now.Year - 4, 5)
        .Select(y => new { Year = y })
        .ToList();

    // Calendrier ISO (semaine commençant le lundi, règle des 4 jours)
    var cal = CultureInfo.InvariantCulture.Calendar;
    var currentWeek = cal.GetWeekOfYear(now, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday);

    // Calcul du nombre de semaines de l'année courante (52 ou 53)
    var weekOfDec31 = cal.GetWeekOfYear(new DateTime(currentYear, 12, 31),
                                        CalendarWeekRule.FirstFourDayWeek,
                                        DayOfWeek.Monday);
    var weeksCount = (weekOfDec31 == 1) ? 52 : weekOfDec31;

    var weeks = Enumerable.Range(1, weeksCount)
                          .Select(w => new { Week = w })
                          .ToList();
    
}

@(Html.X().ResourceManager())

<form id="tms_form">

