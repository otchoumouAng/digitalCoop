<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeMouvementStockProduit.columnManager.getColumns(), App.grpListeMouvementStockProduit.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    // MODIFICATION ICI: La fonction renderIcon pour gérer plusieurs icônes
    var renderIcon = function (value, metaData, record) {
        var icons = [];

        // Icône de désactivation
        if (record.get('Desactive') === true) {
            icons.push('<span class="glyphicon glyphicon-remove icon-cross" aria-hidden="true" data-qtip="Désactivé"></span>');
        }

        // Icône de sens
        if (record.get('Sens') === 1) { // Sens Entrée
            icons.push('<span class="glyphicon glyphicon-arrow-right icon-arrow-right" aria-hidden="true" data-qtip="Entrée"></span>');
        } else if (record.get('Sens') === -1) { // Sens Sortie
            icons.push('<span class="glyphicon glyphicon-arrow-left icon-arrow-left" aria-hidden="true" data-qtip="Sortie"></span>');
        }

        return icons.join(' '); // Affiche les icônes côte à côte
    }


    var Overview =
    {
        // Supprimons cette fonction car renderIcon la remplace
        /*
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value === 1) {
                return 'glyphicon-arrow-right blue';
            }
            else if (value == -1) {
                return 'glyphicon-arrow-left green';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
        },
        */
        SummaryPanelMouvement: function (){
            App.MouvementStockProduitCP.setTitle('Magasin : ' + App.cmbFiltreMagasin.rawValue + ', Production : ' + App.cmbFiltreProduction.rawValue + ', Article : ' + App.cmbFiltreArticle.rawValue + ', Type : ' + App.cmbFiltreMouvementType.rawValue + ', Dir : ' + App.cmbFiltreDirection.rawValue + ', Statut : ' + App.CmbFiltreStatut.rawValue);
        },

        SummaryMouvement: function () {
            var nbrOfrows = App.grpListeMouvementStockProduit.getStore().getCount();
            var totalUnitesEntree = App.storeListeMouvementStockProduit.sum('TotalUnitesEntree') || 0;
            var totalUnitesSortie = App.storeListeMouvementStockProduit.sum('TotalUnitesSortie') || 0;
            var totalPoidsNetEntree = App.storeListeMouvementStockProduit.sum('TotalPoidsNetEntree') || 0;
            var totalPoidsNetSortie = App.storeListeMouvementStockProduit.sum('TotalPoidsNetSortie') || 0;

            var soldeUnites = totalUnitesEntree - totalUnitesSortie;
            var soldePoidsNet = totalPoidsNetEntree - totalPoidsNetSortie;

            totalUnitesEntree = FormatAmount(totalUnitesEntree);
            totalUnitesSortie = FormatAmount(totalUnitesSortie);
            totalPoidsNetEntree = FormatAmount(totalPoidsNetEntree);
            totalPoidsNetSortie = FormatAmount(totalPoidsNetSortie);
            soldeUnites = FormatAmount(soldeUnites);
            soldePoidsNet = FormatAmount(soldePoidsNet);

            App.lblSummaryMouvement.setHtml("Nbr de Mvt : " + nbrOfrows + "<br/>Unités (Entrée/Sortie) : " + totalUnitesEntree + " / " + totalUnitesSortie + "<br/>Poids Net (Entrée/Sortie) : " + totalPoidsNetEntree + " / " + totalPoidsNetSortie + "<br/>Solde Unités : " + soldeUnites + "<br/>Solde Poids Net (Kg) : " + soldePoidsNet);
        },

        resetButtons: function () {
            // MODIFICATION ICI: Logique pour le bouton Annuler/Réactiver
            App.btnCancel.disable();
            App.btnCancel.setText("Annuler"); // Texte par défaut
            App.btnCancel.setIcon(Ext.Net.Icon.Cross); // Icône par défaut

            App.btnChangePosition.disable();

            if (App.rowMouvementStockProduit.hasSelection()) {
                var selectedRecord = App.rowMouvementStockProduit.selected.items[0];
                var isDesactive = selectedRecord.data.Desactive;

                if (App.mvhiddenPermDesactiver.value === 'true') { // Vérifie la permission de désactiver
                    App.btnCancel.enable();
                    if (isDesactive === true) {
                        App.btnCancel.setText("Réactiver");
                        App.btnCancel.setIcon(Ext.Net.Icon.ArrowRefresh); // Icône pour réactiver
                    } else {
                        App.btnCancel.setText("Annuler");
                        App.btnCancel.setIcon(Ext.Net.Icon.Cross); // Icône pour annuler
                    }
                }

                if (App.mvhiddenPermChangePosition.value === 'true') {
                    // Seulement si l'élément n'est PAS désactivé, on peut changer la position
                    if (isDesactive === false) {
                        App.btnChangePosition.enable();
                    }
                }
            }
        }
    }

    // MODIFICATION ICI: Fonction pour le message de confirmation
    var SetMsgBoxConfirm = function (config, isDesactive) {
        var msg = "";
        if (isDesactive === true) {
            msg = "Voulez-vous vraiment réactiver ce mouvement ?";
            config.title = "Réactivation Mouvement Stock";
        } else {
            msg = "Voulez-vous vraiment annuler (désactiver) ce mouvement ?";
            config.title = "Annulation Mouvement Stock";
        }
        config.message = msg;
        return true;
    };


</script>

