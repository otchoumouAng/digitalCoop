@model Tms.Classes.Shared.OrdreFabricationViewModel
@{
    Layout = null;
    var X = Html.X();

    // Logique pour définir le titre de la fenêtre dynamiquement
    var windowTitle = "Ordre de production";
    switch (Model._ExecMode)
    {
        case Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew:
            windowTitle += " - Nouveau";
            break;
        case Tms.Components.Settings.EnumsDefinition.eExecMode.Update:
            windowTitle += " - Modification";
            break;
        case Tms.Components.Settings.EnumsDefinition.eExecMode.Consult:
            windowTitle += " - Consultation";
            break;
    }
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>

<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 140px !important;
    }

    .x-form-text-default.x-form-textarea {
        line-height: 17px;
        min-height: 50px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
@(
X.Window()
    .ID("FormOrdreFabrication")
    .Width(750)
    .Resizable(false)
    .Height(380)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Title(windowTitle)
    .Items
    (
        X.FormPanel()
            .Layout(LayoutType.HBox)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Top, Pack = BoxPack.Center })
            .FieldDefaults(d => d.ReadOnly = Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? true : false)
            .Items(
    #region Zone A
                        X.Panel()
                            .Layout(LayoutType.Form)
                            .Flex(1)
                            .Items
                            (
                                    X.Hidden()
                                        .ID("hiddenExecMode")
                                        .ReadOnly(true)
                                        .Value(Model._ExecMode),
                                    X.Hidden()
                                        .ID("txtOrdreFabricationID")
                                        .ReadOnly(true)
                                        .Value(Model._OrdreFabrication.ID),
                                    X.TextField()
                                        .ID("txtNumeroProduction")
                                        .ReadOnly(true)
                                        .Text(Model._OrdreFabrication.NumeroProduction)
                                        .FieldLabel("Production N°")
                                        .LabelAlign(LabelAlign.Right),

                                    X.ComboBox()
                                        // CORRECTION : ID unique pour éviter les conflits
                                        .ID("cmbArticleModal")
                                        .FieldLabel("Article")
                                        .DisplayField("Nom")
                                        .ValueField("ID")
                                        .AllowBlank(false)
                                        .IndicatorCls("IndicatorRedStar")
                                        .IndicatorText("*")
                                        .QueryMode(DataLoadMode.Local)
                                        .TriggerAction(TriggerAction.All)
                                        .LabelAlign(LabelAlign.Right)
                                        // CORRECTION : Ajout de l'opérateur ?. pour la sécurité
                                        .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._OrdreFabrication.Article?.ID : (Guid?)null)
                                        .Store
                                            (
                                            X.Store()
                                            .AutoLoad(true)
                                            .Model
                                            (
                                                Html.X().Model()
                                                    .IDProperty("ID")
                                                    .Fields
                                                    (
                                                        new ModelField("ID", ModelFieldType.String),
                                                        new ModelField("Nom", ModelFieldType.String)
                                                    )
                                                )
                                                .Proxy
                                                (
                                                    Html.X().AjaxProxy()
                                                .Url(Url.Action("LoadAll", "Article"))
                                                .Reader(Html.X().JsonReader().RootProperty("data"))
                                                )

                                            )
                                            ,

                                    X.ComboBox()
                                        .ID("cmbLigneProduction")
                                        .FieldLabel("Ligne Production")
                                        .DisplayField("Designation")
                                        .ValueField("ID")
                                        .QueryMode(DataLoadMode.Local)
                                        .TriggerAction(TriggerAction.All)
                                        .LabelAlign(LabelAlign.Right)
                                        .Value(Model._OrdreFabrication.LigneDeProduction?.ID)
                                        .Store
                                        (
                                            X.Store()
                                            .AutoLoad(true)
                                            .Model
                                            (
                                                Html.X().Model()
                                                .IDProperty("ID")
                                                .Fields
                                                (
                                                    new ModelField("ID", ModelFieldType.Int),
                                                    new ModelField("Designation", ModelFieldType.String)
                                                )
                                                )
                                                .Proxy
                                                (
                                                    Html.X().AjaxProxy()
                                                    .Url(Url.Action("LoadLigneProduction", "LigneProduction"))
                                                    .Reader(Html.X().JsonReader().RootProperty("data"))
                                                )

                                            ),
                                    X.NumberField()
                                        .ID("txtAnnee")
                                        .FieldLabel("Année")
                                        .AllowBlank(false)
                                        .IndicatorCls("IndicatorRedStar")
                                        .IndicatorText("*")
                                        .LabelAlign(LabelAlign.Right)
                                        .Value(Model._OrdreFabrication.Annee),
                                    X.NumberField()
                                        .ID("txtSemaine")
                                        .FieldLabel("Semaine")
                                        .AllowBlank(false)
                                        .IndicatorCls("IndicatorRedStar")
                                        .IndicatorText("*")
                                        .LabelAlign(LabelAlign.Right)
                                        .Value(Model._OrdreFabrication.Semaine),

                                    X.DateField()
                                        .ID("txtDateEffective")
                                        .FieldLabel("Date Production")
                                        .LabelAlign(LabelAlign.Right)
                                        .Value(Model._OrdreFabrication.DateEffective)
                            ),
    #endregion

    #region Zone B
                        X.Panel()
                            .Layout(LayoutType.Form)
                            .Flex(1)
                            .Items
                            (
                                    X.ComboBox()
                                        .ID("cmbClient")
                                        .FieldLabel("Client")
                                        .DisplayField("Nom")
                                        .ValueField("ID")
                                        .QueryMode(DataLoadMode.Local)
                                        .TriggerAction(TriggerAction.All)
                                        .LabelAlign(LabelAlign.Right)
                                        .Value(Model._OrdreFabrication.Client?.ID)
                                        .Store
                                        (
                                            X.Store()
                                            .AutoLoad(true)
                                            .Model
                                            (
                                                Html.X().Model()
                                                .IDProperty("ID")
                                                .Fields
                                                (
                                                    new ModelField("ID", ModelFieldType.Int),
                                                    new ModelField("Nom", ModelFieldType.String)
                                                )
                                                )
                                                .Proxy
                                                (
                                                    Html.X().AjaxProxy()
                                                    .Url(Url.Action("LoadClient", "Client"))
                                                    .Reader(Html.X().JsonReader().RootProperty("data"))
                                                )

                                            ),
                                    X.ComboBox()
                                        .ID("cmbRecolte")
                                        .FieldLabel("Récolte")
                                        .DisplayField("Designation")
                                        .ValueField("ID")
                                        .QueryMode(DataLoadMode.Local)
                                        .TriggerAction(TriggerAction.All)
                                        .LabelAlign(LabelAlign.Right)
                                        .Value(Model._OrdreFabrication.Recolte?.ID)
                                        .Store
                                        (
                                            X.Store()
                                            .AutoLoad(true)
                                            .Model
                                            (
                                                Html.X().Model()
                                                .IDProperty("ID")
                                                .Fields
                                                (
                                                    new ModelField("ID", ModelFieldType.Int),
                                                    new ModelField("Designation", ModelFieldType.String)
                                                )
                                                )
                                                .Proxy
                                                (
                                                    Html.X().AjaxProxy()
                                                    .Url(Url.Action("LoadRecolte", "Recolte"))
                                                    .Reader(Html.X().JsonReader().RootProperty("data"))
                                                )

                                            ),
                                    X.TextField()
                                        .ID("txtReferenceExterne")
                                        .FieldLabel("Référence Externe")
                                        .LabelAlign(LabelAlign.Right)
                                        .Value(Model._OrdreFabrication.ReferenceExterne),

                                    X.NumberField()
                                        .ID("txtNbrePaletteAProduire")
                                        .FieldLabel("Nbre Palettes")
                                        .AllowBlank(false)
                                        .IndicatorCls("IndicatorRedStar")
                                        .IndicatorText("*")
                                        .LabelAlign(LabelAlign.Right)
                                        .Value(Model._OrdreFabrication.NbrePaletteAProduire),

                                    X.DateField()
                                        .ID("txtDateDebutProduction")
                                        .FieldLabel("Date Début")
                                        .LabelAlign(LabelAlign.Right)
                                        .Value(Model._OrdreFabrication.DateDebutProduction),

                                    X.DateField()
                                        .ID("txtDateFinProduction")
                                        .FieldLabel("Date Fin")
                                        .LabelAlign(LabelAlign.Right)
                                        .Value(Model._OrdreFabrication.DateFinProduction),

                                    X.TextField()
                                        .ID("txtStatut")
                                        .ReadOnly(true)
                                        .FieldLabel("Statut")
                                        .LabelAlign(LabelAlign.Right)
                                        .Value(Model._OrdreFabrication.Statut)
                                            )
    #endregion
             )
    )
    .Buttons
    (
        X.Button()
        .Text("OK")
        .ID("BtnOk")
        .TabIndex(12)
        .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult || Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve ? true : false)
        .DirectEvents
        (

            de =>
            {
                de.Click.Url = Url.Action("SubmitFormMethod");
                de.Click.Before = "return validNew(App.FormOrdreFabrication.id);";
                de.Click.FormID = "#(return this.up('window').down('form');)";
            }
        ),
        X.Button()
        .TabIndex(13)
        .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
        .Handler("App.FormOrdreFabrication.doClose()")
        .Cls("btncancel")

    )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        var areAllrequiredFieldsFilled = isFormValid(winId);

        if (!areAllrequiredFieldsFilled) {
            Ext.Msg.show({
                title: 'Production Order : Data Validation ',
                icon: Ext.MessageBox.WARNING,
                msg: 'Veuillez remplir les champs réquis.',
                buttons: Ext.Msg.OK
            });
            return false;
        }
        return true;
    };
</script>

