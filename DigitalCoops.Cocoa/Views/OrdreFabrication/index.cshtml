    var Overview = {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';
            }
            else if (value == 1) {
                return 'action_approve_02';
            }
            else if (value == 2) {
                return 'action_new_02';
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
        },
        resetButtons: function () {
            var hasSel = App.rowSelectionOrdreFabrication.hasSelection();

            // 1) Modifier
            if (hasSel && App.OrdreFabricationhiddenPermModifier.value === 'true') {
                App.btnModifyOrdreFabrication.enable();
            } else {
                App.btnModifyOrdreFabrication.disable();
            }

            // 2) Activer / Annuler (mnuCancelOrdreFabrication)
            if (hasSel && App.OrdreFabricationhiddenPermDesactiver.value === 'true') {
                App.mnuCancelOrdreFabrication.enable();
            } else {
                App.mnuCancelOrdreFabrication.disable();
            }

            if (hasSel) {
                var isDisabled = App.rowSelectionOrdreFabrication.selected.items[0].data.Desactive;
                if (isDisabled) {
                    if (App.OrdreFabricationhiddenPermActiver.value === 'true') {
                        App.mnuCancelOrdreFabrication.enable();
                    }
                    App.mnuCancelOrdreFabrication.setText('Activer');
                    App.mnuCancelOrdreFabrication.setIconCls('glyphicon glyphicon-ok green');
                    App.btnModifyOrdreFabrication.disable();
                } else {
                    App.mnuCancelOrdreFabrication.setText('Annuler');
                    App.mnuCancelOrdreFabrication.setIconCls('glyphicon glyphicon-remove red');
                    if (App.OrdreFabricationhiddenPermModifier.value === 'true') {
                        App.btnModifyOrdreFabrication.enable();
                    }
                }
            }

            // 3) Fermer
            if (hasSel && App.OrdreFabricationhiddenPermFermer.value === 'true') {
                App.btnClose.enable();
            } else {
                App.btnClose.disable();
            }

            // 4) Ouvrir
            if (hasSel && App.OrdreFabricationhiddenPermOuvrir.value === 'true') {
                App.btnOpen.enable();
            } else {
                App.btnOpen.disable();
            }
        }
    };

    




    Ext.onReady(function () {
        // Function to get ISO week number
        Date.prototype.getWeek = function () {
            var date = new Date(this.getTime());
            date.setHours(0, 0, 0, 0);
            // Thursday in current week decides the year.
            date.setDate(date.getDate() + 3 - (date.getDay() + 6) % 7);
            // January 4 is always in week 1.
            var week1 = new Date(date.getFullYear(), 0, 4);
            // Adjust to Thursday in week 1 and count number of weeks from date to week1.
            return 1 + Math.round(((date.getTime() - week1.getTime()) / 86400000 - 3 + (week1.getDay() + 6) % 7) / 7);
        };

        var currentYear = new Date().getFullYear();
        var yearsData = [];
        for (var i = 0; i < 5; i++) {
            yearsData.push([currentYear - i]);
        }
        App.cmbAnnee.getStore().loadData(yearsData);
        App.cmbAnnee.setValue(currentYear);

        var weeksData = [];
        for (var i = 1; i <= 53; i++) {
            weeksData.push([i]);
        }
        App.cmbSemaine.getStore().loadData(weeksData);
        App.cmbSemaine.setValue(new Date().getWeek());
    });
</script>


