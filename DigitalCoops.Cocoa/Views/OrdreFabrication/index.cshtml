<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" />
</head>
<script type="text/javascript" src="~/Scripts/renderers.js"></script>
<script type="text/javascript" src="~/Scripts/CommonFunctions.js"></script>
@* Le script avec Ext.onReady a été déplacé à la fin du fichier *@

@model Tms.Classes.Shared.OrdreFabrication
@{
    Layout = null;
    var X = Html.X();
}

@functions {
    public int GetCurrentWeekNumber()
    {
        var culture = System.Globalization.CultureInfo.CurrentCulture;
        return culture.Calendar.GetWeekOfYear(
            DateTime.Now,
            culture.DateTimeFormat.CalendarWeekRule,
            culture.DateTimeFormat.FirstDayOfWeek
        );
    }
}

@(Html.X().ResourceManager())

<form id="tms_form">
    @(X.Viewport()
        .ID("TmsViewPort")
        .Layout(LayoutType.Border)
        .Items(
            X.Panel()
                .ID("pnlNorthContainer")
                .Region(Region.North)
                .Border(false)
                .Items(
                    X.Toolbar()
                        .Padding(5)
                        .Items(
                            X.Button()
                                .Text("Filtre")
                                .IconCls("action_filter_02")
                                .Handler("App.OrdreFabricationCriteriaPanel.toggleCollapse();"),
                            X.Button()
                        .ID("btnRefreshOrdreFabrication")
                        .Text("Rafraîchir")
                        .IconCls("action_refresh_01")
                        .Handler(@"
                            // Recharger le store avec les paramètres actuels des filtres
                            var store = App.storeListeOrdreFabrication;
                            store.getProxy().extraParams = {
                                Annee: App.cmbAnnee.getValue(),
                                Semaine: App.cmbSemaine.getValue(),
                                Produit: App.cmbProduit.getValue(),
                                TypeProduit: App.cmbTypeProduit.getValue(),
                                Article: App.cmbArticle.getValue(),
                                Statut: App.cmbStatut.getValue(),
                                Actif: App.cmbActif.getValue()
                            };
                            store.load();
                            App.OrdreFabricationCriteriaPanel.collapse();
                        "),
                            X.Button().ID("btnNewOrdreFabrication").IconCls("action_new_02").Text("Nouveau").DirectEvents(de => { de.Click.Url = Url.Action("OnAdd"); de.Click.EventMask.ShowMask = true; }),
                            X.Button().ID("btnModifyOrdreFabrication").IconCls("action_modify_02").Text("Modifier").Disabled(true)
                            .DirectEvents(de => { de.Click.Url = Url.Action("OnEdit"); de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeOrdreFabrication}.getSelectionModel().getSelection()[0].data" });
                                de.Click.EventMask.ShowMask = true;
                            }),
                            X.Button().ID("btnOpen").Disabled(true).Icon(Icon.BookOpen).Text("Ouvrir un OF").DirectEvents(de => { de.Click.Url = Url.Action("onOpenProduction"); de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeOrdreFabrication}.getSelectionModel().getSelection()[0].data" }); de.Click.EventMask.ShowMask = true; }),
                            X.Button().ID("btnClose").Disabled(true).Icon(Icon.Lock).Text("Fermer").DirectEvents(de => { de.Click.Url = Url.Action("onCloseProduction"); de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeOrdreFabrication}.getSelectionModel().getSelection()[0].data" }); de.Click.EventMask.ShowMask = true; }),
                            X.ToolbarFill(),
                            X.Button().ID("btnActions").Text("Actions").IconCls("menu_04")
                                .Menu(X.Menu().Items(
                                    X.MenuItem().ID("mnuExportListOrdreFabrication").Text("Exporter la liste").Icon(Icon.PageExcel).Handler("/* Implement export logic */"),
                                    X.MenuItem().ID("mnuCancelOrdreFabrication").IconCls("glyphicon glyphicon-remove red").Text("Annuler").Disabled(true)
                                        .DirectEvents(de =>
                                        {
                                            de.Click.Url = Url.Action("OnActivateDeactivate");
                                            de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListeOrdreFabrication}.getSelectionModel().getSelection()[0].data" });
                                            de.Click.EventMask.ShowMask = true;
                                            de.Click.Confirmation.ConfirmRequest = true;
                                            de.Click.Confirmation.Title = "Confirmation";
                                            de.Click.Confirmation.BeforeConfirm = "return SetMsgBoxConfirm(config,#{grpListeOrdreFabrication}.getSelectionModel().getSelection()[0].data.Desactive)";
                                            de.Click.Success = "Overview.resetButtons();";
                                        })
                                ))
                        ),
                    X.FormPanel()
                        .ID("OrdreFabricationCriteriaPanel")
                        .Title("Critères de recherche")
                        .Collapsible(true)
                        .Collapsed(true)
                        .Border(false)
                        .BodyPadding(8)
                        .Layout(LayoutType.VBox)
                        .Items(
                            X.Container()
                                .Layout(LayoutType.HBox)
                                .Border(false)
                                .Items(
                                    // -- Column 1 --
                                    X.Container()
                                        .Layout(LayoutType.Form).Flex(1).Border(false).Padding(5)
                                        .Items(

                                            X.ComboBox()
                                                .ID("cmbAnnee")
                                                .FieldLabel("Année")
                                                .Name("Annee")
                                                .LabelAlign(LabelAlign.Right)
                                                .LabelWidth(120)
                                                .DisplayField("display")
                                                .ValueField("value")
                                                .QueryMode(DataLoadMode.Local)
                                                .ForceSelection(true)
                                                .Store(X.Store()
                                                    .Data(Enumerable.Range(DateTime.Now.Year - 4, 5)
                                                        .Select(y => new { display = y, value = y })
                                                    )
                                                )
                                                .Value(DateTime.Now.Year),

                                            X.ComboBox()
                                                .ID("cmbSemaine")
                                                .FieldLabel("Semaine")
                                                .Name("Semaine")
                                                .LabelAlign(LabelAlign.Right)
                                                .LabelWidth(120)
                                                .DisplayField("display")
                                                .ValueField("value")
                                                .QueryMode(DataLoadMode.Local)
                                                .ForceSelection(true)
                                                .Store(X.Store()
                                                    .Data(Enumerable.Range(-1, 54)
                                                        .Select(w => new
                                                        {
                                                            display = w == -1 ? "{Tous}" : w.ToString(),
                                                            value = w
                                                        })
                                                    )
                                                )
                                                .Value(GetCurrentWeekNumber()),


                                            X.ComboBox().ID("cmbProduit").FieldLabel("Produit").Name("Produit").DisplayField("Designation").ValueField("ID").Value(-1).LabelAlign(LabelAlign.Right).LabelWidth(120)
                                                .Store(X.Store().AutoLoad(true).Proxy(X.AjaxProxy().Url(Url.Action("LoadProduitFini", "ProduitFini")).Reader(X.JsonReader().RootProperty("data")))
                                                    .Listeners(ls => ls.Load.Handler = "this.insert(0, Ext.create(this.model, { ID: -1, Designation: '{Tous}' }));"))
                                        ),
                                    // -- Column 2 --
                                    X.Container()
                                        .Layout(LayoutType.Form).Flex(1).Border(false).Padding(5)
                                        .Items(
                                            X.ComboBox().ID("cmbTypeProduit").FieldLabel("Type de produit").Name("TypeProduit").DisplayField("Designation").ValueField("ID").Value(-1).LabelAlign(LabelAlign.Right).LabelWidth(120)
                                                .Store(X.Store().AutoLoad(true).Proxy(X.AjaxProxy().Url(Url.Action("LoadProduitTypeAll", "ProduitType")).Reader(X.JsonReader().RootProperty("data"))))
                                                .Listeners(ls =>
                                                {
                                                    ls.Select.Handler = @"
                                                        var typeProduitId = this.getValue();
                                                        var articleStore = App.cmbArticle.getStore();
                                                        App.cmbArticle.clearValue();
                                                        articleStore.getProxy().setExtraParam('typeProduitID', typeProduitId);
                                                        articleStore.load();
                                                    ";
                                                }),
                                            X.ComboBox().ID("cmbArticle").FieldLabel("Article").Name("Article").DisplayField("Nom").ValueField("ID").QueryMode(DataLoadMode.Local).TypeAhead(true).ForceSelection(false).LabelAlign(LabelAlign.Right).LabelWidth(120)
                                                .Store(X.Store().AutoLoad(false)
                                                    .Proxy(X.AjaxProxy()
                                                        .Url(Url.Action("LoadByType", "Article"))
                                                        .Reader(X.JsonReader().RootProperty("data")))),
                                            X.ComboBox().ID("cmbStatut").FieldLabel("Statut").Name("Statut").Value("Tous").LabelAlign(LabelAlign.Right).LabelWidth(120)
                                                .Items(new ListItem("{Tous}", "Tous"), new ListItem("En attente", "EA"), new ListItem("En cours", "EC"), new ListItem("Fermé", "CL"))
                                        ),
                                    // -- Column 3 --
                                    X.Container()
                                        .Layout(LayoutType.Form).Flex(1).Border(false).Padding(5)
                                        .Items(
                                            X.ComboBox().ID("cmbActif").Name("Actif").FieldLabel("Actif/Inactif").Value("-1").LabelAlign(LabelAlign.Right).LabelWidth(120)
                                                .Items(new ListItem("{Tous}", "-1"), new ListItem("Actif", "0"), new ListItem("Inactif", "1"))
                                        )
                                )
                        )
                ),
            X.GridPanel()
                .ID("grpListeOrdreFabrication")
                .Region(Region.Center)
                .Border(false)
                .Store(X.StoreFor<Tms.Classes.Shared.OrdreFabrication>().ID("storeListeOrdreFabrication")
                    .Proxy(X.AjaxProxy().Url(Url.Action("Select")).Reader(X.JsonReader().RootProperty("data"))))
                .ColumnModel(
                    X.Column().Text("").DataIndex("mIcon").Renderer("renderIcon").Width(40),
                    X.Column().Text("Année").DataIndex("Annee"),
                    X.Column().Text("Semaine").DataIndex("Semaine"),
                    X.Column().Text("Numéro de production").DataIndex("NumeroProduction").Flex(1),
                    X.Column().Text("Statut").DataIndex("Statut"),
                    X.Column().Text("Article").DataIndex("ArticleAsString").Flex(2)
                )
                .SelectionModel(X.RowSelectionModel().ID("rowSelectionOrdreFabrication").Listeners(l =>
                {
                    l.Select.Fn = "Overview.resetButtons";
                    l.Deselect.Fn = "Overview.resetButtons";
                }))
                .DirectEvents(de =>
                {
                    de.ItemDblClick.Url = Url.Action("OnConsult");
                    de.ItemDblClick.EventMask.ShowMask = true;
                    de.ItemDblClick.ExtraParams.Add(new Parameter("ItemSelected", "Ext.encode(record.data)", ParameterMode.Raw));

                })
                .BottomBar(X.PagingToolbar().DisplayInfo(false))
        )
    )
</form>

@* CORRECTION : Le script est maintenant placé après la définition des composants pour assurer leur initialisation. *@
<script type="text/javascript">
    Ext.onReady(function () {
        var currentYear = new Date().getFullYear();
        var years = [];
        for (var i = 0; i < 5; i++) {
            var yearValue = currentYear - i;
            years.push({ display: yearValue, value: yearValue });
        }
        // Le Store est déjà chargé côté serveur, donc ces lignes ne sont plus nécessaires
        // App.cmbAnnee.getStore().loadData(years);
        // App.cmbAnnee.setValue(currentYear);

        var weeks = [{ display: '{Tous}', value: -1 }];
        for (var i = 1; i <= 52; i++) {
            weeks.push({ display: i, value: i });
        }
        // Le Store est déjà chargé côté serveur, donc ces lignes ne sont plus nécessaires
        // App.cmbSemaine.getStore().loadData(weeks);
        // App.cmbSemaine.setValue(-1);
    });

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';
        var icon_url = Overview.getBootStrapIcons(value);
        return Ext.String.format(tpl, icon_url);
    }

    var SetMsgBoxConfirm = function (config, isDisabled) {
        config.message = isDisabled ? "Êtes-vous sûr de vouloir activer cet élément ?" : "Êtes-vous sûr de vouloir annuler cet élément ?";
        return config;
    };

    var Overview = {
        getBootStrapIcons: function (value) {
            if (value === 0) return 'glyphicon-remove red';
            if (value === 2) return 'glyphicon-file blue';
            return '';
        },
        resetButtons: function () {
            var hasSel = App.rowSelectionOrdreFabrication.hasSelection();
            App.btnModifyOrdreFabrication.setDisabled(!hasSel);
            App.mnuCancelOrdreFabrication.setDisabled(!hasSel);
            App.btnClose.setDisabled(!hasSel);
            App.btnOpen.setDisabled(!hasSel);

            if (hasSel) {
                var record = App.rowSelectionOrdreFabrication.getSelection()[0];
                var isDisabled = record.data.Desactive;
                if (isDisabled) {
                    App.mnuCancelOrdreFabrication.setText('Activer');
                    App.mnuCancelOrdreFabrication.setIconCls('glyphicon glyphicon-ok green');
                    App.btnModifyOrdreFabrication.disable();
                } else {
                    App.mnuCancelOrdreFabrication.setText('Annuler');
                    App.mnuCancelOrdreFabrication.setIconCls('glyphicon glyphicon-remove red');
                }
            }
        }
    };
</script>

