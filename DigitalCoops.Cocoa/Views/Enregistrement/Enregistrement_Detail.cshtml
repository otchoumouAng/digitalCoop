<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>

<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Sales Registration : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        var Amount = Number(unformatNumber(App.txtAmount.value));


        if(!Ext.isNumeric(Amount) && parseFloat(Amount) < 0 ) {
            Ext.Msg.show({ title: 'Sales Registration : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Amount invalid', buttons: Ext.Msg.OK });
            return false;
        }


    
    };

    var CalculAmountTonnage = function () {

        /*var Tonnage = unformatNumberDecimal(App.txtTonnage.value) || '';*/
        var Tonnage = unformatNumberDecimal(App.txtTonnage.value.replace(",", ".")) || '';
        var Price = unformatNumber(App.txtPrice.value) || '';        
        if (isNumeric(Price) && Price > 0) {            
            var Amount = parseFloat(Tonnage) * parseFloat(Price);            
            App.txtAmount.setValue(formatNumber(Amount));
        }

        
        /*if (isNumeric(Tonnage) && Tonnage > 0)
        {
 
            var Price = unformatNumber(App.txtPrice.value) || '';

            if(isNumeric(Price) && Price > 0)
            {
                var Amount = RoundInt(Tonnage * Price);

                App.txtAmount.setValue(formatNumber(Amount));
            }
        }
        else
        {
            App.txtTonnage.setValue('');
            App.txtAmount.setValue('');
        }*/


    };

    var CalculAmountPrice = function () {

        var Price = unformatNumber(App.txtPrice.value) || '';

        var Tonnage = unformatNumberDecimal(App.txtTonnage.value) || '';
        console.log(Tonnage);
        var Amount = RoundInt(Tonnage * Price);
        App.txtAmount.setValue(formatNumber(Amount));


    };



    var RoundInt = function (v) {
        try {
            if ((parseFloat(v) - parseInt(v)) > 0.5) {
                return parseInt(v) + 1;
            }
            else {
                return parseInt(v);
            }
        } catch (err) {
            return 0;
        }
    };

    var RoundIntSup = function (v) {
        try {
                if (v < 1000)
                {
                    var valeur = (v / 100);
                    return RoundInt(valeur)*100;
                }
                else
                {
                    var valeur = (v / 1000);
                    return RoundInt(valeur)*1000;

                }

        } catch (err) {
            return 0;
        }
    };


    var checkMode = function () {
        if (App._cmbModeEnregistrement.value == App.DefaultMode.value) {
            App.grpDetailEnregistrement.disable();
        } else {
            App.grpDetailEnregistrement.enable();
        }

    };

    var CalculateDetailValues = function () {
        var totalTon = App.storeDetailEnregistrement.sum('Tonnage') || 0;
        var totalDetAmount = App.storeDetailEnregistrement.sum('Montant') || 0;        

        App.txtTonnage.setValue(formatNumber(totalTon));
        App.txtAmount.setValue(formatNumber(totalDetAmount));
    };

    var SetContratField = function () {
        var prefixe = App._cmbExportateur.getSelectedRecord().data.PrefixeFacture || '';
        var oldText = App.txtContractExport.value;
        var newText = '';
        if (oldText.length > 3) {            
            newText = oldText.replace(oldText.substring(0, 3), prefixe);
            App.txtContractExport.setValue(newText);
        } else
            App.txtContractExport.setValue(prefixe + '/');
    };

    function formatNumberDecimal(amount) {
        amount = thousands_separators(amount.replace(".", ","));
        formatted = amount.replace(".", ",");

        return formatted;
    };

    function unformatNumberDecimal(amount) {
        formatted = amount.replace(" ", "");

        return formatted;
    };

    function thousands_separators(num) {
        var num_parts = num.toString().split(".");
        num_parts[0] = num_parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, " ");
        return num_parts.join(".");
    };
</script>

