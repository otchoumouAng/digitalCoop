@model Tms.Classes.Business.DeplacementPaletteViewModel

@{
    Layout = null;
    var X = Html.X();
}

<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>

<style>
    .global-scroll-container {
        overflow-y: auto;
        padding: 15px 20px;
        height: calc(100% - 50px);
    }

    .form-container {
        display: flex;
        gap: 30px;
        min-height: min-content;
    }

    .x-form-item {
        margin-bottom: 16px;
    }

    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 180px !important;
        color: #546e7a;
        font-weight: 500;
    }

    .button-container {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 15px 20px;
        background: #f8fafc;
        border-top: 1px solid #eef2f6;
    }

    .x-window-footer {
        padding: 0 !important;
        border-top: none !important;
    }

    .x-window-body {
        overflow: hidden !important;
    }
</style>

@(
    X.Window()
    .ID("FormDeplacementPaletteWindow")
    .Title("SÉLECTIONNER UNE PALETTE")
    .Width(800)
    .Height(450) // Hauteur réduite car moins de champs
    .Resizable(false)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Layout(LayoutType.Fit)
    .Items(
        X.FormPanel()
        .ID("FormDeplacementPanel")
        .Cls("global-scroll-container")
        .Layout(LayoutType.Form)
        .Items(
            // ComboBox pour les années (toujours actif)
            X.ComboBox()
                .ID("cmbAnnee")
                .FieldLabel("Année")
                .LabelAlign(LabelAlign.Right)
                .LabelWidth(120)
                .QueryMode(DataLoadMode.Local)
                .Editable(false)
                .DisplayField("text")
                .ValueField("value")
                .Store(X.Store().Model(X.Model().Fields(
                    new ModelField("value", ModelFieldType.Int),
                    new ModelField("text", ModelFieldType.String)
                )))
                .Listeners(l =>
                {
                    l.AfterRender.Handler = @"
                        var store = this.getStore();
                        var currentYear = new Date().getFullYear();
                        var years = [];
                        for (var i = 0; i < 5; i++) {
                            var year = currentYear - i;
                            years.push({ text: year.toString(), value: year });
                        }
                        store.loadData(years);
                        this.setValue(currentYear);
                    ";
                    // Active le champ suivant et désactive les autres en cascade
                    l.Change.Handler = @"
                        var hasValue = this.getValue() !== null && this.getValue() !== '';
                        App.cmbSemaine.setDisabled(!hasValue);
                        App.cmbSemaine.clearValue();
                        App.cmbProduit.setDisabled(true);
                        App.cmbProduit.clearValue();
                        App.cmbProduitType.setDisabled(true);
                        App.cmbProduitType.clearValue();
                        App.cmbPalette.setDisabled(true);
                        App.cmbPalette.clearValue();
                    ";
                }),

            // ComboBox pour les semaines (désactivé par défaut)
            X.ComboBox()
                .ID("cmbSemaine")
                .FieldLabel("Semaine")
                .Disabled(true)
                .LabelAlign(LabelAlign.Right)
                .LabelWidth(120)
                .QueryMode(DataLoadMode.Local)
                .Editable(false)
                .DisplayField("text")
                .ValueField("value")
                .Store(X.Store().Model(X.Model().Fields(
                    new ModelField("value", ModelFieldType.Int),
                    new ModelField("text", ModelFieldType.String)
                )))
                .Listeners(l =>
                {
                    l.AfterRender.Handler = @"
                        var store = this.getStore();
                        var weeks = [];
                        for (var i = 1; i <= 52; i++) {
                            weeks.push({ text: i.toString(), value: i });
                        }
                        store.loadData(weeks);
                        var today = new Date();
                        var firstDayOfYear = new Date(today.getFullYear(), 0, 1);
                        var pastDaysOfYear = (today - firstDayOfYear) / 86400000;
                        var currentWeekNumber = Math.ceil((pastDaysOfYear + firstDayOfYear.getDay() + 1) / 7);
                        this.setValue(currentWeekNumber);
                    ";
                    l.Change.Handler = @"
                        var hasValue = this.getValue() !== null && this.getValue() !== '';
                        App.cmbProduit.setDisabled(!hasValue);
                        App.cmbProduit.clearValue();
                        App.cmbProduitType.setDisabled(true);
                        App.cmbProduitType.clearValue();
                        App.cmbPalette.setDisabled(true);
                        App.cmbPalette.clearValue();
                    ";
                }),

            // ComboBox pour le Produit (désactivé par défaut)
            X.ComboBox()
                .ID("cmbProduit")
                .FieldLabel("Produit")
                .Disabled(true)
                .LabelAlign(LabelAlign.Right)
                .LabelWidth(120)
                .DisplayField("Designation")
                .ValueField("ID")
                .ForceSelection(true)
                .QueryMode(DataLoadMode.Local)
                .Store(
                    X.Store()
                    .AutoLoad(true)
                    .Model(X.Model().IDProperty("ID").Fields(
                        new ModelField("ID", ModelFieldType.Int),
                        new ModelField("Designation", ModelFieldType.String)
                    ))
                    .Proxy(X.AjaxProxy()
                        .Url(Url.Action("LoadProduitFini", "ProduitFini"))
                        .Reader(X.JsonReader().RootProperty("data"))
                    )
                )
                 .Listeners(l =>
                 {
                     l.Change.Handler = @"
                        var hasValue = this.getValue() !== null && this.getValue() !== '';
                        App.cmbProduitType.setDisabled(!hasValue);
                        App.cmbProduitType.clearValue();
                        App.cmbPalette.setDisabled(true);
                        App.cmbPalette.clearValue();
                    ";
                 }),


    // ComboBox pour le Type de Produit (avec débogage ajouté)
    X.ComboBox()
        .ID("cmbProduitType")
        .FieldLabel("Type de produit")
        .Disabled(true)
        .LabelAlign(LabelAlign.Right)
        .LabelWidth(120)
        .DisplayField("Designation")
        .ValueField("ID")
        .ForceSelection(true)
        .QueryMode(DataLoadMode.Local)
        .Store(
            X.Store()
            .AutoLoad(true)
            .Model(X.Model().IDProperty("ID").Fields(
                new ModelField("ID", ModelFieldType.Int),
                new ModelField("Designation", ModelFieldType.String)
            ))
            .Proxy(X.AjaxProxy()
                .Url(Url.Action("LoadProduitType", "ProduitType"))
                .Reader(X.JsonReader().RootProperty("data"))
            )
        )
        .Listeners(l =>
        {
            l.Select.Handler = @"
                console.log('--- Début du Change Event pour Type de Produit ---');
                var typeProduitId = this.getValue();
                console.log('Type Produit ID sélectionné :', typeProduitId);

                var paletteCombo = App.cmbPalette;
                var paletteStore = paletteCombo.getStore();

                paletteCombo.clearValue();
                paletteStore.removeAll();

                if (typeProduitId) {
                    // On vérifie que les combos précédents existent bien
                    if (!App.cmbAnnee || !App.cmbSemaine || !App.cmbProduit) {
                        console.error('Erreur : Un ou plusieurs ComboBox parents sont introuvables !');
                        return; // Stoppe l'exécution
                    }

                    var annee = App.cmbAnnee.getValue();
                    var semaine = App.cmbSemaine.getValue();
                    var produitId = App.cmbProduit.getValue();
                
                    console.log('Valeurs récupérées :', { annee: annee, semaine: semaine, produitId: produitId, typeProduitId: typeProduitId });

                    if (!annee || !semaine || !produitId) {
                        console.warn('Attention : Un des champs parents est vide. La requête ne sera pas envoyée.');
                        paletteCombo.setDisabled(true);
                        return; // Stoppe si une valeur manque
                    }

                    var proxy = paletteStore.getProxy();
                    proxy.setExtraParam('ItemAnnee', annee);
                    proxy.setExtraParam('ItemSemaine', semaine);
                    proxy.setExtraParam('ItemProduit', produitId);
                    proxy.setExtraParam('ItemProduitType', typeProduitId);

                    console.log('Paramètres envoyés au proxy :', proxy.getExtraParams());
                    console.log('Lancement de la requête vers le serveur...');
                
                    paletteStore.load(); // Appel au serveur
                    paletteCombo.setDisabled(false);

                } else {
                    console.log('Champ Type de Produit vidé. Désactivation de la palette.');
                    paletteCombo.setDisabled(true);
                }
                console.log('--- Fin du Change Event ---');
            ";
        }),

            // ComboBox pour les palettes (désactivé par défaut, chargement manuel)
            X.ComboBox()
                .ID("cmbPalette")
                .FieldLabel("Palette")
                .Disabled(true)
                .LabelAlign(LabelAlign.Right)
                .LabelWidth(120)
                .DisplayField("Numero") // Affichage du numéro
                .ValueField("ID")       // La valeur sera l'ID
                .ForceSelection(true)
                .QueryMode(DataLoadMode.Local)
                .IndicatorCls("IndicatorRedStar")
                .IndicatorText("*")
                .Store(
                    X.Store()
                    .AutoLoad(false) // Très important : pas de chargement automatique
                    .Model(
                        X.Model()
                        .IDProperty("ID")
                        .Fields(
                            new ModelField("ID", ModelFieldType.String),
                            new ModelField("Numero", ModelFieldType.Int)
                        )
                    )
                    .Proxy(
                        X.AjaxProxy()
                        .Url(Url.Action("SelectByModalFilter", "DeplacementPalette"))
                        .Reader(X.JsonReader().RootProperty("data"))
                    )
                )
        )
    )
    .FooterBar(
        X.Toolbar()
        .Cls("button-container")
        .Items(
            X.Button()
                .ID("BtnSubmit")
                .Text("Enregistrer")
                .Cls("x-btn-primary")
                .DirectEvents(de =>
                {
                    de.Click.Url = Url.Action("SubmitFormMethod", "DeplacementPalette");
                    de.Click.FormID = "FormDeplacementPanel";
                    // de.Click.Before = "return validDeplacementForm(App.FormDeplacementPaletteWindow.id);";
                    de.Click.EventMask.ShowMask = true;
                    de.Click.EventMask.Msg = "Enregistrement en cours...";
                }),

            X.Button()
                .Text("Annuler")
                .Handler("App.FormDeplacementPaletteWindow.close()")
                .Cls("btncancel")
        )
    )
)