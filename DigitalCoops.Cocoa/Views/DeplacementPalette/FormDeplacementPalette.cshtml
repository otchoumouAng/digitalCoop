@model Tms.Classes.Business.DeplacementPaletteViewModel
@{
    Layout = null;
    var X = Html.X();
    var anneeActuelle = DateTime.Now.Year;
    var semaineActuelle = System.Globalization.ISOWeek.GetWeekOfYear(DateTime.Now);
}

<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>

<style>
    .custom-form-container {
        padding: 20px;
        background-color: #f9f9f9;
    }

    .section-container {
        margin-bottom: 25px;
        padding: 15px;
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 5px;
    }

    .section-title {
        font-size: 16px;
        font-weight: bold;
        color: #333;
        margin-bottom: 15px;
        border-bottom: 2px solid #337ab7;
        padding-bottom: 5px;
    }

    .info-display {
        font-weight: bold;
        color: #337ab7;
        padding-top: 8px;
    }
</style>

@(
    X.Window()
    .ID("FormDeplacementPaletteWindow")
    .Title("Déplacer Manuellement une Palette")
    .Width(950)
    .Height(650)
    .Resizable(false)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .Layout(LayoutType.Fit)
    .Items(
        X.FormPanel()
        .ID("FormDeplacementPanel")
        .Layout(LayoutType.VBox)
        .BodyPadding(15)
        .Items(
            // Section 1: Critères de sélection de la palette
            X.FieldSet()
            .Title("1. Sélection de la Palette")
            .Layout(LayoutType.Column)
            .Padding(10)
            .Items(
                X.Container()
                .ColumnWidth(0.5)
                .Layout(LayoutType.Form)
                .Items(
                    X.NumberField().ID("NumAnnee").FieldLabel("Année").Value(anneeActuelle).AllowBlank(false),
                    X.ComboBox().ID("CmbProduit").FieldLabel("Produit").DisplayField("Designation").ValueField("ID").Store(
                        X.Store().AutoLoad(true).Proxy(
                            X.AjaxProxy().Url(Url.Action("LoadProduit", "Produit")).Reader(X.JsonReader().RootProperty("data"))
                        )
                    ).Listeners(l => {
                        l.Select.Handler = "App.CmbTypeProduit.clearValue(); App.CmbTypeProduit.getStore().load({ params: { IdProduit: this.getValue() } });";
                    })
                ),
                X.Container()
                .ColumnWidth(0.5)
                .Layout(LayoutType.Form)
                .Items(
                    X.NumberField().ID("NumSemaine").FieldLabel("Semaine").Value(semaineActuelle).AllowBlank(false),
                    X.ComboBox().ID("CmbTypeProduit").FieldLabel("Type de Produit").DisplayField("Designation").ValueField("ID").Store(
                        X.Store().Proxy(
                            X.AjaxProxy().Url(Url.Action("LoadProduitType", "ProduitType")).Reader(X.JsonReader().RootProperty("data"))
                        )
                    ).Listeners(l => {
                        l.Select.Handler = "loadPalettes();";
                    })
                )
            ),

            // Section 2: Liste des palettes et informations
            X.FieldSet()
            .Title("2. Informations sur la Palette")
            .Layout(LayoutType.Column)
            .Padding(10)
            .Items(
                X.ComboBox().ID("CmbPalette").FieldLabel("Sélectionnez la palette").DisplayField("Numero").ValueField("ID").ColumnWidth(1)
                .Store(X.Store().Proxy(X.AjaxProxy().Url(Url.Action("GetPalettesByCriteria", "DeplacementPalette")).Reader(X.JsonReader().RootProperty("data"))))
                .Listeners(l => {
                    l.Select.Handler = "loadPaletteInfo();";
                }),

                // Affichage des informations de la palette
                X.DisplayField().ID("InfoMagasinDepart").FieldLabel("Magasin de départ"),
                X.DisplayField().ID("InfoEmplacementDepart").FieldLabel("Emplacement de départ"),
                X.DisplayField().ID("InfoPoidsBrut").FieldLabel("Poids Brut"),
                X.DisplayField().ID("InfoPoidsNet").FieldLabel("Poids Net"),
                X.DisplayField().ID("InfoTareUnitaire").FieldLabel("Tare Unitaire")
            ),

            // Section 3: Informations sur le déplacement
            X.FieldSet()
            .Title("3. Détails du Déplacement")
            .Layout(LayoutType.Form)
            .Padding(10)
            .Items(
                X.DateField().ID("DateDepart").FieldLabel("Date de départ").AllowBlank(false),
                X.ComboBox().ID("CmbMagasinArrivee").FieldLabel("Magasin d'arrivée").DisplayField("Designation").ValueField("ID").AllowBlank(false).Store(
                    X.Store().AutoLoad(true).Proxy(
                        X.AjaxProxy().Url(Url.Action("LoadMagasin", "Magasin")).Reader(X.JsonReader().RootProperty("data"))
                    )
                ),
                X.TextField().ID("TxtEmplacementArrivee").FieldLabel("Emplacement d'arrivée").AllowBlank(false),
                X.DateField().ID("DateArrivee").FieldLabel("Date d'arrivée").AllowBlank(false)
            )
        )
        .FooterBar(
            X.Toolbar()
            .Padding(10)
            .Items(
                X.Button().ID("BtnSubmit").Text("Valider le Déplacement").Icon(Icon.Accept)
                .DirectEvents(de =>
                {
                    de.Click.Url = Url.Action("SubmitFormMethod", "DeplacementPalette");
                    de.Click.FormID = "FormDeplacementPanel";
                    de.Click.EventMask.ShowMask = true;
                }),
                X.Button().Text("Annuler").Icon(Icon.Cancel)
                .Handler("App.FormDeplacementPaletteWindow.close();")
            )
        )
    )
)

<script>
    function loadPalettes() {
        var annee = App.NumAnnee.getValue();
        var semaine = App.NumSemaine.getValue();
        var produitId = App.CmbProduit.getValue();
        var typeProduitId = App.CmbTypeProduit.getValue();

        if (annee && semaine && produitId && typeProduitId) {
            var store = App.CmbPalette.getStore();
            store.load({
                params: {
                    annee: annee,
                    semaine: semaine,
                    produitId: produitId,
                    typeProduitId: typeProduitId
                }
            });
        }
    }

    function loadPaletteInfo() {
        var paletteId = App.CmbPalette.getValue();
        if (paletteId) {
            Ext.net.DirectMethod.request({
                url: '@Url.Action("GetPaletteStockInfo", "DeplacementPalette")',
                params: {
                    paletteId: paletteId
                },
                success: function(result) {
                    App.InfoMagasinDepart.setValue(result.MagasinSource);
                    App.InfoEmplacementDepart.setValue(result.EmplacementSource);
                    App.InfoPoidsBrut.setValue(result.PoidsBrut);
                    App.InfoPoidsNet.setValue(result.PoidsNet);
                    App.InfoTareUnitaire.setValue(result.TareUnitaire);
                }
            });
        }
    }
</script>