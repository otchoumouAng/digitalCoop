    var SetFieldsToFill = function () {
        var _CanFill = App.cmbMagasin.getSelectedRecord().data.APontBascule;
        if (_CanFill) {
            App.txtPoidsBrut.setReadOnly(false);
            App.txtTareSac.setReadOnly(false);
            App.txtTarePalette.setReadOnly(false);
            App.txtNetWeight.setReadOnly(false);
            App.txtNombreSacs.setReadOnly(false);
        } else {
            App.txtPoidsBrut.setReadOnly(true);
            App.txtTareSac.setReadOnly(true);
            App.txtTarePalette.setReadOnly(true);
            App.txtNetWeight.setReadOnly(true);
            App.txtNombreSacs.setReadOnly(true);
