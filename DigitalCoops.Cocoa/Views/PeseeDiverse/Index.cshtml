<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListePeseeDiverse.columnManager.getColumns(), App.grpListePeseeDiverse.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderObject = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.AsString)
                return value.AsString;
        }

        return value;
    }

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        return Ext.String.format(tpl, icon_url);
    }


    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);

    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
            else if (value == 3) {
                return 'action_new_03';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red';
            }
            else if (value == 1) {
                return  'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue';
            }
            else if (value == 3) {
                return 'glyphicon-ban-circle red';
            }
            else if (value == 4) {
                return 'glyphicon-ban-circle red';
            }
        },

        SummaryPeseeDiverse: function () {
            var nbrOfrows = App.grpListePeseeDiverse.getStore().getCount();                
            var totalNet = App.storeListePeseeDiverse.sum('PoidsNet') || 0;
            var totalGrossWeight = App.storeListePeseeDiverse.sum('PoidsBrut') || 0;
            var totalNbrOfBags = App.storeListePeseeDiverse.sum('NombreSacs') || 0;

            totalNet = FormatAmount(totalNet);
            totalGrossWeight = FormatAmount(totalGrossWeight);
            totalNbrOfBags = FormatAmount(totalNbrOfBags);
            App.lblSummaryPeseeDiverse.setHtml("Nbr de Pesées : " + nbrOfrows + "<br/> Nbr de sacs : " + totalNbrOfBags);
            App.lblSummaryPeseeDiverse2.setHtml("Poids Brut (Kg) : " + totalGrossWeight + " <br/> Poids Net (Kg) : " + totalNet);
        },

        resetButtons: function () {

            App.btnModify.disable();
            App.btnCancel.disable();            
            App.mnuPrintTicket.disable();
            if (App.rowPeseeDiverse.hasSelection()) {

                var isDesactive = App.rowPeseeDiverse.selected.items[0].data.Desactive;
                var EstFinalise = App.rowPeseeDiverse.selected.items[0].data.EstFinalise;

                if (isDesactive === false) {
                    if (App.phiddenPermPrintSheet.value == 'true')
                        App.mnuPrintTicket.enable();

                    if (App.phiddenPermFinalize.value == 'true' && EstFinalise === false) {
                        App.btnModify.enable();

                        if (App.phiddenPermDesactiver.value == 'true')
                            App.btnCancel.enable();
                    }
                }
                else {
                    App.btnModify.disable();
                    App.btnCancel.disable();
                    App.mnuPrintTicket.disable();
                }
            }
        }
    }

</script>

