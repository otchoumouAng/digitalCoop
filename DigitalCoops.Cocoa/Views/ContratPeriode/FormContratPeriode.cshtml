@model Tms.Classes.Business.ContratPeriodeViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style type="text/css">
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 120px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
@(
X.Window()
    .ID("FormForwardContract")
    .Width(760)
    .Resizable(false)
    .Height(300)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    //.X(300)
    .Y(20)
    .Modal(true)
    .Title(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Extend ? "Contrat Periode : Etendre" : "Contrat Periode : Detail")
    .Items(
            X.FormPanel()
                .FieldDefaults(d => d.ReadOnly = (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult || Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve) ? true : false)
                .Layout(LayoutType.HBox)
                .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Middle, Pack = BoxPack.Center })
                .Items(

                        X.Panel()
                            .Layout(LayoutType.Form)
                            .Flex(3)
                            .Items(
                                    X.Hidden().ID("hiddenExecMode").Value(Model._ExecMode),
                                    X.Hidden().ID("hiddenRowversion").Value(Model._ContratPeriode.RowVersionKey),
                                    X.Hidden().ID("hiddenNumeroPrice").Value(Model._ContratPeriode.Numero),
                                    X.Hidden().ID("TxtContratID").Value(Model._ContratPeriode.ID),
                                    X.Hidden().ID("currentcampagneCP").Value(Model._ContratPeriode.Campagne.Designation),
                                    X.Hidden().ID("HiddenFinancingTypeID").Value(ViewData["FinancingTypeID"]),
                                    X.ComboBox()
                                        .ID("cmbSite")
                                        .FieldLabel("Site")
                                        .DisplayField("Nom")
                                        .ValueField("ID")
                                        .MatchFieldWidth(false)
                                        .ListConfig(new BoundList { MinWidth = 300 })
                                        .LabelAlign(LabelAlign.Right)
                                        .TypeAhead(false)
                                        .QueryMode(DataLoadMode.Local)
                                        .TriggerAction(TriggerAction.All)
                                        .ForceSelection(true)
                                        .ReadOnly(true)
                                        .Value(Model._ContratPeriode.Sites.ID)
                                        .Store(
                                                X.Store()
                                                //.Listeners(l => l.Load.Handler = "App.cmbSite.setValue(App.cmbSite.getStore().getAt(0));")
                                                .AutoLoad(true)
                                                .Model(
                                                        Html.X().Model()
                                                        .IDProperty("ID")
                                                        .Fields(
                                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                    new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                                                )
                                                    )
                                                .Proxy(
                                                            Html.X().AjaxProxy()
                                                            .Url(Url.Action("LoadSite", "Site"))
                                                .Reader(
                                                            Html.X().JsonReader().RootProperty("data")
                                                            )
                                                )
                                    ).Listeners(
                                                ls =>
                                                {
                                                    ls.Select.Handler = "if (App.cmbSite.value) { App.FournisseurID.clearValue(); App.FournisseurID.getStore().load(); };";
                                                }
                                            ),
                                    X.ComboBox()
                                        .ID("CropYearID")
                                        .Value(Model._ContratPeriode.Campagne.Designation)
                                        .ReadOnly(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Extend ? false : true)
                                        .FieldLabel("Campagne")
                                        .AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                                        .DisplayField("Designation")
                                        .ValueField("Designation")
                                        .LabelAlign(LabelAlign.Right)
                                        .ForceSelection(true)
                                        .TypeAhead(false)
                                        .QueryMode(DataLoadMode.Local)
                                        .TriggerAction(TriggerAction.All)
                                        .Store(
                                                X.Store()
                                                    .AutoLoad(true)
                                                    .Model(
                                                            Html.X().Model()
                                                                .IDProperty("ID")
                                                                        .Fields(
                                                                            new ModelField("Designation", ModelFieldType.Int) { Mapping = "Designation" },
                                                                            new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                                        )
                                                            )
                                                    .Proxy(Html.X().AjaxProxy()
                                                        .Url(Url.Action("LoadCampagne", "Campagne"))
                                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                                    ).Listeners(ls =>
                                                    {
                                                        ls.Load.Handler = "#{CropYearID}.setValue(#{currentcampagneCP}.value)";
                                                    })
                                                ),
                                    X.ComboBox()
                                        .ID("FournisseurID")
                                        .AllowBlank(false)
                                        .IndicatorCls("IndicatorRedStar")
                                        .IndicatorText("*").FieldLabel("Fournisseur")
                                        .DisplayField("NameAndCode")
                                        .ValueField("ID")
                                        .LabelAlign(LabelAlign.Right)
                                        .ReadOnly(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Extend ? false : true)
                                        .MatchFieldWidth(false)
                                        .ListConfig(new BoundList { MinWidth = 320 })
                                        .ForceSelection(true)
                                        .TypeAhead(false)
                                        .QueryMode(DataLoadMode.Local)
                                        .TriggerAction(TriggerAction.All)
                                        .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ContratPeriode.Fournisseur.ID : (int?)null)
                                        .Store(
                                                X.Store()
                                                    .AutoLoad(true)
                                                    .Model(
                                                            Html.X().Model()
                                                                .IDProperty("ID")
                                                                .Fields(
                                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                    new ModelField("NameAndCode", ModelFieldType.String) { Mapping = "NameAndCode" }
                                                                )
                                                            )
                                                    .Proxy(Html.X().AjaxProxy()
                                                        .Url(Url.Action("LoadSupplierBySite", "Fournisseur"))
                                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                                    )
                                                    .Parameters
                                                    (
                                                        ps => { ps.Add(new StoreParameter("siteID", "App.cmbSite.getValue()", ParameterMode.Raw)); }
                                                    )
                                                ),
                                    X.DateField()
                                        .ID("TxtDateContrat")
                                        .FieldLabel("Date")
                                        .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ContratPeriode.DateContrat.ToString() : DateTime.Now.ToString())
                                        .LabelAlign(LabelAlign.Right)
                                        .AllowBlank(false)
                                        .IndicatorCls("IndicatorRedStar")
                                        .IndicatorText("*")
                                        .ReadOnly(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Extend ? false : true),
                                    X.ComboBox()
                                        .ID("TypeContratID")
                                        .FieldLabel("Type De Contrat")
                                        .DisplayField("Designation")
                                        .ValueField("ID")
                                        .MarginSpec("0 7 10 0")
                                        .LabelAlign(LabelAlign.Right)
                                        .ReadOnly(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Extend || Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Update ? true : false)
                                        .AutoSelect(true)
                                        .ForceSelection(true)
                                        .MatchFieldWidth(false)
                                        .ListConfig( new BoundList {  MinWidth = 300})
                                        .TypeAhead(false)
                                        .QueryMode(DataLoadMode.Local)
                                        .TriggerAction(TriggerAction.All)
                                        .Value(Model._ContratPeriode.ContratPeriodeType.ID)
                                        .Store(
                                                X.Store()
                                                    .AutoLoad(true)
                                                    //.Listeners(l => l.Load.Handler = "App.TypeContratID.setValue(App.TypeContratID.getStore().getAt(0));")
                                                    .Model(
                                                            Html.X().Model()
                                                                .IDProperty("ID")
                                                                .Fields(
                                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                            )
                                                        )
                                                    .Proxy(Html.X().AjaxProxy()
                                                        .Url(Url.Action(ViewData["UrlContratType"].ToString(), "ContratPeriodeType"))
                                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                                            )
                                                    ),
                                    X.DateField()
                                        .ID("TxtStartDate")
                                        .FieldLabel("Debut")
                                        .AllowBlank(false)
                                        .IndicatorCls("IndicatorRedStar")
                                        .IndicatorText("*")
                                        .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ContratPeriode.DateDebut.ToString() : DateTime.Now.ToString())
                                        .LabelAlign(LabelAlign.Right)
                                        //.MinDate(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ContratPeriode.DateContrat.ToString())
                                        .ReadOnly(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Extend ? false : true),
                                    X.DateField()
                                        .ID("TxtDueDate")
                                        .FieldLabel("Fin")
                                        .AllowBlank(false)
                                        .IndicatorCls("IndicatorRedStar")
                                        .IndicatorText("*")
                                        .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ContratPeriode.DateEcheance.ToString() : DateTime.Now.ToString())
                                        .LabelAlign(LabelAlign.Right)

                                ),

                    X.Panel()
                        .Layout(LayoutType.Form)
                        .Flex(2)
                        .Items(

                                X.TextField()
                                    .ID("TxtTonnage")
                                    //.HideTrigger(true)
                                    .FieldLabel("Tonnage (Kg)")
                                    .LabelAlign(LabelAlign.Right)
                                    .AllowBlank(false)
                                    .MaskRe("[0123456789]")
                                    .IndicatorCls("IndicatorRedStar").IndicatorText("*")
                                    .ReadOnly(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Extend ? false : true)
                                    .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ContratPeriode.TonnageAsString : string.Empty)
                                    .Listeners(ls =>
                                    {
                                        ls.Change.Fn = "CalculateAmount";
                                        ls.Blur.Handler = "#{TxtTonnage}.setValue(formatNumber(#{TxtTonnage}.getValue()));";
                                        ls.Focus.Handler = "if (App.TxtTonnage.value) { #{TxtTonnage}.setRawValue(unformatNumber(#{TxtTonnage}.getValue()));}";
                                    })
                                ,
                                X.TextField()
                                    //.HideTrigger(true)
                                    .ID("TxtGrossPrice").FieldLabel("Prix Brut (CFA)")
                                    .LabelAlign(LabelAlign.Right)
                                    .AllowBlank(false)
                                    .IndicatorCls("IndicatorRedStar")
                                    .IndicatorText("*")
                                    .MaskRe("[0123456789]")
                                    .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ContratPeriode.PrixBrutAsString : string.Empty)
                                    .ReadOnly(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Extend ? false : true)
                                    .Listeners(ls =>
                                    {
                                        ls.Change.Fn = "CalculateNetPrice";
                                        ls.Blur.Handler = "#{TxtGrossPrice}.setValue(formatNumber(#{TxtGrossPrice}.getValue()));";
                                        ls.Focus.Handler = "if (App.TxtGrossPrice.value) { #{TxtGrossPrice}.setRawValue(unformatNumber(#{TxtGrossPrice}.getValue()));}";
                                    })
                                //.MinValue(0)
                                //.AllowDecimals(false)
                                ,
                                X.TextField()
                                    .ID("TxtPrime")
                                    //.HideTrigger(true)
                                    .FieldLabel("Coef. PR")
                                    .LabelAlign(LabelAlign.Right)
                                    //.AllowBlank(false)
                                    .MaskRe("[0123456789]")
                                    //.IndicatorCls("IndicatorRedStar").IndicatorText("*")
                                    .ReadOnly(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Extend ? false : true)
                                    .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ContratPeriode.MontantPrimeAsString : string.Empty)
                                    .Listeners(ls =>
                                    {
                                        ls.Change.Fn = "CalculateNetPrice";
                                        ls.Blur.Handler = "#{TxtPrime}.setValue(formatNumber(#{TxtPrime}.getValue()));";
                                        ls.Focus.Handler = "if (App.TxtPrime.value) { #{TxtPrime}.setRawValue(unformatNumber(#{TxtPrime}.getValue()));}";
                                    })
                                ,
                                X.TextField()
                                    //.HideTrigger(true)
                                    .ID("TxtPrice").FieldLabel("Prix (CFA)")
                                    .LabelAlign(LabelAlign.Right)
                                    .AllowBlank(false)
                                    .IndicatorCls("IndicatorRedStar")
                                    .IndicatorText("*")
                                    .ReadOnly(true)
                                    .MaskRe("[0123456789]")
                                    .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ContratPeriode.PrixAsString : string.Empty)
                                    .ReadOnly(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Extend ? false : true)
                                    .Listeners(ls =>
                                    {
                                        ls.Change.Fn = "CalculateAmount";
                                        ls.Blur.Handler = "#{TxtPrice}.setValue(formatNumber(#{TxtPrice}.getValue()));";
                                        ls.Focus.Handler = "if (App.TxtPrice.value) { #{TxtPrice}.setRawValue(unformatNumber(#{TxtPrice}.getValue()));}";
                                    }),
                                X.TextField()
                                    .ID("txtAmount")
                                    .MaskRe("[0123456789]")
                                    .FieldLabel("Montant (CFA)")
                                    .HideTrigger(true)
                                    .TabIndex(8)
                                    .LabelAlign(LabelAlign.Right)
                                    .ReadOnly(true)
                                    .AllowBlank(false)
                                    .IndicatorCls("IndicatorRedStar")
                                    .IndicatorText("*")
                                    //.LabelWidth(146)
                                    //.Width(303)
                                    .Value(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ContratPeriode.MontantAsString : string.Empty)
                                    .Listeners
                                        (
                                        ls =>
                                        {
                                            ls.Blur.Handler = "if (App.txtAmount.value) {#{txtAmount}.setValue(formatNumber(#{txtAmount}.getValue()))}";
                                            ls.Focus.Handler = "if (App.txtAmount.value) { #{txtAmount}.setRawValue(unformatNumber(#{txtAmount}.getValue()));}";
                                        }

                                        ),
                                X.TextArea()
                                    .ID("TxtCommentaire")
                                    .FieldLabel("Commentaire")
                                    .AllowBlank(false)
                                    .IndicatorCls("IndicatorRedStar")
                                    .IndicatorText("*")
                                    .LabelAlign(LabelAlign.Right)
                                    .Text(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.AddNew ? Model._ContratPeriode.Commentaire.ToString() : string.Empty)
                                    .ReadOnly(Model._ExecMode != Tms.Components.Settings.EnumsDefinition.eExecMode.Extend ? false : true)
                            )

)
            )
            .Buttons(
                        X.Button()
                            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnApprove)
                            .ID("BtnApproveContract")
                            .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve ? false : true)
                            .DirectEvents(de =>
                            {

                                de.Click.Url = Url.Action("ApproveFormMethod");
                                de.Click.Before = "return validNew(App.FormForwardContract.id);";
                                de.Click.FormID = "#(return this.up('window').down('form');)";
                                de.Click.Confirmation.ConfirmRequest = true;
                                de.Click.Confirmation.BeforeConfirm = "config.confirmation.title = 'Contrat Periode : Approuver'; config.confirmation.message = 'Do you want to Approve this contract ?';";
                                //de.Click.Success = "Overview.resetButtons();";

                            }),
                        X.Button()
                            .Text("OK")
                            .ID("BtnSubmitContract")
                            .Hidden(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult || Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Approve ? true : false)
                            .DirectEvents(de =>
                            {
                                if (Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Extend)
                                {
                                    de.Click.Url = Url.Action("SubmitExtendFormMethod");
                                    de.Click.Before = "return validNew(App.FormForwardContract.id);";
                                    de.Click.FormID = "#(return this.up('window').down('form');)";
                                    de.Click.EventMask.ShowMask = true;
                                }
                                else {
                                    de.Click.Url = Url.Action("SubmitFormMethod");
                                    de.Click.Before = "return validNew(App.FormForwardContract.id);";
                                    de.Click.FormID = "#(return this.up('window').down('form');)";
                                    de.Click.EventMask.ShowMask = true;
                                }
                            }),
                        X.Button()
                            .Text(Model._ExecMode == Tms.Components.Settings.EnumsDefinition.eExecMode.Consult ? "Fermer" : "Annuler")
                            .Handler("App.FormForwardContract.doClose()")
                            .Cls("btncancel")
                        )


)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
                /*alert(winId);*/
                /*var winId = #{FormFournisseur}.id;*/
                var areAllrequiredFieldsFilled = isFormValid(winId);

                /*
               *   Vérification de la saisie des champs obligatoires
               */
                if (!areAllrequiredFieldsFilled) {
                    console.log('error fields');
                    Ext.Msg.show({ title: 'Contrat Periode : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
                    return false;

                }

                if (App.HiddenFinancingTypeID.value == App.TypeContratID.value) {
                    Ext.Msg.show({ title: 'Contrat Periode : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Financing type is only generated by Financing.', buttons: Ext.Msg.OK });
                    return false;
                }

                /*var startdate = App.TxtStartDate.rawValue;
                var duedate = App.TxtDueDate.rawValue;

                var arrStartDate = startdate.split("/");
                var datebegin = new Date(arrStartDate[2], arrStartDate[1], arrStartDate[0]);
                var arrEndDate = duedate.split("/");
                var dateend = new Date(arrEndDate[2], arrEndDate[1], arrEndDate[0]);

                if (dateend < datebegin) {
                    Ext.Msg.show({ title: 'Contrat Periode : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Date Fin must be Higher/equal to start date !', buttons: Ext.Msg.OK });
                    return false;
                }*/
            };
        /*Ext.onReady(function() {
         #{BtnOk}.on(#{BtnOk}.clickEvent,validNew );
        //})*/
    var CalculateAmount = function () {

        try {

            var Price = unformatNumber(App.TxtPrice.value) || 0;
            var Tonnage = unformatNumber(App.TxtTonnage.value) || 0;
            var Amount = 0;

            App.txtAmount.setValue('');

            if (Ext.isNumeric(Price) && Ext.isNumeric(Tonnage)) {
                App.txtAmount.setValue('0');
                Amount = RoundInt(Price * Tonnage);
                App.txtAmount.setValue(formatNumber(Amount));
            }
        }
        catch (err) {
            Ext.Msg.show({ title: 'Contrat : Amount Calculation ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating amount.', buttons: Ext.Msg.OK });
        }

    };

    var CalculateNetPrice = function () {

        try {

            var gPrice = parseInt(unformatNumber(App.TxtGrossPrice.value) || 0);
            var mPrime = parseInt(unformatNumber(App.TxtPrime.value) || 0);
            var Amount = 0;

            App.TxtPrice.setValue('');

            if (Ext.isNumeric(gPrice) && Ext.isNumeric(mPrime)) {
                /*App.txtAmount.setValue('0');*/
                Amount = gPrice + mPrime;
                App.TxtPrice.setValue(formatNumber(Amount));
                /*CalculateAmount();*/
            }
        }
        catch (err) {
            Ext.Msg.show({ title: 'Contrat : Amount Calculation ', icon: Ext.MessageBox.WARNING, msg: 'Error when calculating amount.', buttons: Ext.Msg.OK });
        }

    };
</script>






