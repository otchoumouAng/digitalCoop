@Scripts.Render("~/bundles/CommonScripts")
<script type="text/javascript">
    var SetExcelList = function () {
        var mList = getRowsForExcel(App.grpListeEmbarquement.columnManager.getColumns(), App.grpListeEmbarquement.getRowsValues({ visibleOnly: true }));
        var BaseUrl = App.BaseUrl.value;
        if (mList) {
            Ext.net.DirectMethod.request({
                url: BaseUrl + "/Report/ExportToExcel",
                cleanRequest: true,
                isUpload: true,
                params: {
                    ItemList: mList
                }
            });
            return true;
        }
        else
            return false;
    };

    var renderIcon = function (value) {
        var tpl = '<span class="glyphicon {0}" aria-hidden="true"></span>';


        //var tpl = '<span class="x-btn-icon-el {0}" aria-hidden="true"></span>';

        var icon_url = Overview.getBootStrapIcons(value);

        //console.log(Ext.String.format(tpl, icon_url));

        return Ext.String.format(tpl, icon_url);
    }



    var iconRenderer = function (value, metaData, record) {

        metaData.css = Overview.getIcons(value);


    }


    var Overview =
    {
        getIcons: function (value) {
            if (value === 0) {
                return 'icon-delete';//Ext.net.ResourceMgr.getIcon('Icon.BulletCross');//'glyphicon-remove';//Ext.net.ResourceMgr.getIconUrl('Icon.BulletCross');
            }
            else if (value == 1) {
                return 'action_approve_02';// 'glyphicon-ok';//Ext.net.ResourceMgr.getIconUrl('Icon.Tick');
            }
            else if (value == 2) {
                return 'action_new_02';//'glyphicon-file';//Ext.net.ResourceMgr.getIconUrl('Icon.Add'); // New  glyphicon glyphicon-ok
            }
        },
        getBootStrapIcons: function (value) {
            if (value === 0) {
                return 'glyphicon-remove red'; // glyphicon glyphicon-remove red
            }
            else if (value == 1) {
                return 'glyphicon-ok green';
            }
            else if (value == 2) {
                return 'glyphicon-file blue'; // glyphicon glyphicon-file blue
            }
            else if (value == 3) {
                return 'glyphicon-retweet green'; // glyphicon glyphicon-file blue
            }
            else if (value == 4) {
                return 'glyphicon-lock red'; // glyphicon glyphicon-file blue
            }
        },
        SummarySh: function () {
            var nbrOfrows = App.grpListeEmbarquement.getStore().getCount();
            var totalTonnage = parseFloat(App.storeListeEmbarquement.sum('Quantite')) || 0;

            totalBalance = FormatAmount(totalTonnage);
            App.lblSummaryShI.setText(" Total Quantity : " + totalBalance + " (T)");
        },
        resetButtons: function () {

          /** Permission control**/
            App.btnModify.disable();
            App.mnuCancel.disable();
            App.mnuPrintOrderTransit.disable();

            if (App.rowSelectionListeEmbarquement.hasSelection()) {

                var isDisabled = App.rowSelectionListeEmbarquement.selected.items[0].data.Desactive;
                
                if (isDisabled === false) {
                    var isPlan = App.rowSelectionListeEmbarquement.selected.items[0].data.IsPlan;
                    if (isPlan === false) {

                        if (App.emhiddenPermModifier.value == 'true')
                            App.btnModify.disable();

                        if (App.emhiddenPermPrintOrderTransit.value == 'true')
                            App.mnuPrintOrderTransit.enable();

                        if (App.emhiddenPermDesactiver.value == 'true') {
                            App.mnuCancel.disable();
                            App.mnuCancel.setText('Desactiver');
                            App.mnuCancel.setIconCls('glyphicon glyphicon-remove red');
                        }

                    }
                    else
                    {
                        if (App.emhiddenPermModifier.value == 'true')
                            App.btnModify.enable();

                        if (App.emhiddenPermPrintOrderTransit.value == 'true')
                            App.mnuPrintOrderTransit.enable();

                        if (App.emhiddenPermDesactiver.value == 'true') {
                            App.mnuCancel.enable();
                            App.mnuCancel.setText('Desactiver');
                            App.mnuCancel.setIconCls('glyphicon glyphicon-remove red');
                        }
                    }

                }

                
                else {
                    App.btnModify.disable();

                    if (App.emhiddenPermActiver.value == 'true') {
                        App.mnuCancel.enable();
                        App.mnuCancel.setText('Activer');
                        App.mnuCancel.setIconCls('glyphicon glyphicon-ok green');
                    }

                }
            }


        }
    }


</script>


