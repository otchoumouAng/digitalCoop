<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Shipment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

        var SoldeContrat = App._cmbContract.lastSelection[0].data.Solde;
        var ContratKey = App._cmbContract.lastSelection[0].data.ID;

        var SoldeEnregistr = App._cmbRegistration.lastSelection[0].data.TonnageRestant;
        var EnregistrKey = App._cmbRegistration.lastSelection[0].data.ID;

        var Quantity = Number(unformatNumberDecimal(App.txtQuantity.value.toString().replace(",", "."))) || 0;

        var ExecMode = App.hiddenExecMode.value;
        if (ExecMode == "Update") {
            var hQuantity = Number(App.hiddenQuantity.value);
            var hContrat = App.hiddenContrat.value;
            var hRegistre = App.hiddenRegistre.value;

            if (hContrat == ContratKey)
                SoldeContrat = SoldeContrat + hQuantity;
            if (hRegistre == EnregistrKey)
                SoldeEnregistr = SoldeEnregistr + hQuantity;
        }


        var PoidsBrut = unformatNumber(App.txtGrossWeight.value) || 0;

        PoidsBrut = PoidsBrut / 1000;

        if (Quantity > SoldeContrat) {
            console.log('Quantity ' + Quantity);
            console.log('SoldeContrat ' + SoldeContrat);
            Ext.Msg.show({ title: 'Shipment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'The quantity is greater than the quantity of the contract.', buttons: Ext.Msg.OK });
            return false;
        }

        if (Quantity > SoldeEnregistr) {
            console.log('Quantity ' + Quantity);
            console.log('SoldeEnregistr ' + SoldeEnregistr);
            Ext.Msg.show({ title: 'Shipment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'the quantity is greater than the quantity of the registration.', buttons: Ext.Msg.OK });
            return false;
        }

        if (App.grpDetailLot.getRowsValues().length < 1) {
            
            Ext.Msg.show({ title: 'Shipment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: '¨Please add lots.', buttons: Ext.Msg.OK });
            return false;
        }

        /*if (Quantity != PoidsBrut) {
           Ext.Msg.show({ title: 'Shipment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'the quantity is different from the gross weight of the lots.', buttons: Ext.Msg.OK });
            return false;
        }*/


        
    };


    var RefreshLot = function () {
        var text = "";
        if (App.grpDetailLot.getRowsValues().length >= 1) {
            for (i = 0; i < App.grpDetailLot.getRowsValues().length; i++) {
                if (App.grpDetailLot.getRowsValues()[i].Desactive == 0) {
                    if(i == 0)
                        text = App.grpDetailLot.getRowsValues()[i].NumeroLot;
                    else
                        text = App.grpDetailLot.getRowsValues()[i].NumeroLot.replace(" ","") +",  " +text  ;


                }
            }

        }

        App.txtLots.setValue(text);

        /***Calcul des poids***/
        var NbreSac = 0;
        console.log(App.HiddenPoidsStdNetUnitaire.value);
        var StdBrutUnitaire = Number(App.HiddeniPoidsStdBrutUnitaire.value) || 0;
        var StdNetUnitaire = Number(App.HiddenPoidsStdNetUnitaire.value) || 0;

        if (App.grpDetailLot.getRowsValues().length >= 1) {
            for (i = 0; i < App.grpDetailLot.getRowsValues().length; i++) {
                if (App.grpDetailLot.getRowsValues()[i].Desactive == 0) {
                    
                    NbreSac = NbreSac + App.grpDetailLot.getRowsValues()[i].NombreSacs;

                }
            }

        }

        var PoidsNet = NbreSac * StdNetUnitaire;
        var PoidsBrut = NbreSac * StdBrutUnitaire;

        App.txtGrossWeight.setValue(formatNumber(PoidsBrut));
        App.txtNetWeight.setValue(formatNumber(PoidsNet));

        /**Control**/
        if (App.grpDetailLot.getRowsValues().length < 1) {
            App._cmbCampagne.setReadOnly(false);
            App._cmbExportateur.setReadOnly(false);
            App._cmbCertification.setReadOnly(false);

        }

    };

    var VerifyQuantity = function () {
        var contrat = App._cmbContract.value;
        var enregistr = App._cmbRegistration.value;

        /*console.log(App._cmbContract);*/
        if((!contrat || contrat == undefined || contrat == "") || (!enregistr || enregistr == undefined || enregistr == ""))
        {

            Ext.Msg.show({ title: 'Shipment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Select a contract and a registration, please.', buttons: Ext.Msg.OK });
            App.txtQuantity.setValue('');
            return false;
        }
        else
        {
            
            var SoldeContrat = App._cmbContract.lastSelection[0].data.Solde;
            var ContratKey = App._cmbContract.lastSelection[0].data.ID;

            var SoldeEnregistr = App._cmbRegistration.lastSelection[0].data.TonnageRestant;
            var EnregistrKey = App._cmbRegistration.lastSelection[0].data.ID;

            var Quantity = Number(unformatNumberDecimal(App.txtQuantity.value.toString().replace(",", "."))) || 0;
            console.log('a ' +Quantity);
            console.log('b ' + SoldeContrat);
            console.log('c ' + SoldeEnregistr);
            var ExecMode = App.hiddenExecMode.value;
            if (ExecMode == "Update")
            {
                var hQuantity = Number(App.hiddenQuantity.value);
                var hContrat = App.hiddenContrat.value;
                var hRegistre = App.hiddenRegistre.value;

                if (hContrat == ContratKey)
                    SoldeContrat = SoldeContrat + hQuantity;
                if (hRegistre == EnregistrKey)
                    SoldeEnregistr = SoldeEnregistr + hQuantity;
            }

            if(Quantity > SoldeContrat)
            {
                console.log('Quantity ' + Quantity);
                console.log('SoldeContrat ' + SoldeContrat);
                Ext.Msg.show({ title: 'Shipment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'The quantity is greater than the Quantity of the contract.', buttons: Ext.Msg.OK });
                return false;
            }

            if (Quantity > SoldeEnregistr) {
                console.log('Quantity ' + Quantity);
                console.log('SoldeEnregistr ' + SoldeEnregistr);
                Ext.Msg.show({ title: 'Shipment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'the quantity is greater than the Quantity of the registration.', buttons: Ext.Msg.OK });
                return false;
            }
           
        }
    };

    var loadValues = function () {
        var contrat = App._cmbContract.value;
        var enregistr = App._cmbRegistration.value;

        /*console.log(App._cmbContract);*/
        if((!contrat || contrat == undefined || contrat == "") || (!enregistr || enregistr == undefined || enregistr == "")){        
            return false;
        }
        else {

            var SoldeContrat = App._cmbContract.lastSelection[0].data.Solde;
            var ContratKey = App._cmbContract.lastSelection[0].data.ID;

            var SoldeEnregistr = App._cmbRegistration.lastSelection[0].data.TonnageRestant;
            var EnregistrKey = App._cmbRegistration.lastSelection[0].data.ID;
            var mDomiciliation = App._cmbContract.lastSelection[0].data.Banque.ID;
            var mCertif = App._cmbContract.lastSelection[0].data.Certification.ID;
            
            var Quantity = Number(unformatNumberDecimal(App.txtQuantity.value.toString().replace(",", "."))) || 0;
            console.log('a ' + Quantity);
            console.log('b ' + SoldeContrat);
            console.log('c ' + SoldeEnregistr);
            var ExecMode = App.hiddenExecMode.value;
            if (ExecMode == "AddNew") {
                App.txtQuantity.setValue(SoldeEnregistr.toString().replace(".", ","));

                if (Number(mDomiciliation)) {
                    App._cmbDomiciliation.setValue(mDomiciliation);
                }

                if (Number(mCertif)) App._cmbCertification.setValue(mCertif);
            }
            
        }
    };

   
    function formatNumberDecimal(amount) {
       
        amount = thousands_separators(amount.toString().replace(".", ","));
        
        formatted = amount.toString().replace(".", ",");
      
        return formatted;
    };

    function unformatNumberDecimal(amount) {
        formatted = amount.toString().replace(" ", "");

        return formatted;
    };

    function thousands_separators(num) {
        var num_parts = num.toString().split(".");
        num_parts[0] = num_parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, " ");
        return num_parts.join(".");
    };
    

</script>

