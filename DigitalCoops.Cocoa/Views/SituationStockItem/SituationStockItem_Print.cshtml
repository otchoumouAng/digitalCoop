@{
    Layout = null;
    var X = Html.X();
    string StartDate = DateTime.Now.AddDays(-60).ToShortDateString();
    string EndDate = DateTime.Now.ToShortDateString();
    string BaseUrl = (new Tms.Classes.Shared.Parametres(0).Base_url);
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
    <style type="text/css">
        .header_style {
            background-color: white;
        }

        .x-form-text-default.x-form-textarea {
            line-height: 17px;
            min-height: 50px !important;
        }

        .title_style {
            color: black;
            font-size: small;
            line-height: inherit;
        }

        .frame_title_style {
            border: 1px solid transparent !important;
            border-bottom-width: 0px !important;
            color: black;
            font-size: small;
            line-height: inherit;
        }


        .x-form-layout-auto-label > * > .x-form-item-label {
            width: 100px !important;
        }

        .x-panel .x-panel-header-default-framed-top {
            border-bottom-width: 0px !important;
        }
    </style>

</head>
@(
X.Window()
    .ID("SituationStockItem_Print")
    .Width(700)
    .Resizable(false)
    .Height(230)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    //.X(20)
    .Y(20)
    .Title("Stoct Statut : Print")
    .BodyPadding(5)
    .Items
    (
        X.FormPanel()
            .Layout(LayoutType.HBox)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch })
            .Items
            (

    #region Zone A
                    X.Container()
                            .Border(false)
                            .Frame(false)
                            .Flex(1)
                            .Layout(LayoutType.Form)
                            .Items
                            (
                                X.ComboBox()
                                    .ID("cmbMagasin")
                                    .FieldLabel("Magasin")
                                    .DisplayField("Designation")
                                    .ValueField("ID")
                                    .LabelAlign(LabelAlign.Right)
                                    .Value(int.Parse(ViewData["magasinID"].ToString()))
                                    .Store
                                    (
                                        X.Store()
                                            .AutoLoad(true)
                                            .Model
                                            (
                                                Html.X().Model().IDProperty("ID")
                                                .Fields
                                                (
                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                )
                                            )
                                            .Proxy
                                            (
                                                Html.X().AjaxProxy()
                                                .Url(Url.Action("LoadActiveMagasinWithAccess", "Magasin"))
                                                .Reader(Html.X().JsonReader().RootProperty("data"))
                                            )
                                            .Listeners
                                            (
                                                li => li.Load.Handler = "if (App.cmbEmplacement.value) {App.cmbEmplacement.clearValue()}; App.cmbEmplacement.getStore().load();"
                                            )
                                    )
                                    .Listeners
                                    (
                                        ls =>
                                        {
                                            ls.Select.Handler = "if (App.cmbEmplacement.value) {App.cmbEmplacement.clearValue()}; App.cmbEmplacement.getStore().load();";
                                            ls.Change.Handler = "if (App.cmbEmplacement.value) {App.cmbEmplacement.clearValue()}; App.cmbEmplacement.getStore().load();";
                                        }
                                    ),
                                X.ComboBox()
                                    .ID("cmbCampagne")
                                    .FieldLabel("Campagne")
                                    .DisplayField("Designation")
                                    .ValueField("Designation")
                                    .LabelAlign(LabelAlign.Right)
                                    .Value(ViewData["Campagne"])
                                    .Store
                                    (
                                            X.Store()
                                                .AutoLoad(true)
                                                .Model
                                                (
                                                    Html.X().Model().IDProperty("Designation")
                                                        .Fields
                                                        (
                                                            new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" },
                                                            new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                        )
                                                    )
                                            .Proxy
                                            (
                                                Html.X().AjaxProxy()
                                            .Url(Url.Action("LoadCampagneAll", "Campagne"))
                                            .Reader(Html.X().JsonReader().RootProperty("data"))
                                            )
                                    ),
                            //    .DirectEvents(
                            //        de =>
                            //        {
                            //            de.Select.Url = Url.Action("OnChangeCampagne");
                            //            de.Select.ExtraParams.Add(new Parameter { Name = "ItemCampagne", Encode = false, Value = "#{cmbCampagne}.getValue()", Mode = ParameterMode.Raw });
                            //            de.Select.Success = "App.txtFiltreDateFin.setMinValue(App.cmbCampagne.getSelectedRecord().data.DateDebutAsString)";

                            //        }
                            //),
                            X.ComboBox()
                                .ID("cmbExportateur")
                                .FieldLabel("Exportateur")
                                .DisplayField("Nom")
                                .ValueField("ID")
                                .LabelAlign(LabelAlign.Right)
                                .QueryMode(DataLoadMode.Local)
                                .TriggerAction(TriggerAction.All)
                                .Value(ViewData["Exportateur"])
                                //.MatchFieldWidth(false)
                                //.ListConfig(new BoundList { MinWidth = 300 })
                                .Store
                                (
                                        X.Store()
                                        .AutoLoad(true)
                                        .Model
                                        (
                                            Html.X().Model()
                                            .IDProperty("ID")
                                            .Fields
                                            (
                                                new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                            )
                                        )
                                        .Proxy
                                        (
                                            Html.X().AjaxProxy()
                                        .Url(Url.Action("LoadExportateurActive", "Exportateur"))
                                        .Reader(Html.X().JsonReader().RootProperty("data"))
                                        )

                                )

                        ),
    #endregion
    #region Zone B
                    X.Container()
                        .Border(false)
                        .Frame(false)
                        .Flex(1)
                        .Layout(LayoutType.Form)
                        .Items
                        (
                            //X.DateField().ID("dtpFiltreStartDate").FieldLabel("Debut").ReadOnly(true).LabelAlign(LabelAlign.Right),
                            X.DateField()
                                .ID("txtDateFin")
                                .FieldLabel("Date")
                                .LabelAlign(LabelAlign.Right)
                                .Text(DateTime.Now.ToString()),
                                //.MinDate(DateTime.Parse(ViewData["CampagneMinDate"].ToString())),
                            X.ComboBox()
                                    .ID("cmbEmplacement")
                                    .FieldLabel("Position")
                                    .DisplayField("Designation")
                                    .ValueField("ID")
                                    .LabelAlign(LabelAlign.Right)
                                    .Store
                                    (
                                            X.Store()
                                                .AutoLoad(false)
                                                .Model
                                                (
                                                    Html.X().Model().IDProperty("ID")
                                                        .Fields
                                                        (
                                                            new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                            new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                        )
                                                    )
                                            .Proxy
                                            (
                                                Html.X().AjaxProxy()
                                                    .Url(Url.Action("LoadActiveEmplacement", "Emplacement"))
                                                    .Reader(Html.X().JsonReader().RootProperty("data"))
                                            )
                                            .Parameters
                                            (
                                                ps =>
                                                {
                                                    ps.Add(new StoreParameter("ItemMagasin", "#{cmbMagasin}.getValue()", ParameterMode.Raw));
                                                }
                                            )
                                            .Listeners
                                            (
                                                li =>
                                                {
                                                    li.Load.Handler = "var combo = App.cmbEmplacement; combo.setValue(records.length > 0 ? records[0].data.ID : -1);";
                                                }
                                            )
                                    )
                        )
    #endregion


            )
    )
    .Buttons
    (
        X.Button()
            .Text("OK")
            .ID("")
            .DirectEvents(de =>
            {
                de.Click.Url = Url.Action("PrintList");
                de.Click.Before = "return validNew(App.SituationStockItem_Print.id);";
                de.Click.FormID = "#(return this.up('window').down('form');)";
            }),
        X.Button()
            .Text(DigitalCoops.Cocoa.Properties.Resources.BtnCancel)
            .Handler("App.SituationStockItem_Print.doClose()")
            .Cls("btncancel")
    )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Error : Stock Status - (Items) ', msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }

    };


</script>










