
@model Tms.Classes.Business.PayementViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />

</head>
<script src="~/Scripts/FormatAmount.js"></script>
@(       
X.Window()
    .ID("FormPendingPayement")
    .Width(900)
    .Resizable(false)
    .Height(400)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    //.X(400)
    .Y(30)
    .Title("Paiement : Element en attente")
    .Layout(LayoutType.VBox)
    .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch, Pack = BoxPack.Start })
    .Items(
             X.FormPanel()
                .Items(
                                X.Panel()
                                    .Layout(LayoutType.Form)
                                    .MaxWidth(550)
                                    .Items(
                                    X.ComboBox()
                                                        .ID("cmbPendingPayementSiteID")
                                                        .FieldLabel("Site")
                                                        .DisplayField("Nom")
                                                        .ValueField("ID")
                                                        .MatchFieldWidth(false)
                                                        .ListConfig(new BoundList { MinWidth = 300 })
                                                        .LabelAlign(LabelAlign.Right)
                                                        .TypeAhead(false)
                                                        .QueryMode(DataLoadMode.Local)
                                                        .TriggerAction(TriggerAction.All)
                                                        .ForceSelection(true)
                                                        .ReadOnly(true)
                                                        .Value(Model._Payement.Sites.ID)
                                                        .Store(
                                                                X.Store()
                                                                .AutoLoad(true)
                                                                .Model(
                                                                        X.Model()
                                                                        .IDProperty("ID")
                                                                        .Fields(
                                                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                                    new ModelField("Nom", ModelFieldType.String) { Mapping = "Nom" }
                                                                                )
                                                                    )
                                                                .Proxy(
                                                                            X.AjaxProxy()
                                                                            .Url(Url.Action("LoadAllSiteByAccess", "Site"))
                                                                .Reader(
                                                                            X.JsonReader().RootProperty("data")
                                                                            )
                                                                )
                                                        ).Listeners(
                                                                ls =>
                                                                {
                                                                    ls.Select.Handler = "if (App.CmbPendingPayementTypeID.value) { App.CmbPendingPayementFounisseurID.clearValue(); App.CmbPendingPayementFounisseurID.getStore().load(); };";
                                                                }
                                                            ),

                                            X.ComboBox()
                                                .ID("CmbPendingPayementTypeID")
                                                .AllowBlank(false).IndicatorCls("IndicatorRedStar").IndicatorText("*")
                                                .FieldLabel("Type de Paiement")
                                                .DisplayField("Designation")
                                                .ValueField("ID")
                                                .LabelWidth(120)
                                                //.MatchFieldWidth(false)
                                                //.ListConfig(new BoundList { MinWidth = 300 })
                                                .LabelAlign(LabelAlign.Right)
                                                .TypeAhead(false)
                                                .QueryMode(DataLoadMode.Local)
                                                .TriggerAction(TriggerAction.All)
                                                .ForceSelection(true)
                                                .Store(
                                                        X.Store()
                                                            .AutoLoad(true)
                                                            .Model(
                                                                    X
                                                                        .Model()
                                                                        .IDProperty("ID")
                                                                        .Fields(
                                                                                    new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                                    new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                                                )
                                                                )
                                                            .Proxy(
                                                                    X
                                                                        .AjaxProxy()
                                                                        .Url(
                                                                                Url.Action("LoadAll", "PayementType")
                                                                                )
                                                            .Reader(
                                                                        X.JsonReader().RootProperty("data")
                                                                        )
                                                    )
                                                    )
                                                .Listeners(li =>
                                                {
                                                    li.Select.Handler = "App.CmbPendingPayementFounisseurID.clearValue(); App.CmbPendingPayementFounisseurID.getStore().load(); App.storePendingViewPayementItem.removeAll(); App.grpListePendingViewInvoice.getStore().load();";
                                                    li.Change.Handler = "App.CmbPendingPayementFounisseurID.clearValue(); App.CmbPendingPayementFounisseurID.getStore().load(); App.storePendingViewPayementItem.removeAll(); App.grpListePendingViewInvoice.getStore().load();";
                                                }
                                                    )
                                            ,

                                            X.ComboBox()
                                                .ID("CmbPendingPayementFounisseurID")
                                                .FieldLabel("Fournisseur")
                                                .LabelWidth(120)
                                                .MatchFieldWidth(false)
                                                .ListConfig(new BoundList { MinWidth = 350 })
                                                .DisplayField("NameAndCode")
                                                .ValueField("ID")
                                                .LabelAlign(LabelAlign.Right)
                                                .TypeAhead(false)
                                                .ForceSelection(true)
                                                .QueryMode(DataLoadMode.Local)
                                                .TriggerAction(TriggerAction.All)
                                                .SelectedItems(se => { se.Add(new ListItem { Text = "{Tous}", Value = "-1" }); })
                                                .Store(
                                                        X.Store()
                                                            .AutoLoad(false)
                                                            .Model(
                                                                    X
                                                                        .Model()
                                                                        .IDProperty("ID")
                                                                        .Fields(
                                                                                new ModelField("ID", ModelFieldType.Int) { Mapping = "ID" },
                                                                                new ModelField("NameAndCode", ModelFieldType.String) { Mapping = "NameAndCode" }
                                                                                )
                                                                    )
                                                            .Proxy(
                                                                    X
                                                                        .AjaxProxy()
                                                                        .Url(
                                                                                Url.Action("LoadFournisseurByPayementTypeAll", "Fournisseur")
                                                                            )
                                                                        .Reader(
                                                                                X.JsonReader().RootProperty("data")
                                                                                )
                                                                )
                                                            //.Listeners(li => li.Load.Handler = "var combo = App.CmbPendingPayementFounisseurID;if(App.PayementHiddenExecMode.value == 'AddNew') { combo.setValue(records[0].get(combo.valueField)); } ")
                                                            .Parameters
                                                            (
                                                                ps => {
                                                                    ps.Add(new StoreParameter("PayementTypeID", "App.CmbPendingPayementTypeID.getValue()", ParameterMode.Raw));
                                                                    ps.Add(new StoreParameter("SiteID", "App.cmbPendingPayementSiteID.getValue()", ParameterMode.Raw));
                                                                }

                                                            )

                                                        )
                                                .Listeners(li =>
                                                {
                                                    li.Select.Handler = "App.storePendingViewPayementItem.removeAll(); App.grpListePendingViewInvoice.getStore().load();";
                                                    li.Change.Handler = "App.storePendingViewPayementItem.removeAll(); App.grpListePendingViewInvoice.getStore().load();";
                                                }
                                                )


                                            ),
                           X.Panel()
                                .Layout(LayoutType.Fit)
                                .MarginSpec("10 10 5 10")
                                .Items(
                                    X.GridPanel()
                                       .Layout(LayoutType.Fit)
                                       .ID("grpListePendingViewInvoice")
                                       .Region(Region.Center)
                                       .ForceFit(true)
                                       .Border(true)
                                       .Height(200)
                                       .AllowDeselect(true)
                                       .Store(
                                                X.StoreFor<Tms.Classes.Shared.PayementItem>()
                                                    .ID("storePendingViewPayementItem")
                                                    .AutoLoad(false)
                                                    .Proxy(
                                                           X.AjaxProxy()
                                                           .Url(Url.Action("SelectPayementItems"))
                                                           .Reader(
                                                                    X.JsonReader().RootProperty("data")
                                                                    )
                                                      )
                                                    .Parameters(ps =>
                                                    {
                                                        ps.Add(new StoreParameter("ItemFournisseur", "#{CmbPendingPayementFounisseurID}.getValue()", ParameterMode.Raw));
                                                        ps.Add(new StoreParameter("ItemType", "#{CmbPendingPayementTypeID}.getValue()", ParameterMode.Raw));
                                                        ps.Add(new StoreParameter("ItemSite", "#{cmbPendingPayementSiteID}.getValue()", ParameterMode.Raw));
                                                    })
                                                    .Listeners(ls => ls.Load.Fn = "GetTotalAmount")
                                        )
                                        .ColumnModel
                                        (
                                            X.Column().Text("Date").DataIndex("DateItemAsString").Flex(1),
                                            X.Column().Text("Item N°").DataIndex("Reference").Flex(1),
                                            X.Column().Text("Item Type").DataIndex("PayementType").Flex(1),
                                            //X.Column().Text("Description").DataIndex("Description"),
                                            X.Column().Text("Fournisseur").DataIndex("Fournisseur").Renderer("renderNameAndCode").Flex(2),
                                            X.Column().Text("Montant").DataIndex("OldMontantAsString").Flex(1).Hideable(false).EmptyCellText("0"),
                                            X.Column().Text("Solde").DataIndex("SoldeAsString").Flex(1).EmptyCellText("0")
                                        //X.Column().Text("A Payer").DataIndex("NewMontant").Flex(1).EmptyCellText("0")
                                        //X.Column().Text("Montant").DataIndex("MontantAsString").Flex(1).EmptyCellText("0")
                                        )
                                        .SelectionModel(
                                            X.RowSelectionModel()
                                            .Mode(SelectionMode.Single)
                                            .AllowDeselect(true)
                                        )
                            ),
                           X.Panel()
                            .Layout(LayoutType.VBox)
                            .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Right })
                            .MarginSpec("0 10 0 0")
                            .Items(
                                    X.TextField()
                                        .ID("TxtTotalPayement")
                                        .FieldLabel("Total")
                                        .LabelStyle("font-weight:bold;")
                                        .LabelAlign(LabelAlign.Right).Text("0")
                                        .ReadOnly(true)
                                        .FieldStyle("text-align: right; font-weight: bold;")

                            )
)
            )
            .Buttons(

                        X.Button().Text("Fermer").Handler("App.FormPendingPayement.doClose()")

                    )

)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript">
    var validNew = function (winId) {
                    /*alert(winId);*/
                    /*var winId = #{FormFournisseur}.id;*/
                    var areAllrequiredFieldsFilled = isFormValid(winId);

                    /*
                   *   Vérification de la saisie des champs obligatoires
                   */
                    if (!areAllrequiredFieldsFilled) {
                        console.log('error fileds');
                        Ext.Msg.show({ title: 'Payment : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Please enter the delivery ID', buttons: Ext.Msg.OK });
                        return false;
                    }

                }

        /*Ext.onReady(function() {
         #{BtnOk}.on(#{BtnOk}.clickEvent,validNew );
        //})*/
</script>
<script type="text/javascript">
    var GetTotalAmount = function () {
        var nbr = App.grpListePendingViewInvoice.getStore().getCount();
        var total = 0;
        if (nbr > 0) {

            for (var i = 0; i < nbr; i++) {                
                var newvalue = parseFloat(App.grpListePendingViewInvoice.getRowsValues()[i].Montant);
                total += newvalue;
            }
            total = FormatAmount(total);
            App.TxtTotalPayement.setValue(total);
        } else {
            App.TxtTotalPayement.setValue(0);
        }

    };

    var renderNameAndCode = function (value) {
        if (!Ext.isEmpty(value)) {
            if (value.NameAndCode)
                return value.NameAndCode;
        }

        return value;
    };
</script>



