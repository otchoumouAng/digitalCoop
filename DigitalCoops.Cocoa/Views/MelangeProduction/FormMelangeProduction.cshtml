    var loadFilter = function (plugin) {
        var filterRawValue = App.cmbMelange.getRawValue();
        var filtervalue = App.cmbMelange.getValue();
        if (filtervalue != '-1') {
            plugin.setValue({
                MelangeAsString: filterRawValue
            });
        } else {
            App.BtnClearFilter.fireHandler();
        }
    };

    var SetOrdreProductionValues = function () {
        App.cmbChefQuart.setValue(App.cmbProduction.getSelectedRecord().data.ChefQuartAsString);
        App.cmbQuart.setValue(App.cmbProduction.getSelectedRecord().data.QuartAsString);
        App.cmbMelangeur.setValue(App.cmbProduction.getSelectedRecord().data.MelangeurAsString);
        App.cmbCampagne.setValue(App.cmbProduction.getSelectedRecord().data.CampagneAsString);
        App.txtDateProduction.setValue(App.cmbProduction.getSelectedRecord().data.DateProductionAstring);
    }
</script>