@model Tms.Classes.Business.stock.Lot_GestionStockViewModel
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style>
    .x-form-layout-auto-label > * > .x-form-item-label {
        width: 140px !important;
    }

    .x-form-text-default.x-form-textarea {
        line-height: 17px;
        min-height: 50px !important;
    }
</style>
<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>

@(
X.Window()
    .ID("FormImport_Lot")
    .Width(280)
    .Resizable(false)
    .Height(180)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    //.X(400)
    .Y(20)
    .Title("Importer Lot")
    .Items
    (
        X.FormPanel()
            .Layout(LayoutType.Form)
            //.LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })            
            .Items(
                     X.DateField()
                        .ID("TxtDateDebut")
                        .TabIndex(1)
                        .FieldLabel("Date Debut")
                        .Text(DateTime.Now.ToShortDateString())
                        .LabelAlign(LabelAlign.Right)
                        .AllowBlank(false)
                        //.SubmitFormat("d/m/Y H:i:s")
                        .IndicatorCls("IndicatorRedStar")
                        .IndicatorText("*"),
                     X.DateField()
                        .ID("TxtDateFin")
                        .TabIndex(2)
                        .FieldLabel("Date Fin")
                        .Text(DateTime.Now.ToShortDateString())
                        .LabelAlign(LabelAlign.Right)
                        .AllowBlank(false)
                        //.SubmitFormat("d/m/Y H:i:s")
                        .IndicatorCls("IndicatorRedStar")
                        .IndicatorText("*")

            )
    )
    .Buttons
    (
        X.Button()
            .Text("OK")
            .ID("BtnOk")
            .TabIndex(14)
            .DirectEvents
            (
                de =>
                {
                    de.Click.Url = Url.Action("FetchFromApi_New1", "Lot_GestionStock");
                    de.Click.EventMask.ShowMask = true;
                    de.Click.Success = "handleSuccess(response);";
                    de.Click.Failure = "handleFailure(response);";
                    de.Click.ExtraParams.AddRange(new Parameter[]
                       {
                            new Parameter
                            {
                                Name = "debut",
                                Value = "Ext.util.Format.date(App.TxtDateDebut.getValue(), 'Y-m-d')",
                                Mode = ParameterMode.Raw
                            },
                            new Parameter
                            {
                                Name = "fin",
                                Value = "Ext.util.Format.date(App.TxtDateFin.getValue(), 'Y-m-d')",
                                Mode = ParameterMode.Raw
                            }
                       });
                    //de.Click.FormID = "#(return this.up('window').down('form');)";
                    //de.Click.Before = "return validNew(App.FormImport_Lot.id);";
                }
            ),
        X.Button()
            .TabIndex(15)
            .Text("Fermer")
            .Handler("App.FormImport_Lot.doClose()")
            .Cls("btncancel")
    )
)

@Scripts.Render("~/bundles/validation")

<script type="text/javascript" src="~/Scripts/FormatNumber.js"></script>
<script type="text/javascript">

    var validNew = function (winId) {
        /*alert(winId);*/
        /*var winId = #{FormFournisseur}.id;*/
        var areAllrequiredFieldsFilled = isFormValid(winId);

        /*
       *   Vérification de la saisie des champs obligatoires
       */
        if (!areAllrequiredFieldsFilled) {

            Ext.Msg.show({ title: 'Production - Lot_GestionStock : Data Validation ', icon: Ext.MessageBox.WARNING, msg: 'Veuillez remplir les champs réquis.', buttons: Ext.Msg.OK });
            return false;
        }     
    };
    function handleSuccess(response) {
        var result = response.result;
        if (result.success) {
            Ext.Msg.alert("Success",
                "Importation de " + result.records + " Lots\n" +
                result.message,
                function () {
                    /* Optional: Refresh grid or update UI*/
                });
        } else {
            Ext.Msg.alert("Error", result.error || "Unknown error occurred");
        }
    }

    function handleFailure(response) {
        Ext.Msg.alert("Error",
            "Server request failed: " + response.statusText + "\n" +
            "Status code: " + response.status);
    }
</script>