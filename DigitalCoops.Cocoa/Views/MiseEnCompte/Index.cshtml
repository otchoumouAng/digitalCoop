                                                      .LabelWidth(110)
                                                      .DisplayField("Description")
                                                      .ValueField("ID")
                                                      .LabelAlign(LabelAlign.Right)
                                                      .TypeAhead(true)
                                                      .ForceSelection(true)
                                                      .Items
                                                      (
                                                         it =>
                                                         {
                                                             it.Add(new ListItem { Text = "{Tous}", Value = "%%" });
                                                             it.Add(new ListItem { Text = "Paid", Value = "PA" });
                                                             it.Add(new ListItem { Text = "Unpaid", Value = "UP" });
                                                         }
                                                      )
                                                      .SelectedItems
                                                      (
                                                         it =>
                                                         {
                                                             it.Add(new ListItem { Text = "Unpaid", Value = "UP" });
                                                         }
                                                      )

                                ),

                            X.Panel()
                                .Layout(LayoutType.Form)                                
                                .Flex(2)
                                .Items
                                (
                                    X.DateField().ID("dtpStartDate").FieldLabel("Debut").LabelAlign(LabelAlign.Right).Text(""),
                                    X.DateField().ID("dtpEndDate").FieldLabel("Fin").LabelAlign(LabelAlign.Right).Text("")
                                ),


                               X.Panel()
                                .ID("formOverview")
                                .Flex(2)
                                .Border(false)
                                //.BodyPadding(6)
                                .Layout(LayoutType.HBox)
                                .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
                                .Items
                                 (
                                    X.Container()
                                    .ID("")
                                    .Layout(LayoutType.VBox)
                                    .LayoutConfig(new VBoxLayoutConfig { Pack = BoxPack.Center })
                                    .Items(X.Label().ID("lblSummaryMEC").Text("Montant").EmptyText(""))
