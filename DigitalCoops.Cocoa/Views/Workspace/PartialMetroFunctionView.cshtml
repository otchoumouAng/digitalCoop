@*@model IEnumerable<Tms2017.MVC.Models.Module>*@
@model IEnumerable<Tms.Classes.Security.Module>
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/metro.min.css" />
    <link rel="stylesheet" href="~/Content/metro-icons.min.css" />
    <link rel="stylesheet" href="~/Content/metro-colors.min.css" />
    <link rel="stylesheet" href="~/Content/metro-responsive.min.css" />
    <link rel="stylesheet" href="~/Content/metro-schemes.min.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<script src="~/Scripts/FunctionHelpers.js"></script>

<style type="text/css">
    body {
        height: 10% !important;
    }

    .tile-container a {
        text-decoration: none;
        color: white;
    }

    .tile-container {
        width: 800px;
        margin: 0 auto;
        background-color: transparent !important;
    }


    .tile {
        width: 100px;
        height: 100px;
        float: left;
        margin: 5px;
        box-shadow: inset 0 0 1px #FFC;
        position: relative;
        user-select: none;
    }

    .tile-cfg {
        width: 150px;
        height: 60px;
        float: left;
        margin: 5px;
        box-shadow: inset 0 0 1px #FFC;
        position: relative;
        user-select: none;
    }

    .tile-wide-cust {
        float: left;
        margin: 5px;
        box-shadow: inset 0 0 1px #FFC;
        position: relative;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        width: 260px;
        height: 100px;
    }



    .tile-content.iconic .icon {
        position: absolute;
        width: 64px;
        height: 64px;
        font-size: 48px;
        top: 50%;
        margin-top: -40px;
        left: 50%;
        margin-left: -32px;
        text-align: center;
    }


    .tile-container {
        width: 800px;
        margin: 0 auto;
        padding-top: 10px;
        /* top: 25%; */
        /* float: none; */
        /* position: absolute; */
        /* left: unset; */
    }

    .tile-content.iconic .icon-cfg {
        position: absolute;
        color: rgba(0, 0, 0, 0.20);
        width: 64px;
        height: 34px;
        font-size: 40px;
        top: 50%;
        margin-top: -20px;
        left: 50%;
        /* margin-left: -32px; */
        text-align: center;
        /* z-index: 1; */
    }


    .tile-wide {
        float: left;
        margin: 5px;
        box-shadow: inset 0 0 1px #FFC;
        position: relative;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        width: 260px;
        height: 100px;
    }

    .tile-mid {
        float: left;
        margin: 5px;
        box-shadow: inset 0 0 1px #FFC;
        position: relative;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        width: 153px;
        height: 100px;
    }

        .tile-mid .tile-label {
            position: absolute;
            bottom: 0;
            left: .625rem;
            padding: .425rem .25rem;
            z-index: 999;
        }

    .tile-cfg .tile-label {
        position: absolute;
        bottom: 0;
        left: .625rem;
        padding: .425rem .25rem;
        z-index: 999;
    }
</style>

<div class="tile-container">

    @if (Model.Count() > 0)
    {
        foreach (var Item in Model)
        {
            <a href="javascript:addTab(window.parent.Ext.getCmp('tabCenter'),'@Item.ID.ToString()', '@Item.FullUrl', this,'@Item.Nom','overview');">
                <div class="@Item.DisplayOnTwoCols @Item.BackGroundColor fg-white" data-role="tile">
                    <div class="tile-content iconic">
                        <span class="@Item.IconModule"></span>
                        <span class="tile-label fg-white"> @Item.Nom </span>
                    </div>
                </div>
            </a>

        }
    }    

</div>




