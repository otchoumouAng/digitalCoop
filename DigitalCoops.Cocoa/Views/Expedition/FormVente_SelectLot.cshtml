@model Tms.Classes.Business.Sites.VenteLotDetail
@{
    Layout = null;
    var X = Html.X();
}
<head>
    <link rel="stylesheet" href="~/Content/IconsStyles.css" />
    <link rel="stylesheet" href="~/Content/CustomStyles.css" />
</head>
<style>
    .x-btn-default-toolbar-small {
        padding: 2px 7px 2px 7px;
    }
</style>
<script>

    var SetValidBtnOK = function () {
        if (App.RowPendingLivforWeighing.hasSelection())
            App.BtnSendBlDelivery.enable();
        else
            App.BtnSendBlDelivery.disable();
    };
</script>
@(
X.Window()
    .ID("FormVente_SelectLot")
    .Width(700)
    .Resizable(false)
    .Height(460)
    .Modal(true)
    .CloseAction(Ext.Net.CloseAction.Destroy)
    .X(200)
    .Y(20)
    .Title("Lots disponibles")
    .Layout(LayoutType.VBox)
    .BodyPadding(5)
    .LayoutConfig(new VBoxLayoutConfig { Align = VBoxAlign.Stretch })
    .Items
    (
        X.Hidden().ID("VenteID").Value(Model.VenteLot.ID),
        X.Panel()
            .Border(true)
            //.Frame(true)
            .LayoutConfig(new HBoxLayoutConfig { Align = HBoxAlign.Stretch, Pack = BoxPack.Center })
            .Items
            (
    #region Zone A
                    X.Container()
                        .Flex(3)
                        .Layout(LayoutType.Form)
                        .Items
                        (
                         X.Button().ID("BtnReloadListe").Text("OK").Hidden(true)
                                .DirectEvents(de =>
                                {
                                    de.Click.Url = Url.Action("SetAvailableNbrSacs");
                                    de.Click.FormID = "#(return this.up('window').down('form');)";
                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemListeAdded", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListeBL.getRowsValues({selectedOnly : false})" });
                                    de.Click.ExtraParams.Add(new Parameter { Name = "ItemListeToAdd", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListLots.getRowsValues({selectedOnly : false})" });

                                }),
                            X.ComboBox()
                                                .ID("cmbDetCropVt")
                                                .FieldLabel("Campagne")
                                                .MarginSpec("0 8 5 0")
                                                .DisplayField("Designation")
                                                .ValueField("Designation")
                                                .QueryMode(DataLoadMode.Local)
                                                .TriggerAction(TriggerAction.All)
                                                .LabelAlign(LabelAlign.Right)
                                                .AllowBlank(false)
                                                .IndicatorCls("IndicatorRedStar")
                                                .IndicatorText("*")
                                                .Value(Model.VenteLot.Campagne.Designation)
                                                .Store
                                                (
                                                    X.Store()
                                                    .AutoLoad(true)
                                                    .Model
                                                    (
                                                        Html.X().Model()
                                                            .IDProperty("Designation")
                                                            .Fields
                                                            (
                                                                new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" },
                                                                new ModelField("Designation", ModelFieldType.String) { Mapping = "Designation" }
                                                            )
                                                        )
                                                        .Proxy
                                                        (
                                                            X.AjaxProxy().Url(Url.Action("LoadCampagne", "Campagne"))
                                                                .Reader(Html.X().JsonReader().RootProperty("data"))
                                                        )
                                                    )

                        ),
    #endregion
    #region Zone B
                    X.Container()
                        .Flex(2)
                        .Layout(LayoutType.Form)
                        .Items
                        (
                            X.DateField().ID("livFiltreDateDebut").FieldLabel("Debut").LabelAlign(LabelAlign.Right).Text(DateTime.Now.AddDays(-7).ToString()),
                            X.DateField().ID("txtFiltreDateFin").FieldLabel("Fin").LabelAlign(LabelAlign.Right).Text(DateTime.Now.ToString())
                        )
    #endregion
        ),
        //X.Button().ID("BtnReloadListe").Text("OK").Hidden(true)
        //    .DirectEvents(de =>
        //    {
        //        de.Click.Url = Url.Action("SetAvailableNbrSacs");
        //        de.Click.FormID = "#(return this.up('window').down('form');)";
        //        de.Click.ExtraParams.Add(new Parameter { Name = "ItemListeAdded", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListeWeightPAU.getRowsValues({selectedOnly : false})" });
        //        de.Click.ExtraParams.Add(new Parameter { Name = "ItemListeToAdd", Encode = true, Mode = ParameterMode.Raw, Value = "App.grpListLots.getRowsValues({selectedOnly : false})" });

        //    }),
        X.GridPanel()
            .Layout(LayoutType.Fit)
            .ID("grpListLots")
            .MarginSpec("5 0 0 0")
            .Frame(true)
            .Height(290)
            .AllowDeselect(true)
            .Store
            (
                X.StoreFor<Tms.Classes.Business.Sites.LotCoop>()
                    .ID("storeListeLot")
                    .AutoLoad(true)
                    .Proxy
                    (
                    Html.X().AjaxProxy()
                        .Url(Url.Action("LoadListOfAvailableLotExpedition", "Expedition"))
                        .Reader(Html.X().JsonReader().RootProperty("data"))
                    )
                    .Listeners(
                        ls =>
                        {
                            ls.BeforeLoad.Handler = "Ext.net.Mask.show();";
                            ls.Load.Handler = "Ext.net.Mask.hide();  FilterDeliveries();";
                            //ls.Load.Handler = "Ext.net.Mask.hide(); App.BtnReloadListe.fireEvent('click', App.BtnReloadListe);";
                        }
                    )
                    .Parameters
                    (
                        ps =>
                        {
                            ps.Add(new StoreParameter("ItemSite", string.Format("{0}", Model.VenteLot.Sites.ID.ToString()), ParameterMode.Value));
                            ps.Add(new StoreParameter("ItemCampagne", "App.cmbDetCropVt.getValue()", ParameterMode.Raw));
                            ps.Add(new StoreParameter("ItemPeriodStart", "#{livFiltreDateDebut}.getRawValue()", ParameterMode.Raw));
                            ps.Add(new StoreParameter("ItemPeriodEnd", "#{txtFiltreDateFin}.getRawValue()", ParameterMode.Raw));
                            //ps.Add(new StoreParameter("ItemPeseeID", "App.TxtPeseePauID.getValue()", ParameterMode.Raw));
                        }
                    )
            )
            //.Listeners(ls => ls.Add.Handler = "App.BtnReloadListe.fireEvent('click', App.BtnReloadListe);")
            .ColumnModel
            (
                Html.X().Column().Text("Date Lot.").DataIndex("DateCompositionAsString").Flex(1).Hideable(false),
                Html.X().Column().Text("Numero").DataIndex("Numero").Flex(1).Hideable(false),
                Html.X().Column().Text("Nbr De Sacs").DataIndex("NombreSacs").Flex(1).Hideable(false).Editor(Html.X().NumberField().ID("NewNbrSacs").HideTrigger(true)),
                Html.X().Column().Text("Poids Brut (Kg)").DataIndex("PoidsBrutAsString").Flex(1).Hideable(false),
                Html.X().Column().Text("Poids Net (Kg)").DataIndex("PoidsNetAsString").Flex(1).Hideable(false)
            )
            .Plugins
            (
                X.CellEditing().ClicksToEdit(2),
                X.FilterHeader()
            )
            .Listeners(
                ls => ls.BeforeEdit.Handler = "App.NewNbrSacs.setMaxValue(e.record.data.NombreSacs);"
            )
            .DockedItems(
                            X.Toolbar()
                                .Dock(Dock.Top)
                                .Items(
                                        X.Button()
                                            .ID("btnRefreshList")
                                            .IconCls("action_refresh_01")
                                            .Text("Rafraichir")
                                            .Border(false)
                                            .Cls("ButtonStyle")
                                            .Disable(false)
                                            .Listeners(
                                                ls => ls.Click.Handler = "App.grpListLots.getStore().load();"
                                            )
                                         )

            )
            .SelectionModel(
                X.CheckboxSelectionModel()
                    .ID("RowPendingLivforWeighing")
                    .Mode(SelectionMode.Multi)
                    .Listeners
                    (
                        l =>
                        {
                            l.Select.Handler = "SetValidBtnOK();";
                            l.Deselect.Handler = "SetValidBtnOK();";
                        })
            )
    )
    .Buttons
    (
        X.Button()
                    .Text("Selectionner")
                    .ID("BtnSendBlDelivery")
                    .Disabled(true)
                    .DirectEvents
                    (
                        de =>
                        {
                            de.Click.Url = Url.Action("SubmitLot");
                            de.Click.EventMask.ShowMask = true;
                            de.Click.ExtraParams.Add(new Parameter { Name = "ItemSelected", Mode = ParameterMode.Raw, Encode = true, Value = "#{grpListLots}.getRowsValues({selectedOnly : true})" });
                            de.Click.ExtraParams.Add(new Parameter { Name = "VenteID", Mode = ParameterMode.Raw, Encode = false, Value = "App.VenteID.value" });
                        }
                    ),
                X.Button()
                    .Text("Annuler")
                    .Handler("App.FormVente_SelectLot.doClose()")
                    .Cls("btncancel")
            )

)

@Scripts.Render("~/bundles/validation")
<script>
    var FilterDeliveries = function () {
        App.BtnReloadListe.fireEvent('click', App.BtnReloadListe);
    };
</script>










